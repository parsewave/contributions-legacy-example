[162.554332, "o", "       01  WS-N                     COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.554396, "o", "       01  WS-FACTOR                COMP-2 VALUE 0.\r\n\u001b[?2004l\r"]
[162.55443, "o", "\u001b[?2004h> "]
[162.554597, "o", "       01  WS-TMP                   COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.554649, "o", "\u001b[?2004h> "]
[162.554786, "o", "       01  WS-MON-ED                PIC 9(3).\r\n\u001b[?2004l\r"]
[162.554817, "o", "\u001b[?2004h> "]
[162.554975, "o", "       01  WS-PAY-ED                PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.55514, "o", "       01  WS-INT-ED                PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.555308, "o", "       01  WS-PRN-ED                PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.55552, "o", "       01  WS-BAL-ED                PIC 9(10).99.\r\n\u001b[?2004l\r"]
[162.555537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.555575, "o", "> "]
[162.555666, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.55568, "o", "> "]
[162.55572, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.555734, "o", "> "]
[162.555864, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r"]
[162.555881, "o", "\u001b[?2004h> "]
[162.556016, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.556072, "o", "\u001b[?2004h> "]
[162.55619, "o", "           PERFORM UNTIL WS-EOF = \"Y\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.556294, "o", "               READ INFILE\r\n\u001b[?2004l\r    \u001b[?2004h> "]
[162.556411, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.556428, "o", "> "]
[162.556588, "o", "                       MOVE \"Y\" TO WS-EOF\r\n\u001b[?2004l\rAL"]
[162.556625, "o", "\u001b[?2004h> "]
[162.556784, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.556957, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.557037, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.557154, "o", "           END-PERFORM\r\n\u001b[?2004l\r   \u001b[?2004h> \r\n\u001b[?2004l\r "]
[162.557207, "o", "\u001b[?2004h> "]
[162.55728, "o", "           CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.557391, "o", "           CLOSE OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.55743, "o", "> "]
[162.557524, "o", "           STOP RUN.\r\n\u001b[?2004l\r  "]
[162.557538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.557572, "o", "> "]
[162.557632, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r"]
[162.557645, "o", "\u001b[?2004h> "]
[162.5578, "o", "           MOVE SPACES TO WS-ID\r\n\u001b[?2004l\r"]
[162.557812, "o", "\u001b[?2004h> "]
[162.557932, "o", "           MOVE SPACES TO WS-NAME\r\n\u001b[?2004l\r    \u001b[?2004h"]
[162.557977, "o", "> "]
[162.558065, "o", "           MOVE SPACES TO WS-LOAN-TXT\r\n\u001b[?2004l\r    \u001b[?2004h> "]
[162.558216, "o", "           MOVE SPACES TO WS-PROP-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.558427, "o", "           MOVE SPACES TO WS-DOWN-TXT\r\n\u001b[?2004l\r"]
[162.558474, "o", "\u001b[?2004h> "]
[162.55857, "o", "           MOVE SPACES TO WS-TERM-TXT\r\n\u001b[?2004l\rING\r\n\u001b[?2004h"]
[162.558584, "o", "> "]
[162.558732, "o", "           MOVE SPACES TO WS-RATE-TXT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.558762, "o", "\u001b[?2004h> "]
[162.558899, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.55893, "o", "> "]
[162.558981, "o", "               INTO WS-ID\r\n\u001b[?2004l\r"]
[162.559, "o", "\u001b[?2004h> "]
[162.559084, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.559169, "o", "                    WS-LOAN-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.559255, "o", "                    WS-PROP-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.55934, "o", "                    WS-DOWN-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.559465, "o", "                    WS-TERM-TXT\r\n\u001b[?2004l\r"]
[162.559484, "o", "\u001b[?2004h> "]
[162.559554, "o", "                    WS-RATE-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.559629, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.559646, "o", "\u001b[?2004h> "]
[162.559739, "o", "           PERFORM CONVERT-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.559833, "o", "           PERFORM DECIDE-AND-WRITE.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.559899, "o", "\u001b[?2004h> "]
[162.559928, "o", "       CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56012, "o", "           COMPUTE WS-LOAN-AMT ROUNDED = FUNCTION NUMVAL(WS-LOAN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.560276, "o", "           COMPUTE WS-PROP-VALUE ROUNDED = FUNCTION NUMVAL(WS-PROP-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.560464, "o", "           COMPUTE WS-DOWN-PAY ROUNDED = FUNCTION NUMVAL(WS-DOWN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.56048, "o", "\u001b[?2004h> "]
[162.560632, "o", "           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.560748, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.56081, "o", "\u001b[?2004h> "]
[162.560872, "o", "           MOVE 0 TO WS-DOT-COUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561019, "o", "           INSPECT WS-RATE-TXT TALLYING WS-DOT-COUNT FOR ALL \".\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561086, "o", "           IF WS-DOT-COUNT > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561214, "o", "               MOVE FUNCTION NUMVAL(WS-RATE-TXT) TO WS-R\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561275, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561454, "o", "               COMPUTE WS-R ROUNDED = FUNCTION NUMVAL(WS-RATE-TXT) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561524, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.561634, "o", "           COMPUTE WS-RATE-PCT ROUNDED = WS-R\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.561682, "o", "\u001b[?2004h> "]
[162.561797, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VALUE * 0.15.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.561813, "o", "\u001b[?2004h> "]
[162.56189, "o", "       DECIDE-AND-WRITE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56199, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562144, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56224, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56232, "o", "               STRING WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562425, "o", "                      WS-STATUS-DENY\r\n\u001b[?2004l\r"]
[162.562437, "o", "\u001b[?2004h> "]
[162.562532, "o", "                      SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562606, "o", "                      WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562713, "o", "                      DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562792, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562869, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.562963, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56302, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56309, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.563108, "o", "> "]
[162.563183, "o", "               STRING WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563267, "o", "                      WS-STATUS-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563356, "o", "                      DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563491, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563557, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563645, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563734, "o", "               PERFORM CALC-MONTHLY-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563838, "o", "               PERFORM WRITE-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.563888, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.563904, "o", "> "]
[162.563985, "o", "       CALC-MONTHLY-PAY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564122, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE-PCT / 1200\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.564182, "o", "\u001b[?2004h> "]
[162.564239, "o", "           IF WS-TERM-MONTHS = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564322, "o", "               MOVE 0 TO WS-MONTHLY-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564397, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564481, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.564538, "o", "\u001b[?2004h> "]
[162.564595, "o", "           IF WS-MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564695, "o", "               COMPUTE WS-MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564799, "o", "                   WS-LOAN-AMT / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564862, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.564962, "o", "               MOVE WS-LOAN-AMT TO WS-L\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565067, "o", "               MOVE WS-MONTHLY-RATE TO WS-R\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.565085, "o", "> "]
[162.565184, "o", "               MOVE WS-TERM-MONTHS TO WS-N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565308, "o", "               COMPUTE WS-FACTOR = (1 + WS-R) ** WS-N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565481, "o", "               COMPUTE WS-TMP = (WS-L * WS-R * WS-FACTOR) /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56557, "o", "                   (WS-FACTOR - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565689, "o", "               COMPUTE WS-MONTHLY-PAY ROUNDED = WS-TMP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565736, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.565752, "o", "> "]
[162.565821, "o", "       WRITE-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.565926, "o", "           MOVE WS-LOAN-AMT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566061, "o", "           PERFORM VARYING WS-MON FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566156, "o", "               UNTIL WS-MON > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.566204, "o", "> "]
[162.566283, "o", "               COMPUTE WS-INTEREST ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566402, "o", "                   WS-BALANCE * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[162.56646, "o", "> "]
[162.566533, "o", "               IF WS-MON = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566652, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566816, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.566975, "o", "                       WS-PRINCIPAL + WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.567084, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56714, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56725, "o", "                   COMPUTE WS-PRINCIPAL ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.567362, "o", "                       WS-MONTHLY-PAY - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.567501, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r"]
[162.567517, "o", "\u001b[?2004h> "]
[162.567634, "o", "                       WS-PRINCIPAL + WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.56774, "o", "                   COMPUTE WS-BALANCE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.567847, "o", "                       WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.567893, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.567909, "o", "\u001b[?2004h> "]
[162.568033, "o", "               MOVE WS-MON TO WS-MON-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568136, "o", "               MOVE WS-PAYMENT TO WS-PAY-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568239, "o", "               MOVE WS-INTEREST TO WS-INT-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568342, "o", "               MOVE WS-PRINCIPAL TO WS-PRN-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568466, "o", "               MOVE WS-BALANCE TO WS-BAL-ED\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[162.568485, "o", "\u001b[?2004h> "]
[162.568586, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568666, "o", "               STRING WS-MON-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568722, "o", "                      SPACE\r\n\u001b[?2004l\r\u001b[?2004h"]
[162.568738, "o", "> "]
[162.568827, "o", "                      WS-PAY-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.568914, "o", "                      SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569008, "o", "                      WS-INT-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569075, "o", "                      SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569133, "o", "                      WS-PRN-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569224, "o", "                      SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569302, "o", "                      WS-BAL-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569395, "o", "                      DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569503, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569583, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569683, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569775, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.569823, "o", "EOF\r\n\u001b[?2004l\r"]
[162.571249, "o", "\u001b[?2004hroot@89ebd35e8c9b:/app/src# "]
[162.628882, "i", "wc -l program.cbl && sed -n '1,60p' program.cbl\n"]
[162.629196, "o", "wc -l program.cbl && sed -n '1,60p' program.cbl\r\n\u001b[?2004l\r"]
