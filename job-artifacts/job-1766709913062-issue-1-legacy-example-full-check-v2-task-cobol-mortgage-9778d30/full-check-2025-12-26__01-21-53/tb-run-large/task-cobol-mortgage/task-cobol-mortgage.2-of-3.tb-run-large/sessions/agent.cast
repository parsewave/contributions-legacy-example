[162.540718, "i", "cat > program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. MORTGAGE.\n\n       ENVIRONMENT DIVISION.\n       CONFIGURATION SECTION.\n       SPECIAL-NAMES.\n           DECIMAL-POINT IS DOT.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INFILE.\n       01  IN-REC                   PIC X(200).\n       FD  OUTFILE.\n       01  OUT-REC                  PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                   PIC X VALUE \"N\".\n\n       01  WS-ID                    PIC X(10).\n       01  WS-NAME                  PIC X(30).\n       01  WS-LOAN-TXT              PIC X(20).\n       01  WS-PROP-TXT              PIC X(20).\n       01  WS-DOWN-TXT              PIC X(20).\n       01  WS-TERM-TXT              PIC X(10).\n       01  WS-RATE-TXT"]
[162.540772, "i", "              PIC X(20).\n\n       01  WS-LOAN-AMT              PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-PROP-VALUE            PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-DOWN-PAY              PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-MIN-DOWN              PIC 9(11)V99 COMP-3 VALUE 0.\n\n       01  WS-TERM-YEARS            PIC 9(2) COMP VALUE 0.\n       01  WS-TERM-MONTHS           PIC 9(4) COMP VALUE 0.\n\n       01  WS-RATE-PCT              PIC 9(3)V9(4) COMP-3 VALUE 0.\n       01  WS-MONTHLY-RATE          PIC 9V9(9) COMP-3 VALUE 0.\n       01  WS-MONTHLY-PAY           PIC 9(11)V99 COMP-3 VALUE 0.\n\n       01  WS-BALANCE               PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-INTEREST              PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-PRINCIPAL             PIC 9(11)V99 COMP-3 VALUE 0.\n       01  WS-PAYMENT               PIC 9(11)V99 COMP-3 VALUE 0.\n\n       01  WS-MON                   PIC 9(4) COMP VALUE 0.\n\n       01  WS-STATUS-APPRO          PIC X(5) VALUE \"APPRO\".\n       01  WS-STATUS-DENY           PIC X("]
[162.540987, "i", "5) VALUE \"DENY \".\n       01  WS-REASON                PIC X(50) VALUE SPACES.\n\n       01  WS-DOT-COUNT             PIC 9 COMP VALUE 0.\n\n       01  WS-L                     COMP-2 VALUE 0.\n       01  WS-R                     COMP-2 VALUE 0.\n       01  WS-N                     COMP-2 VALUE 0.\n       01  WS-FACTOR                COMP-2 VALUE 0.\n       01  WS-TMP                   COMP-2 VALUE 0.\n\n       01  WS-MON-ED                PIC 9(3).\n       01  WS-PAY-ED                PIC 9(8).99.\n       01  WS-INT-ED                PIC 9(8).99.\n       01  WS-PRN-ED                PIC 9(8).99.\n       01  WS-BAL-ED                PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n\n           PERFORM UNTIL WS-EOF = \"Y\"\n               READ INFILE\n                   AT END\n                       MOVE \"Y\" TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE INFILE\n    "]
[162.541026, "o", "cat > program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[162.541161, "i", "       CLOSE OUTFILE\n           STOP RUN.\n\n       PROCESS-REC.\n           MOVE SPACES TO WS-ID\n           MOVE SPACES TO WS-NAME\n           MOVE SPACES TO WS-LOAN-TXT\n           MOVE SPACES TO WS-PROP-TXT\n           MOVE SPACES TO WS-DOWN-TXT\n           MOVE SPACES TO WS-TERM-TXT\n           MOVE SPACES TO WS-RATE-TXT\n\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-TXT\n                    WS-PROP-TXT\n                    WS-DOWN-TXT\n                    WS-TERM-TXT\n                    WS-RATE-TXT\n           END-UNSTRING\n\n           PERFORM CONVERT-FIELDS\n           PERFORM DECIDE-AND-WRITE.\n\n       CONVERT-FIELDS.\n           COMPUTE WS-LOAN-AMT ROUNDED = FUNCTION NUMVAL(WS-LOAN-TXT)\n           COMPUTE WS-PROP-VALUE ROUNDED = FUNCTION NUMVAL(WS-PROP-TXT)\n           COMPUTE WS-DOWN-PAY ROUNDED = FUNCTION NUMVAL(WS-DOWN-TXT)\n\n           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT)\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS"]
[162.541193, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r5) VALUE \"DENY \".\r\n       01  WS-REASON                PIC X(50) VALUE SPACES.\r\n\r\n       01  WS-DOT-COUNT             PIC 9 COMP VALUE 0.\r\n\r\n       01  WS-L                     COMP-2 VALUE 0.\r\n       01  WS-R                     COMP-2 VALUE 0.\r\n       01  WS-N                     COMP-2 VALUE 0.\r\n       01  WS-FACTOR                COMP-2 VALUE 0.\r\n       01  WS-TMP                   COMP-2 VALUE 0.\r\n\r\n       01  WS-MON-ED                PIC 9(3).\r\n       01  WS-PAY-ED                PIC 9(8).99.\r\n       01  WS-INT-ED                PIC 9(8).99.\r\n       01  WS-PRN-ED                PIC 9(8).99.\r\n       01  WS-BAL-ED                PIC 9(10).99.\r\n\r\n       PROCEDURE DIVISION.\r\n       MAIN.\r\n           OPEN INPUT INFILE\r\n           OPEN OUTPUT OUTFILE\r\n\r\n           PERFORM UNTIL WS-EOF = \"Y\"\r\n               READ INFILE\r\n        "]
[162.541219, "i", " * 12\n\n           MOVE 0 TO WS-DOT-COUNT\n           INSPECT WS-RATE-TXT TALLYING WS-DOT-COUNT FOR ALL \".\"\n           IF WS-DOT-COUNT > 0\n               MOVE FUNCTION NUMVAL(WS-RATE-TXT) TO WS-R\n           ELSE\n               COMPUTE WS-R ROUNDED = FUNCTION NUMVAL(WS-RATE-TXT) / 100\n           END-IF\n           COMPUTE WS-RATE-PCT ROUNDED = WS-R\n\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VALUE * 0.15.\n\n       DECIDE-AND-WRITE.\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               MOVE SPACES TO OUT-REC\n               STRING WS-ID\n                      WS-STATUS-DENY\n                      SPACE\n                      WS-REASON\n                      DELIMITED BY SIZE\n                      INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE SPACES TO OUT-REC\n               STRING WS-ID\n                      WS-STATUS-APPRO\n                      DELIMITED BY SIZE\n                      I"]
[162.541335, "o", "           AT END\r\n                       MOVE \"Y\" TO W"]
[162.541411, "i", "NTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n               PERFORM CALC-MONTHLY-PAY\n               PERFORM WRITE-SCHEDULE\n           END-IF.\n\n       CALC-MONTHLY-PAY.\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE-PCT / 1200\n\n           IF WS-TERM-MONTHS = 0\n               MOVE 0 TO WS-MONTHLY-PAY\n               EXIT PARAGRAPH\n           END-IF\n\n           IF WS-MONTHLY-RATE = 0\n               COMPUTE WS-MONTHLY-PAY ROUNDED =\n                   WS-LOAN-AMT / WS-TERM-MONTHS\n           ELSE\n               MOVE WS-LOAN-AMT TO WS-L\n               MOVE WS-MONTHLY-RATE TO WS-R\n               MOVE WS-TERM-MONTHS TO WS-N\n               COMPUTE WS-FACTOR = (1 + WS-R) ** WS-N\n               COMPUTE WS-TMP = (WS-L * WS-R * WS-FACTOR) /\n                   (WS-FACTOR - 1)\n               COMPUTE WS-MONTHLY-PAY ROUNDED = WS-TMP\n           END-IF.\n\n       WRITE-SCHEDULE.\n           MOVE WS-LOAN-AMT TO WS-BALANCE\n\n           PERFORM VARYING WS-MON FROM 1 BY 1\n               UNTIL WS-MON > WS-TERM-"]
[162.54148, "o", "S-EOF\r\n                   NOT AT END\r\n                       PERFORM PROCESS-REC\r\n               END-READ\r\n           END-PERFORM\r\n\r\n           CLOSE INFILE\r\n           CLOSE OUTFILE\r\n           STOP RUN.\r\n\r\n       PROCESS-REC.\r\n           MOVE SPACES TO WS-ID\r\n           MOVE SPACES TO WS-NAME\r\n           MOVE SPACES TO WS-LOAN-TXT\r\n           MOVE SPACES TO WS-PROP-TXT\r\n           MOVE SPACES TO WS-DOWN-TXT\r\n           MOVE SPACES TO WS-TERM-TXT\r\n           MOVE SPACES TO WS-RATE-TXT\r\n\r\n           UNSTRING IN-REC DELIMITED BY \";\"\r\n               INTO WS-ID\r\n                    WS-NAME\r\n                    WS-LOAN-TXT\r\n                    WS-PROP-TXT\r\n                    WS-DOWN-TXT\r\n                    WS-TERM-TXT\r\n                    WS-RATE-TXT\r\n           END-UNSTRING\r\n\r\n           PERFORM CONVERT-FIELDS\r\n           PERFORM DECIDE-AND-WRITE.\r\n\r\n       CONVERT-FIELDS.\r\n           COMPUTE WS-LOAN-AMT ROUNDED = FUNCTION NUMVAL(WS-LOAN-TXT)\r\n           COMPUTE WS-PROP-VALUE ROUNDED = FUNCTION NUMVAL(WS-PROP-"]
[162.541558, "i", "MONTHS\n\n               COMPUTE WS-INTEREST ROUNDED =\n                   WS-BALANCE * WS-MONTHLY-RATE\n\n               IF WS-MON = WS-TERM-MONTHS\n                   MOVE WS-BALANCE TO WS-PRINCIPAL\n                   COMPUTE WS-PAYMENT ROUNDED =\n                       WS-PRINCIPAL + WS-INTEREST\n                   MOVE 0 TO WS-BALANCE\n               ELSE\n                   COMPUTE WS-PRINCIPAL ROUNDED =\n                       WS-MONTHLY-PAY - WS-INTEREST\n                   COMPUTE WS-PAYMENT ROUNDED =\n                       WS-PRINCIPAL + WS-INTEREST\n                   COMPUTE WS-BALANCE ROUNDED =\n                       WS-BALANCE - WS-PRINCIPAL\n               END-IF\n\n               MOVE WS-MON TO WS-MON-ED\n               MOVE WS-PAYMENT TO WS-PAY-ED\n               MOVE WS-INTEREST TO WS-INT-ED\n               MOVE WS-PRINCIPAL TO WS-PRN-ED\n               MOVE WS-BALANCE TO WS-BAL-ED\n\n               MOVE SPACES TO OUT-REC\n               STRING WS-MON-ED\n                      SPACE\n                      WS-PAY-ED\n "]
[162.541618, "o", "TXT)\r\n           COMPUTE WS-DOWN-PAY ROUNDED = FUNCTION NUMVAL(WS-DOWN-TXT)\r\n\r\n           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT)\r\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\r\n           MOVE 0 TO WS-DOT-COUNT\r\n           INSPE\u001b[?2004h> "]
