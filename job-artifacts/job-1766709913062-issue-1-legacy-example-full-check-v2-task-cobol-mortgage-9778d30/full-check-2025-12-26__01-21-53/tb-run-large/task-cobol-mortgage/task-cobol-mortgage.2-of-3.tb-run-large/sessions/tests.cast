[3.49888, "o", "        result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n            [\u001b[33m'\u001b[39;49;00m\u001b[33m/app/src/programCOMP\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m\r\n            capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            text=\u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m result.returncode == \u001b[94m0\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mProgram failed: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mresult.stderr\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Program failed: libcob: error: file does not exist (status = 35) for file INFILE ('INPUT_DAT' => INPUT.DAT)\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE       assert 1 == 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 1 = CompletedProcess(args=['/app/src/programCOMP'], returncode=1, stdout='', stderr=\"libcob: error: file does not exist (status = 35) for file INFILE ('INPUT_DAT' => INPUT.DAT)\\n\").returncode\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:61: Assertion"]
