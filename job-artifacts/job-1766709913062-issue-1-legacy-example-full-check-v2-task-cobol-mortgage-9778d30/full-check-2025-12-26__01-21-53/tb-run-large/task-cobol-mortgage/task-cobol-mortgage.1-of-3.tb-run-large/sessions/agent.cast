[72.575853, "o", "wc -l /app/data/OUTPUT.DAT && sed -n '1,40p' /app/data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[72.577093, "o", "1 /app/data/OUTPUT.DAT\r\n"]
