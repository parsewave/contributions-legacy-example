[205.179421, "o", "\u001b[?2004hroot@8932fc9aa05e:/app/src# "]
[205.68395, "i", "python3 - <<'PY'\ncontent = \"\"\"       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                 PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                 PIC X VALUE 'N'.\n\n       01  WS-FIELDS.\n           05  WS-ID              PIC X(10).\n           05  WS-NAME            PIC X(30).\n           05  WS-LOAN-A          PIC X(32).\n           05  WS-PROP-A          PIC X(32).\n           05  WS-DOWN-A          PIC X(32).\n           05  WS-TERM-A          PIC X(32).\n           05  WS-RATE-A          PIC X(32).\n\n       01  WS-NUMS.\n           05  WS-LOAN         "]
[205.684204, "i", "   PIC 9(12)V99 COMP-3.\n           05  WS-PROP            PIC 9(12)V99 COMP-3.\n           05  WS-DOWN            PIC 9(12)V99 COMP-3.\n           05  WS-TERM-YRS        PIC 9(4) COMP-3.\n           05  WS-TERM-MOS        PIC 9(5) COMP-3.\n           05  WS-RATE-PCT        PIC 9(3)V99 COMP-3.\n\n       01  WS-CALC.\n           05  WS-MIN-DOWN        PIC 9(12)V99 COMP-3.\n           05  WS-BAL             PIC 9(12)V99 COMP-3.\n           05  WS-MR              COMP-2.\n           05  WS-ONE-PLUS        COMP-2.\n           05  WS-POW             COMP-2.\n           05  WS-DEN             COMP-2.\n           05  WS-PAY-DBL         COMP-2.\n           05  WS-PAY             PIC 9(12)V99 COMP-3.\n           05  WS-INT             PIC 9(12)V99 COMP-3.\n           05  WS-PRIN            PIC 9(12)V99 COMP-3.\n           05  WS-NEWBAL          PIC 9(12)V99 COMP-3.\n\n       01  WS-OUT.\n           05  O-ID               PIC X(10).\n           05  O-STATUS           PIC X(5).\n           05  O-REASON           PIC X(50).\n\n       01  WS-LINE"]
[205.684365, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.684454, "i", ".\n           05  L-MON              PIC 9(3).\n           05  L-PAY              PIC 9(8).99.\n           05  L-INT              PIC 9(8).99.\n           05  L-PRIN             PIC 9(8).99.\n           05  L-REM              PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE.\n\n           PERFORM UNTIL WS-EOF = 'Y'\n               READ IN-FILE\n                   AT END\n                       MOVE 'Y' TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM.\n\n           CLOSE IN-FILE OUT-FILE.\n           STOP RUN.\n\n       PROCESS-REC.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY ';'\n               INTO WS-ID WS-NAME WS-LOAN-A WS-PROP-A\n                    WS-DOWN-A WS-TERM-A WS-RATE-A\n           END-UNSTRING\n\n           PERFORM CONVERT-INPUT\n\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\n\n           IF WS-DOWN < WS-MIN-DOWN\n               "]
[205.684553, "o", "content = \"\"\"       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.684573, "i", "MOVE WS-ID TO O-ID\n               MOVE 'DENY ' TO O-STATUS\n               MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO O-REASON\n               MOVE SPACES TO OUT-REC\n               STRING O-ID DELIMITED BY SIZE\n                      O-STATUS DELIMITED BY SIZE\n                      O-REASON DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE SPACES TO OUT-REC\n               STRING WS-ID DELIMITED BY SIZE\n                      'APPRO' DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       CONVERT-INPUT.\n           COMPUTE WS-LOAN = FUNCTION NUMVAL(WS-LOAN-A)\n           COMPUTE WS-PROP = FUNCTION NUMVAL(WS-PROP-A)\n           COMPUTE WS-DOWN = FUNCTION NUMVAL(WS-DOWN-A)\n           COMPUTE WS-TERM-YRS = FUNCTION NUMVAL(WS-TERM-A)\n           COMPUTE WS-TERM-MOS = WS-TERM-YRS * 12\n           COMPUTE WS-RATE-PCT = FUNC"]
[205.68464, "o", "       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.684698, "i", "TION NUMVAL(WS-RATE-A) / 100.\n\n       BUILD-SCHEDULE.\n           IF WS-TERM-MOS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           MOVE WS-LOAN TO WS-BAL\n\n           COMPUTE WS-MR = (WS-RATE-PCT / 1.0) / 1200.0\n           COMPUTE WS-ONE-PLUS = 1.0 + WS-MR\n\n           IF WS-MR = 0.0\n               COMPUTE WS-PAY ROUNDED = WS-LOAN / WS-TERM-MOS\n           ELSE\n               COMPUTE WS-POW = FUNCTION POWER(WS-ONE-PLUS, WS-TERM-MOS)\n               COMPUTE WS-DEN = 1.0 - (1.0 / WS-POW)\n               COMPUTE WS-PAY-DBL = (WS-LOAN / 1.0) * WS-MR / WS-DEN\n               COMPUTE WS-PAY ROUNDED = WS-PAY-DBL\n           END-IF\n\n           PERFORM VARYING L-MON FROM 1 BY 1\n               UNTIL L-MON > WS-TERM-MOS\n\n               COMPUTE WS-INT ROUNDED = WS-BAL * WS-MR\n               COMPUTE WS-PRIN ROUNDED = WS-PAY - WS-INT\n\n               IF L-MON = WS-TERM-MOS\n                   MOVE WS-BAL TO WS-PRIN\n                   COMPUTE WS-PAY ROUNDED = WS-INT + WS-PRIN\n               END-IF\n\n               COMPU"]
[205.68472, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h>        FILE-CONTROL.\r\n\u001b[?2004l\r"]
[205.684759, "i", "TE WS-NEWBAL ROUNDED = WS-BAL - WS-PRIN\n               IF WS-NEWBAL < 0\n                   MOVE 0 TO WS-NEWBAL\n               END-IF\n\n               MOVE WS-PAY TO L-PAY\n               MOVE WS-INT TO L-INT\n               MOVE WS-PRIN TO L-PRIN\n               MOVE WS-NEWBAL TO L-REM\n\n               MOVE SPACES TO OUT-REC\n               STRING L-MON DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-PAY DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-INT DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-PRIN DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-REM DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n\n               MOVE WS-NEWBAL TO WS-BAL\n           END-PERFORM.\n\"\"\"\nopen('/app/src/program.cbl','w',encoding='utf-8').write(content)\nPY\n"]
[205.684841, "o", "\u001b[?2004h> "]
[205.684918, "o", "           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\r\n\u001b[?2004l\r /"]
[205.684941, "o", "\u001b[?2004h> "]
[205.68508, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.685243, "o", "           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n\u001b[?2004l\r COMPUTE WS-\u001b[?2004h> "]
[205.685346, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.685377, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>        DATA DIVISION.\r\n\u001b[?2004l\r"]
[205.685539, "o", "\u001b[?2004h>        FILE SECTION.\r\n\u001b[?2004l\rON\u001b[?2004h>        FD  IN-FILE.\r\n\u001b[?2004l\rUS, \u001b[?2004h> "]
[205.685675, "o", "       01  IN-REC                 PIC X(256).\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.685692, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.685771, "o", "       FD  OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.685821, "o", "> "]
[205.685932, "o", "       01  OUT-REC                PIC X(256).\r\n\u001b[?2004l\r1\u001b[?2004h> \r\n\u001b[?2004l\r.\u001b[?2004h"]
[205.685993, "o", "> "]
[205.686059, "o", "       WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.686198, "o", "       01  WS-EOF                 PIC X VALUE 'N'.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.686237, "o", "       01  WS-FIELDS.\r\n\u001b[?2004l\r PERFO\u001b[?2004h> "]
[205.686362, "o", "           05  WS-ID              PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.686456, "o", "           05  WS-NAME            PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.686496, "o", "> "]
[205.686602, "o", "           05  WS-LOAN-A          PIC X(32).\r\n\u001b[?2004l\r    \u001b[?2004h"]
[205.686625, "o", "> "]
[205.686751, "o", "           05  WS-PROP-A          PIC X(32).\r\n\u001b[?2004l\rWS-I"]
[205.68678, "o", "\u001b[?2004h> "]
[205.686896, "o", "           05  WS-DOWN-A          PIC X(32).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.687083, "o", "           05  WS-TERM-A          PIC X(32).\r\n\u001b[?2004l\r     \u001b[?2004h> "]
[205.687193, "o", "           05  WS-RATE-A          PIC X(32).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.687219, "o", "+\u001b[?2004h> "]
[205.687371, "o", "       01  WS-NUMS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.687542, "o", "           05  WS-LOAN            PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.687684, "o", "           05  WS-PROP            PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r      \u001b[?2004h> "]
[205.687844, "o", "           05  WS-DOWN            PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.687984, "o", "           05  WS-TERM-YRS        PIC 9(4) COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.688103, "o", "           05  WS-TERM-MOS        PIC 9(5) COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.688272, "o", "           05  WS-RATE-PCT        PIC 9(3)V99 COMP-3.\r\n\u001b[?2004l\r     \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.688298, "o", "> "]
[205.688365, "o", "       01  WS-CALC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.688601, "o", "           05  WS-MIN-DOWN        PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.688759, "o", "           05  WS-BAL             PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r      \u001b[?2004h> "]
[205.688893, "o", "           05  WS-MR              COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689008, "o", "           05  WS-ONE-PLUS        COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689121, "o", "           05  WS-POW             COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689256, "o", "           05  WS-DEN             COMP-2.\r\n\u001b[?2004l\rS\u001b[?2004h> "]
[205.689386, "o", "           05  WS-PAY-DBL         COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689561, "o", "           05  WS-PAY             PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689707, "o", "           05  WS-INT             PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.689872, "o", "           05  WS-PRIN            PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69001, "o", "           05  WS-NEWBAL          PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r-"]
[205.690029, "o", "\u001b[?2004h> "]
[205.690106, "o", "       01  WS-OUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.690215, "o", "           05  O-ID               PIC X(10).\r\n\u001b[?2004l\r'w',\u001b[?2004h"]
[205.690242, "o", "> "]
[205.690408, "o", "           05  O-STATUS           PIC X(5).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.690593, "o", "           05  O-REASON           PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69063, "o", "       01  WS-LINE.\r\n\u001b[?2004l\r"]
[205.690706, "o", "\u001b[?2004h"]
[205.69075, "o", "> "]
[205.690811, "o", "           05  L-MON              PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.690938, "o", "           05  L-PAY              PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.690958, "o", "> "]
[205.691077, "o", "           05  L-INT              PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.691215, "o", "           05  L-PRIN             PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.691368, "o", "           05  L-REM              PIC 9(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.691392, "o", "> "]
[205.691509, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.691546, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.691649, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69177, "o", "                OUTPUT OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.691787, "o", "\u001b[?2004h> "]
[205.691911, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692004, "o", "               READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692088, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692218, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692317, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692441, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692577, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.692649, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.692672, "o", "\u001b[?2004h> "]
[205.692782, "o", "           CLOSE IN-FILE OUT-FILE.\r\n\u001b[?2004l\r"]
[205.6928, "o", "\u001b[?2004h> "]
[205.692881, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.692899, "o", "\u001b[?2004h> "]
[205.692988, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69311, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r"]
[205.693126, "o", "\u001b[?2004h> "]
[205.693249, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r"]
[205.693266, "o", "\u001b[?2004h> "]
[205.693432, "o", "               INTO WS-ID WS-NAME WS-LOAN-A WS-PROP-A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.693617, "o", "                    WS-DOWN-A WS-TERM-A WS-RATE-A\r\n\u001b[?2004l\r"]
[205.693636, "o", "\u001b[?2004h> "]
[205.693722, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[205.693752, "o", "\u001b[?2004l\r"]
[205.693763, "o", "\u001b[?2004h"]
[205.693771, "o", "> "]
[205.693891, "o", "           PERFORM CONVERT-INPUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.693911, "o", "\r\n\u001b[?2004l\r"]
[205.69399, "o", "\u001b[?2004h> "]
[205.694103, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.694192, "o", "\u001b[?2004h> "]
[205.694224, "o", "           IF WS-DOWN < WS-MIN-DOWN\r\n\u001b[?2004l\r"]
[205.694289, "o", "\u001b[?2004h> "]
[205.694341, "o", "               MOVE WS-ID TO O-ID\r\n\u001b[?2004l\r"]
[205.694364, "o", "\u001b[?2004h> "]
[205.69445, "o", "               MOVE 'DENY ' TO O-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.694591, "o", "               MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO O-REASON\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.69461, "o", "> "]
[205.694718, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r"]
[205.694756, "o", "\u001b[?2004h> "]
[205.694896, "o", "               STRING O-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.694995, "o", "                      O-STATUS DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.6951, "o", "                      O-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69513, "o", "                 INTO OUT-REC\r\n"]
[205.695195, "o", "\u001b[?2004l\r\u001b[?2004h>                END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695285, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695304, "o", "           ELSE\r\n\u001b[?2004l\r"]
[205.695385, "o", "\u001b[?2004h> "]
[205.695481, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695572, "o", "               STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695667, "o", "                      'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695756, "o", "                 INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.695778, "o", "               END-STRING\r\n\u001b[?2004l\r"]
[205.695854, "o", "\u001b[?2004h>                WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[205.695875, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.695999, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.696074, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.696091, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.696104, "o", "> "]
[205.696201, "o", "       CONVERT-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.696354, "o", "           COMPUTE WS-LOAN = FUNCTION NUMVAL(WS-LOAN-A)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.696537, "o", "           COMPUTE WS-PROP = FUNCTION NUMVAL(WS-PROP-A)\r\n\u001b[?2004l\r"]
[205.696568, "o", "\u001b[?2004h> "]
[205.696752, "o", "           COMPUTE WS-DOWN = FUNCTION NUMVAL(WS-DOWN-A)\r\n\u001b[?2004l\r"]
[205.696839, "o", "\u001b[?2004h> "]
[205.696961, "o", "           COMPUTE WS-TERM-YRS = FUNCTION NUMVAL(WS-TERM-A)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.697128, "o", "           COMPUTE WS-TERM-MOS = WS-TERM-YRS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.697335, "o", "           COMPUTE WS-RATE-PCT = FUNCTION NUMVAL(WS-RATE-A) / 100.\r\n\u001b[?2004l\r"]
[205.697355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.697435, "o", "\u001b[?2004h> "]
[205.697456, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r"]
[205.697538, "o", "\u001b[?2004h"]
[205.697598, "o", "> "]
[205.697665, "o", "           IF WS-TERM-MOS <= 0\r\n\u001b[?2004l\r"]
[205.697683, "o", "\u001b[?2004h> "]
[205.697823, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.697907, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[205.697925, "o", "\u001b[?2004l\r\u001b[?2004h"]
[205.697993, "o", "> "]
[205.69807, "o", "           MOVE WS-LOAN TO WS-BAL\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.698085, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.698157, "o", "> "]
[205.698278, "o", "           COMPUTE WS-MR = (WS-RATE-PCT / 1.0) / 1200.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.698427, "o", "           COMPUTE WS-ONE-PLUS = 1.0 + WS-MR\r\n\u001b[?2004l\r"]
[205.698444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.698546, "o", "\u001b[?2004h> "]
[205.698564, "o", "           IF WS-MR = 0.0\r\n\u001b[?2004l\r"]
[205.69863, "o", "\u001b[?2004h> "]
[205.698812, "o", "               COMPUTE WS-PAY ROUNDED = WS-LOAN / WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.698905, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.699108, "o", "               COMPUTE WS-POW = FUNCTION POWER(WS-ONE-PLUS, WS-TERM-MOS)\r\n\u001b[?2004l\r"]
[205.699126, "o", "\u001b[?2004h> "]
[205.699293, "o", "               COMPUTE WS-DEN = 1.0 - (1.0 / WS-POW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.699309, "o", "> "]
[205.699516, "o", "               COMPUTE WS-PAY-DBL = (WS-LOAN / 1.0) * WS-MR / WS-DEN\r\n\u001b[?2004l\r"]
[205.699607, "o", "\u001b[?2004h> "]
[205.699695, "o", "               COMPUTE WS-PAY ROUNDED = WS-PAY-DBL\r\n\u001b[?2004l\r"]
[205.699713, "o", "\u001b[?2004h> "]
[205.699802, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.69982, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.699875, "o", "> "]
[205.699996, "o", "           PERFORM VARYING L-MON FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.70015, "o", "               UNTIL L-MON > WS-TERM-MOS\r\n\u001b[?2004l\r"]
[205.700166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.700177, "o", "\u001b[?2004h> "]
[205.700355, "o", "               COMPUTE WS-INT ROUNDED = WS-BAL * WS-MR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.700577, "o", "               COMPUTE WS-PRIN ROUNDED = WS-PAY - WS-INT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.700595, "o", "\u001b[?2004h> "]
[205.70075, "o", "               IF L-MON = WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.7009, "o", "                   MOVE WS-BAL TO WS-PRIN\r\n\u001b[?2004l\r"]
[205.700919, "o", "\u001b[?2004h> "]
[205.701066, "o", "                   COMPUTE WS-PAY ROUNDED = WS-INT + WS-PRIN\r\n\u001b[?2004l\r"]
[205.701085, "o", "\u001b[?2004h> "]
[205.701173, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.701191, "o", "\r\n\u001b[?2004l\r"]
[205.701272, "o", "\u001b[?2004h> "]
[205.701398, "o", "               COMPUTE WS-NEWBAL ROUNDED = WS-BAL - WS-PRIN\r\n\u001b[?2004l\r"]
[205.701416, "o", "\u001b[?2004h> "]
[205.701538, "o", "               IF WS-NEWBAL < 0\r\n\u001b[?2004l\r"]
[205.701556, "o", "\u001b[?2004h> "]
[205.70168, "o", "                   MOVE 0 TO WS-NEWBAL\r\n\u001b[?2004l\r"]
[205.701698, "o", "\u001b[?2004h> "]
[205.701795, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.701812, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.701893, "o", "> "]
[205.701962, "o", "               MOVE WS-PAY TO L-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.702085, "o", "               MOVE WS-INT TO L-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.702215, "o", "               MOVE WS-PRIN TO L-PRIN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.702361, "o", "               MOVE WS-NEWBAL TO L-REM\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.702435, "o", "\u001b[?2004h> "]
[205.702531, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r"]
[205.70255, "o", "\u001b[?2004h> "]
[205.702705, "o", "               STRING L-MON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.702873, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[205.702891, "o", "\u001b[?2004h> "]
[205.703075, "o", "                      L-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.703186, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.703337, "o", "                      L-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.703514, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
