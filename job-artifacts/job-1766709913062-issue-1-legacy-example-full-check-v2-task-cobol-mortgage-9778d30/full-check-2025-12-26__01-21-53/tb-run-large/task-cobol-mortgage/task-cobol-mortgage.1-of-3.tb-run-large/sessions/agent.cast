[69.183117, "o", "> "]
[69.183244, "o", "               STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.183336, "o", "                      WS-STATUS DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.183484, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18354, "o", "                      WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.183661, "o", "                   INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.183763, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h>                WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.183787, "o", "> "]
[69.18388, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18401, "o", "               MOVE 'APPRO' TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184109, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18422, "o", "               STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184335, "o", "                      WS-STATUS DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184404, "o", "                   INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184498, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184559, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.184632, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184715, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.184762, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[69.184782, "o", "\u001b[?2004l\r"]
[69.184837, "o", "\u001b[?2004h> "]
[69.184924, "o", "       CONVERT-NUMBERS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185069, "o", "           COMPUTE WS-LOAN = FUNCTION NUMVAL(WS-LOAN-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185286, "o", "           COMPUTE WS-PROP = FUNCTION NUMVAL(WS-PROP-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185401, "o", "           COMPUTE WS-DOWN = FUNCTION NUMVAL(WS-DOWN-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185539, "o", "           COMPUTE WS-TERM = FUNCTION NUMVAL(WS-TERM-A)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185695, "o", "           COMPUTE WS-RATE = FUNCTION NUMVAL(WS-RATE-A) * 100.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.185754, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.185813, "o", "> "]
[69.18587, "o", "           MOVE WS-LOAN TO WS-BAL\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186073, "o", "           COMPUTE WS-MR = (WS-RATE / 100.0) / 1200.0\r\n\u001b[?2004l\r\u001b[?2004h>            COMPUTE WS-ONE-PLUS-MR = 1.0 + WS-MR\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.186258, "o", "\u001b[?2004h>            IF WS-TERM <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186355, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h>            END-IF\r\n\u001b[?2004l\r"]
[69.186421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18645, "o", "           IF WS-MR = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186611, "o", "               COMPUTE WS-PAY ROUNDED = WS-LOAN / WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186673, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186822, "o", "               COMPUTE WS-POW = FUNCTION POWER(WS-ONE-PLUS-MR, WS-TERM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.186928, "o", "               COMPUTE WS-DENOM = 1.0 - (1.0 / WS-POW)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.187128, "o", "               COMPUTE WS-PAY-DBL = (WS-LOAN / 100.0) * WS-MR / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.187258, "o", "               COMPUTE WS-PAY ROUNDED = WS-PAY-DBL * 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.187423, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.187643, "o", "           PERFORM VARYING F-MON FROM 1 BY 1 UNTIL F-MON > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.187729, "o", "               COMPUTE WS-INT ROUNDED = WS-BAL * WS-MR\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.187751, "o", "\u001b[?2004h> "]
[69.187878, "o", "               COMPUTE WS-PRIN ROUNDED = WS-PAY - WS-INT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.187894, "o", "\u001b[?2004h> "]
[69.187992, "o", "               IF F-MON = WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188079, "o", "                   MOVE WS-BAL TO WS-PRIN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188212, "o", "                   COMPUTE WS-PAY ROUNDED = WS-INT + WS-PRIN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188288, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.188305, "o", "\u001b[?2004h> "]
[69.188489, "o", "               COMPUTE WS-NEWBAL ROUNDED = WS-BAL - WS-PRIN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188608, "o", "               IF WS-NEWBAL < 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188735, "o", "                   MOVE 0 TO WS-NEWBAL\r\n\u001b[?2004l\r"]
[69.188822, "o", "\u001b[?2004h> "]
[69.18888, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.188953, "o", "               COMPUTE F-PAY = WS-PAY / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189035, "o", "               COMPUTE F-INT = WS-INT / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189125, "o", "               COMPUTE F-PRIN = WS-PRIN / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189252, "o", "               COMPUTE F-REM = WS-NEWBAL / 100\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189359, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189485, "o", "               STRING F-MON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18958, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189753, "o", "                      F-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.189874, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190002, "o", "                      F-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190106, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190242, "o", "                      F-PRIN DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h>                       ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190397, "o", "                      F-REM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190418, "o", "                   INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190547, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.190561, "o", "> "]
[69.190655, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.190775, "o", "\u001b[?2004h> "]
[69.190814, "o", "               MOVE WS-NEWBAL TO WS-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.190906, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> COB\r\n\u001b[?2004l\r"]
