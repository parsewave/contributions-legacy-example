[341.863411, "o", "\u001b[?2004h> "]
[341.863575, "o", "           05  WS-INT-AMT         PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[341.863591, "o", "\u001b[?2004h> "]
[341.863762, "o", "           05  WS-PRIN-AMT        PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[341.863777, "o", "\u001b[?2004h> "]
[341.863965, "o", "           05  WS-REM-AMT         PIC 9(12)V99 COMP-3.\r\n\u001b[?2004l\r"]
[341.86398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.863998, "o", "> "]
[341.864117, "o", "       01  WS-OUT-FIELDS.\r\n\u001b[?2004l\r \u001b[?2004h"]
[341.864157, "o", "> "]
[341.864276, "o", "           05  O-ID               PIC X(10).\r\n\u001b[?2004l\r"]
[341.864294, "o", "\u001b[?2004h> "]
[341.864432, "o", "           05  O-STATUS           PIC X(5).\r\n\u001b[?2004l\r"]
[341.864445, "o", "\u001b[?2004h> "]
[341.864617, "o", "           05  O-REASON           PIC X(50).\r\n\u001b[?2004l\r"]
[341.864632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.864695, "o", " \u001b[?2004h> "]
[341.864788, "o", "       01  WS-LINE.\r\n\u001b[?2004l\r \u001b[?2004h"]
[341.864804, "o", "> "]
[341.864974, "o", "           05  L-MON              PIC 9(3).\r\n\u001b[?2004l\r"]
[341.864988, "o", "\u001b[?2004h> "]
[341.865161, "o", "           05  L-PAY              PIC 9(8).99.\r\n\u001b[?2004l\r"]
[341.865212, "o", "\u001b[?2004h> "]
[341.865335, "o", "           05  L-INT              PIC 9(8).99.\r\n\u001b[?2004l\r"]
[341.865348, "o", "\u001b[?2004h> "]
[341.865561, "o", "           05  L-PRIN             PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.865733, "o", "           05  L-REM              PIC 9(10).99.\r\n\u001b[?2004l\r"]
[341.865751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rA\u001b[?2004h"]
[341.865788, "o", "> "]
[341.865897, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r"]
[341.86591, "o", "\u001b[?2004h> "]
[341.865972, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.866099, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.866222, "o", "                OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[341.866234, "o", "\u001b[?2004l\r\u001b[?2004h"]
[341.866283, "o", "> "]
[341.86641, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.866563, "o", "               READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.866661, "o", "                   AT END\r\n\u001b[?2004l\r"]
[341.866677, "o", "\u001b[?2004h> "]
[341.866873, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.866906, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.867072, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.86716, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.867181, "o", "           END-PERFORM\r\n\u001b[?2004l\r"]
[341.867225, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.86724, "o", "\u001b[?2004h> "]
[341.867368, "o", "           CLOSE IN-FILE OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.867445, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[341.867515, "o", "\u001b[?2004l\r"]
[341.867541, "o", "\u001b[?2004h> "]
[341.867596, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.867618, "o", "> "]
[341.867742, "o", "           MOVE SPACES TO WS-IN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.867886, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r"]
[341.867909, "o", "\u001b[?2004h> "]
[341.868064, "o", "               INTO IN-ID IN-NAME IN-LOAN-A IN-PROP-A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.86823, "o", "                    IN-DOWN-A IN-TERM-A IN-RATE-A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.868318, "o", "           END-UNSTRING\r\n\u001b[?2004l\r"]
[341.868334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.868395, "o", "\u001b[?2004h> "]
[341.868497, "o", "           PERFORM CONVERT-INPUT\r\n\u001b[?2004l\r"]
[341.868516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.868572, "o", "\u001b[?2004h> "]
[341.868729, "o", "           COMPUTE WS-MIN-DOWN-C ROUNDED = WS-PROP-C * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.868744, "o", "\u001b[?2004h> "]
[341.868901, "o", "           IF WS-DOWN-C < WS-MIN-DOWN-C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.869035, "o", "               MOVE IN-ID TO O-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.86918, "o", "               MOVE 'DENY ' TO O-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.86937, "o", "               MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO O-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.869514, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r"]
[341.869532, "o", "\u001b[?2004h> "]
[341.869685, "o", "               STRING O-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.86984, "o", "                      O-STATUS DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870021, "o", "                      O-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870097, "o", "                 INTO OUT-REC\r\n\u001b[?2004l\r"]
[341.870117, "o", "\u001b[?2004h> "]
[341.870225, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870346, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870416, "o", "           ELSE\r\n\u001b[?2004l\r"]
[341.87043, "o", "\u001b[?2004h> "]
[341.87058, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.870597, "o", "> "]
[341.870742, "o", "               STRING IN-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870925, "o", "                      'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.870952, "o", "                 INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.870999, "o", "> "]
[341.871078, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.871098, "o", "> "]
[341.871205, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[341.87122, "o", "\u001b[?2004l\r\u001b[?2004h"]
[341.871277, "o", "> "]
[341.871379, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r"]
[341.871396, "o", "\u001b[?2004h> "]
[341.871497, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.871526, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.871543, "o", "> "]
[341.871662, "o", "       CONVERT-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.871855, "o", "           COMPUTE WS-LOAN-C = FUNCTION NUMVAL(IN-LOAN-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87204, "o", "           COMPUTE WS-PROP-C = FUNCTION NUMVAL(IN-PROP-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.872232, "o", "           COMPUTE WS-DOWN-C = FUNCTION NUMVAL(IN-DOWN-A) * 100\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.872251, "o", "\u001b[?2004h> "]
[341.87244, "o", "           COMPUTE WS-TERM-YRS = FUNCTION NUMVAL(IN-TERM-A)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.8726, "o", "           COMPUTE WS-TERM-MOS = WS-TERM-YRS * 12\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.872617, "o", "\u001b[?2004h> "]
[341.872826, "o", "           COMPUTE WS-RATE-PCT = FUNCTION NUMVAL(IN-RATE-A) / 100.0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.872867, "o", "> "]
[341.872966, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r"]
[341.872995, "o", "\u001b[?2004h> "]
[341.873117, "o", "           IF WS-TERM-MOS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.873215, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.873271, "o", "           END-IF\r\n\u001b[?2004l\r"]
[341.873298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.873348, "o", "\u001b[?2004h"]
[341.873371, "o", "> "]
[341.873484, "o", "           MOVE WS-LOAN-C TO WS-BAL-C\r\n\u001b[?2004l\r"]
[341.873511, "o", "\u001b[?2004h> "]
[341.873563, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.873683, "o", "           COMPUTE WS-MR = WS-RATE-PCT / 1200.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.873842, "o", "           COMPUTE WS-ONE-PLUS = 1.0 + WS-MR\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.8739, "o", "\u001b[?2004h> "]
[341.87399, "o", "           IF WS-MR = 0.0\r\n\u001b[?2004l\r"]
[341.874011, "o", "\u001b[?2004h> "]
[341.874188, "o", "               COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C / WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.874267, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.874458, "o", "               COMPUTE WS-POW = WS-ONE-PLUS ** WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87463, "o", "               COMPUTE WS-DEN = 1.0 - (1.0 / WS-POW)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.874749, "o", "               IF WS-DEN = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.874958, "o", "                   COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C / WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.875022, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87523, "o", "                   COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C * WS-MR / WS-DEN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.875304, "o", "               END-IF\r\n\u001b[?2004l\r"]
[341.875323, "o", "\u001b[?2004h> "]
[341.875403, "o", "           END-IF\r\n\u001b[?2004l\r"]
[341.875416, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.875483, "o", "> "]
[341.875621, "o", "           PERFORM VARYING L-MON FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.875769, "o", "               UNTIL L-MON > WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.875782, "o", "> "]
[341.875979, "o", "               COMPUTE WS-INT-C ROUNDED = WS-BAL-C * WS-MR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.876173, "o", "               COMPUTE WS-PRIN-C ROUNDED = WS-PAY-C - WS-INT-C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.876307, "o", "               IF L-MON = WS-TERM-MOS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.876451, "o", "                   MOVE WS-BAL-C TO WS-PRIN-C\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.876519, "o", "> "]
[341.876683, "o", "                   COMPUTE WS-PAY-C ROUNDED = WS-INT-C + WS-PRIN-C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.876772, "o", "               END-IF\r\n\u001b[?2004l\r"]
[341.876787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.876827, "o", "\u001b[?2004h"]
[341.876895, "o", "> "]
[341.877033, "o", "               COMPUTE WS-NEWBAL-C ROUNDED = WS-BAL-C - WS-PRIN-C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87716, "o", "               IF WS-NEWBAL-C < 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.877304, "o", "                   MOVE 0 TO WS-NEWBAL-C\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.877361, "o", "> "]
[341.877423, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.877447, "o", "\u001b[?2004h> "]
[341.877648, "o", "               COMPUTE WS-PAY-AMT ROUNDED = WS-PAY-C / 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87783, "o", "               COMPUTE WS-INT-AMT ROUNDED = WS-INT-C / 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.878023, "o", "               COMPUTE WS-PRIN-AMT ROUNDED = WS-PRIN-C / 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.87824, "o", "               COMPUTE WS-REM-AMT ROUNDED = WS-NEWBAL-C / 100.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.878298, "o", "               MOVE WS-PAY-AMT TO L-PAY\r\n\u001b[?2004l\r"]
[341.87831, "o", "\u001b[?2004h"]
[341.87835, "o", "> "]
[341.878499, "o", "               MOVE WS-INT-AMT TO L-INT\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.878577, "o", "> "]
[341.87868, "o", "               MOVE WS-PRIN-AMT TO L-PRIN\r\n\u001b[?2004l\r"]
[341.878697, "o", "\u001b[?2004h> "]
[341.878866, "o", "               MOVE WS-REM-AMT TO L-REM\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.878881, "o", "\u001b[?2004h> "]
[341.879024, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.879196, "o", "               STRING L-MON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.879292, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.879436, "o", "                      L-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.879606, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.879728, "o", "                      L-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[341.879745, "o", "\u001b[?2004h> "]
[341.879893, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[341.879909, "o", "\u001b[?2004h> "]
[341.880059, "o", "                      L-PRIN DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.880192, "o", "                      ' ' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.880345, "o", "                      L-REM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.88044, "o", "                 INTO OUT-REC\r\n\u001b[?2004l\r"]
[341.880452, "o", "\u001b[?2004h> "]
[341.880589, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.880688, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[341.880702, "o", "\u001b[?2004l\r"]
[341.880746, "o", "\u001b[?2004h> "]
[341.880913, "o", "               MOVE WS-NEWBAL-C TO WS-BAL-C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.880995, "o", "           END-PERFORM.\r\n\u001b[?2004l\r"]
[341.881013, "o", "\u001b[?2004h> "]
[341.881036, "o", "COB\r\n\u001b[?2004l\r"]
[341.882762, "o", "\u001b[?2004hroot@8932fc9aa05e:/app/src# "]
[342.147183, "i", "python3 - <<'PY'\n# verify fixed-format line length requirement\nmx=0\nbad=[]\nfor i,l in enumerate(open('/app/src/program.cbl','r',encoding='utf-8'),1):\n    n=len(l.rstrip('\\n'))\n    mx=max(mx,n)\n    if n>80:\n        bad.append((i,n,l.rstrip('\\n')))\nprint('max_len',mx)\nif bad:\n    print('lines>80:',len(bad))\n    for b in bad[:10]:\n        print(b)\nPY\n"]
[342.147382, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[342.147489, "o", "\u001b[?2004h> "]
[342.147573, "o", "# verify fixed-format line length requirement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.147631, "o", "mx=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.147686, "o", "bad=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.147801, "o", "for i,l in enumerate(open('/app/src/program.cbl','r',encoding='utf-8'),1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.14786, "o", "> "]
[342.147932, "o", "    n=len(l.rstrip('\\n'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.147988, "o", "    mx=max(mx,n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.148041, "o", "    if n>80:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.148113, "o", "        bad.append((i,n,l.rstrip('\\n')))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.148185, "o", "print('max_len',mx)\r\n\u001b[?2004l\r"]
[342.148232, "o", "\u001b[?2004h> "]
[342.148249, "o", "if bad:\r\n\u001b[?2004l\r"]
[342.148297, "o", "\u001b[?2004h> "]
