[69.180407, "o", "> "]
[69.180571, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.180657, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r"]
[69.180743, "o", "\u001b[?2004h> "]
[69.180807, "o", "                OUTPUT OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.180878, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.180898, "o", "> "]
[69.180956, "o", "               READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.180977, "o", "> "]
[69.181032, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181146, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181257, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18133, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181417, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181448, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181554, "o", "           CLOSE IN-FILE OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.181682, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.181705, "o", "\u001b[?2004h> "]
[69.181771, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.181794, "o", "> "]
[69.181839, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.18206, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.182182, "o", "               INTO WS-ID WS-NAME WS-LOAN-A WS-PROP-A\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.182203, "o", "> "]
[69.182315, "o", "                    WS-DOWN-A WS-TERM-A WS-RATE-A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.182392, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.182409, "o", "\u001b[?2004h> "]
[69.182498, "o", "           PERFORM CONVERT-NUMBERS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[69.182557, "o", "> "]
[69.182649, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.182669, "o", "\u001b[?2004h> "]
[69.182765, "o", "           IF WS-DOWN < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
