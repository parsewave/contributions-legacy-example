[341.8518, "i", "cat > /app/src/program.cbl <<'COB'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                 PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                 PIC X VALUE 'N'.\n\n       01  WS-IN.\n           05  IN-ID              PIC X(10).\n           05  IN-NAME            PIC X(30).\n           05  IN-LOAN-A          PIC X(32).\n           05  IN-PROP-A          PIC X(32).\n           05  IN-DOWN-A          PIC X(32).\n           05  IN-TERM-A          PIC X(32).\n           05  IN-RATE-A          PIC X(32).\n\n       01  WS-RAW.\n           05  WS-TERM-YRS     "]
[341.851875, "i", "   PIC 9(4) COMP-3.\n           05  WS-TERM-MOS        PIC 9(5) COMP-3.\n           05  WS-RATE-PCT        COMP-2.\n\n       01  WS-MONEY-CENTS.\n           05  WS-LOAN-C          PIC 9(14) COMP-3.\n           05  WS-PROP-C          PIC 9(14) COMP-3.\n           05  WS-DOWN-C          PIC 9(14) COMP-3.\n           05  WS-MIN-DOWN-C      PIC 9(14) COMP-3.\n           05  WS-BAL-C           PIC 9(14) COMP-3.\n           05  WS-PAY-C           PIC 9(14) COMP-3.\n           05  WS-INT-C           PIC 9(14) COMP-3.\n           05  WS-PRIN-C          PIC 9(14) COMP-3.\n           05  WS-NEWBAL-C        PIC 9(14) COMP-3.\n\n       01  WS-MATH.\n           05  WS-MR              COMP-2.\n           05  WS-ONE-PLUS        COMP-2.\n           05  WS-POW             COMP-2.\n           05  WS-DEN             COMP-2.\n\n       01  WS-AMTS.\n           05  WS-PAY-AMT         PIC 9(10)V99 COMP-3.\n           05  WS-INT-AMT         PIC 9(10)V99 COMP-3.\n           05  WS-PRIN-AMT        PIC 9(10)V99 COMP-3.\n           05  WS-REM-AMT         PIC 9("]
[341.851886, "i", "12)V99 COMP-3.\n\n       01  WS-OUT-FIELDS.\n           05  O-ID               PIC X(10).\n           05  O-STATUS           PIC X(5).\n           05  O-REASON           PIC X(50).\n\n       01  WS-LINE.\n           05  L-MON              PIC 9(3).\n           05  L-PAY              PIC 9(8).99.\n           05  L-INT              PIC 9(8).99.\n           05  L-PRIN             PIC 9(8).99.\n           05  L-REM              PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE\n\n           PERFORM UNTIL WS-EOF = 'Y'\n               READ IN-FILE\n                   AT END\n                       MOVE 'Y' TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE IN-FILE OUT-FILE\n           STOP RUN.\n\n       PROCESS-REC.\n           MOVE SPACES TO WS-IN\n           UNSTRING IN-REC DELIMITED BY ';'\n               INTO IN-ID IN-NAME IN-LOAN-A IN-PROP-A\n                    IN-DOWN-A"]
[341.851894, "i", " IN-TERM-A IN-RATE-A\n           END-UNSTRING\n\n           PERFORM CONVERT-INPUT\n\n           COMPUTE WS-MIN-DOWN-C ROUNDED = WS-PROP-C * 0.15\n\n           IF WS-DOWN-C < WS-MIN-DOWN-C\n               MOVE IN-ID TO O-ID\n               MOVE 'DENY ' TO O-STATUS\n               MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO O-REASON\n               MOVE SPACES TO OUT-REC\n               STRING O-ID DELIMITED BY SIZE\n                      O-STATUS DELIMITED BY SIZE\n                      O-REASON DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE SPACES TO OUT-REC\n               STRING IN-ID DELIMITED BY SIZE\n                      'APPRO' DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       CONVERT-INPUT.\n           COMPUTE WS-LOAN-C = FUNCTION NUMVAL(IN-LOAN-A) * 100\n           COMPUTE WS-PROP-C = FUNCTION NUMVAL(IN-PROP-"]
[341.852083, "i", "A) * 100\n           COMPUTE WS-DOWN-C = FUNCTION NUMVAL(IN-DOWN-A) * 100\n\n           COMPUTE WS-TERM-YRS = FUNCTION NUMVAL(IN-TERM-A)\n           COMPUTE WS-TERM-MOS = WS-TERM-YRS * 12\n\n           COMPUTE WS-RATE-PCT = FUNCTION NUMVAL(IN-RATE-A) / 100.0.\n\n       BUILD-SCHEDULE.\n           IF WS-TERM-MOS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           MOVE WS-LOAN-C TO WS-BAL-C\n\n           COMPUTE WS-MR = WS-RATE-PCT / 1200.0\n           COMPUTE WS-ONE-PLUS = 1.0 + WS-MR\n\n           IF WS-MR = 0.0\n               COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C / WS-TERM-MOS\n           ELSE\n               COMPUTE WS-POW = WS-ONE-PLUS ** WS-TERM-MOS\n               COMPUTE WS-DEN = 1.0 - (1.0 / WS-POW)\n               IF WS-DEN = 0.0\n                   COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C / WS-TERM-MOS\n               ELSE\n                   COMPUTE WS-PAY-C ROUNDED = WS-LOAN-C * WS-MR / WS-DEN\n               END-IF\n           END-IF\n\n           PERFORM VARYING L-MON FROM 1 BY 1\n               UNTIL L-MON > WS-T"]
[341.852207, "o", "cat > /app/src/program.cbl <<'COB'\r\n\u001b[?2004l\rA) * 100\r\n           COMPUTE WS-DOW\u001b[?2004h> "]
[341.85224, "i", "ERM-MOS\n\n               COMPUTE WS-INT-C ROUNDED = WS-BAL-C * WS-MR\n               COMPUTE WS-PRIN-C ROUNDED = WS-PAY-C - WS-INT-C\n\n               IF L-MON = WS-TERM-MOS\n                   MOVE WS-BAL-C TO WS-PRIN-C\n                   COMPUTE WS-PAY-C ROUNDED = WS-INT-C + WS-PRIN-C\n               END-IF\n\n               COMPUTE WS-NEWBAL-C ROUNDED = WS-BAL-C - WS-PRIN-C\n               IF WS-NEWBAL-C < 0\n                   MOVE 0 TO WS-NEWBAL-C\n               END-IF\n\n               COMPUTE WS-PAY-AMT ROUNDED = WS-PAY-C / 100.0\n               COMPUTE WS-INT-AMT ROUNDED = WS-INT-C / 100.0\n               COMPUTE WS-PRIN-AMT ROUNDED = WS-PRIN-C / 100.0\n               COMPUTE WS-REM-AMT ROUNDED = WS-NEWBAL-C / 100.0\n\n               MOVE WS-PAY-AMT TO L-PAY\n               MOVE WS-INT-AMT TO L-INT\n               MOVE WS-PRIN-AMT TO L-PRIN\n               MOVE WS-REM-AMT TO L-REM\n\n               MOVE SPACES TO OUT-REC\n               STRING L-MON DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n             "]
[341.852395, "i", "         L-PAY DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-INT DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-PRIN DELIMITED BY SIZE\n                      ' ' DELIMITED BY SIZE\n                      L-REM DELIMITED BY SIZE\n                 INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n\n               MOVE WS-NEWBAL-C TO WS-BAL-C\n           END-PERFORM.\nCOB\n"]
