[72.578825, "m", "Episode 1: 12 commands"]
[72.578825, "o", "\u001b[?2004hroot@8932fc9aa05e:/app/src# "]
[202.877326, "i", "sed -n '1,60p' /app/src/program.cbl 2>/dev/null || true\n"]
[202.877656, "o", "sed -n '1,60p' /app/src/program.cbl 2>/dev/null || true\r\n\u001b[?2004l\r"]
[202.879352, "o", "       IDENTIFICATION DIVISION.\r\n       PROGRAM-ID. PROGRAM.\r\n\r\n       ENVIRONMENT DIVISION.\r\n       INPUT-OUTPUT SECTION.\r\n       FILE-CONTROL.\r\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\r\n               ORGANIZATION IS LINE SEQUENTIAL.\r\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n               ORGANIZATION IS LINE SEQUENTIAL.\r\n\r\n       DATA DIVISION.\r\n       FILE SECTION.\r\n       FD  IN-FILE.\r\n       01  IN-REC                      PIC X(256).\r\n\r\n       FD  OUT-FILE.\r\n       01  OUT-REC                     PIC X(256).\r\n\r\n       WORKING-STORAGE SECTION.\r\n       01  WS-EOF                      PIC X VALUE 'N'.\r\n\r\n       01  WS-FIELDS.\r\n"]
[202.879391, "o", "           05  WS-ID                   PIC X(10).\r\n           05  WS-NAME                 PIC X(30).\r\n           05  WS-LOAN-A               PIC X(32).\r\n           05  WS-PROP-A               PIC X(32).\r\n           05  WS-DOWN-A               PIC X(32).\r\n           05  WS-TERM-A               PIC X(32).\r\n           05  WS-RATE-A               PIC X(32).\r\n\r\n       01  WS-NUMS.\r\n           05  WS-LOAN                 PIC 9(12)V99 COMP-3.\r\n           05  WS-PROP                 PIC 9(12)V99 COMP-3.\r\n           05  WS-DOWN                 PIC 9(12)V99 COMP-3.\r\n           05  WS-TERM                 PIC 9(4) COMP-3.\r\n           05  WS-RATE                 PIC 9(5)V99 COMP-3.\r\n\r\n       01  WS-CALC.\r\n           05  WS-MIN-DOWN             PIC 9(12)V99 COMP-3.\r\n           05  WS-BAL                  PIC 9(12)V99 COMP-3.\r\n"]
[202.879603, "o", "           05  WS-MR                   COMP-2.\r\n           05  WS-ONE-PLUS-MR          COMP-2.\r\n           05  WS-POW                  COMP-2.\r\n           05  WS-DENOM                COMP-2.\r\n           05  WS-PAY-DBL              COMP-2.\r\n           05  WS-PAY                  PIC 9(12)V99 COMP-3.\r\n           05  WS-INT                  PIC 9(12)V99 COMP-3.\r\n           05  WS-PRIN                 PIC 9(12)V99 COMP-3.\r\n           05  WS-NEWBAL               PIC 9(12)V99 COMP-3.\r\n\r\n       01  WS-OUT-FMTS.\r\n           05  F-MON                   PIC 9(3).\r\n           05  F-PAY                   PIC 9(8).99.\r\n           05  F-INT                   PIC 9(8).99.\r\n           05  F-PRIN                  PIC 9(8).99.\r\n           05  F-REM                   PIC 9(10).99.\r\n\r\n       01  WS-STATUS                   PIC X(5).\r\n       01  WS-REASON                   PIC X(50).\r\n"]
[202.879775, "o", "\u001b[?2004hroot@8932fc9aa05e:/app/src# "]
