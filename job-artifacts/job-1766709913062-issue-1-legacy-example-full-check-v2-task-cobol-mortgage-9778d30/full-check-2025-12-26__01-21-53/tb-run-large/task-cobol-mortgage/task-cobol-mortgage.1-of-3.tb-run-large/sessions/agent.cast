[205.977522, "i", "python3 - <<'PY'\n# quick check: no line > 80 chars\np = '/app/src/program.cbl'\nmx = 0\nbad = []\nwith open(p,'r',encoding='utf-8') as f:\n    for i,l in enumerate(f,1):\n        n = len(l.rstrip('\\n'))\n        mx = max(mx,n)\n        if n > 80:\n            bad.append((i,n,l.rstrip('\\n')))\nprint('max_len', mx)\nfor i,n,l in bad[:10]:\n    print(i,n,l)\nPY\n"]
