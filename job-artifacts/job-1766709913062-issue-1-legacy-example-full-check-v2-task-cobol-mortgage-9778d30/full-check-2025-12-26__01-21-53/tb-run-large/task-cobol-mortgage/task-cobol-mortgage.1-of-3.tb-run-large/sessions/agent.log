[?2004l[?2004h>                END-STRING
[?2004l[?2004h>                WRITE OUT-REC
[?2004l[?2004h> 
[?2004l[?2004h>                PERFORM BUILD-SCHEDULE
[?2004l[?2004h>            END-IF.
[?2004l[?2004h> 
[?2004l[?2004h>        CONVERT-INPUT.
[?2004l[?2004h>            COMPUTE WS-LOAN = FUNCTION NUMVAL(WS-LOAN-A)
[?2004l[?2004h>            COMPUTE WS-PROP = FUNCTION NUMVAL(WS-PROP-A)
[?2004l[?2004h>            COMPUTE WS-DOWN = FUNCTION NUMVAL(WS-DOWN-A)
[?2004l[?2004h>            COMPUTE WS-TERM-YRS = FUNCTION NUMVAL(WS-TERM-A)
[?2004l[?2004h>            COMPUTE WS-TERM-MOS = WS-TERM-YRS * 12
[?2004l[?2004h>            COMPUTE WS-RATE-PCT = FUNCTION NUMVAL(WS-RATE-A) / 100.
[?2004l[?2004h> 
[?2004l[?2004h>        BUILD-SCHEDULE.
[?2004l[?2004h>            IF WS-TERM-MOS <= 0
[?2004l[?2004h>                EXIT PARAGRAPH
[?2004l[?2004h>            END-IF
[?2004l[?2004h> 
[?2004l[?2004h>            MOVE WS-LOAN TO WS-BAL
[?2004l[?2004h> 
[?2004l[?2004h>            COMPUTE WS-MR = (WS-RATE-PCT / 1.0) / 1200.0
[?2004l[?2004h>            COMPUTE WS-ONE-PLUS = 1.0 + WS-MR
[?2004l[?2004h> 
[?2004l[?2004h>            IF WS-MR = 0.0
[?2004l[?2004h>                COMPUTE WS-PAY ROUNDED = WS-LOAN / WS-TERM-MOS
[?2004l[?2004h>            ELSE
[?2004l[?2004h>                COMPUTE WS-POW = FUNCTION POWER(WS-ONE-PLUS, WS-TERM-MOS)
[?2004l[?2004h>                COMPUTE WS-DEN = 1.0 - (1.0 / WS-POW)
[?2004l[?2004h>                COMPUTE WS-PAY-DBL = (WS-LOAN / 1.0) * WS-MR / WS-DEN
[?2004l[?2004h>                COMPUTE WS-PAY ROUNDED = WS-PAY-DBL
[?2004l[?2004h>            END-IF
[?2004l[?2004h> 
[?2004l[?2004h>            PERFORM VARYING L-MON FROM 1 BY 1
[?2004l[?2004h>                UNTIL L-MON > WS-TERM-MOS
[?2004l[?2004h> 
[?2004l[?2004h>                COMPUTE WS-INT ROUNDED = WS-BAL * WS-MR
[?2004l[?2004h>                COMPUTE WS-PRIN ROUNDED = WS-PAY - WS-INT
[?2004l[?2004h> 
[?2004l[?2004h>                IF L-MON = WS-TERM-MOS
[?2004l[?2004h>                    MOVE WS-BAL TO WS-PRIN
[?2004l[?2004h>                    COMPUTE WS-PAY ROUNDED = WS-INT + WS-PRIN
[?2004l[?2004h>                END-IF
[?2004l[?2004h> 
[?2004l[?2004h>                COMPUTE WS-NEWBAL ROUNDED = WS-BAL - WS-PRIN
[?2004l[?2004h>                IF WS-NEWBAL < 0
[?2004l[?2004h>                    MOVE 0 TO WS-NEWBAL
[?2004l[?2004h>                END-IF
[?2004l[?2004h> 
[?2004l[?2004h>                MOVE WS-PAY TO L-PAY
[?2004l[?2004h>                MOVE WS-INT TO L-INT
[?2004l[?2004h>                MOVE WS-PRIN TO L-PRIN
[?2004l[?2004h>                MOVE WS-NEWBAL TO L-REM
[?2004l[?2004h> 
[?2004l[?2004h>                MOVE SPACES TO OUT-REC
[?2004l[?2004h>                STRING L-MON DELIMITED BY SIZE
[?2004l[?2004h>                       ' ' DELIMITED BY SIZE
[?2004l[?2004h>                       L-PAY DELIMITED BY SIZE
[?2004l[?2004h>                       ' ' DELIMITED BY SIZE
[?2004l[?2004h>                       L-INT DELIMITED BY SIZE
[?2004l[?2004h>                       ' ' DELIMITED BY SIZE
