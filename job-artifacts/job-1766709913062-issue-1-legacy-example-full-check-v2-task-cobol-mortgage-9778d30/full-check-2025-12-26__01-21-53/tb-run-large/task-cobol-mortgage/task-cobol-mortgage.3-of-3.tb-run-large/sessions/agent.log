[?2004l[?2004h>        PARSE-INPUT.
[?2004l[?2004h>            MOVE SPACES TO WS-FIELDS
[?2004l[?2004h>            UNSTRING IN-REC DELIMITED BY ';'
[?2004l[?2004h>                INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X
[?2004l[?2004h>                     WS-TERM-X WS-RATE-X
[?2004l[?2004h>            END-UNSTRING
[?2004l[?2004h> 
[?2004l[?2004h>            COMPUTE LOAN-AMT ROUNDED = FUNCTION NUMVAL(WS-LOAN-X)
[?2004l[?2004h>            COMPUTE PROP-VALUE ROUNDED = FUNCTION NUMVAL(WS-PROP-X)
[?2004l[?2004h>            COMPUTE DOWN-PAY ROUNDED = FUNCTION NUMVAL(WS-DOWN-X)
[?2004l[?2004h>            COMPUTE TERM-MONTHS = FUNCTION NUMVAL(WS-TERM-X)
[?2004l[?2004h>            COMPUTE RATE-ANN ROUNDED = FUNCTION NUMVAL(WS-RATE-X).
[?2004l[?2004h> 
[?2004l[?2004h>        CHECK-APPLICATION.
[?2004l[?2004h>            COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15
[?2004l[?2004h> 
[?2004l[?2004h>            IF DOWN-PAY < MIN-DOWN
[?2004l[?2004h>                MOVE "INSUFFICIENT FUNDS FOR DOWN PAYMENT" TO WS-REASON
[?2004l[?2004h>                PERFORM WRITE-DENY
[?2004l[?2004h>            ELSE
[?2004l[?2004h>                PERFORM WRITE-APPRO
[?2004l[?2004h>                PERFORM BUILD-SCHEDULE
[?2004l[?2004h>            END-IF.
[?2004l[?2004h> 
[?2004l[?2004h>        WRITE-DENY.
[?2004l[?2004h>            MOVE SPACES TO OUT-REC
[?2004l[?2004h>            STRING WS-ID DELIMITED BY SIZE
[?2004l[?2004h>                   "DENY " DELIMITED BY SIZE
[?2004l[?2004h>                   WS-REASON DELIMITED BY SIZE
[?2004l[?2004h>                   INTO OUT-REC
[?2004l[?2004h>            END-STRING
[?2004l[?2004h>            WRITE OUT-REC.
[?2004l[?2004h> 
[?2004l[?2004h>        WRITE-APPRO.
[?2004l[?2004h>            MOVE SPACES TO OUT-REC
[?2004l[?2004h>            STRING WS-ID DELIMITED BY SIZE
[?2004l[?2004h>                   "APPRO" DELIMITED BY SIZE
[?2004l[?2004h>                   INTO OUT-REC
[?2004l[?2004h>            END-STRING
[?2004l[?2004h>            WRITE OUT-REC.
[?2004l[?2004h> 
[?2004l[?2004h>        BUILD-SCHEDULE.
[?2004l[?2004h>            IF TERM-MONTHS <= 0
[?2004l[?2004h>                EXIT PARAGRAPH
[?2004l[?2004h>            END-IF
[?2004l[?2004h> 
[?2004l[?2004h>            COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200
[?2004l[?2004h>            MOVE LOAN-AMT TO BALANCE
[?2004l[?2004h> 
[?2004l[?2004h>            IF MONTHLY-RATE = 0
[?2004l[?2004h>                COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS
[?2004l[?2004h>            ELSE
[?2004l[?2004h>                COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE
[?2004l[?2004h>                COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)
[?2004l[?2004h>                COMPUTE DENOM ROUNDED = 1 - POWVAL
[?2004l[?2004h>                COMPUTE MONTHLY-PAY ROUNDED =
[?2004l[?2004h>                    (LOAN-AMT * MONTHLY-RATE) / DENOM
[?2004l[?2004h>            END-IF
[?2004l[?2004h> 
[?2004l[?2004h>            PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS
[?2004l[?2004h>                COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE
[?2004l[?2004h>                COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART
[?2004l[?2004h> 
[?2004l[?2004h>                IF I = TERM-MONTHS
[?2004l[?2004h>                    MOVE BALANCE TO PRINC-PART
[?2004l[?2004h>                    COMPUTE MONTHLY-PAY ROUNDED =
[?2004l[?2004h>                        INTEREST-PART + PRINC-PART
[?2004l[?2004h>                END-IF
[?2004l[?2004h> 
[?2004l[?2004h>                COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART
[?2004l[?2004h> 
[?2004l[?2004h>                MOVE I TO ED-MONTH
[?2004l[?2004h>                MOVE MONTHLY-PAY TO ED-PAY
[?2004l[?2004h>                MOVE INTEREST-PART TO ED-INT
[?2004l[?2004h>                MOVE PRINC-PART TO ED-PRN
[?2004l[?2004h>                MOVE REMAIN TO ED-REM
[?2004l[?2004h> 
[?2004l[?2004h>                MOVE SPACES TO OUT-REC
[?2004l[?2004h>                STRING ED-MONTH DELIMITED BY SIZE
[?2004l[?2004h>                       " " DELIMITED BY SIZE
[?2004l[?2004h>                       ED-PAY DELIMITED BY SIZE
[?2004l[?2004h>                       " " DELIMITED BY SIZE
[?2004l[?2004h>                       ED-INT DELIMITED BY SIZE
[?2004l[?2004h>                       " " DELIMITED BY SIZE
[?2004l[?2004h>                       ED-PRN DELIMITED BY SIZE
[?2004l[?2004h>                       " " DELIMITED BY SIZE
[?2004l[?2004h>                       ED-REM DELIMITED BY SIZE
[?2004l[?2004h>                       INTO OUT-REC
[?2004l[?2004h>                END-STRING
[?2004l[?2004h>                WRITE OUT-REC
[?2004l[?2004h> 
[?2004l[?2004h>                MOVE REMAIN TO BALANCE
[?2004l[?2004h>            END-PERFORM.
