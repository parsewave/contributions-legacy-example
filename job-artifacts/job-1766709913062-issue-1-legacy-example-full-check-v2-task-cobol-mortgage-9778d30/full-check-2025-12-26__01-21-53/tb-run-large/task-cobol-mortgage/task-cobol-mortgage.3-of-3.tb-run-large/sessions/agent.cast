[189.299661, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INFILE.\n       01  IN-REC                   PIC X(256).\n\n       FD  OUTFILE.\n       01  OUT-REC                  PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                   PIC X VALUE 'N'.\n\n       01  WS-FIELDS.\n           05  WS-ID                PIC X(10).\n           05  WS-NAME              PIC X(30).\n           05  WS-LOAN-X            PIC X(20).\n           05  WS-PROP-X            PIC X(20).\n           05  WS-DOWN-X            PIC X(20).\n           05  WS-TERM-X            PIC X(10).\n           05  WS-RATE-X            PIC X(20).\n\n       01  WS-NUMS.\n          "]
[189.299713, "i", " 05  LOAN-AMT             PIC 9(10)V99 VALUE 0.\n           05  PROP-VALUE           PIC 9(10)V99 VALUE 0.\n           05  DOWN-PAY             PIC 9(10)V99 VALUE 0.\n           05  TERM-YEARS           PIC 9(2)     VALUE 0.\n           05  TERM-MONTHS          PIC 9(4)     VALUE 0.\n           05  RATE-ANN             PIC 9(3)V9(2) VALUE 0.\n\n       01  WS-CALC.\n           05  MIN-DOWN             PIC 9(10)V99 VALUE 0.\n           05  MONTHLY-RATE         PIC 9V9(8)   VALUE 0.\n           05  BASE                 PIC 9V9(8)   VALUE 0.\n           05  POWVAL               PIC 9V9(12)  VALUE 0.\n           05  DENOM                PIC S9V9(12) VALUE 0.\n           05  MONTHLY-PAY          PIC 9(10)V99 VALUE 0.\n           05  BALANCE              PIC 9(10)V99 VALUE 0.\n           05  INTEREST-PART        PIC 9(10)V99 VALUE 0.\n           05  PRINC-PART           PIC 9(10)V99 VALUE 0.\n           05  REMAIN               PIC 9(10)V99 VALUE 0.\n\n       01  WS-OUT-EDIT.\n           05  ED-MONTH             PIC 0(3).\n           05"]
[189.299885, "i", "  ED-PAY               PIC 0(8).00.\n           05  ED-INT               PIC 0(8).00.\n           05  ED-PRN               PIC 0(8).00.\n           05  ED-REM               PIC 0(10).00.\n\n       01  WS-REASON                PIC X(50).\n       01  I                        PIC 9(4) VALUE 0.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n\n           PERFORM UNTIL WS-EOF = 'Y'\n               READ INFILE\n                   AT END\n                       MOVE 'Y' TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-ONE\n               END-READ\n           END-PERFORM\n\n           CLOSE INFILE\n           CLOSE OUTFILE\n           STOP RUN.\n\n       PROCESS-ONE.\n           PERFORM PARSE-INPUT\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY ';'\n               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\n                    WS-TERM-X WS-RATE-X\n           END-UN"]
[189.299906, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[189.299964, "i", "STRING\n\n           COMPUTE LOAN-AMT ROUNDED =\n               FUNCTION NUMVAL(WS-LOAN-X) / 100\n           COMPUTE PROP-VALUE ROUNDED =\n               FUNCTION NUMVAL(WS-PROP-X) / 100\n           COMPUTE DOWN-PAY ROUNDED =\n               FUNCTION NUMVAL(WS-DOWN-X) / 100\n           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\n           COMPUTE TERM-MONTHS = TERM-YEARS * 12\n           COMPUTE RATE-ANN ROUNDED =\n               FUNCTION NUMVAL(WS-RATE-X) / 100.\n\n       CHECK-APPLICATION.\n           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\n\n           IF DOWN-PAY < MIN-DOWN\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"DENY \" DELIMITED BY SIZE\n                  WS-REASON DELIMITED BY SIZE\n                  INTO OUT-REC\n           EN"]
[189.300039, "o", "\u001b[?2004h> "]
[189.300097, "i", "D-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"APPRO\" DELIMITED BY SIZE\n                  INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHEDULE.\n           IF TERM-MONTHS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\n           MOVE LOAN-AMT TO BALANCE\n\n           IF MONTHLY-RATE = 0\n               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\n           ELSE\n               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\n               COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)\n               COMPUTE DENOM ROUNDED = 1 - POWVAL\n               COMPUTE MONTHLY-PAY ROUNDED =\n                   (LOAN-AMT * MONTHLY-RATE) / DENOM\n           END-IF\n\n           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\n               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\n               COMPUTE PR"]
[189.300118, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.300166, "i", "INC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\n\n               IF I = TERM-MONTHS\n                   MOVE BALANCE TO PRINC-PART\n                   COMPUTE MONTHLY-PAY ROUNDED =\n                       INTEREST-PART + PRINC-PART\n               END-IF\n\n               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\n\n               MOVE I TO ED-MONTH\n               MOVE MONTHLY-PAY TO ED-PAY\n               MOVE INTEREST-PART TO ED-INT\n               MOVE PRINC-PART TO ED-PRN\n               MOVE REMAIN TO ED-REM\n\n               MOVE SPACES TO OUT-REC\n               STRING ED-MONTH DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-PAY DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-INT DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-PRN DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-REM DELIMITED BY SIZE\n                      INTO OUT-REC\n               END-STRING\n "]
[189.300187, "i", "              WRITE OUT-REC\n\n               MOVE REMAIN TO BALANCE\n           END-PERFORM.\nEOF\n"]
[189.300285, "o", "       PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r "]
[189.300303, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.300353, "o", "\u001b[?2004h> "]
[189.300464, "o", "       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r"]
[189.300513, "o", "\u001b[?2004h> "]
[189.300787, "o", "       INPUT-OUTPUT SECTION."]
[189.300841, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.300997, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\r"]
[189.301086, "o", "\u001b[?2004h> "]
[189.301304, "o", "           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\r\n\u001b[?2004l\r"]
[189.301371, "o", "\u001b[?2004h> "]
[189.301505, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\rD-\u001b[?2004h"]
[189.301524, "o", "> "]
[189.30184, "o", "           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n\u001b[?2004l\r"]
[189.301865, "o", "\u001b[?2004h> "]
[189.302105, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r"]
[189.302123, "o", "\u001b[?2004h> "]
[189.302205, "o", "\r\n\u001b[?2004l\rU"]
[189.302227, "o", "\u001b[?2004h> "]
[189.30228, "o", "       DATA DIVISION.\r\n\u001b[?2004l\r"]
[189.302305, "o", "\u001b[?2004h> "]
[189.302491, "o", "       FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.302619, "o", "       FD  INFILE.\r\n\u001b[?2004l\r"]
[189.302695, "o", "\u001b[?2004h> "]
[189.302943, "o", "       01  IN-REC                   PIC X(256).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.302977, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.303165, "o", "       FD  OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.303448, "o", "       01  OUT-REC                  PIC X(256).\r\n\u001b[?2004l\r"]
[189.303481, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[189.303501, "o", "> "]
[189.303618, "o", "       WORKING-STORAGE SECTION.\r\n\u001b[?2004l\rOM\u001b[?2004h> "]
[189.303917, "o", "       01  WS-EOF                   PIC X VALUE 'N'.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.304004, "o", "\u001b[?2004h> "]
[189.304092, "o", "       01  WS-FIELDS.\r\n\u001b[?2004l\rED =\u001b[?2004h"]
[189.304154, "o", "> "]
[189.304294, "o", "           05  WS-ID                PIC X(10).\r\n\u001b[?2004l\r \u001b[?2004h> "]
[189.304502, "o", "           05  WS-NAME              PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.304661, "o", "           05  WS-LOAN-X            PIC X(20).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.30483, "o", "           05  WS-PROP-X            PIC X(20).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.305041, "o", "           05  WS-DOWN-X            PIC X(20).\r\n\u001b[?2004l\r"]
[189.305067, "o", "\u001b[?2004h> "]
[189.305263, "o", "           05  WS-TERM-X            PIC X(10).\r\n\u001b[?2004l\r"]
[189.305326, "o", "\u001b[?2004h> "]
[189.305428, "o", "           05  WS-RATE-X            PIC X(20).\r\n\u001b[?2004l\rNTHL\u001b[?2004h"]
[189.305486, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.305537, "o", "       01  WS-NUMS.\r\n\u001b[?2004l\r"]
[189.305585, "o", "\u001b[?2004h> "]
[189.305782, "o", "           05  LOAN-AMT             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.305837, "o", "> "]
[189.306088, "o", "           05  PROP-VALUE           PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.306253, "o", "           05  DOWN-PAY             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.306278, "o", "> "]
[189.30644, "o", "           05  TERM-YEARS           PIC 9(2)     VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.306624, "o", "           05  TERM-MONTHS          PIC 9(4)     VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.306834, "o", "           05  RATE-ANN             PIC 9(3)V9(2) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.306886, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.306976, "o", "       01  WS-CALC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.307204, "o", "           05  MIN-DOWN             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[189.307227, "o", "\u001b[?2004h> "]
[189.307435, "o", "           05  MONTHLY-RATE         PIC 9V9(8)   VALUE 0.\r\n\u001b[?2004l\r\r\n  \u001b[?2004h> "]
[189.307674, "o", "           05  BASE                 PIC 9V9(8)   VALUE 0.\r\n\u001b[?2004l\rSP\u001b[?2004h> "]
[189.30786, "o", "           05  POWVAL               PIC 9V9(12)  VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.308069, "o", "           05  DENOM                PIC S9V9(12) VALUE 0.\r\n\u001b[?2004l\r"]
[189.308138, "o", "\u001b[?2004h> "]
[189.308268, "o", "           05  MONTHLY-PAY          PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[189.308291, "o", "\u001b[?2004h> "]
[189.308495, "o", "           05  BALANCE              PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.308698, "o", "           05  INTEREST-PART        PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.308999, "o", "           05  PRINC-PART           PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[189.309019, "o", "\u001b[?2004h> "]
[189.309245, "o", "           05  REMAIN               PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[189.309264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r-"]
[189.309302, "o", "\u001b[?2004h"]
[189.30934, "o", "> "]
[189.309402, "o", "       01  WS-OUT-EDIT.\r\n\u001b[?2004l\r"]
[189.309422, "o", "\u001b[?2004h> "]
[189.309595, "o", "           05  ED-MONTH             PIC 0(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.309834, "o", "           05  ED-PAY               PIC 0(8).00.\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.309855, "o", "> "]
[189.310018, "o", "           05  ED-INT               PIC 0(8).00.\r\n\u001b[?2004l\r"]
[189.310037, "o", "\u001b[?2004h> "]
[189.310217, "o", "           05  ED-PRN               PIC 0(8).00.\r\n\u001b[?2004l\r"]
[189.310237, "o", "\u001b[?2004h> "]
[189.31039, "o", "           05  ED-REM               PIC 0(10).00.\r\n\u001b[?2004l\r"]
[189.310413, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.310512, "o", "       01  WS-REASON                PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.310625, "o", "       01  I                        PIC 9(4) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.310645, "o", "> \r\n\u001b[?2004l\r"]
[189.310728, "o", "\u001b[?2004h>        PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.310802, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.310863, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.310962, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31109, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.311106, "o", "> "]
[189.311172, "o", "               READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.311249, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.311353, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.311436, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31157, "o", "                       PERFORM PROCESS-ONE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.311642, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.311722, "o", ">            END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.311808, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>            CLOSE INFILE\r\n\u001b[?2004l\r"]
[189.311881, "o", "\u001b[?2004h>            CLOSE OUTFILE\r\n\u001b[?2004l\r"]
[189.311897, "o", "\u001b[?2004h> "]
[189.311956, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.311978, "o", "\u001b[?2004h>        PROCESS-ONE.\r\n\u001b[?2004l\r"]
[189.312039, "o", "\u001b[?2004h> "]
[189.312127, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r"]
[189.312142, "o", "\u001b[?2004h> "]
[189.312235, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.312324, "o", "\u001b[?2004h>        PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.312372, "o", "> "]
[189.312423, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.312495, "o", "> "]
[189.312543, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.312664, "o", "               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.312777, "o", "                    WS-TERM-X WS-RATE-X\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.312831, "o", "           END-UNSTRING\r\n\u001b[?2004l\r"]
[189.312843, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.312898, "o", "\u001b[?2004h> "]
[189.312962, "o", "           COMPUTE LOAN-AMT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313108, "o", "               FUNCTION NUMVAL(WS-LOAN-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313218, "o", "           COMPUTE PROP-VALUE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313332, "o", "               FUNCTION NUMVAL(WS-PROP-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313461, "o", "           COMPUTE DOWN-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313562, "o", "               FUNCTION NUMVAL(WS-DOWN-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313696, "o", "           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31383, "o", "           COMPUTE TERM-MONTHS = TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.313929, "o", "           COMPUTE RATE-ANN ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314076, "o", "               FUNCTION NUMVAL(WS-RATE-X) / 100.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.314145, "o", "\u001b[?2004h> "]
[189.31421, "o", "       CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314312, "o", "           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.31438, "o", "\u001b[?2004h> "]
[189.314439, "o", "           IF DOWN-PAY < MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314579, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314667, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314754, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314819, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.314904, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31494, "o", "           END-IF."]
[189.315012, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.315065, "o", "\u001b[?2004h> "]
[189.315117, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315177, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315287, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315383, "o", "                  \"DENY \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315521, "o", "                  WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315593, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315651, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315714, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.3158, "o", "       WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.315882, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316004, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316139, "o", "                  \"APPRO\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316227, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316303, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316356, "o", "           WRITE OUT-REC."]
[189.316424, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316468, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31654, "o", "           IF TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316619, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316689, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316843, "o", "           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.316952, "o", "           MOVE LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.317029, "o", "\u001b[?2004h> "]
[189.317093, "o", "           IF MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.317146, "o", "> "]
[189.317256, "o", "               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.317306, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.317425, "o", "               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.317594, "o", "               COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.31771, "o", "               COMPUTE DENOM ROUNDED = 1 - POWVAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.317834, "o", "               COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.317961, "o", "                   (LOAN-AMT * MONTHLY-RATE) / DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318035, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318209, "o", "           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318369, "o", "               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318516, "o", "               COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.318571, "o", "\u001b[?2004h> "]
[189.318651, "o", "               IF I = TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318767, "o", "                   MOVE BALANCE TO PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.318879, "o", "                   COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319005, "o", "                       INTEREST-PART + PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319084, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319124, "o", "\r\n\u001b[?2004l\r"]
[189.319178, "o", "\u001b[?2004h> "]
[189.31926, "o", "               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.319311, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.3194, "o", "               MOVE I TO ED-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319475, "o", "               MOVE MONTHLY-PAY TO ED-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319578, "o", "               MOVE INTEREST-PART TO ED-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319679, "o", "               MOVE PRINC-PART TO ED-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.319791, "o", "               MOVE REMAIN TO ED-REM\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.319858, "o", "\u001b[?2004h> "]
[189.319922, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320089, "o", "               STRING ED-MONTH DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320188, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320306, "o", "                      ED-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320412, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320526, "o", "                      ED-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320631, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320757, "o", "                      ED-PRN DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.320869, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.321009, "o", "                      ED-REM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.321131, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.32121, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.321239, "o", "> "]
[189.321305, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.32142, "o", "               MOVE REMAIN TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.321486, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[189.323097, "o", "\u001b[?2004hroot@f2dfd4d3de5d:/app/src# "]
[189.393165, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/src/program.cbl')\nmx=0\nbad=[]\nfor i,line in enumerate(p.read_text().splitlines(),1):\n    l=len(line)\n    mx=max(mx,l)\n    if l>80:\n        bad.append((i,l,line))\nprint('max_len',mx)\nprint('over_80',len(bad))\nfor i,l,_ in bad[:10]:\n    print('line',i,'len',l)\nPY\n"]
