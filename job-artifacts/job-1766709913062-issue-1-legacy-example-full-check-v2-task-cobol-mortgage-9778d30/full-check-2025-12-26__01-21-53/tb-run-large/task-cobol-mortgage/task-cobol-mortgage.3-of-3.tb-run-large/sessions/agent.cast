[74.718961, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719094, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719162, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719253, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719373, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719433, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719524, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719626, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719806, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.719844, "o", "                  \"DENY \" DELIMITED BY SIZE\r\n"]
[74.719933, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.720024, "o", "                  WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720107, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720185, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720273, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.720299, "o", "\u001b[?2004h> "]
[74.720369, "o", "       WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720464, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720579, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720715, "o", "                  \"APPRO\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720827, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720905, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.720981, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.721068, "o", "\u001b[?2004h> "]
[74.721094, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.721221, "o", "           IF TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.721316, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.721339, "o", "> "]
[74.721406, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.721586, "o", "           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.721612, "o", "> "]
[74.721716, "o", "           MOVE LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.721803, "o", "\u001b[?2004h> "]
[74.721822, "o", "           IF MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722064, "o", "               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722146, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.7223, "o", "               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722481, "o", "               COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722641, "o", "               COMPUTE DENOM ROUNDED = 1 - POWVAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722803, "o", "               COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.722955, "o", "                   (LOAN-AMT * MONTHLY-RATE) / DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.723038, "o", "           END-IF\r\n\u001b[?2004l\r"]
[74.723083, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.723258, "o", "           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.723473, "o", "               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.723676, "o", "               COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.723709, "o", "\u001b[?2004h> "]
[74.72383, "o", "               IF I = TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.723982, "o", "                   MOVE BALANCE TO PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.724168, "o", "                   COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.724314, "o", "                       INTEREST-PART + PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.724392, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.724572, "o", "               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.724634, "o", "\u001b[?2004h> "]
[74.724728, "o", "               MOVE I TO ED-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.724868, "o", "               MOVE MONTHLY-PAY TO ED-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725007, "o", "               MOVE INTEREST-PART TO ED-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725159, "o", "               MOVE PRINC-PART TO ED-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725276, "o", "               MOVE REMAIN TO ED-REM\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.725301, "o", "\u001b[?2004h> "]
[74.725427, "o", "               MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725588, "o", "               STRING ED-MONTH DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725778, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.725895, "o", "                      ED-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726046, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726162, "o", "                      ED-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726301, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.72643, "o", "                      ED-PRN DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726567, "o", "                      \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726722, "o", "                      ED-REM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.72675, "o", "> "]
[74.726849, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.726942, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.727067, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.727144, "o", "\u001b[?2004h> "]
[74.727211, "o", "               MOVE REMAIN TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.727263, "o", "> "]
[74.727323, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
