[582.03579, "o", "nl -ba program.cbl | sed -n '136,150p'\r\n\u001b[?2004l\r"]
[582.03708, "o", "   136\t           MOVE LOAN-AMT TO BALANCE\r\n   137\t\r\n   138\t           IF MONTHLY-RATE = 0\r\n   139\t               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\r\n   140\t           ELSE\r\n   141\t               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\r\n   142\t               COMPUTE POWVAL ROUNDED =\r\n   143\t                   FUNCTION POWER(BASE, -TERM-MONTHS)\r\n   144\t               COMPUTE DENOM ROUNDED = 1 - POWVAL\r\n   145\t               COMPUTE MONTHLY-PAY ROUNDED =\r\n   146\t                   (LOAN-AMT * MONTHLY-RATE) / DENOM\r\n   147\t           END-IF\r\n   148\t\r\n   149\t           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\r\n   150\t               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\r\n"]
[582.037353, "o", "\u001b[?2004hroot@f2dfd4d3de5d:/app/src# "]
[582.138062, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('program.cbl')\ntext = p.read_text().splitlines()\nout = []\ni = 0\nwhile i < len(text):\n    line = text[i]\n    if line.strip() == 'COMPUTE POWVAL ROUNDED =':\n        # Replace this + next line with a single exponentiation line\n        out.append('               COMPUTE POWVAL ROUNDED = BASE ** (-TERM-MONTHS)')\n        i += 2\n        continue\n    out.append(line)\n    i += 1\np.write_text(\"\\n\".join(out) + \"\\n\")\nprint('patched')\nPY\n"]
[582.138318, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
