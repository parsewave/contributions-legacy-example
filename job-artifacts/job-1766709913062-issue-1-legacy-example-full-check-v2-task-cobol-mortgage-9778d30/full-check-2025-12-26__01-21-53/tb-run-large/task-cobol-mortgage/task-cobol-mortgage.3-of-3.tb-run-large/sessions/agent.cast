[74.714647, "o", "\u001b[?2004h> "]
[74.714782, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.714863, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.714939, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.71504, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715114, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715205, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715283, "o", "               READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715378, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715511, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715607, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715757, "o", "                       PERFORM PROCESS-ONE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715851, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.715903, "o", "           END-PERFORM\r\n\u001b[?2004l\r"]
[74.715957, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.716063, "o", "\u001b[?2004h> "]
[74.716126, "o", "           CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h>            CLOSE OUTFILE\r\n\u001b[?2004l\r"]
[74.716169, "o", "\u001b[?2004h> "]
[74.716229, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.716297, "o", "       PROCESS-ONE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.71642, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.716516, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.716566, "o", "\u001b[?2004h> "]
[74.716614, "o", "       PARSE-INPUT.\r\n\u001b[?2004l\r"]
[74.716684, "o", "\u001b[?2004h> "]
[74.716795, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.716888, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.717076, "o", "               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.717101, "o", "> "]
[74.717236, "o", "                    WS-TERM-X WS-RATE-X\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.717332, "o", "           END-UNSTRING"]
[74.717427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.717571, "o", "           COMPUTE LOAN-AMT ROUNDED = FUNCTION NUMVAL(WS-LOAN-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.717719, "o", "           COMPUTE PROP-VALUE ROUNDED = FUNCTION NUMVAL(WS-PROP-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.71791, "o", "           COMPUTE DOWN-PAY ROUNDED = FUNCTION NUMVAL(WS-DOWN-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.718119, "o", "           COMPUTE TERM-MONTHS = FUNCTION NUMVAL(WS-TERM-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
