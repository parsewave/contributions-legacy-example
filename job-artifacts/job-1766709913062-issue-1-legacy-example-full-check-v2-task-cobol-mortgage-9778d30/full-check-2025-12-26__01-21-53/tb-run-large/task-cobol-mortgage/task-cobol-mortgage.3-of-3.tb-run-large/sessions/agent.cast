[548.316899, "o", "\"       PROCEDURE DIVISION.\",\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[548.317026, "o", "\"       MAIN.\",\r\n\u001b[?2004l\r"]
[548.317044, "o", "\u001b[?2004h> "]
[548.317199, "o", "\"           OPEN INPUT INFILE\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.317288, "o", "> "]
[548.317361, "o", "\"           OPEN OUTPUT OUTFILE\",\r\n\u001b[?2004l\r \u001b[?2004h> "]
[548.317382, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.317436, "o", "\u001b[?2004h> "]
[548.317555, "o", "\"           PERFORM UNTIL WS-EOF = 'Y'\",\r\n\u001b[?2004l\r"]
[548.317572, "o", "\u001b[?2004h> "]
[548.317689, "o", "\"               READ INFILE\",\r\n\u001b[?2004l\rE\u001b[?2004h"]
[548.317708, "o", "> "]
[548.317801, "o", "\"                   AT END\",\r\n\u001b[?2004l\r"]
[548.317818, "o", "\u001b[?2004h> "]
[548.317967, "o", "\"                       MOVE 'Y' TO WS-EOF\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.318133, "o", "\"                   NOT AT END\",\r\n\u001b[?2004l\r"]
[548.31815, "o", "\u001b[?2004h> "]
[548.318309, "o", "\"                       PERFORM PROCESS-ONE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.318412, "o", "\"               END-READ\",\r\n\u001b[?2004l\r"]
[548.318429, "o", "\u001b[?2004h> "]
[548.318527, "o", "\"           END-PERFORM\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.318545, "o", "\"\","]
[548.318595, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.318707, "o", "\"           CLOSE INFILE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.318821, "o", "\"           CLOSE OUTFILE\",\r\n\u001b[?2004l\rE'\u001b[?2004h"]
[548.318837, "o", "> "]
[548.319046, "o", "\"           STOP RUN.\",\r\n\u001b[?2004l\r\u001b[?2004h> \"\",\r\n\u001b[?2004l\r"]
[548.319143, "o", "\u001b[?2004h> "]
[548.31917, "o", "\"       PROCESS-ONE.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.319299, "o", "\"           PERFORM PARSE-INPUT\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.319466, "o", "\"           PERFORM CHECK-APPLICATION.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.319484, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.319551, "o", "> "]
[548.319568, "o", "\"       PARSE-INPUT.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.319711, "o", "\"           MOVE SPACES TO WS-FIELDS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.319856, "o", "\"           UNSTRING IN-REC DELIMITED BY ';'\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320089, "o", "\"               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320227, "o", "\"                    WS-TERM-X WS-RATE-X\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320335, "o", "\"           END-UNSTRING\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320407, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.32043, "o", "\u001b[?2004h> "]
[548.320516, "o", "\"           COMPUTE LOAN-AMT ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320673, "o", "\"               FUNCTION NUMVAL(WS-LOAN-X) / 100\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.320814, "o", "\"           COMPUTE PROP-VALUE ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321007, "o", "\"               FUNCTION NUMVAL(WS-PROP-X) / 100\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321133, "o", "\"           COMPUTE DOWN-PAY ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321288, "o", "\"               FUNCTION NUMVAL(WS-DOWN-X) / 100\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321475, "o", "\"           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321647, "o", "\"           COMPUTE TERM-MONTHS = TERM-YEARS * 12\",\r\n\u001b[?2004l\r"]
[548.321667, "o", "\u001b[?2004h> "]
[548.321792, "o", "\"           COMPUTE RATE-ANN ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321952, "o", "\"               FUNCTION NUMVAL(WS-RATE-X) / 100.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.321967, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.322067, "o", "\u001b[?2004h> "]
[548.322131, "o", "\"       CHECK-APPLICATION.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.322294, "o", "\"           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.322309, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.322384, "o", "\u001b[?2004h> "]
[548.322441, "o", "\"           IF DOWN-PAY < MIN-DOWN\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32266, "o", "\"               MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\" TO WS-REASON\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.322788, "o", "\"               PERFORM WRITE-DENY\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.322874, "o", "\"           ELSE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323004, "o", "\"               PERFORM WRITE-APPRO\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.323094, "o", "> "]
[548.323154, "o", "\"               PERFORM BUILD-SCHEDULE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32325, "o", "\"           END-IF.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323271, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.323328, "o", "> "]
[548.323397, "o", "\"       WRITE-DENY.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323498, "o", "\"           MOVE SPACES TO OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323641, "o", "\"           STRING WS-ID DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323809, "o", "\"                  \\\"DENY \\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.323958, "o", "\"                  WS-REASON DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.324047, "o", "> "]
[548.324136, "o", "\"                  INTO OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.324197, "o", "\"           END-STRING\",\r\n\u001b[?2004l\r"]
[548.32421, "o", "\u001b[?2004h> "]
[548.324318, "o", "\"           WRITE OUT-REC.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.324334, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.324413, "o", "\u001b[?2004h> "]
[548.32443, "o", "\"       WRITE-APPRO.\",\r\n\u001b[?2004l\r"]
[548.324439, "o", "\u001b[?2004h"]
[548.324487, "o", "> "]
[548.324576, "o", "\"           MOVE SPACES TO OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.324735, "o", "\"           STRING WS-ID DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.324885, "o", "\"                  \\\"APPRO\\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r"]
[548.3249, "o", "\u001b[?2004h> "]
[548.325031, "o", "\"                  INTO OUT-REC\",\r\n\u001b[?2004l\r"]
[548.325108, "o", "\u001b[?2004h> "]
[548.325125, "o", "\"           END-STRING\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.325186, "o", "> "]
[548.325244, "o", "\"           WRITE OUT-REC.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.325294, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.325318, "o", "\u001b[?2004h> "]
[548.325377, "o", "\"       BUILD-SCHEDULE.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.325541, "o", "\"           IF TERM-MONTHS <= 0\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.325566, "o", "\"               EXIT PARAGRAPH\","]
[548.325575, "o", "\r\n\u001b[?2004l\r"]
[548.325652, "o", "\u001b[?2004h> "]
[548.32567, "o", "\"           END-IF\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.325734, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32591, "o", "\"           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.326094, "o", "\"           MOVE LOAN-AMT TO BALANCE\",\r\n\u001b[?2004l\r\u001b[?2004h> \"\",\r\n"]
[548.326113, "o", "\u001b[?2004l\r"]
[548.326171, "o", "\u001b[?2004h> "]
[548.326257, "o", "\"           IF MONTHLY-RATE = 0\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32646, "o", "\"               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.326546, "o", "\"           ELSE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.326717, "o", "\"               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.326852, "o", "\"               COMPUTE POWVAL ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.327025, "o", "\"                   FUNCTION POWER(BASE, -TERM-MONTHS)\",\r\n\u001b[?2004l\r"]
[548.327046, "o", "\u001b[?2004h> "]
[548.327206, "o", "\"               COMPUTE DENOM ROUNDED = 1 - POWVAL\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.327223, "o", "> "]
[548.327371, "o", "\"               COMPUTE MONTHLY-PAY ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.327524, "o", "\"                   (LOAN-AMT * MONTHLY-RATE) / DENOM\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.327607, "o", "\"           END-IF\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32768, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.327702, "o", "> "]
[548.327841, "o", "\"           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32808, "o", "\"               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\",\r\n\u001b[?2004l\r"]
[548.328095, "o", "\u001b[?2004h> "]
[548.328301, "o", "\"               COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.328385, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.328466, "o", "\"               IF I = TERM-MONTHS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.328617, "o", "\"                   MOVE BALANCE TO PRINC-PART\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.328776, "o", "\"                   COMPUTE MONTHLY-PAY ROUNDED =\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.328934, "o", "\"                       INTEREST-PART + PRINC-PART\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.32905, "o", "\"               END-IF\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.329073, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[548.329133, "o", "> "]
[548.329279, "o", "\"               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.329297, "o", "\"\",\r\n\u001b[?2004l\r"]
[548.329353, "o", "\u001b[?2004h> "]
[548.329443, "o", "\"               MOVE I TO ED-MONTH\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.329589, "o", "\"               MOVE MONTHLY-PAY TO ED-PAY\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.329734, "o", "\"               MOVE INTEREST-PART TO ED-INT\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.329882, "o", "\"               MOVE PRINC-PART TO ED-PRN\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330009, "o", "\"               MOVE REMAIN TO ED-REM\",\r\n\u001b[?2004l\r"]
[548.330095, "o", "\u001b[?2004h> \"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330221, "o", "\"               MOVE SPACES TO OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330385, "o", "\"               STRING ED-MONTH DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330532, "o", "\"                      \\\" \\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330677, "o", "\"                      ED-PAY DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.330822, "o", "\"                      \\\" \\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331002, "o", "\"                      ED-INT DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331146, "o", "\"                      \\\" \\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331291, "o", "\"                      ED-PRN DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331439, "o", "\"                      \\\" \\\" DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331599, "o", "\"                      ED-REM DELIMITED BY SIZE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331725, "o", "\"                      INTO OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331825, "o", "\"               END-STRING\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331941, "o", "\"               WRITE OUT-REC\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.331968, "o", "\"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332139, "o", "\"               MOVE REMAIN TO BALANCE\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332235, "o", "\"           END-PERFORM.\",\r\n\u001b[?2004l\r"]
[548.332293, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[548.332312, "o", "\u001b[?2004h> "]
[548.33238, "o", "# validate length\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332484, "o", "mx = max(len(s) for s in lines)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332673, "o", "bad = [(i+1,len(s),s) for i,s in enumerate(lines) if len(s)>80]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332756, "o", "if bad:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.332881, "o", "    raise SystemExit('line >80: '+str(bad[0][:2]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.333083, "o", "Path('/app/src/program.cbl').write_text(\"\\n\".join(lines)+\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.333246, "o", "print('WROTE', len(lines), 'lines; max_len', mx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[548.333264, "o", "PY\r\n\u001b[?2004l\r"]
[548.359355, "o", "WROTE 182 lines; max_len 71\r\n"]
[548.363842, "o", "\u001b[?2004hroot@f2dfd4d3de5d:/app/src# "]
[548.41069, "i", "nl -ba program.cbl | sed -n '120,180p'\n"]
[548.410936, "o", "nl -ba program.cbl | sed -n '120,180p'\r\n\u001b[?2004l\r"]
[548.412504, "o", "   120\t           WRITE OUT-REC.\r\n   121\t\r\n   122\t       WRITE-APPRO.\r\n   123\t           MOVE SPACES TO OUT-REC\r\n   124\t           STRING WS-ID DELIMITED BY SIZE\r\n   125\t                  \"APPRO\" DELIMITED BY SIZE\r\n   126\t                  INTO OUT-REC\r\n   127\t           END-STRING\r\n   128\t           WRITE OUT-REC.\r\n   129\t\r\n   130\t       BUILD-SCHEDULE.\r\n   131\t           IF TERM-MONTHS <= 0\r\n   132\t               EXIT PARAGRAPH\r\n   133\t           END-IF\r\n   134\t\r\n   135\t           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\r\n   136\t           MOVE LOAN-AMT TO BALANCE\r\n   137\t\r\n   138\t           IF MONTHLY-RATE = 0\r\n   139\t               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\r\n   140\t           ELSE\r\n   141\t               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\r\n   142\t               COMPUTE POWVAL ROUNDED =\r\n   143\t                   FUNCTION POWER(BASE, -TERM-MONTHS)\r\n   144\t               COMPUTE DENOM ROUNDED = 1 - POWVAL\r\n"]
[548.412622, "o", "   145\t               COMPUTE MONTHLY-PAY ROUNDED =\r\n   146\t                   (LOAN-AMT * MONTHLY-RATE) / DENOM\r\n   147\t           END-IF\r\n   148\t\r\n   149\t           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\r\n   150\t               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\r\n   151\t               COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\r\n   152\t\r\n   153\t               IF I = TERM-MONTHS\r\n   154\t                   MOVE BALANCE TO PRINC-PART\r\n   155\t                   COMPUTE MONTHLY-PAY ROUNDED =\r\n   156\t                       INTEREST-PART + PRINC-PART\r\n   157\t               END-IF\r\n   158\t\r\n   159\t               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\r\n   160\t\r\n   161\t               MOVE I TO ED-MONTH\r\n   162\t               MOVE MONTHLY-PAY TO ED-PAY\r\n   163\t               MOVE INTEREST-PART TO ED-INT\r\n   164\t               MOVE PRINC-PART TO ED-PRN\r\n   165\t               MOVE REMAIN TO ED-REM\r\n   166\t\r\n   167\t               MOVE SPACES TO OUT-REC\r\n   168\t         "]
[548.412734, "o", "      STRING ED-MONTH DELIMITED BY SIZE\r\n   169\t                      \" \" DELIMITED BY SIZE\r\n   170\t                      ED-PAY DELIMITED BY SIZE\r\n   171\t                      \" \" DELIMITED BY SIZE\r\n   172\t                      ED-INT DELIMITED BY SIZE\r\n   173\t                      \" \" DELIMITED BY SIZE\r\n   174\t                      ED-PRN DELIMITED BY SIZE\r\n   175\t                      \" \" DELIMITED BY SIZE\r\n   176\t                      ED-REM DELIMITED BY SIZE\r\n   177\t                      INTO OUT-REC\r\n   178\t               END-STRING\r\n   179\t               WRITE OUT-REC\r\n   180\t\r\n"]
[548.412943, "o", "\u001b[?2004hroot@f2dfd4d3de5d:/app/src# "]
[548.511546, "i", "cobc -x -std=gnucobol program.cbl 2>&1 | sed -n '1,200p'\n"]
[548.511888, "o", "cobc -x -std=gnucobol program.cbl 2>&1 | sed -n '1,200p'\r\n\u001b[?2004l\r"]
[548.528635, "o", "program.cbl: in paragraph 'BUILD-SCHEDULE':\r\nprogram.cbl:143: error: FUNCTION 'POWER' unknown\r\n"]
