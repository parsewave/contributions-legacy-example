[186.186425, "i", "nl -ba program.cbl | sed -n '1,80p'\n"]
[186.186638, "o", "nl -ba program.cbl | sed -n '1,80p'\r\n\u001b[?2004l\r"]
[186.188547, "o", "     1\t       IDENTIFICATION DIVISION.\r\n     2\t       PROGRAM-ID. PROGRAM.\r\n     3\t\r\n     4\t       ENVIRONMENT DIVISION.\r\n     5\t       INPUT-OUTPUT SECTION.\r\n     6\t       FILE-CONTROL.\r\n     7\t           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\r\n     8\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n     9\t           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n    10\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    11\t\r\n    12\t       DATA DIVISION.\r\n    13\t       FILE SECTION.\r\n    14\t       FD  INFILE.\r\n    15\t       01  IN-REC               PIC X(256).\r\n    16\t\r\n    17\t       FD  OUTFILE.\r\n    18\t       01  OUT-REC              PIC X(256)."]
[186.188693, "o", "\r\n    19\t\r\n    20\t       WORKING-STORAGE SECTION.\r\n    21\t       01  WS-EOF               PIC X VALUE 'N'.\r\n    22\t\r\n    23\t       01  WS-FIELDS.\r\n    24\t           05  WS-ID            PIC X(10).\r\n    25\t           05  WS-NAME          PIC X(30).\r\n    26\t           05  WS-LOAN-X        PIC X(20).\r\n    27\t           05  WS-PROP-X        PIC X(20).\r\n    28\t           05  WS-DOWN-X        PIC X(20).\r\n    29\t           05  WS-TERM-X        PIC X(10).\r\n    30\t           05  WS-RATE-X        PIC X(20).\r\n    31\t\r\n    32\t       01  WS-NUMS.\r\n    33\t           05  LOAN-AMT         PIC 9(10)V99 VALUE 0.\r\n    34\t           05  PROP-VALUE       PIC 9(10)V99 VALUE 0.\r\n    35\t           05  DOWN-PAY         PIC 9(10)V99 VALUE 0.\r\n    36\t           05  TERM-MONTHS      PIC 9(4)     VALUE 0.\r\n    37\t           05  RATE-ANN         PIC 9(3)V9(2) VALUE 0.\r\n    38\t\r\n    39\t       01  WS-CALC.\r\n    40\t           05  MIN-DOWN         PIC 9(10)V99 VALUE 0.\r\n    41\t           05  MONTHLY-RATE     PIC 9V9(8)   VALUE 0.\r\n    42\t    "]
[186.188746, "o", "       05  BASE             PIC 9V9(8)   VALUE 0.\r\n    43\t           05  POWVAL           PIC 9V9(12)  VALUE 0.\r\n    44\t           05  DENOM            PIC S9V9(12) VALUE 0.\r\n    45\t           05  MONTHLY-PAY      PIC 9(10)V99 VALUE 0.\r\n    46\t           05  BALANCE          PIC 9(10)V99 VALUE 0.\r\n    47\t           05  INTEREST-PART    PIC 9(10)V99 VALUE 0.\r\n    48\t           05  PRINC-PART       PIC 9(10)V99 VALUE 0.\r\n    49\t           05  REMAIN           PIC 9(10)V99 VALUE 0.\r\n    50\t\r\n    51\t       01  WS-OUT-EDIT.\r\n    52\t           05  ED-MONTH         PIC 9(3).\r\n    53\t           05  ED-PAY           PIC 9(8).99.\r\n    54\t           05  ED-INT           PIC 9(8).99.\r\n    55\t           05  ED-PRN           PIC 9(8).99.\r\n    56\t           05  ED-REM           PIC 9(10).99.\r\n    57\t\r\n    58\t       01  WS-REASON            PIC X(50).\r\n    59\t       01  I                    PIC 9(4) VALUE 0.\r\n    60\t\r\n    61\t       PROCEDURE DIVISION.\r\n    62\t       MAIN.\r\n    63\t           OPEN INPUT INFILE\r\n    64\t        "]
[186.188806, "o", "   OPEN OUTPUT OUTFILE\r\n    65\t\r\n    66\t           PERFORM UNTIL WS-EOF = 'Y'\r\n    67\t               READ INFILE\r\n    68\t                   AT END\r\n    69\t                       MOVE 'Y' TO WS-EOF\r\n    70\t                   NOT AT END\r\n    71\t                       PERFORM PROCESS-ONE\r\n    72\t               END-READ\r\n    73\t           END-PERFORM\r\n    74\t\r\n    75\t           CLOSE INFILE\r\n    76\t           CLOSE OUTFILE\r\n    77\t           STOP RUN.\r\n    78\t\r\n    79\t       PROCESS-ONE.\r\n    80\t           PERFORM PARSE-INPUT\r\n"]
