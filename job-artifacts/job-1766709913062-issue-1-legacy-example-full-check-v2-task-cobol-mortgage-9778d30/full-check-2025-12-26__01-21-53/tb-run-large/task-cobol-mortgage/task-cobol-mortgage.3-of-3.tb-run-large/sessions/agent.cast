[475.502203, "o", "\u001b[?2004hroot@f2dfd4d3de5d:/app/src# "]
[475.606575, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INFILE.\n       01  IN-REC                   PIC X(256).\n\n       FD  OUTFILE.\n       01  OUT-REC                  PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                   PIC X VALUE 'N'.\n\n       01  WS-FIELDS.\n           05  WS-ID                PIC X(10).\n           05  WS-NAME              PIC X(30).\n           05  WS-LOAN-X            PIC X(20).\n           05  WS-PROP-X            PIC X(20).\n           05  WS-DOWN-X            PIC X(20).\n           05  WS-TERM-X            PIC X(10).\n           05  WS-RATE-X            PIC X(20).\n\n       01  WS-NUMS.\n          "]
[475.60662, "i", " 05  LOAN-AMT             PIC 9(10)V99 VALUE 0.\n           05  PROP-VALUE           PIC 9(10)V99 VALUE 0.\n           05  DOWN-PAY             PIC 9(10)V99 VALUE 0.\n           05  TERM-YEARS           PIC 9(2)     VALUE 0.\n           05  TERM-MONTHS          PIC 9(4)     VALUE 0.\n           05  RATE-ANN             PIC 9(3)V9(2) VALUE 0.\n\n       01  WS-CALC.\n           05  MIN-DOWN             PIC 9(10)V99 VALUE 0.\n           05  MONTHLY-RATE         PIC 9V9(8)   VALUE 0.\n           05  BASE                 PIC 9V9(8)   VALUE 0.\n           05  POWVAL               PIC 9V9(12)  VALUE 0.\n           05  DENOM                PIC S9V9(12) VALUE 0.\n           05  MONTHLY-PAY          PIC 9(10)V99 VALUE 0.\n           05  BALANCE              PIC 9(10)V99 VALUE 0.\n           05  INTEREST-PART        PIC 9(10)V99 VALUE 0.\n           05  PRINC-PART           PIC 9(10)V99 VALUE 0.\n           05  REMAIN               PIC 9(10)V99 VALUE 0.\n\n       01  WS-OUT-EDIT.\n           05  ED-MONTH             PIC 9(3).\n           05"]
[475.606754, "i", "  ED-PAY               PIC 9(8).99.\n           05  ED-INT               PIC 9(8).99.\n           05  ED-PRN               PIC 9(8).99.\n           05  ED-REM               PIC 9(10).99.\n\n       01  WS-REASON                PIC X(50).\n       01  I                        PIC 9(4) VALUE 0.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n\n           PERFORM UNTIL WS-EOF = 'Y'\n               READ INFILE\n                   AT END\n                       MOVE 'Y' TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-ONE\n               END-READ\n           END-PERFORM\n\n           CLOSE INFILE\n           CLOSE OUTFILE\n           STOP RUN.\n\n       PROCESS-ONE.\n           PERFORM PARSE-INPUT\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY ';'\n               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\n                    WS-TERM-X WS-RATE-X\n           END-UN"]
[475.606774, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[475.606854, "i", "STRING\n\n           COMPUTE LOAN-AMT ROUNDED =\n               FUNCTION NUMVAL(WS-LOAN-X) / 100\n           COMPUTE PROP-VALUE ROUNDED =\n               FUNCTION NUMVAL(WS-PROP-X) / 100\n           COMPUTE DOWN-PAY ROUNDED =\n               FUNCTION NUMVAL(WS-DOWN-X) / 100\n           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\n           COMPUTE TERM-MONTHS = TERM-YEARS * 12\n           COMPUTE RATE-ANN ROUNDED =\n               FUNCTION NUMVAL(WS-RATE-X) / 100.\n\n       CHECK-APPLICATION.\n           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\n\n           IF DOWN-PAY < MIN-DOWN\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"DENY \" DELIMITED BY SIZE\n                  WS-REASON DELIMITED BY SIZE\n                  INTO OUT-REC\n           EN"]
[475.606921, "o", "  ED-PAY               PIC 9(8).99.\r\n           05  ED-INT               PIC 9(8).99.\r\n           05  ED-PRN               PIC 9(8).99.\r\n           05  ED-REM               PIC 9(10).99.\r\n\r\n       01  WS-REASON                PIC X(50).\r\n       01  I                        PIC 9(4) VALUE 0.\r\n\r\n       PROCEDURE DIVISION.\r\n       MAIN.\r\n           OPEN INPUT INFILE\r\n           OPEN OUTPUT OUTFILE\r\n\r\n           PERFORM UNTIL WS-EOF = 'Y'\r\n               READ INFILE\r\n                   AT END\r\n     "]
[475.606955, "i", "D-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"APPRO\" DELIMITED BY SIZE\n                  INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHEDULE.\n           IF TERM-MONTHS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\n           MOVE LOAN-AMT TO BALANCE\n\n           IF MONTHLY-RATE = 0\n               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\n           ELSE\n               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\n               COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)\n               COMPUTE DENOM ROUNDED = 1 - POWVAL\n               COMPUTE MONTHLY-PAY ROUNDED =\n                   (LOAN-AMT * MONTHLY-RATE) / DENOM\n           END-IF\n\n           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\n               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\n               COMPUTE PR"]
[475.607031, "o", "                  MOVE 'Y' TO WS-EOF\r\n                   NOT AT END\r\n                       PERFORM PROCESS-ONE\r\n               END-READ\r\n           END-PERFORM\r\n\r\n           CLOSE INFILE\r\n           CLOSE OUTFILE\r\n           STOP RUN.\r\n\r\n       PROCESS-ONE.\r\n           PERFORM PARSE-INPUT\r\n           PERFORM CHECK-APPLICATION.\r\n\r\n       PARSE-INPUT.\r\n           MOVE SPACES TO WS-FIELDS\r\n           UNSTRING IN-REC DE"]
[475.607051, "i", "INC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\n\n               IF I = TERM-MONTHS\n                   MOVE BALANCE TO PRINC-PART\n                   COMPUTE MONTHLY-PAY ROUNDED =\n                       INTEREST-PART + PRINC-PART\n               END-IF\n\n               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\n\n               MOVE I TO ED-MONTH\n               MOVE MONTHLY-PAY TO ED-PAY\n               MOVE INTEREST-PART TO ED-INT\n               MOVE PRINC-PART TO ED-PRN\n               MOVE REMAIN TO ED-REM\n\n               MOVE SPACES TO OUT-REC\n               STRING ED-MONTH DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-PAY DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-INT DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-PRN DELIMITED BY SIZE\n                      \" \" DELIMITED BY SIZE\n                      ED-REM DELIMITED BY SIZE\n                      INTO OUT-REC\n               END-STRING\n "]
[475.607066, "o", "LIMITED BY ';'\r\n               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\r\n                    WS-TERM-X WS-RATE-X\r\n           "]
[475.60709, "i", "              WRITE OUT-REC\n\n               MOVE REMAIN TO BALANCE\n           END-PERFORM.\nEOF\n"]
[475.607135, "o", "END-UNSTRING\r\n\r\n           COMPUTE LOAN-AMT ROUNDED =\r\n               FUNCTION NUMVAL(WS-LOAN-X) / 100\r\n           COMPUTE PROP-VALUE ROUNDED =\r\n               FUNCTION NUMVAL(WS-PROP-X) / 100\r\n           COMPUTE DOWN-PAY ROUNDED =\r\n               FUNCTION "]
[475.607281, "o", "NUMVAL(WS-DOWN-X) / 100\r\n           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\r\n           COMPUTE TERM-MONTHS = TERM-YEARS * 12\r\n           COMPUTE RATE-ANN ROUNDED =\r\n               FUNCTION NUMVAL(WS-RATE-X) / 100.\r\n\r\n       CHECK-APPLICATION.\r\n           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\r\n\r\n           IF DOWN-PAY < MIN-DOWN\r\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n               PERFORM WRITE-DENY\r\n           ELSE\r\n               PERFORM WRITE-APPRO\r\n               PERFORM BUILD-SCHEDULE\r\n           END-IF.\r\n\r\n       WRITE-DENY.\r\n           MOVE SPACES TO OUT-REC\r\n           ST"]
[475.607349, "o", "RING WS-ID DELIMITED BY SIZE\r\n                  \"DENY \" DELIMITED BY SIZE\r\n                  WS-REASON DELIMITED BY SIZE\r\n                  INTO OUT-RE"]
[475.607426, "o", "C\r\n           END-STRING\r\n           WRITE OUT-REC."]
[475.607546, "o", "\u001b[?2004h> "]
[475.607637, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r"]
[475.607671, "o", "\u001b[?2004h> "]
[475.607779, "o", "       PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[475.607886, "o", "       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.608058, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.608143, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\rZ\u001b[?2004h> "]
[475.608277, "o", "           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.608442, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.608483, "o", "> "]
[475.608773, "o", "           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n\u001b[?2004l\r"]
[475.608858, "o", "\u001b[?2004h> "]
[475.609087, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\rOMP\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.609159, "o", "\u001b[?2004h"]
[475.609181, "o", "> "]
[475.609331, "o", "       DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.609441, "o", "       FILE SECTION.\r\n\u001b[?2004l\r"]
[475.609462, "o", "\u001b[?2004h> "]
[475.609563, "o", "       FD  INFILE.\r\n\u001b[?2004l\r"]
[475.609583, "o", "\u001b[?2004h> "]
[475.609806, "o", "       01  IN-REC                   PIC X(256).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.609884, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[475.609968, "o", "       FD  OUTFILE.\r\n\u001b[?2004l\r"]
[475.610048, "o", "\u001b[?2004h> "]
[475.610205, "o", "       01  OUT-REC                  PIC X(256).\r\n\u001b[?2004l\r"]
[475.61028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[475.610337, "o", "\u001b[?2004h> "]
[475.610468, "o", "       WORKING-STORAGE SECTION.\r\n\u001b[?2004l\rOM\u001b[?2004h"]
[475.610534, "o", "> "]
[475.610686, "o", "       01  WS-EOF                   PIC X VALUE 'N'.\r\n\u001b[?2004l\r"]
[475.610748, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rO"]
[475.610769, "o", "\u001b[?2004h> "]
[475.610851, "o", "       01  WS-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.611063, "o", "           05  WS-ID                PIC X(10).\r\n\u001b[?2004l\r"]
[475.611127, "o", "\u001b[?2004h> "]
[475.611292, "o", "           05  WS-NAME              PIC X(30).\r\n\u001b[?2004l\r  \u001b[?2004h"]
[475.611316, "o", "> "]
[475.611486, "o", "           05  WS-LOAN-X            PIC X(20).\r\n\u001b[?2004l\r"]
[475.611505, "o", "\u001b[?2004h> "]
[475.611692, "o", "           05  WS-PROP-X            PIC X(20).\r\n\u001b[?2004l\r \u001b[?2004h> "]
[475.611887, "o", "           05  WS-DOWN-X            PIC X(20).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.612088, "o", "           05  WS-TERM-X            PIC X(10).\r\n\u001b[?2004l\r"]
[475.612152, "o", "\u001b[?2004h> "]
[475.612351, "o", "           05  WS-RATE-X            PIC X(20).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.612425, "o", "\r\n\u001b[?2004l\rY\u001b[?2004h> "]
[475.612513, "o", "       01  WS-NUMS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.612732, "o", "           05  LOAN-AMT             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[475.612754, "o", "> "]
[475.61296, "o", "           05  PROP-VALUE           PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[475.612978, "o", "\u001b[?2004h> "]
[475.613204, "o", "           05  DOWN-PAY             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[475.613224, "o", "\u001b[?2004h> "]
[475.613469, "o", "           05  TERM-YEARS           PIC 9(2)     VALUE 0.\r\n\u001b[?2004l\rC\u001b[?2004h> "]
[475.613652, "o", "           05  TERM-MONTHS          PIC 9(4)     VALUE 0.\r\n\u001b[?2004l\rN\u001b[?2004h> "]
[475.613885, "o", "           05  RATE-ANN             PIC 9(3)V9(2) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.613906, "o", "\r\n\u001b[?2004l\rD\u001b[?2004h"]
[475.613966, "o", "> "]
[475.614114, "o", "       01  WS-CALC.\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[475.614309, "o", "           05  MIN-DOWN             PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[475.61433, "o", "\u001b[?2004h> "]
[475.614492, "o", "           05  MONTHLY-RATE         PIC 9V9(8)   VALUE 0.\r\n\u001b[?2004l\r\r\n  \u001b[?2004h"]
[475.614511, "o", "> "]
[475.614674, "o", "           05  BASE                 PIC 9V9(8)   VALUE 0.\r\n\u001b[?2004l\r"]
[475.614693, "o", "\u001b[?2004h> "]
[475.614863, "o", "           05  POWVAL               PIC 9V9(12)  VALUE 0.\r\n\u001b[?2004l\rD B\u001b[?2004h> "]
[475.615071, "o", "           05  DENOM                PIC S9V9(12) VALUE 0.\r\n\u001b[?2004l\r"]
[475.61509, "o", "\u001b[?2004h> "]
[475.6153, "o", "           05  MONTHLY-PAY          PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[475.615486, "o", "           05  BALANCE              PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r"]
[475.615504, "o", "\u001b[?2004h> "]
[475.615692, "o", "           05  INTEREST-PART        PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\rIZE\u001b[?2004h"]
[475.615716, "o", "> "]
[475.615962, "o", "           05  PRINC-PART           PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.616035, "o", "> "]
[475.616254, "o", "           05  REMAIN               PIC 9(10)V99 VALUE 0.\r\n\u001b[?2004l\rD\u001b[?2004h"]
[475.616274, "o", "> \r\n\u001b[?2004l\r"]
[475.616335, "o", "-\u001b[?2004h> "]
[475.61643, "o", "       01  WS-OUT-EDIT.\r\n\u001b[?2004l\r"]
[475.61649, "o", "\u001b[?2004h> "]
[475.616629, "o", "           05  ED-MONTH             PIC 9(3).\r\n\u001b[?2004l\r"]
[475.616682, "o", "\u001b[?2004h> "]
[475.616827, "o", "           05  ED-PAY               PIC 9(8).99.\r\n\u001b[?2004l\r"]
[475.616853, "o", "\u001b[?2004h> "]
[475.617051, "o", "           05  ED-INT               PIC 9(8).99.\r\n\u001b[?2004l\r"]
[475.617105, "o", "\u001b[?2004h> "]
[475.617254, "o", "           05  ED-PRN               PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.617394, "o", "           05  ED-REM               PIC 9(10).99.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.617435, "o", "> \r\n\u001b[?2004l\r"]
[475.617467, "o", "\u001b[?2004h> "]
[475.617605, "o", "       01  WS-REASON                PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.617761, "o", "       01  I                        PIC 9(4) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[475.617813, "o", "\u001b[?2004l\r\u001b[?2004h"]
[475.617846, "o", "> "]
[475.617924, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.618019, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.618125, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.618143, "o", "> "]
[475.618268, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.618331, "o", "\u001b[?2004h> "]
[475.618421, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.618459, "o", "> "]
[475.618547, "o", "               READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.61859, "o", "> "]
[475.61866, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.618701, "o", "> "]
[475.618807, "o", "                       MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.618861, "o", "> "]
[475.618939, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.619032, "o", "> "]
[475.619127, "o", "                       PERFORM PROCESS-ONE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.619166, "o", "> "]
[475.619264, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.619316, "o", "> "]
[475.619359, "o", "           END-PERFORM\r\n\u001b[?2004l\r"]
[475.619409, "o", "\u001b[?2004h> \r\n"]
[475.619453, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[475.619536, "o", "           CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.619626, "o", "           CLOSE OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.619653, "o", "> "]
[475.619725, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.619759, "o", "> \r\n\u001b[?2004l\r"]
[475.619796, "o", "\u001b[?2004h> "]
[475.619868, "o", "       PROCESS-ONE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.61991, "o", "> "]
[475.620024, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.620079, "o", "> "]
[475.620162, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r"]
[475.620203, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.620234, "o", "\u001b[?2004h> "]
[475.620324, "o", "       PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.620362, "o", "> "]
[475.620467, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.620509, "o", "> "]
[475.620623, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.620801, "o", "               INTO WS-ID WS-NAME WS-LOAN-X WS-PROP-X WS-DOWN-X\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.620912, "o", "                    WS-TERM-X WS-RATE-X\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.620949, "o", "> "]
[475.621036, "o", "           END-UNSTRING\r\n\u001b[?2004l\r"]
[475.621094, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.621135, "o", "\u001b[?2004h> "]
[475.621254, "o", "           COMPUTE LOAN-AMT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.621403, "o", "               FUNCTION NUMVAL(WS-LOAN-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.621443, "o", "> "]
[475.62154, "o", "           COMPUTE PROP-VALUE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.621559, "o", "> "]
[475.621699, "o", "               FUNCTION NUMVAL(WS-PROP-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.621819, "o", "           COMPUTE DOWN-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.621942, "o", "               FUNCTION NUMVAL(WS-DOWN-X) / 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.621979, "o", "> "]
[475.622165, "o", "           COMPUTE TERM-YEARS = FUNCTION NUMVAL(WS-TERM-X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.622333, "o", "           COMPUTE TERM-MONTHS = TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.622456, "o", "           COMPUTE RATE-ANN ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.622604, "o", "               FUNCTION NUMVAL(WS-RATE-X) / 100.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.622626, "o", "\u001b[?2004h> "]
[475.622742, "o", "       CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.622893, "o", "           COMPUTE MIN-DOWN ROUNDED = PROP-VALUE * 0.15\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.622917, "o", "> \r\n\u001b[?2004l\r"]
[475.623008, "o", "\u001b[?2004h"]
[475.62305, "o", "> "]
[475.623088, "o", "           IF DOWN-PAY < MIN-DOWN\r\n\u001b[?2004l\r"]
[475.623106, "o", "\u001b[?2004h> "]
[475.623307, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.623425, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.623514, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.623641, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.623663, "o", "> "]
[475.623778, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.623799, "o", "> "]
[475.623869, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.623893, "o", "> \r\n\u001b[?2004l\r"]
[475.62393, "o", "\u001b[?2004h"]
[475.623965, "o", "> "]
[475.624041, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.624168, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.624317, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.624456, "o", "                  \"DENY \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.624599, "o", "                  WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.624628, "o", "> "]
[475.624731, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.624752, "o", "> "]
[475.624839, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.62486, "o", "> "]
[475.624961, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.624979, "o", "> \r\n\u001b[?2004l\r"]
[475.625037, "o", "\u001b[?2004h> "]
[475.625121, "o", "       WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.625143, "o", "> "]
[475.625261, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.625396, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.62554, "o", "                  \"APPRO\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[475.625561, "o", "> "]
[475.625662, "o", "                  INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.625767, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.625871, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.625895, "o", "\r\n\u001b[?2004l\r"]
[475.625954, "o", "\u001b[?2004h> "]
[475.626035, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r"]
[475.626096, "o", "\u001b[?2004h> "]
[475.626195, "o", "           IF TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.626328, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.626422, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.62645, "o", "\u001b[?2004h> "]
[475.62664, "o", "           COMPUTE MONTHLY-RATE ROUNDED = RATE-ANN / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.626757, "o", "           MOVE LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[475.626771, "o", "> "]
[475.626861, "o", "           IF MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.627002, "o", "               COMPUTE MONTHLY-PAY ROUNDED = LOAN-AMT / TERM-MONTHS\r\n\u001b[?2004l\r"]
[475.62708, "o", "\u001b[?2004h>            ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.627198, "o", "               COMPUTE BASE ROUNDED = 1 + MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.627399, "o", "               COMPUTE POWVAL ROUNDED = FUNCTION POWER(BASE, -TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.627487, "o", "               COMPUTE DENOM ROUNDED = 1 - POWVAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.62759, "o", "               COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.627701, "o", "                   (LOAN-AMT * MONTHLY-RATE) / DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.62776, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.62789, "o", "           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628051, "o", "               COMPUTE INTEREST-PART ROUNDED = BALANCE * MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628196, "o", "               COMPUTE PRINC-PART ROUNDED = MONTHLY-PAY - INTEREST-PART\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[475.628207, "o", "\u001b[?2004h"]
[475.628306, "o", "> "]
[475.62833, "o", "               IF I = TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628453, "o", "                   MOVE BALANCE TO PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628559, "o", "                   COMPUTE MONTHLY-PAY ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628679, "o", "                       INTEREST-PART + PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628753, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[475.628866, "o", "               COMPUTE REMAIN ROUNDED = BALANCE - PRINC-PART\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[475.628923, "o", "> "]
[475.628981, "o", "               MOVE I TO ED-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
