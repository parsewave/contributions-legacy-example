[34.289621, "o", "01 MIN-DOWN          PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289682, "o", "01 MONTHLY-RATE      PIC 9(5)V9(6).\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.28973, "o", "> "]
[34.289785, "o", "01 MONTHLY-PAYMENT   PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.28987, "o", "01 BALANCE           PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289959, "o", "01 INTEREST-PART     PIC 9(8)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290055, "o", "01 PRINCIPAL-PART    PIC 9(8)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29014, "o", "01 MON-NUMBER        PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290229, "o", "01 REASON            PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290365, "o", "01 WS-SPACES         PIC X(1) VALUE SPACE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290433, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r"]
[34.290485, "o", "\u001b[?2004h> "]
[34.290535, "o", "   OPEN INPUT INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290589, "o", "   OPEN OUTPUT OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290661, "o", "   PERFORM UNTIL END-OF-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290733, "o", "      READ INPUT-FILE INTO INPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290841, "o", "         AT END SET END-OF-FILE TO TRUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290862, "o", "      NOT AT END\r\n"]
[34.29089, "o", "\u001b[?2004l\r\u001b[?2004h"]
[34.290974, "o", "> "]
[34.290995, "o", "         PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.291054, "o", "> "]
[34.291114, "o", "      END-READ\r\n\u001b[?2004l\r\u001b[?2004h>    END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291132, "o", "   CLOSE INPUT-FILE\r\n\u001b[?2004l\r"]
[34.291177, "o", "\u001b[?2004h> "]
[34.291217, "o", "   CLOSE OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291311, "o", "   STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291371, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291445, "o", "   UNSTRING INPUT-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291507, "o", "      INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291572, "o", "           WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291621, "o", "           WS-LOAN-AMOUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291679, "o", "           WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291735, "o", "           WS-DOWN-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.291783, "o", "> "]
[34.291855, "o", "           WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291913, "o", "           WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h>    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.291959, "o", "> "]
[34.292012, "o", "   COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292093, "o", "   IF WS-DOWN-PAYMENT < MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292219, "o", "      MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292373, "o", "      STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292464, "o", "             \"DENY \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29255, "o", "             REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292624, "o", "         INTO OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292692, "o", "      END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.292742, "o", "> "]
[34.292803, "o", "      WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>    ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292863, "o", "      MOVE \"APPRO\" TO REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29296, "o", "      STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293063, "o", "             REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293127, "o", "         INTO OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293178, "o", "      END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293198, "o", "      WRITE OUTPUT-REC\r\n\u001b[?2004l\r"]
[34.293216, "o", "\u001b[?2004h> "]
[34.29334, "o", "      PERFORM GENERATE-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293358, "o", "   END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.293409, "o", "\u001b[?2004h> "]
[34.293476, "o", "GENERATE-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293559, "o", "   COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29368, "o", "   COMPUTE MONTHLY-PAYMENT = WS-LOAN-AMOUNT * MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293824, "o", "        (1 - FUNCTION POW (1 + MONTHLY-RATE, -WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293918, "o", "   MOVE WS-LOAN-AMOUNT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29406, "o", "   PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.294108, "o", "> "]
[34.294214, "o", "      COMPUTE INTEREST-PART = BALANCE * MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294422, "o", "      COMPUTE PRINCIPAL-PART = MONTHLY-PAYMENT - INTEREST-PART ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294549, "o", "      SUBTRACT PRINCIPAL-PART FROM BALANCE GIVING BALANCE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294675, "o", "      STRING FUNCTION NUMVAL-C (MON-NUMBER) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294769, "o", "             \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294906, "o", "             FUNCTION NUMVAL-C (MONTHLY-PAYMENT) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294985, "o", "             \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295133, "o", "             FUNCTION NUMVAL-C (INTEREST-PART) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295212, "o", "             \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295388, "o", "             FUNCTION NUMVAL-C (PRINCIPAL-PART) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29545, "o", "             \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295591, "o", "             FUNCTION NUMVAL-C (BALANCE) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295673, "o", "         INTO OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295724, "o", "      END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295769, "o", "      WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.295819, "o", "> "]
[34.295837, "o", "   END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[34.295845, "o", "\r\n\u001b[?2004l\r"]
