[66.451149, "o", " BALANCE * MONTHLY-RATE ROUNDED\r\n              COMPUTE PRINCIPAL-PART = MONTHLY-PAYMENT - INTEREST-PART ROUNDED\r\n              SUBTRACT PRINCIPAL-PART FROM BALANCE GIVING BALANCE ROUNDED\r\n              STRING FUNCTION NUMVAL-C (MON-NUMBER) DELIMITED BY SIZE\r\n                     \" \" DELIMITED BY SIZE\r\n                     FUNCTION NUMVAL-C (MONTHLY-PAYMENT) DELIMITED BY SIZE\r\n                     \" \" DELIMITED BY SIZE\r\n                     FUNCTION NUMVAL-C (INTEREST-PART) DELIMITED BY SIZE\r\n                     \" \" DELIMITED BY SIZE\r\n                     FUNCTION"]
