[66.450177, "i", "cat > program.cbl <<'EOF'\n      IDENTIFICATION DIVISION.\n      PROGRAM-ID. MORTGAGE.\n      ENVIRONMENT DIVISION.\n      INPUT-OUTPUT SECTION.\n      FILE-CONTROL.\n          SELECT INPUT-FILE ASSIGN TO \"INPUT.DAT\"\n              ORGANIZATION IS LINE SEQUENTIAL.\n          SELECT OUTPUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n              ORGANIZATION IS LINE SEQUENTIAL.\n      DATA DIVISION.\n      FILE SECTION.\n      FD INPUT-FILE.\n      01 INPUT-REC PIC X(200).\n      FD OUTPUT-FILE.\n      01 OUTPUT-REC PIC X(200).\n      WORKING-STORAGE SECTION.\n      01 WS-EOF PIC X VALUE \"N\".\n         88 END-OF-FILE VALUE \"Y\".\n      01 WS-REC.\n         05 WS-ID           PIC X(10).\n         05 WS-NAME         PIC X(30).\n         05 WS-LOAN-AMOUNT  PIC 9(10).\n         05 WS-PROP-VALUE   PIC 9(10).\n         05 WS-DOWN-PAYMENT PIC 9(10).\n         05 WS-TERM         PIC 9(2).\n         05 WS-RATE         PIC 9(3)V9(2).\n      01 MIN-DOWN          PIC 9(10)V99.\n      01 MONTHLY-RATE      PIC 9(5)V9(6).\n      01 MONTHLY-PAYMENT   PIC 9(10)V"]
[66.450446, "i", "99.\n      01 BALANCE           PIC 9(10)V99.\n      01 INTEREST-PART     PIC 9(8)V99.\n      01 PRINCIPAL-PART    PIC 9(8)V99.\n      01 MON-NUMBER        PIC 9(3).\n      01 REASON            PIC X(50).\n      PROCEDURE DIVISION.\n          OPEN INPUT INPUT-FILE\n          OPEN OUTPUT OUTPUT-FILE\n          PERFORM UNTIL END-OF-FILE\n              READ INPUT-FILE INTO INPUT-REC\n                  AT END SET END-OF-FILE TO TRUE\n              NOT AT END\n                  PERFORM PROCESS-RECORD\n              END-READ\n          END-PERFORM\n          CLOSE INPUT-FILE\n          CLOSE OUTPUT-FILE\n          STOP RUN.\n\n      PROCESS-RECORD.\n          UNSTRING INPUT-REC DELIMITED BY ';'\n              INTO WS-ID\n                   WS-NAME\n                   WS-LOAN-AMOUNT\n                   WS-PROP-VALUE\n                   WS-DOWN-PAYMENT\n                   WS-TERM\n                   WS-RATE\n          END-UNSTRING\n          COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n          IF WS-DOWN-PAYMENT < MIN-DOWN\n              MOVE"]
[66.450571, "o", "cat > program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h>       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r99.\r\n      01 BALANCE           PIC 9(10)V99.\r\n      01 INTEREST-PART     PIC 9(8)V99.\r\n      01 PRINCIPAL-PART    PIC 9(8)V99.\r\n      01 MON-NUMBER        PIC 9(3).\r\n      01 REASON            PIC X(50).\r\n      PROCEDURE DIVISION.\r\n          OPEN INPUT INPUT-FILE\r\n          OPEN OUTPUT OUTPUT-FILE\r\n          PERFORM UNTIL END-OF-FILE\r\n              READ INPUT-FILE INT"]
[66.450645, "i", " \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO REASON\n              STRING WS-ID DELIMITED BY SIZE\n                     \"DENY \" DELIMITED BY SIZE\n                     REASON DELIMITED BY SIZE\n                 INTO OUTPUT-REC\n              END-STRING\n              WRITE OUTPUT-REC\n          ELSE\n              MOVE \"APPRO\" TO REASON\n              STRING WS-ID DELIMITED BY SIZE\n                     REASON DELIMITED BY SIZE\n                 INTO OUTPUT-REC\n              END-STRING\n              WRITE OUTPUT-REC\n              PERFORM GENERATE-SCHEDULE\n          END-IF.\n\n      GENERATE-SCHEDULE.\n          COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n          COMPUTE MONTHLY-PAYMENT = WS-LOAN-AMOUNT * MONTHLY-RATE /\n               (1 - FUNCTION POW (1 + MONTHLY-RATE, -WS-TERM)) ROUNDED\n          MOVE WS-LOAN-AMOUNT TO BALANCE\n          PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\n              COMPUTE INTEREST-PART = BALANCE * MONTHLY-RATE ROUNDED\n              COMPUTE PRINCIPAL-PART = MONTHLY-PAYM"]
[66.450748, "o", "O INPUT-REC\r\n                  AT END SET END-OF-FILE TO TRUE\r\n              NOT AT END\r\n                  PERFORM PROCESS-RECORD\r\n              END-READ\r\n          END-PERFORM\r\n          CLOSE INPUT-FILE\r\n          CLOSE OUTPUT-FILE\r\n          STOP RUN.\r\n\r\n      PROCESS-RECORD.\r\n          UNSTRING INPUT-REC DELIMITED BY ';'\r\n              INTO WS-ID\r\n                   WS-NAME\r\n                   WS-LOAN-AMOUNT\r\n                   WS-PROP-VALUE\r\n                   WS-DOWN-PAYMENT\r\n                   WS-TERM\r\n                   WS-RATE\r\n          END-UNSTRING\r\n          COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n          IF WS-DOWN-PAYMENT < MIN-DOWN\r\n              MOVE"]
[66.450773, "i", "ENT - INTEREST-PART ROUNDED\n              SUBTRACT PRINCIPAL-PART FROM BALANCE GIVING BALANCE ROUNDED\n              STRING FUNCTION NUMVAL-C (MON-NUMBER) DELIMITED BY SIZE\n                     \" \" DELIMITED BY SIZE\n                     FUNCTION NUMVAL-C (MONTHLY-PAYMENT) DELIMITED BY SIZE\n                     \" \" DELIMITED BY SIZE\n                     FUNCTION NUMVAL-C (INTEREST-PART) DELIMITED BY SIZE\n                     \" \" DELIMITED BY SIZE\n                     FUNCTION NUMVAL-C (PRINCIPAL-PART) DELIMITED BY SIZE\n                     \" \" DELIMITED BY SIZE\n                     FUNCTION NUMVAL-C (BALANCE) DELIMITED BY SIZE\n                 INTO OUTPUT-REC\n              END-STRING\n              WRITE OUTPUT-REC\n          END-PERFORM.\nEOF\n"]
[66.450886, "o", " \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO REASON\r\n              STRING WS-ID DELIMITED BY SIZE\r\n                     \"DENY \" DELIMITED BY SIZE\r\n                     REASON DELIMITED BY SIZE\r\n                 INTO OUTPUT-REC\r\n              END-STRING\r\n              WRITE OUTPUT-REC\r\n          ELSE\r\n              MOVE \"APPRO\" TO REASON\r\n              STRING WS-ID DELIMITED BY SIZE\r\n                     REASON DELIMITED BY SIZE\r\n                 INTO OUTPUT-REC\r\n              END-STRING\r\n              WRITE OUTPUT-REC\r\n              PERFORM GENERATE-SCHEDULE\r\n          END-IF.\r\n\r\n      GENERATE-SCHEDULE.\r\n          COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n          COMPUTE MONTHLY-PAYMENT = WS-LOAN-AMOUNT * MONTHLY-RA"]
