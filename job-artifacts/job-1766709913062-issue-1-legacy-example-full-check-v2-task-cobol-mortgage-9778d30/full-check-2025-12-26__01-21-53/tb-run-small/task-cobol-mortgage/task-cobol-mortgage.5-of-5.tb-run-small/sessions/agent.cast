[47.303468, "o", "                   COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.303663, "o", "                   STRING WS-MONTH-NO DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.30376, "o", "> "]
[47.303942, "o", "                          WS-MONTHLY-PAY DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.30408, "o", "                          WS-INTEREST DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.304204, "o", "                          WS-PRINCIPAL DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.304337, "o", "                          WS-BALANCE DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.304428, "o", "                          INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
