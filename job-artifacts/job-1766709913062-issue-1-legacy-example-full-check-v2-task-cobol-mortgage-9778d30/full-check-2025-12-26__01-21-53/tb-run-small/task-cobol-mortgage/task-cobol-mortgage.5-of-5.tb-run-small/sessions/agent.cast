[47.301878, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301995, "o", "               STRING WS-ID DELIMITED BY SIZE \" APPRO\" INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302075, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302238, "o", "               MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302487, "o", "               COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302659, "o", "               COMPUTE WS-MONTHLY-PAY = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.302853, "o", "                     (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.303025, "o", "               PERFORM VARYING WS-MONTH-NO FROM 1 BY 1 UNTIL WS-MONTH-NO > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.303163, "o", "                   COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
