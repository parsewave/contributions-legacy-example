[69.367644, "o", ">           88 NOT-EOF        VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.367677, "o", "> "]
[69.36783, "o", "       01 WS-DELIM          PIC X VALUE \";\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.3679, "o", "       01 WS-ID             PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368044, "o", "       01 WS-NAME           PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368118, "o", "       01 WS-LOAN-AMOUNT    PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368243, "o", "       01 WS-PROP-VALUE     PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368358, "o", "       01 WS-DOWN-PAY       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368428, "o", "       01 WS-TERM           PIC 9(2).\r\n\u001b[?2004l\r"]
[69.368513, "o", "\u001b[?2004h> "]
[69.368536, "o", "       01 WS-RATE           PIC 9(3)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368621, "o", "       01 WS-MIN-DOWN       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368731, "o", "       01 WS-MONTHLY-RATE   PIC S9(5)V9(5).\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.368752, "o", "> "]
[69.368872, "o", "       01 WS-MONTHLY-PAY    PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.368965, "o", "       01 WS-BALANCE        PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369076, "o", "       01 WS-INTEREST       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369173, "o", "       01 WS-PRINCIPAL      PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369273, "o", "       01 WS-MONTH-NO       PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369361, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369434, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369536, "o", "                OUTPUT OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369642, "o", "           PERFORM UNTIL EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369829, "o", "               READ IN-FILE AT END SET EOF TO TRUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.369929, "o", "               NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.370058, "o", "                   MOVE IN-REC TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.370075, "o", "> "]
[69.370278, "o", "                   UNSTRING OUT-REC DELIMITED BY WS-DELIM\r\n\u001b[?2004l\r"]
[69.370296, "o", "\u001b[?2004h> "]
[69.370477, "o", "                     INTO WS-ID, WS-NAME, WS-LOAN-AMOUNT,\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.370499, "o", "> "]
[69.370636, "o", "                          WS-PROP-VALUE, WS-DOWN-PAY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.370803, "o", "                          WS-TERM, WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.370896, "o", "                   PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371019, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371041, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371128, "o", "           CLOSE IN-FILE OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371205, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371316, "o", "       PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371583, "o", "           COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.371704, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r"]
[69.371805, "o", "\u001b[?2004h"]
[69.371871, "o", ">                STRING WS-ID DELIMITED BY SIZE\r\n"]
[69.371971, "o", "\u001b[?2004l\r"]
[69.37199, "o", "\u001b[?2004h> "]
[69.372105, "o", "                      \"DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.372157, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.372249, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.372269, "o", "> "]
[69.372322, "o", "           ELSE\r\n\u001b[?2004l\r"]
[69.372338, "o", "\u001b[?2004h> "]
[69.372571, "o", "               STRING WS-ID DELIMITED BY SIZE \"APPRO\" INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.372626, "o", "> "]
[69.372692, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r"]
[69.372842, "o", "\u001b[?2004h> "]
[69.372941, "o", "               MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r"]
[69.372962, "o", "\u001b[?2004h> "]
[69.373156, "o", "               COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.373299, "o", "               COMPUTE WS-MONTHLY-PAY =\r\n\u001b[?2004l\r"]
[69.373314, "o", "\u001b[?2004h> "]
[69.373537, "o", "                 WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.373758, "o", "                 (1 - FUNCTION POWER (1 + WS-MONTHLY-RATE, -WS-TERM))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.373874, "o", "                 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.374111, "o", "               PERFORM VARYING WS-MONTH-NO FROM 1 BY 1 UNTIL WS-MONTH-NO > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.374317, "o", "                   COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.374522, "o", "                   COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAY - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.374805, "o", "                   COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\r\n\u001b[?2004l\r"]
[69.374833, "o", "\u001b[?2004h> "]
[69.375039, "o", "                   STRING WS-MONTH-NO DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.375247, "o", "                          WS-MONTHLY-PAY DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.375398, "o", "                          WS-INTEREST DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.375581, "o", "                          WS-PRINCIPAL DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.375751, "o", "                          WS-BALANCE DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.37591, "o", "                          INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.376012, "o", "                   WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.376092, "o", "               END-PERFORM\r\n\u001b[?2004l\r"]
[69.376108, "o", "\u001b[?2004h> "]
[69.376191, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.376211, "o", "EOF\r\n\u001b[?2004l\r"]
[69.377539, "o", "\u001b[?2004hroot@9c6f98dfcef8:/app# "]
