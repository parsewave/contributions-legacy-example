[69.468881, "o", "cobc -x /app/src/program.cbl -o /app/src/program\r\n\u001b[?2004l\r"]
[69.483991, "o", "/app/src/program.cbl: in paragraph 'PROCESS-RECORD':\r\n/app/src/program.cbl:52: error: syntax error, unexpected ROUNDED\r\n/app/src/program.cbl:62: error: syntax error, unexpected ROUNDED\r\n"]
[69.484036, "o", "/app/src/program.cbl:65: error: FUNCTION 'POWER' unknown\r\n/app/src/program.cbl:66: error: syntax error, unexpected ROUNDED\r\n/app/src/program.cbl:67: error: invalid expression\r\n"]
[69.484159, "o", "/app/src/program.cbl:68: error: syntax error, unexpected Identifier\r\n/app/src/program.cbl:69: error: syntax error, unexpected Identifier\r\n/app/src/program.cbl:70: error: syntax error, unexpected Identifier\r\n"]
[69.484801, "o", "\u001b[?2004hroot@9c6f98dfcef8:/app# "]
[71.476674, "i", "/app/src/program\n"]
