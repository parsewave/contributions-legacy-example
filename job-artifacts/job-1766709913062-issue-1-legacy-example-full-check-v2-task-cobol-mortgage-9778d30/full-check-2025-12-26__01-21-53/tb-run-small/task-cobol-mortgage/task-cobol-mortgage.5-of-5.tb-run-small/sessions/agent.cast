[2.938228, "m", "Episode 0: 3 commands"]
[2.938228, "o", "\u001b[?2004hroot@9c6f98dfcef8:/app# "]
[47.294071, "i", "cat <<'EOF' > /app/src/program.cbl\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n       DATA DIVISION.\n       FILE SECTION.\n       FD IN-FILE.\n       01 IN-REC PIC X(200).\n       FD OUT-FILE.\n       01 OUT-REC PIC X(200).\n       WORKING-STORAGE SECTION.\n       01 WS-EOF            PIC X VALUE \"N\".\n          88 EOF            VALUE \"Y\".\n          88 NOT-EOF        VALUE \"N\".\n       01 WS-DELIM          PIC X VALUE \";\".\n       01 WS-ID             PIC X(10).\n       01 WS-NAME           PIC X(30).\n       01 WS-LOAN-AMOUNT    PIC 9(10)V9(2).\n       01 WS-PROP-VALUE     PIC 9(10)V9(2).\n       01 WS-DOWN-PAY       PIC 9(10)V9(2).\n       01 WS-TERM           PIC 9(2).\n       01 WS-RATE           PIC 9(3)V9(2).\n     "]
[47.294309, "i", "  01 WS-MIN-DOWN       PIC 9(10)V9(2).\n       01 WS-MONTHLY-RATE   PIC S9(5)V9(5).\n       01 WS-MONTHLY-PAY    PIC 9(10)V9(2).\n       01 WS-BALANCE        PIC 9(10)V9(2).\n       01 WS-INTEREST       PIC 9(10)V9(2).\n       01 WS-PRINCIPAL      PIC 9(10)V9(2).\n       01 WS-MONTH-NO       PIC 9(3).\n       PROCEDURE DIVISION.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE.\n           PERFORM UNTIL EOF\n               READ IN-FILE AT END SET EOF TO TRUE\n               NOT AT END\n                   MOVE IN-REC TO OUT-REC\n                   UNSTRING OUT-REC DELIMITED BY WS-DELIM\n                     INTO WS-ID, WS-NAME, WS-LOAN-AMOUNT,\n                          WS-PROP-VALUE, WS-DOWN-PAY,\n                          WS-TERM, WS-RATE\n                   PERFORM PROCESS-RECORD\n               END-READ\n           END-PERFORM.\n           CLOSE IN-FILE OUT-FILE.\n           STOP RUN.\n       PROCESS-RECORD.\n           COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED.\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n    "]
[47.294382, "o", "cat <<'EOF' > /app/src/program.cbl\r\n\u001b[?2004l\r\u001b[?2004h>        IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.294412, "i", "           STRING WS-ID DELIMITED BY SIZE\n                      \" DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n                      INTO OUT-REC\n               WRITE OUT-REC\n           ELSE\n               STRING WS-ID DELIMITED BY SIZE \" APPRO\" INTO OUT-REC\n               WRITE OUT-REC\n               MOVE WS-LOAN-AMOUNT TO WS-BALANCE\n               COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n               COMPUTE WS-MONTHLY-PAY = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\n                     (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\n               PERFORM VARYING WS-MONTH-NO FROM 1 BY 1 UNTIL WS-MONTH-NO > WS-TERM\n                   COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n                   COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAY - WS-INTEREST ROUNDED\n                   COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\n                   STRING WS-MONTH-NO DELIMITED BY SIZE \" \"\n                          WS-MONTHLY-PAY DELIMITED BY SIZE \" \"\n                          WS-INTEREST DELIM"]
[47.294719, "o", "       PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h>        ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.294818, "i", "ITED BY SIZE \" \"\n                          WS-PRINCIPAL DELIMITED BY SIZE \" \"\n                          WS-BALANCE DELIMITED BY SIZE\n                          INTO OUT-REC\n                   WRITE OUT-REC\n               END-PERFORM\n           END-IF.\nEOF\n"]
[47.2949, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h>        FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h>            SELECT IN-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295002, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295167, "o", "           SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295372, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295511, "o", "       DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h>        FD IN-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295604, "o", "       01 IN-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295735, "o", "       FD OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295866, "o", "       01 OUT-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h>        WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.295895, "o", "       01 WS-EOF            PIC X VALUE \"N\".\r\n\u001b[?2004l\r"]
[47.295918, "o", "\u001b[?2004h> "]
[47.29601, "o", "          88 EOF            VALUE \"Y\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296131, "o", "          88 NOT-EOF        VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296243, "o", "       01 WS-DELIM          PIC X VALUE \";\".\r\n\u001b[?2004l\r"]
[47.296337, "o", "\u001b[?2004h> "]
