[47.296511, "o", "\u001b[?2004h> "]
[47.296608, "o", "       01 WS-NAME           PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296785, "o", "       01 WS-LOAN-AMOUNT    PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h>        01 WS-PROP-VALUE     PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.296909, "o", "       01 WS-DOWN-PAY       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.29702, "o", "       01 WS-TERM           PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297103, "o", "       01 WS-RATE           PIC 9(3)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297199, "o", "       01 WS-MIN-DOWN       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.297299, "o", "> "]
[47.297369, "o", "       01 WS-MONTHLY-RATE   PIC S9(5)V9(5).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.297465, "o", "       01 WS-MONTHLY-PAY    PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.297554, "o", "> "]
[47.297641, "o", "       01 WS-BALANCE        PIC 9(10)V9(2).\r\n\u001b[?2004l\r"]
[47.297696, "o", "\u001b[?2004h> "]
[47.297896, "o", "       01 WS-INTEREST       PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298066, "o", "       01 WS-PRINCIPAL      PIC 9(10)V9(2).\r\n\u001b[?2004l\r"]
[47.298131, "o", "\u001b[?2004h> "]
[47.298241, "o", "       01 WS-MONTH-NO       PIC 9(3).\r\n\u001b[?2004l\r"]
[47.298305, "o", "\u001b[?2004h> "]
[47.298392, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298522, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298649, "o", "                OUTPUT OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298772, "o", "           PERFORM UNTIL EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.298945, "o", "               READ IN-FILE AT END SET EOF TO TRUE\r\n\u001b[?2004l\r"]
[47.299001, "o", "\u001b[?2004h> "]
