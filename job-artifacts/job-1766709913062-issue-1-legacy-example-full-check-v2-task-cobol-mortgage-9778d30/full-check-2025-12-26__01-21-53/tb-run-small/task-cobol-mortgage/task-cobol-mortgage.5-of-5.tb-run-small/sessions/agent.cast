[47.300237, "o", "\u001b[?2004h> "]
[47.30037, "o", "                   PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r"]
[47.300453, "o", "\u001b[?2004h> "]
[47.300546, "o", "               END-READ\r\n\u001b[?2004l\r"]
[47.300637, "o", "\u001b[?2004h>            END-PERFORM.\r\n\u001b[?2004l\r"]
[47.300719, "o", "\u001b[?2004h> "]
[47.300805, "o", "           CLOSE IN-FILE OUT-FILE.\r\n\u001b[?2004l\r"]
[47.300864, "o", "\u001b[?2004h> "]
[47.300937, "o", "           STOP RUN.\r\n\u001b[?2004l\r"]
[47.301009, "o", "\u001b[?2004h> "]
[47.30108, "o", "       PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.301122, "o", "> "]
[47.301253, "o", "           COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301357, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301477, "o", "               STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301604, "o", "                      \" DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.301688, "o", "                      INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
