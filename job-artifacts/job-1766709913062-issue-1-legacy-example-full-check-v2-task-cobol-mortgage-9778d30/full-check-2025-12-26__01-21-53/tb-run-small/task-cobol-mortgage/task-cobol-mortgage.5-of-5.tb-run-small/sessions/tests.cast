[3.387013, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_fixed_format_constraints\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the code is written in fixed format\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        src = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/src/program.cbl\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m).read_text()\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m>>SOURCE FORMAT IS FIXED\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m src\u001b[90m\u001b[39;49;00m\r\n        longest = \u001b[96mmax\u001b[39;49;00m(\u001b[96mlen\u001b[39;49;00m(line.rstrip(\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)) \u001b[94mfor\u001b[39;49;00m line \u001b[95min\u001b[39;49;00m src.splitlines())\u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m longest <= \u001b[94m80\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       assert 82 <= 80\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:20: AssertionError\r\n"]
