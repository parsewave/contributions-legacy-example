[83.523159, "o", "   88 NOT-EOF VALUE \"N\".\r\n\u001b[?2004l\r"]
[83.523175, "o", "\u001b[?2004h> "]
[83.523302, "o", "01 WS-ID PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.523464, "o", "01 WS-NAME PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.523605, "o", "01 WS-LOAN-AMOUNT PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> 01 WS-PROP-VALUE PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52372, "o", "01 WS-DOWN-PAYMENT PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.523742, "o", "01 WS-TERM PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.523825, "o", "01 WS-RATE PIC 9(3)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52393, "o", "01 WS-MIN-DOWN PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52403, "o", "01 WS-MONTHLY-RATE PIC 9(5)V9999.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.524051, "o", "01 WS-MONTHLY-PAYMENT PIC 9(10)V99."]
[83.52412, "o", "\r\n\u001b[?2004l\r"]
[83.524182, "o", "\u001b[?2004h> "]
[83.524272, "o", "01 WS-REMAIN-BAL PIC 9(12)V99.\r\n\u001b[?2004l\r"]
[83.524297, "o", "\u001b[?2004h> "]
[83.524414, "o", "01 WS-INTEREST PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.524492, "o", "01 WS-PRINCIPAL PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.524599, "o", "01 WS-MONTH-NUM PIC 9(3) VALUE ZEROS.\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.52462, "o", "> "]
[83.524694, "o", "01 WS-REASON PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.524775, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.524795, "o", "MAIN-PARA.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52487, "o", "    OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52494, "o", "    OPEN OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525011, "o", "    PERFORM UNTIL EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525129, "o", "        READ IN-FILE INTO IN-LINE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525199, "o", "            AT END SET EOF TO TRUE\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.525217, "o", "> "]
[83.52531, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52539, "o", "            PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525414, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525487, "o", "    END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525576, "o", "    CLOSE IN-FILE OUT-FILE\r\n\u001b[?2004l\r"]
[83.525595, "o", "\u001b[?2004h> "]
[83.525674, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525755, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525832, "o", "    UNSTRING IN-LINE DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.525985, "o", "        INTO WS-ID, WS-NAME, WS-LOAN-AMOUNT, WS-PROP-VALUE,\r\n\u001b[?2004l\r"]
[83.526004, "o", "\u001b[?2004h> "]
[83.526133, "o", "             WS-DOWN-PAYMENT, WS-TERM, WS-RATE\r\n\u001b[?2004l\r"]
[83.526151, "o", "\u001b[?2004h> "]
[83.526218, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.526239, "o", "> "]
[83.526482, "o", "    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.526598, "o", "    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.526732, "o", "        MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.526837, "o", "        STRING WS-ID, \"DENY \", WS-REASON INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.526922, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.527014, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>     ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.527122, "o", "        STRING WS-ID, \"APPRO\" INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.527142, "o", "> "]
[83.527227, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.527354, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.527446, "o", "        PERFORM CALCULATE-PAYMENT-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52747, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.527561, "o", "CALCULATE-PAYMENT-SCHEDULE.\r\n\u001b[?2004l\r"]
[83.52758, "o", "\u001b[?2004h> "]
[83.527737, "o", "    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52788, "o", "    COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.527901, "o", "> "]
[83.528041, "o", "        (1 - (1 + WS-MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\r\n\u001b[?2004l\r"]
[83.528061, "o", "\u001b[?2004h> "]
[83.528165, "o", "    MOVE WS-LOAN-AMOUNT TO WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.528186, "o", "> "]
[83.528293, "o", "    PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.52841, "o", "        UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.528558, "o", "        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.528757, "o", "        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.528865, "o", "        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.529031, "o", "        STRING WS-MONTH-NUM, \" \", WS-MONTHLY-PAYMENT, \" \",\r\n\u001b[?2004l\r"]
[83.529051, "o", "\u001b[?2004h> "]
[83.529191, "o", "               WS-INTEREST, \" \", WS-PRINCIPAL, \" \", WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.529306, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.529344, "o", "> "]
[83.529424, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.529512, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.529529, "o", "    END-PERFORM.\r\n\u001b[?2004l\r"]
[83.529539, "o", "\u001b[?2004h"]
[83.529633, "o", "> EOF\r\n\u001b[?2004l\r"]
