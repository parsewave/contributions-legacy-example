[2.923137, "i", "clear\r"]
[2.923409, "o", "clear\r\n\u001b[?2004l\r"]
[2.924796, "o", "\u001b[H\u001b[J\u001b[3J"]
[2.925007, "m", "Episode 0: 4 commands"]
[2.925007, "o", "\u001b[?2004hroot@77b4cbbd22ab:/app# "]
[33.836973, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. PROGRAM.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT IN-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD IN-FILE.\n01 IN-REC.\n   05 IN-LINE PIC X(200).\nFD OUT-FILE.\n01 OUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01 WS-EOF PIC X VALUE \"N\".\n   88 EOF VALUE \"Y\".\n   88 NOT-EOF VALUE \"N\".\n01 WS-FIELDS.\n   05 WS-ID PIC X(10).\n   05 WS-NAME PIC X(30).\n   05 WS-LOAN-AMOUNT PIC 9(10)V99.\n   05 WS-PROP-VALUE PIC 9(10)V99.\n   05 WS-DOWN-PAYMENT PIC 9(10)V99.\n   05 WS-TERM PIC 9(2).\n   05 WS-RATE PIC 9(3)V99.\n01 WS-MIN-DOWN PIC 9(10)V99.\n01 WS-MONTHLY-RATE PIC 9(5)V9999.\n01 WS-MONTHLY-PAYMENT PIC 9(10)V99.\n01 WS-REMAIN-BAL PIC 9(12)V99.\n01 WS-INTEREST PIC 9(10)V99.\n01 WS-PRINCIPAL PIC 9(10)V99.\n01 WS-MONTH-NUM PIC 9(3) VALUE ZEROS.\n01 WS-REASON PIC X(50).\nPROCEDURE DIVISION."]
[33.837207, "i", "\nMAIN-PARA.\n    OPEN INPUT IN-FILE\n    OPEN OUTPUT OUT-FILE\n    PERFORM UNTIL EOF\n        READ IN-FILE INTO IN-LINE\n            AT END SET EOF TO TRUE\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE IN-FILE OUT-FILE\n    STOP RUN.\nPROCESS-RECORD.\n    UNSTRING IN-LINE DELIMITED BY ';'\n        INTO WS-ID\n             WS-NAME\n             WS-LOAN-AMOUNT\n             WS-PROP-VALUE\n             WS-DOWN-PAYMENT\n             WS-TERM\n             WS-RATE\n    END-UNSTRING\n    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n        MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n        STRING WS-ID DELIMITED BY SIZE\n               \"DENY \" DELIMITED BY SIZE\n               WS-REASON DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    ELSE\n        STRING WS-ID DELIMITED BY SIZE\n               \"APPRO\" DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n  "]
[33.837492, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.837539, "i", "      PERFORM CALCULATE-PAYMENT-SCHEDULE\n    END-IF.\nCALCULATE-PAYMENT-SCHEDULE.\n    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n    COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\n          (1 - (1 + WS-MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\n    MOVE WS-LOAN-AMOUNT TO WS-REMAIN-BAL\n    PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\n        UNTIL WS-MONTH-NUM > WS-TERM\n        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\n        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\n        STRING WS-MONTH-NUM DELIMITED BY SIZE\n               \" \" DELIMITED BY SIZE\n               WS-MONTHLY-PAYMENT DELIMITED BY SIZE\n               \" \" DELIMITED BY SIZE\n               WS-INTEREST DELIMITED BY SIZE\n               \" \" DELIMITED BY SIZE\n               WS-PRINCIPAL DELIMITED BY SIZE\n               \" \" DELIMITED BY SIZE\n               WS-REMAIN-BAL DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OU"]
[33.837645, "o", "PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.837685, "i", "T-REC\n    END-PERFORM.\nEOF\n"]
[33.837731, "o", "FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT IN-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.837878, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.837911, "o", "    SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.837983, "o", "> "]
[33.838083, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838158, "o", "FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> FD IN-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838228, "o", "01 IN-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838316, "o", "   05 IN-LINE PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838342, "o", "FD OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838418, "o", "01 OUT-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838474, "o", "WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838572, "o", "01 WS-EOF PIC X VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.83869, "o", "   88 EOF VALUE \"Y\".\r\n\u001b[?2004l\r\u001b[?2004h>    88 NOT-EOF VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838789, "o", "01 WS-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h>    05 WS-ID PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838859, "o", "   05 WS-NAME PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.838964, "o", "   05 WS-LOAN-AMOUNT PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839089, "o", "   05 WS-PROP-VALUE PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839211, "o", "   05 WS-DOWN-PAYMENT PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839349, "o", "   05 WS-TERM PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839457, "o", "   05 WS-RATE PIC 9(3)V99.\r\n\u001b[?2004l\r\u001b[?2004h> 01 WS-MIN-DOWN PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.839564, "o", "> "]
[33.83961, "o", "01 WS-MONTHLY-RATE PIC 9(5)V9999.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839658, "o", "01 WS-MONTHLY-PAYMENT PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839719, "o", "01 WS-REMAIN-BAL PIC 9(12)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839808, "o", "01 WS-INTEREST PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839871, "o", "01 WS-PRINCIPAL PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.839995, "o", "01 WS-MONTH-NUM PIC 9(3) VALUE ZEROS.\r\n\u001b[?2004l\r\u001b[?2004h> 01 WS-REASON PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.840039, "o", "> "]
[33.840092, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> MAIN-PARA.\r\n\u001b[?2004l\r"]
[33.840139, "o", "\u001b[?2004h> "]
[33.840192, "o", "    OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840239, "o", "    OPEN OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840338, "o", "    PERFORM UNTIL EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840441, "o", "        READ IN-FILE INTO IN-LINE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840521, "o", "            AT END SET EOF TO TRUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840595, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840686, "o", "            PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840734, "o", "        END-READ\r\n\u001b[?2004l\r"]
[33.840775, "o", "\u001b[?2004h> "]
[33.840821, "o", "    END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840866, "o", "    CLOSE IN-FILE OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.840911, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.84097, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841054, "o", "    UNSTRING IN-LINE DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841122, "o", "        INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841168, "o", "             WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.84124, "o", "             WS-LOAN-AMOUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841347, "o", "             WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841424, "o", "             WS-DOWN-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841511, "o", "             WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841547, "o", "             WS-RATE\r\n\u001b[?2004l\r"]
[33.841591, "o", "\u001b[?2004h> "]
[33.841637, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841747, "o", "    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841844, "o", "    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.841992, "o", "        MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842091, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842195, "o", "               \"DENY \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.84232, "o", "               WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842407, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842478, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842531, "o", "        WRITE OUT-REC\r\n"]
[33.842588, "o", "\u001b[?2004l\r\u001b[?2004h>     ELSE\r\n\u001b[?2004l\r"]
[33.842632, "o", "\u001b[?2004h> "]
[33.842683, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842777, "o", "               \"APPRO\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842858, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.842945, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843007, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843091, "o", "        PERFORM CALCULATE-PAYMENT-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843134, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.843174, "o", "> "]
[33.84322, "o", "CALCULATE-PAYMENT-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843349, "o", "    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843512, "o", "    COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.84364, "o", "          (1 - (1 + WS-MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843747, "o", "    MOVE WS-LOAN-AMOUNT TO WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843842, "o", "    PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.843937, "o", "        UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.8441, "o", "        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844289, "o", "        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844422, "o", "        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844545, "o", "        STRING WS-MONTH-NUM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844619, "o", "               \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844769, "o", "               WS-MONTHLY-PAYMENT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844871, "o", "               \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.844994, "o", "               WS-INTEREST DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845091, "o", "               \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.84519, "o", "               WS-PRINCIPAL DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845312, "o", "               \" \" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845427, "o", "               WS-REMAIN-BAL DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845511, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845598, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845638, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845701, "o", "    END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.845747, "o", "EOF\r\n\u001b[?2004l\r"]
