[40.854797, "o", "\u001b[?2004hroot@77b4cbbd22ab:/app# "]
[83.520751, "i", "cat > /app/src/program.cbl <<'EOF'\n>>SOURCE FORMAT IS FREE\nIDENTIFICATION DIVISION.\nPROGRAM-ID. PROGRAM.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT IN-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD IN-FILE.\n01 IN-REC.\n   05 IN-LINE PIC X(200).\nFD OUT-FILE.\n01 OUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01 WS-EOF PIC X VALUE \"N\".\n   88 EOF VALUE \"Y\".\n   88 NOT-EOF VALUE \"N\".\n01 WS-ID PIC X(10).\n01 WS-NAME PIC X(30).\n01 WS-LOAN-AMOUNT PIC 9(10)V99.\n01 WS-PROP-VALUE PIC 9(10)V99.\n01 WS-DOWN-PAYMENT PIC 9(10)V99.\n01 WS-TERM PIC 9(2).\n01 WS-RATE PIC 9(3)V99.\n01 WS-MIN-DOWN PIC 9(10)V99.\n01 WS-MONTHLY-RATE PIC 9(5)V9999.\n01 WS-MONTHLY-PAYMENT PIC 9(10)V99.\n01 WS-REMAIN-BAL PIC 9(12)V99.\n01 WS-INTEREST PIC 9(10)V99.\n01 WS-PRINCIPAL PIC 9(10)V99.\n01 WS-MONTH-NUM PIC 9(3) VALUE ZEROS.\n01 WS-REASON PIC X(50).\nPROCEDURE DIVISION.\nMAIN-PARA."]
[83.520805, "i", "\n    OPEN INPUT IN-FILE\n    OPEN OUTPUT OUT-FILE\n    PERFORM UNTIL EOF\n        READ IN-FILE INTO IN-LINE\n            AT END SET EOF TO TRUE\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE IN-FILE OUT-FILE\n    STOP RUN.\nPROCESS-RECORD.\n    UNSTRING IN-LINE DELIMITED BY ';'\n        INTO WS-ID, WS-NAME, WS-LOAN-AMOUNT, WS-PROP-VALUE,\n             WS-DOWN-PAYMENT, WS-TERM, WS-RATE\n    END-UNSTRING\n    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n        MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n        STRING WS-ID, \"DENY \", WS-REASON INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    ELSE\n        STRING WS-ID, \"APPRO\" INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n        PERFORM CALCULATE-PAYMENT-SCHEDULE\n    END-IF.\nCALCULATE-PAYMENT-SCHEDULE.\n    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n    COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\n        (1 - (1 + WS-MONTHLY-R"]
[83.521029, "i", "ATE) ** (- WS-TERM)) ROUNDED\n    MOVE WS-LOAN-AMOUNT TO WS-REMAIN-BAL\n    PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\n        UNTIL WS-MONTH-NUM > WS-TERM\n        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\n        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\n        STRING WS-MONTH-NUM, \" \", WS-MONTHLY-PAYMENT, \" \",\n               WS-INTEREST, \" \", WS-PRINCIPAL, \" \", WS-REMAIN-BAL\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    END-PERFORM.\nEOF\n"]
[83.521113, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.521152, "o", ">>SOURCE FORMAT IS FREE\r\n\u001b[?2004l\r"]
[83.521284, "o", "\u001b[?2004h> "]
[83.521395, "o", "IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.521485, "o", "PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.521559, "o", "ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
