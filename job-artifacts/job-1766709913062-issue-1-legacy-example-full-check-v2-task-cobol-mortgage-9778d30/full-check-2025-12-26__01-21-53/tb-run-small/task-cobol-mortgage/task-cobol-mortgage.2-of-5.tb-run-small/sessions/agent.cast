[83.522508, "o", "FD IN-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> 01 IN-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.522568, "o", "   05 IN-LINE PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.522622, "o", "FD OUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
