[63.977637, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. MORTGAGE.\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n       DATA DIVISION.\n       FILE SECTION.\n       FD INFILE.\n       01 IN-REC PIC X(200).\n       FD OUTFILE.\n       01 OUT-REC PIC X(200).\n       WORKING-STORAGE SECTION.\n       01 WS-EOF            PIC X VALUE \"N\".\n          88 END-OF-FILE    VALUE \"Y\".\n       01 WS-ID            PIC X(10).\n       01 WS-NAME          PIC X(30).\n       01 WS-LOAN-AMT      PIC 9(10).\n       01 WS-PROP-VALUE    PIC 9(10).\n       01 WS-DOWN-PMT      PIC 9(10).\n       01 WS-TERM          PIC 9(2).\n       01 WS-RATE          PIC 9(3)V9(2).\n       01 MIN-DOWN         PIC 9(10).\n       01 MONTHLY-RATE     COMP-2.\n       01 MONTHLY-PMT      COMP-2.\n      "]
[63.977845, "i", " 01 INTEREST         COMP-2.\n       01 PRINCIPAL        COMP-2.\n       01 BALANCE          COMP-2.\n       01 MON-NUMBER       PIC 9(3)   VALUE ZEROS.\n       01 WS-MON-OUT       PIC 9(3)   VALUE ZEROS.\n       01 WS-PAY-OUT       PIC 9(8).99 VALUE ZEROS.\n       01 WS-INT-OUT       PIC 9(8).99 VALUE ZEROS.\n       01 WS-PRIN-OUT      PIC 9(8).99 VALUE ZEROS.\n       01 WS-BAL-OUT       PIC 9(10).99 VALUE ZEROS.\n       01 TMP-STR          PIC X(200).\n       PROCEDURE DIVISION.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n           PERFORM UNTIL END-OF-FILE\n               READ INFILE INTO IN-REC\n                   AT END MOVE \"Y\" TO WS-EOF\n               NOT AT END\n                   PERFORM PROCESS-RECORD\n               END-READ\n           END-PERFORM\n           CLOSE INFILE OUTFILE\n           STOP RUN.\n       PROCESS-RECORD.\n           MOVE IN-REC TO TMP-STR\n           UNSTRING TMP-STR\n               DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-"]
[63.977986, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[63.978123, "i", "AMT\n                    WS-PROP-VALUE\n                    WS-DOWN-PMT\n                    WS-TERM\n                    WS-RATE\n           END-UNSTRING\n           COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n           IF WS-DOWN-PMT < MIN-DOWN\n               MOVE WS-ID TO OUT-REC(1:10)\n               STRING \"DENY\" \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n                   INTO OUT-REC(11:)\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE WS-ID TO OUT-REC(1:10)\n               STRING \"APPRO\" INTO OUT-REC(11:)\n               END-STRING\n               WRITE OUT-REC\n               COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n               COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE /\n                       (1 - (1 + MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\n               MOVE WS-LOAN-AMT TO BALANCE\n               PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\n                   COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\n                   COM"]
[63.978219, "o", "\u001b[?2004h>        IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID. MORTGAGE.\r\n\u001b[?2004l\r"]
[63.978262, "i", "PUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\n                   SUBTRACT PRINCIPAL FROM BALANCE ROUNDED\n                   MOVE MON-NUMBER TO WS-MON-OUT\n                   MOVE MONTHLY-PMT TO WS-PAY-OUT\n                   MOVE INTEREST TO WS-INT-OUT\n                   MOVE PRINCIPAL TO WS-PRIN-OUT\n                   MOVE BALANCE TO WS-BAL-OUT\n                   STRING WS-MON-OUT \" \"\n                          WS-PAY-OUT \" \"\n                          WS-INT-OUT \" \"\n                          WS-PRIN-OUT \" \"\n                          WS-BAL-OUT INTO OUT-REC\n                   END-STRING\n                   WRITE OUT-REC\n               END-PERFORM\n           END-IF.\nEOF\n"]
[63.978347, "o", "\u001b[?2004h>        ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r"]
[63.9784, "o", "PUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n                   SUBTRACT PRINCIPAL FROM BALANCE ROUNDED\r\n                   MOVE MON-NUMBER TO WS-MON-OUT\r\n                   MOVE MONTHLY-PMT TO WS-PAY-OUT\r\n                   MOVE INTEREST TO WS-INT-OUT\r\n                   MOVE PRINCIPAL TO WS-PRIN-OUT\r\n                   MOVE BALANCE TO WS-BAL-OUT\r\n                   STRING WS-MON-OUT \" \"\r\n                          WS-PAY-OUT \" \"\r\n                          WS-INT-OUT \" \"\r\n                          WS-PRIN-OUT \" \"\r\n                          WS-BAL-OUT INTO OUT-REC\r\n                   END-STRING\r\n                   WRITE OUT-REC\r\n               END-PERFORM\r\n           END-IF.\r\nEOF\r\n"]
