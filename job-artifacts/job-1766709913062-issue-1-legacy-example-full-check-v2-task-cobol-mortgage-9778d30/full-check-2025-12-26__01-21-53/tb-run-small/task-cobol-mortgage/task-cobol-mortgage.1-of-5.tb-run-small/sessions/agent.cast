[7.488533, "m", "Episode 1: 5 commands"]
[7.488533, "o", "\u001b[?2004hroot@7c360067301d:/app# "]
[40.787374, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. MORTGAGE.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD INFILE.\n01 IN-REC PIC X(200).\nFD OUTFILE.\n01 OUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01 WS-EOF PIC X VALUE \"N\".\n   88 END-OF-FILE VALUE \"Y\".\n01 WS-APP-REC.\n   05 WS-ID PIC X(10).\n   05 WS-NAME PIC X(30).\n   05 WS-LOAN-AMT PIC 9(10).\n   05 WS-PROP-VALUE PIC 9(10).\n   05 WS-DOWN-PMT PIC 9(10).\n   05 WS-TERM PIC 9(2).\n   05 WS-RATE PIC 9(3)V9(2).\n01 MIN-DOWN PIC 9(10).\n01 MONTHLY-RATE COMP-2.\n01 MONTHLY-PMT COMP-2.\n01 INTEREST COMP-2.\n01 PRINCIPAL COMP-2.\n01 BALANCE COMP-2.\n01 MON-NUMBER PIC 9(3) ZERO-FILL.\n01 WS-MON-OUT PIC 9(3) ZERO-FILL.\n01 WS-PAY-OUT PIC 9(8).99 ZERO-FILL.\n01 WS-INT-OUT PIC 9(8).99 ZERO-FILL.\n01 WS-PRIN-OUT PIC 9(8).99 ZERO-FILL.\n01 WS-BA"]
[40.787554, "i", "L-OUT PIC 9(10).99 ZERO-FILL.\n01 TMP-STR PIC X(200).\nPROCEDURE DIVISION.\n    OPEN INPUT INFILE\n    OPEN OUTPUT OUTFILE\n    PERFORM UNTIL END-OF-FILE\n        READ INFILE INTO IN-REC\n            AT END MOVE \"Y\" TO WS-EOF\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE INFILE OUTFILE\n    STOP RUN.\nPROCESS-RECORD.\n    MOVE IN-REC TO TMP-STR\n    UNSTRING TMP-STR\n        DELIMITED BY \";\"\n        INTO WS-ID\n             WS-NAME\n             WS-LOAN-AMT\n             WS-PROP-VALUE\n             WS-DOWN-PMT\n             WS-TERM\n             WS-RATE\n    END-UNSTRING\n    COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PMT < MIN-DOWN\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING \"DENY\" DELIMITED BY SIZE\n               \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n               INTO OUT-REC(11:)\n        END-STRING\n        WRITE OUT-REC\n    ELSE\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING \"APPRO\" INTO OUT-REC(11:)\n        END-STRING\n        WRITE OUT-REC\n "]
[40.787643, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[40.787742, "i", "       COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n        COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE /\n               (1 - (1 + MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\n        MOVE WS-LOAN-AMT TO BALANCE\n        PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\n            COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\n            COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\n            SUBTRACT PRINCIPAL FROM BALANCE ROUNDED\n            MOVE MON-NUMBER TO WS-MON-OUT\n            MOVE MONTHLY-PMT TO WS-PAY-OUT\n            MOVE INTEREST TO WS-INT-OUT\n            MOVE PRINCIPAL TO WS-PRIN-OUT\n            MOVE BALANCE TO WS-BAL-OUT\n            STRING WS-MON-OUT DELIMITED BY SIZE \" \"\n                   WS-PAY-OUT DELIMITED BY SIZE \" \"\n                   WS-INT-OUT DELIMITED BY SIZE \" \"\n                   WS-PRIN-OUT DELIMITED BY SIZE \" \"\n                   WS-BAL-OUT DELIMITED BY SIZE\n                   INTO OUT-REC\n            END-STRING\n            WRITE OUT-REC\n        END-PERFOR"]
[40.787821, "o", "\u001b[?2004h> IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> PROGRAM-ID. MORTGAGE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.787846, "i", "M\n    END-IF.\nEOF\n"]
[40.787997, "o", "ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788174, "o", "FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h>     SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788355, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788445, "o", "    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r"]
[40.788509, "o", "\u001b[?2004h> "]
[40.788645, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788677, "o", "FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> FD INFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788783, "o", "01 IN-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> FD OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.788882, "o", "01 OUT-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789024, "o", "WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789149, "o", "01 WS-EOF PIC X VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h>    88 END-OF-FILE VALUE \"Y\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.78919, "o", "01 WS-APP-REC.\r\n\u001b[?2004l\r\u001b[?2004h>    05 WS-ID PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789319, "o", "   05 WS-NAME PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789426, "o", "   05 WS-LOAN-AMT PIC 9(10).\r\n\u001b[?2004l\r"]
[40.789466, "o", "\u001b[?2004h>    05 WS-PROP-VALUE PIC 9(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789583, "o", "   05 WS-DOWN-PMT PIC 9(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789608, "o", "   05 WS-TERM PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789738, "o", "   05 WS-RATE PIC 9(3)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.78985, "o", "01 MIN-DOWN PIC 9(10).\r\n\u001b[?2004l\r\u001b[?2004h> 01 MONTHLY-RATE COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.789949, "o", "01 MONTHLY-PMT COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.78998, "o", "01 INTEREST COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790042, "o", "01 PRINCIPAL COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790114, "o", "01 BALANCE COMP-2.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790197, "o", "01 MON-NUMBER PIC 9(3) ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790349, "o", "01 WS-MON-OUT PIC 9(3) ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790444, "o", "01 WS-PAY-OUT PIC 9(8).99 ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790535, "o", "01 WS-INT-OUT PIC 9(8).99 ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790625, "o", "01 WS-PRIN-OUT PIC 9(8).99 ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790704, "o", "01 WS-BAL-OUT PIC 9(10).99 ZERO-FILL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790803, "o", "01 TMP-STR PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.79083, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.790903, "o", "    OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791, "o", "    OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791074, "o", "    PERFORM UNTIL END-OF-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791142, "o", "        READ INFILE INTO IN-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791229, "o", "            AT END MOVE \"Y\" TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.79135, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791379, "o", "            PERFORM PROCESS-RECORD\r\n"]
[40.79146, "o", "\u001b[?2004l\r"]
[40.791483, "o", "\u001b[?2004h> "]
[40.791569, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791603, "o", "    END-PERFORM\r\n\u001b[?2004l\r"]
[40.791697, "o", "\u001b[?2004h>     CLOSE INFILE OUTFILE\r\n\u001b[?2004l\r"]
[40.791733, "o", "\u001b[?2004h> "]
[40.791833, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791933, "o", "    MOVE IN-REC TO TMP-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.791972, "o", "    UNSTRING TMP-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792069, "o", "        DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h>         INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792161, "o", "             WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792191, "o", "             WS-LOAN-AMT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792274, "o", "             WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792399, "o", "             WS-DOWN-PMT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792424, "o", "             WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792504, "o", "             WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792589, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792667, "o", "    COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792754, "o", "    IF WS-DOWN-PMT < MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792843, "o", "        MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.792918, "o", "        STRING \"DENY\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.793023, "o", "               \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.793096, "o", "> "]
[40.79314, "o", "               INTO OUT-REC(11:)\r\n\u001b[?2004l\r"]
[40.793226, "o", "\u001b[?2004h> "]
[40.793332, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h>         WRITE OUT-REC\r\n\u001b[?2004l\r"]
[40.793362, "o", "\u001b[?2004h> "]
[40.793443, "o", "    ELSE\r\n\u001b[?2004l\r"]
[40.793483, "o", "\u001b[?2004h>         MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.793565, "o", "        STRING \"APPRO\" INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.793597, "o", "> "]
[40.793697, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h>         WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.793818, "o", "        COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.793937, "o", "        COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE /\r\n\u001b[?2004l\r"]
[40.794014, "o", "\u001b[?2004h> "]
[40.794095, "o", "               (1 - (1 + MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.79413, "o", "> "]
[40.794203, "o", "        MOVE WS-LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.794399, "o", "        PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.794523, "o", "            COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.794554, "o", "> "]
[40.794672, "o", "            COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.794782, "o", "            SUBTRACT PRINCIPAL FROM BALANCE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.794811, "o", "> "]
[40.794887, "o", "            MOVE MON-NUMBER TO WS-MON-OUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.79498, "o", "            MOVE MONTHLY-PMT TO WS-PAY-OUT\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.795011, "o", "> "]
[40.795101, "o", "            MOVE INTEREST TO WS-INT-OUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795191, "o", "            MOVE PRINCIPAL TO WS-PRIN-OUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795316, "o", "            MOVE BALANCE TO WS-BAL-OUT\r\n\u001b[?2004l\r"]
[40.795346, "o", "\u001b[?2004h> "]
[40.79545, "o", "            STRING WS-MON-OUT DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795569, "o", "                   WS-PAY-OUT DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795699, "o", "                   WS-INT-OUT DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795814, "o", "                   WS-PRIN-OUT DELIMITED BY SIZE \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.795919, "o", "                   WS-BAL-OUT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.796003, "o", "                   INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.7961, "o", "            END-STRING\r\n\u001b[?2004l\r\u001b[?2004h>             WRITE OUT-REC\r\n\u001b[?2004l\r"]
[40.796125, "o", "\u001b[?2004h> "]
[40.796201, "o", "        END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h>     END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.796222, "o", "EOF\r\n\u001b[?2004l\r"]
