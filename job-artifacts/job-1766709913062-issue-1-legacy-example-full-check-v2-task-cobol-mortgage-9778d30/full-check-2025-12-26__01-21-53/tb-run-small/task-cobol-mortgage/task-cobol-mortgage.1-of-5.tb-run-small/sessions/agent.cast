[63.984535, "o", "           STOP RUN.\r\n\u001b[?2004l\r"]
[63.984553, "o", "\u001b[?2004h> "]
[63.984647, "o", "       PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
