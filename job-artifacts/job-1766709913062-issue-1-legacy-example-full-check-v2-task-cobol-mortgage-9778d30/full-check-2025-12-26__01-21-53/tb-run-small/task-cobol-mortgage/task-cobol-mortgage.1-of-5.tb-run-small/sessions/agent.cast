[63.983107, "o", "       01 TMP-STR          PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.983207, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r"]
[63.983226, "o", "\u001b[?2004h> "]
[63.983353, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.983468, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r"]
[63.983488, "o", "\u001b[?2004h> "]
[63.983601, "o", "           PERFORM UNTIL END-OF-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.983729, "o", "               READ INFILE INTO IN-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.983867, "o", "                   AT END MOVE \"Y\" TO WS-EOF\r\n\u001b[?2004l\r"]
[63.983885, "o", "\u001b[?2004h> "]
[63.983968, "o", "               NOT AT END\r\n\u001b[?2004l\r"]
[63.983986, "o", "\u001b[?2004h> "]
