[63.989624, "o", "                   MOVE PRINCIPAL TO WS-PRIN-OUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.989764, "o", "                   MOVE BALANCE TO WS-BAL-OUT\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.989803, "o", "> "]
[63.989907, "o", "                   STRING WS-MON-OUT \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.990038, "o", "                          WS-PAY-OUT \" \"\r\n\u001b[?2004l\r"]
[63.990075, "o", "\u001b[?2004h> "]
[63.990183, "o", "                          WS-INT-OUT \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.990339, "o", "                          WS-PRIN-OUT \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.990491, "o", "                          WS-BAL-OUT INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.990603, "o", "                   END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
