[63.986063, "o", "\u001b[?2004h> "]
[63.986159, "o", "           IF WS-DOWN-PMT < MIN-DOWN\r\n\u001b[?2004l\r"]
[63.986196, "o", "\u001b[?2004h> "]
[63.98633, "o", "               MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r"]
[63.986377, "o", "\u001b[?2004h> "]
[63.986514, "o", "               STRING \"DENY\" \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.986637, "o", "                   INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.986655, "o", "> "]
[63.986745, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.986854, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r"]
[63.986871, "o", "\u001b[?2004h> "]
[63.986914, "o", "           ELSE\r\n\u001b[?2004l\r"]
[63.986965, "o", "\u001b[?2004h> "]
[63.987085, "o", "               MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.987231, "o", "               STRING \"APPRO\" INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.987344, "o", "               END-STRING\r\n\u001b[?2004l\r"]
[63.987398, "o", "\u001b[?2004h> "]
[63.987465, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.987504, "o", "> "]
[63.987654, "o", "               COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.987821, "o", "               COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.988009, "o", "                       (1 - (1 + MONTHLY-RATE) ** (- WS-TERM)) ROUNDED\r\n\u001b[?2004l\r"]
[63.988048, "o", "\u001b[?2004h> "]
[63.988158, "o", "               MOVE WS-LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.988395, "o", "               PERFORM VARYING MON-NUMBER FROM 1 BY 1 UNTIL MON-NUMBER > WS-TERM\r\n\u001b[?2004l\r"]
[63.988413, "o", "\u001b[?2004h> "]
[63.988595, "o", "                   COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r"]
[63.988613, "o", "\u001b[?2004h> "]
[63.988797, "o", "                   COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.988961, "o", "                   SUBTRACT PRINCIPAL FROM BALANCE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.989108, "o", "                   MOVE MON-NUMBER TO WS-MON-OUT\r\n\u001b[?2004l\r"]
