[57.030776, "o", "> "]
[57.030878, "o", "         UNTIL WS-MON-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031071, "o", "         COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031261, "o", "         COMPUTE WS-PRINCIPAL = WS-MONTHLY-PMT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031416, "o", "         SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031548, "o", "         MOVE WS-MON-NUM TO WS-MON-NUM-STR\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.031566, "o", "> "]
[57.031709, "o", "         MOVE WS-MONTHLY-PMT TO WS-PMT-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031835, "o", "         MOVE WS-INTEREST TO WS-INT-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.031964, "o", "         MOVE WS-PRINCIPAL TO WS-PRIN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.032117, "o", "         MOVE WS-REMAIN-BAL TO WS-BAL-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.032307, "o", "         STRING WS-MON-NUM-STR SPACE WS-PMT-STR SPACE WS-INT-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.032463, "o", "                SPACE WS-PRIN-STR SPACE WS-BAL-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.032579, "o", "                INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.032787, "o", "         WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>      END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
