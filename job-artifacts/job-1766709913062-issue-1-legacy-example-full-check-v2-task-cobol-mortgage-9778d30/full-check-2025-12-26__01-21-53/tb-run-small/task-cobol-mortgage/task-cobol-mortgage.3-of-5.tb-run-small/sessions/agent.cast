[2.931744, "i", "clear\r"]
[2.932036, "o", "clear\r\n\u001b[?2004l\r"]
[2.933306, "o", "\u001b[H\u001b[J\u001b[3J"]
[2.933539, "m", "Episode 0: 0 commands"]
[2.933539, "m", "Episode 1: 2 commands"]
[2.933539, "o", "\u001b[?2004hroot@fd18caf110c5:/app# "]
[26.724483, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. PROGRAM.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INFILE ASSIGN TO '/app/src/INPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTFILE ASSIGN TO '/app/data/OUTPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD INFILE.\n01 IN-REC PIC X(200).\nFD OUTFILE.\n01 OUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01 WS-EOF        PIC X VALUE 'N'.\n01 WS-DELIM      PIC X VALUE ';'.\n01 WS-ID         PIC X(10).\n01 WS-NAME       PIC X(30).\n01 WS-LOAN-AMT   PIC 9(10)V99.\n01 WS-PROP-VALUE PIC 9(10)V99.\n01 WS-DOWN-PAY   PIC 9(10)V99.\n01 WS-TERM       PIC 9(2) COMP.\n01 WS-RATE       PIC 9(3)V99.\n01 WS-MIN-DOWN   PIC 9(10)V99.\n01 WS-MONTHLY-RATE PIC S9(4)V9(6).\n01 WS-MONTHLY-PMT PIC 9(8)V99.\n01 WS-INTEREST   PIC 9(8)V99.\n01 WS-PRINCIPAL  PIC 9(8)V99.\n01 WS-REMAIN-BAL PIC 9(10)V99.\n01 WS-MON-NUM    PIC 9(3).\n01 WS-REASON     PIC X(50) VALUE\n   'INSUFFICIENT FUNDS FOR DOWN PAYMENT'.\nPROCEDURE D"]
[26.72472, "i", "IVISION.\nMAIN-LOGIC.\n    OPEN INPUT INFILE\n    OPEN OUTPUT OUTFILE\n    PERFORM UNTIL WS-EOF = 'Y'\n        READ INFILE AT END\n            MOVE 'Y' TO WS-EOF\n        NOT AT END\n            PERFORM SPLIT-RECORD\n            PERFORM PROCESS-APP\n        END-READ\n    END-PERFORM\n    CLOSE INFILE\n    CLOSE OUTFILE\n    STOP RUN.\nSPLIT-RECORD.\n    UNSTRING IN-REC DELIMITED BY WS-DELIM\n        INTO WS-ID, WS-NAME, WS-LOAN-AMT,\n             WS-PROP-VALUE, WS-DOWN-PAY,\n             WS-TERM, WS-RATE.\nPROCESS-APP.\n    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAY < WS-MIN-DOWN\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING 'DENY ' WS-REASON DELIMITED BY SIZE\n            INTO OUT-REC(11:)\n        WRITE OUTFILE FROM OUT-REC\n    ELSE\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING 'APPRO' DELIMITED BY SIZE\n            INTO OUT-REC(11:)\n        WRITE OUTFILE FROM OUT-REC\n        PERFORM CALCULATE-PAYMENT\n    END-IF.\nCALCULATE-PAYMENT.\n    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n    COMPUT"]
[26.724787, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.724807, "i", "E WS-MONTHLY-PMT =\n        WS-LOAN-AMT * WS-MONTHLY-RATE /\n        (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM))\n        ROUNDED\n    MOVE WS-LOAN-AMT TO WS-REMAIN-BAL\n    PERFORM VARYING WS-MON-NUM FROM 1 BY 1\n        UNTIL WS-MON-NUM > WS-TERM\n        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\n        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PMT - WS-INTEREST ROUNDED\n        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\n        MOVE WS-MON-NUM TO OUT-REC(1:3)\n        STRING\n          FUNCTION NUMVAL-C (WS-MONTHLY-PMT) DELIMITED BY SIZE\n          ' ' FUNCTION NUMVAL-C (WS-INTEREST) DELIMITED BY SIZE\n          ' ' FUNCTION NUMVAL-C (WS-PRINCIPAL) DELIMITED BY SIZE\n          ' ' FUNCTION NUMVAL-C (WS-REMAIN-BAL) DELIMITED BY SIZE\n          INTO OUT-REC(4:)\n        WRITE OUTFILE FROM OUT-REC\n    END-PERFORM.\nEOF\n"]
[26.72499, "o", "IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
