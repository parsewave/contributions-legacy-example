[27.244027, "o", "\u001b[?2004hroot@fd18caf110c5:/app# "]
[57.021249, "i", "cat > /app/src/program.cbl <<'EOF'\n IDENTIFICATION DIVISION.\n PROGRAM-ID. PROGRAM.\n ENVIRONMENT DIVISION.\n INPUT-OUTPUT SECTION.\n FILE-CONTROL.\n     SELECT INFILE ASSIGN TO '/app/src/INPUT.DAT'\n         ORGANIZATION IS LINE SEQUENTIAL.\n     SELECT OUTFILE ASSIGN TO '/app/data/OUTPUT.DAT'\n         ORGANIZATION IS LINE SEQUENTIAL.\n DATA DIVISION.\n FILE SECTION.\n FD INFILE.\n 01 IN-REC PIC X(200).\n FD OUTFILE.\n 01 OUT-REC PIC X(200).\n WORKING-STORAGE SECTION.\n 01 WS-EOF        PIC X VALUE 'N'.\n 01 WS-DELIM      PIC X VALUE ';'.\n 01 WS-ID         PIC X(10).\n 01 WS-NAME       PIC X(30).\n 01 WS-LOAN-AMT   PIC 9(10)V99.\n 01 WS-PROP-VALUE PIC 9(10)V99.\n 01 WS-DOWN-PAY   PIC 9(10)V99.\n 01 WS-TERM       PIC 9(2) COMP.\n 01 WS-RATE       PIC 9(3)V99.\n 01 WS-MIN-DOWN   PIC 9(10)V99.\n 01 WS-MONTHLY-RATE PIC S9(4)V9(6).\n 01 WS-MONTHLY-PMT PIC 9(8)V99.\n 01 WS-INTEREST   PIC 9(8)V99.\n 01 WS-PRINCIPAL  PIC 9(8)V99.\n 01 WS-REMAIN-BAL PIC 9(10)V99.\n 01 WS-MON-NUM    PIC 9(3).\n 01 WS-REASON     PIC X(50) VALUE\n    'INSUFFICIENT FU"]
[57.021298, "i", "NDS FOR DOWN PAYMENT'.\n 01 WS-MON-NUM-STR    PIC X(3).\n 01 WS-PMT-STR        PIC X(12).\n 01 WS-INT-STR        PIC X(12).\n 01 WS-PRIN-STR       PIC X(12).\n 01 WS-BAL-STR        PIC X(12).\n PROCEDURE DIVISION.\n MAIN-LOGIC.\n     OPEN INPUT INFILE\n     OPEN OUTPUT OUTFILE\n     PERFORM UNTIL WS-EOF = 'Y'\n         READ INFILE AT END\n             MOVE 'Y' TO WS-EOF\n         NOT AT END\n             PERFORM SPLIT-REC\n             PERFORM PROCESS-APP\n         END-READ\n     END-PERFORM\n     CLOSE INFILE\n     CLOSE OUTFILE\n     STOP RUN.\n SPLIT-REC.\n     UNSTRING IN-REC DELIMITED BY WS-DELIM\n         INTO WS-ID, WS-NAME, WS-LOAN-AMT,\n              WS-PROP-VALUE, WS-DOWN-PAY,\n              WS-TERM, WS-RATE.\n PROCESS-APP.\n     COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n     IF WS-DOWN-PAY < WS-MIN-DOWN\n         MOVE WS-ID TO OUT-REC(1:10)\n         STRING 'DENY ' WS-REASON DELIMITED BY SIZE\n             INTO OUT-REC(11:)\n         WRITE OUTFILE FROM OUT-REC\n     ELSE\n         MOVE WS-ID TO OUT-REC(1:10)\n         STRI"]
[57.02146, "i", "NG 'APPRO' DELIMITED BY SIZE\n             INTO OUT-REC(11:)\n         WRITE OUTFILE FROM OUT-REC\n         PERFORM CALCULATE-PAYMENT\n     END-IF.\n CALCULATE-PAYMENT.\n     COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n     COMPUTE WS-MONTHLY-PMT =\n         WS-LOAN-AMT * WS-MONTHLY-RATE /\n         (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM))\n         ROUNDED\n     MOVE WS-LOAN-AMT TO WS-REMAIN-BAL\n     PERFORM VARYING WS-MON-NUM FROM 1 BY 1\n         UNTIL WS-MON-NUM > WS-TERM\n         COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\n         COMPUTE WS-PRINCIPAL = WS-MONTHLY-PMT - WS-INTEREST ROUNDED\n         SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\n         MOVE WS-MON-NUM TO WS-MON-NUM-STR\n         MOVE WS-MONTHLY-PMT TO WS-PMT-STR\n         MOVE WS-INTEREST TO WS-INT-STR\n         MOVE WS-PRINCIPAL TO WS-PRIN-STR\n         MOVE WS-REMAIN-BAL TO WS-BAL-STR\n         STRING WS-MON-NUM-STR SPACE WS-PMT-STR SPACE WS-INT-STR\n                SPACE WS-PRIN-STR SPACE WS-BAL-STR\n                INTO OUT-REC\n   "]
[57.021487, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[57.021502, "i", "      WRITE OUTFILE FROM OUT-REC\n     END-PERFORM.\n EOF\n"]
[57.021602, "o", "NG 'APPRO' DELIMITED BY SIZE\r\n             INTO OUT-REC(11:)\r\n         WRITE OUTFILE FROM OUT-REC\r\n         PERFORM CALCULATE-PAYMENT\r\n     END-IF.\r\n CALCULATE-PAYMENT.\r\n     COMPUTE WS-MONTHLY-RATE = W"]
[57.021725, "o", "S-RATE / 1200 ROUNDED\r\n     COMPUTE WS-MONTHLY-PMT =\r\n         WS-LOAN-AMT * WS-MONTHLY-RATE /\r\n         (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM))\r\n         ROUNDED\r\n     MOVE WS-LOAN-AMT TO WS-REMAIN-BAL\r\n     PERFORM VARYING WS-MON-NUM FROM 1 BY 1\r\n         UNTIL WS-MON-NUM > WS-TERM\r\n         COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\r\n         COMPUTE WS-PRINCIPAL = WS-MONTHLY-PMT - WS-INTEREST ROUNDED\r\n         SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\r\n         MOVE WS-MON-NUM TO WS-MON-NUM-STR\r\n         MOVE WS-"]
[57.021807, "o", "MONTHLY-PMT TO WS-PMT-STR\r\n         MOVE WS-INTEREST TO WS-INT-STR\r\n         MOVE WS-PRINCIPAL TO WS-PRIN-STR\r\n         MOVE WS-REMAIN-BAL TO WS-BAL-STR\r\n         STRING WS-MON-NUM-STR SPACE WS-PMT-STR SPACE WS-INT-STR\r\n                SPACE WS-PRIN-STR SPACE WS-BAL-STR\r\n                INTO OUT-REC\r\n         WRITE OUTFILE FROM OUT-REC\r\n     END-PERFORM.\r\n EOF\r\n"]
