[57.029111, "o", "\u001b[?2004h> "]
[57.029159, "o", "         MOVE WS-ID TO OUT-REC(1:10)"]
[57.029205, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.029306, "o", "         STRING 'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.029403, "o", "             INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.029422, "o", "> "]
