[57.030008, "o", "     COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.030102, "o", "     COMPUTE WS-MONTHLY-PMT =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.030232, "o", "         WS-LOAN-AMT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.030387, "o", "         (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.030468, "o", "         ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
