[26.726591, "o", "\u001b[?2004h> "]
[26.726734, "o", "01 WS-DOWN-PAY   PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726817, "o", "01 WS-TERM       PIC 9(2) COMP.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726839, "o", "01 WS-RATE       PIC 9(3)V99.\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.726917, "o", "> 01 WS-MIN-DOWN   PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.726975, "o", "> "]
[26.727053, "o", "01 WS-MONTHLY-RATE PIC S9(4)V9(6).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727163, "o", "01 WS-MONTHLY-PMT PIC 9(8)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727254, "o", "01 WS-INTEREST   PIC 9(8)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72731, "o", "01 WS-PRINCIPAL  PIC 9(8)V99.\r\n\u001b[?2004l\r"]
[26.727365, "o", "\u001b[?2004h> "]
[26.727431, "o", "01 WS-REMAIN-BAL PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72748, "o", "01 WS-MON-NUM    PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727516, "o", "01 WS-REASON     PIC X(50) VALUE\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.727562, "o", "> "]
[26.72763, "o", "   'INSUFFICIENT FUNDS FOR DOWN PAYMENT'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727759, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> MAIN-LOGIC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727863, "o", "    OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727889, "o", "    OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727961, "o", "    PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728015, "o", "        READ INFILE AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728072, "o", "            MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728117, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.728189, "o", "> "]
[26.728265, "o", "            PERFORM SPLIT-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728287, "o", "            PERFORM PROCESS-APP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728353, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728415, "o", "    END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728434, "o", "    CLOSE INFILE\r\n\u001b[?2004l\r"]
[26.728471, "o", "\u001b[?2004h> "]
[26.728523, "o", "    CLOSE OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728564, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728671, "o", "SPLIT-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728745, "o", "    UNSTRING IN-REC DELIMITED BY WS-DELIM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728849, "o", "        INTO WS-ID, WS-NAME, WS-LOAN-AMT,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728947, "o", "             WS-PROP-VALUE, WS-DOWN-PAY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.729063, "o", "             WS-TERM, WS-RATE.\r\n\u001b[?2004l\r"]
[26.729125, "o", "\u001b[?2004h> "]
[26.729196, "o", "PROCESS-APP.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.729267, "o", "    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.729341, "o", "> "]
[26.729428, "o", "    IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r"]
[26.729475, "o", "\u001b[?2004h> "]
[26.729546, "o", "        MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.729663, "o", "        STRING 'DENY ' WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.729757, "o", "            INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.729775, "o", "> "]
[26.729841, "o", "        WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.729854, "o", "> "]
[26.729936, "o", "    ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730007, "o", "        MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.73008, "o", "        STRING 'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730179, "o", "            INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730229, "o", "        WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.730271, "o", "> "]
[26.730332, "o", "        PERFORM CALCULATE-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730401, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.73045, "o", "CALCULATE-PAYMENT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730579, "o", "    COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730698, "o", "    COMPUTE WS-MONTHLY-PMT =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730804, "o", "        WS-LOAN-AMT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.730921, "o", "        (1 - (1 + WS-MONTHLY-RATE) ** (-WS-TERM))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731023, "o", "        ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.73105, "o", "    MOVE WS-LOAN-AMT TO WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731147, "o", "    PERFORM VARYING WS-MON-NUM FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731238, "o", "        UNTIL WS-MON-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731411, "o", "        COMPUTE WS-INTEREST = WS-REMAIN-BAL * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731557, "o", "        COMPUTE WS-PRINCIPAL = WS-MONTHLY-PMT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731722, "o", "        SUBTRACT WS-PRINCIPAL FROM WS-REMAIN-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731819, "o", "        MOVE WS-MON-NUM TO OUT-REC(1:3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.731894, "o", "        STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732027, "o", "          FUNCTION NUMVAL-C (WS-MONTHLY-PMT) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732135, "o", "          ' ' FUNCTION NUMVAL-C (WS-INTEREST) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732257, "o", "          ' ' FUNCTION NUMVAL-C (WS-PRINCIPAL) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732405, "o", "          ' ' FUNCTION NUMVAL-C (WS-REMAIN-BAL) DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732482, "o", "          INTO OUT-REC(4:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.732571, "o", "        WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.7327, "o", "    END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
