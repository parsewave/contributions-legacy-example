                  IF WS-LEN > 0\n                       MOVE INPUT-RECORD(WS-START:WS-LEN)\n                           TO WS-TEMP-FIELD\n                       PERFORM ASSIGN-FIELD\n                   END-IF\n                   ADD 1 TO WS-FIELD-NUM\n                   COMPUTE WS-START = WS-PTR + 1\n               END-IF\n           END-PERFORM.\n\n           MOVE INPUT-RECORD(WS-START:5) TO WS-TEMP-FIELD.\n           MOVE 7 TO WS-FIELD-NUM.\n           PERFORM ASSIGN-FIELD.\n\n       ASSIGN-FIELD.\n           EVALUATE WS-FIELD-NUM\n               WHEN 1\n                   MOVE WS-TEMP-FIELD(1:10) TO WS-ID\n               WHEN 2\n                   MOVE WS-TEMP-FIELD(1:30) TO WS-NAME\n               WHEN 3\n                   MOVE WS-TEMP-FIELD(1:10) TO WS-LOAN-AMOUNT\n               WHEN 4\n                   MOVE WS-TEMP-FIELD(1:10) TO WS-PROPERTY-VALUE\n               WHEN 5\n                   MOVE WS-TEMP-FIELD(1:10) TO WS-DOWN-PAYMENT\n               WHEN 6\n                   MOVE WS-TEMP-FIELD(1:2) TO WS-TERM\n               WHEN 7\n                   MOVE WS-TEMP-FIELD(1:5) TO WS-RATE\n           END-EVALUATE.\n\n       VALIDATE-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED =\n               WS-PROPERTY-VALUE * 0.15.\n\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n               PERFORM WRITE-DENIAL\n           ELSE\n               PERFORM CALCULATE-AND-WRITE-SCHEDULE\n           END-IF.\n\n       WRITE-DENIAL.\n           INITIALIZE WS-OUTPUT-DENY.\n           MOVE WS-ID TO WS-OUT-ID-D.\n           MOVE \"DENY \" TO WS-OUT-STATUS-D.\n           MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-OUT-REASON.\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-DENY.\n\n       CALCULATE-AND-WRITE-SCHEDULE.\n           MOVE WS-LOAN-AMOUNT TO WS-LOAN-NUM.\n           COMPUTE WS-TERM-MONTHS = WS-TERM * 12.\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200.\n\n           COMPUTE WS-TEMP1 ROUNDED = 1 + WS-MONTHLY-RATE.\n           COMPUTE WS-TEMP2 ROUNDED =\n               WS-TEMP1 ** (0 - WS-TERM-MONTHS).\n           COMPUTE WS-TEMP3 ROUNDED = 1 - WS-TEMP2.\n           COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n               WS-LOAN-NUM * WS-MONTHLY-RATE / WS-TEMP3.\n\n           INITIALIZE WS-OUTPUT-APPRO.\n           MOVE WS-ID TO WS-OUT-ID-A.\n           MOVE \"APPRO\" TO WS-OUT-STATUS-A.\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPRO.\n\n           MOVE WS-LOAN-NUM TO WS-REMAINING-BALANCE.\n\n           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\n                   UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\n               COMPUTE WS-INTEREST-PART ROUNDED =\n                   WS-REMAINING-BALANCE * WS-MONTHLY-RATE\n               COMPUTE WS-PRINCIPAL-PART ROUNDED =\n                   WS-MONTHLY-PAYMENT - WS-INTEREST-PART\n               COMPUTE WS-REMAINING-BALANCE ROUNDED =\n                   WS-REMAINING-BALANCE - WS-PRINCIPAL-PART\n               IF WS-REMAINING-BALANCE < 0\n                   MOVE 0 TO WS-REMAINING-BALANCE\n               END-IF\n               PERFORM WRITE-SCHEDULE-LINE\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           INITIALIZE WS-OUTPUT-SCHEDULE.\n           MOVE WS-MONTH-CTR TO WS-SCHED-MONTH.\n           MOVE WS-MONTHLY-PAYMENT TO WS-SCHED-PAYMENT.\n           MOVE WS-INTEREST-PART TO WS-SCHED-INTEREST.\n           MOVE WS-PRINCIPAL-PART TO WS-SCHED-PRINCIPAL.\n           MOVE WS-REMAINING-BALANCE TO WS-SCHED-BALANCE.\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\n","numLines":201,"startLine":1,"totalLines":201}}}
