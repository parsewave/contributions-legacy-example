[172.006669, "o", "T             PIC 9(10).\\n           05  WS-TERM                     PIC 9(2).\\n           05  WS-RATE                     PIC 9(3)V9(2).\\n       01  WS-DELIM                        PIC X VALUE \\\";\\\".\\n       01  WS-PTR                          PIC 9(3).\\n       01  WS-MONTHLY-RATE                 PIC 9V9(10).\\n       01  WS-TERM-MONTHS                  PIC 9(4).\\n\\n       PROCEDURE DIVISION.\\n           OPEN INPUT INPUT-FILE.\\n           PERFORM UNTIL WS-EOF = 1\\n               READ INPUT-FILE INTO INPUT-RECORD\\n                   AT END MOVE 1 TO WS-EOF\\n                   NOT AT END\\n                       INITIALIZE WS-INPUT-FIELDS\\n                       MOVE 1 TO WS-PTR\\n                       UNSTRING INPUT-RECORD DELIMITED BY WS-DELIM\\n                           INTO WS-ID WS-NAME WS-LOAN-AMOUNT\\n                                WS-PROPERTY-VALUE WS-DOWN-PAYMENT\\n                                WS-TERM WS-RATE\\n                           WITH POINTER WS-PTR\\n                       DISPLAY \\\"ID: \\\" WS-I"]
[172.006702, "o", "D\\n                       DISPLAY \\\"LOAN: \\\" WS-LOAN-AMOUNT\\n                       DISPLAY \\\"TERM: \\\" WS-TERM\\n                       DISPLAY \\\"RATE: \\\" WS-RATE\\n                       COMPUTE WS-TERM-MONTHS = WS-TERM * 12\\n                       DISPLAY \\\"TERM-MONTHS: \\\" WS-TERM-MONTHS\\n                       COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200\\n                       DISPLAY \\\"MONTHLY-RATE: \\\" WS-MONTHLY-RATE\\n               END-READ\\n           END-PERFORM.\\n           CLOSE INPUT-FILE.\\n           STOP RUN.\\nENDOFFILE\\ncobc -x -fixed debug.cbl -o debug && ./debug\",\"description\":\"Debug parsing\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":542,\"cache_read_input_tokens\":28247,\"cache_creation\":{\"ephemeral_5m_input_tokens\":542,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"891d0751-bd53-4b1b-a96e-07fee2a717ab\",\"uuid\":\"4acf6105-13ac-4c9d-add1-126ddde18452\"}\r"]
