[216.187153, "o", "OCESS-RECORDS UNTIL WS-EOF = 1.\\n           PERFORM CLOSE-FILES.\\n           STOP RUN.\\n\\n       OPEN-FILES.\\n           OPEN INPUT INPUT-FILE.\\n           OPEN OUTPUT OUTPUT-FILE.\\n\\n       CLOSE-FILES.\\n           CLOSE INPUT-FILE.\\n           CLOSE OUTPUT-FILE.\\n\\n       PROCESS-RECORDS.\\n           READ INPUT-FILE INTO INPUT-RECORD\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\\n\\n       PARSE-INPUT-RECORD.\\n           INITIALIZE WS-TEMP-FIELDS.\\n           INITIALIZE WS-INPUT-FIELDS.\\n           MOVE 1 TO WS-PTR.\\n           UNSTRING INPUT-RECORD DELIMITED BY WS-DELIM\\n               INTO WS-TEMP-ID\\n                    WS-TEMP-NAME\\n                    WS-TEMP-LOAN\\n                    WS-TEMP-PROP\\n                    WS-TEMP-DOWN\\n                    WS-TEMP-TERM\\n                    WS-TEMP-RATE\\n               WITH POINTER WS-PTR.\\n           M"]
[216.187213, "o", "OVE WS-TEMP-ID TO WS-ID.\\n           MOVE WS-TEMP-NAME TO WS-NAME.\\n           MOVE WS-TEMP-LOAN TO WS-LOAN-AMOUNT.\\n           MOVE WS-TEMP-PROP TO WS-PROPERTY-VALUE.\\n           MOVE WS-TEMP-DOWN TO WS-DOWN-PAYMENT.\\n           MOVE WS-TEMP-TERM TO WS-TERM.\\n           MOVE WS-TEMP-RATE TO WS-RATE-NUM.\\n           COMPUTE WS-RATE ROUNDED = WS-RATE-NUM / 100.\\n\\n       VALIDATE-APPLICATION.\\n           COMPUTE WS-MIN-DOWN ROUNDED =\\n               WS-PROPERTY-VALUE * 0.15.\\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n               PERFORM WRITE-REJECTION\\n           ELSE\\n               PERFORM CALCULATE-AND-WRITE-SCHEDULE\\n           END-IF.\\n\\n       WRITE-REJECTION.\\n           INITIALIZE WS-OUTPUT-REJECT.\\n           MOVE WS-ID TO WS-OUT-ID-REJ.\\n           MOVE \\\"DENY \\\" TO WS-OUT-STATUS-REJ.\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\"\\n               TO WS-OUT-REASON.\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-REJECT.\\n\\n       CALCULATE-AND-WRITE-SCHEDULE.\\n           COMPUTE WS-TER"]
[216.187237, "o", "M-MONTHS = WS-TERM * 12.\\n           COMPUTE WS-MONTHLY-RATE ROUNDED =\\n               WS-RATE / 1200.\\n           COMPUTE WS-POWER-BASE ROUNDED =\\n               1 + WS-MONTHLY-RATE.\\n           COMPUTE WS-POWER-RESULT ROUNDED =\\n               WS-POWER-BASE ** (0 - WS-TERM-MONTHS).\\n           COMPUTE WS-DENOMINATOR ROUNDED =\\n               1 - WS-POWER-RESULT.\\n           COMPUTE WS-NUMERATOR ROUNDED =\\n               WS-LOAN-AMOUNT * WS-MONTHLY-RATE.\\n           IF WS-DENOMINATOR > 0\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-NUMERATOR / WS-DENOMINATOR\\n           ELSE\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-LOAN-AMOUNT / WS-TERM-MONTHS\\n           END-IF.\\n           PERFORM WRITE-APPROVAL-HEADER.\\n           MOVE WS-LOAN-AMOUNT TO WS-REMAINING-BAL.\\n           PERFORM WRITE-SCHEDULE-LINE\\n               VARYING WS-MONTH-NUM FROM 1 BY 1\\n               UNTIL WS-MONTH-NUM > WS-TERM-MONTHS.\\n\\n       WRITE-APPROVAL-HEADER.\\n           IN"]
[216.187292, "o", "ITIALIZE WS-OUTPUT-APPROVE.\\n           MOVE WS-ID TO WS-OUT-ID-APP.\\n           MOVE \\\"APPRO\\\" TO WS-OUT-STATUS-APP.\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE.\\n\\n       WRITE-SCHEDULE-LINE.\\n           COMPUTE WS-INTEREST-PART ROUNDED =\\n               WS-REMAINING-BAL * WS-MONTHLY-RATE.\\n           IF WS-MONTH-NUM = WS-TERM-MONTHS\\n               MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\\n               ADD WS-INTEREST-PART TO WS-PRINCIPAL-PART\\n                   GIVING WS-PAYMENT-AMT ROUNDED\\n               MOVE 0 TO WS-REMAINING-BAL\\n           ELSE\\n               MOVE WS-MONTHLY-PAYMENT TO WS-PA"]
[216.187366, "o", "YMENT-AMT\\n               COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n                   WS-PAYMENT-AMT - WS-INTEREST-PART\\n               COMPUTE WS-REMAINING-BAL ROUNDED =\\n                   WS-REMAINING-BAL - WS-PRINCIPAL-PART\\n           END-IF.\\n           INITIALIZE WS-OUTPUT-SCHEDULE.\\n           MOVE WS-MONTH-NUM TO WS-OUT-MON-NUM.\\n           MOVE WS-PAYMENT-AMT TO WS-OUT-PAYMENT.\\n           MOVE WS-INTEREST-PART TO WS-OUT-INTEREST.\\n           MOVE WS-PRINCIPAL-PART TO WS-OUT-PRINCIPAL.\\n           MOVE WS-REMAINING-BAL TO WS-OUT-REMAINING.\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\\n\"}}],\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":1861,\"cache_read_input_tokens\":28789,\"cache_creation\":{\"ephemeral_5m_input_tokens\":1861,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2958,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"891d0751-bd53-4b1b-a96e-07fee2a717ab\",\"uuid\":\"bff4d437-6aa6-4ce7-beab-88f"]
