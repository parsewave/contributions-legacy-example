[120.855036, "o", "CORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\\n\\n       PARSE-INPUT-RECORD.\\n           INITIALIZE WS-INPUT-FIELDS.\\n           MOVE 1 TO WS-PTR.\\n           UNSTRING INPUT-RECORD DELIMITED BY WS-DELIM\\n               INTO WS-ID\\n                    WS-NAME\\n                    WS-LOAN-AMOUNT\\n                    WS-PROPERTY-VALUE\\n                    WS-DOWN-PAYMENT\\n                    WS-TERM\\n                    WS-RATE\\n               WITH POINTER WS-PTR.\\n\\n       VALIDATE-APPLICATION.\\n           COMPUTE WS-MIN-DOWN ROUNDED =\\n               WS-PROPERTY-VALUE * 0.15.\\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n               PERFORM WRITE-REJECTION\\n           ELSE\\n               PERFORM CALCULATE-AND-WRITE-SCHEDULE\\n           END-IF.\\n\\n       WRITE-REJECTION.\\n           INITIALIZE WS-OUTPUT-REJECT.\\n           MOVE WS-ID TO WS-OUT-ID-REJ.\\n           MOVE \\\"DENY \\\" TO WS-OUT-STATUS-REJ.\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\"\\n               TO WS-O"]
[120.855049, "o", "UT-REASON.\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-REJECT.\\n\\n       CALCULATE-AND-WRITE-SCHEDULE.\\n           COMPUTE WS-TERM-MONTHS = WS-TERM * 12.\\n           COMPUTE WS-MONTHLY-RATE ROUNDED =\\n               WS-RATE / 1200.\\n           COMPUTE WS-POWER-BASE ROUNDED =\\n               1 + WS-MONTHLY-RATE.\\n           COMPUTE WS-POWER-RESULT ROUNDED =\\n               WS-POWER-BASE ** (0 - WS-TERM-MONTHS).\\n           COMPUTE WS-DENOMINATOR ROUNDED =\\n               1 - WS-POWER-RESULT.\\n           COMPUTE WS-NUMERATOR ROUNDED =\\n               WS-LOAN-AMOUNT * WS-MONTHLY-RATE.\\n           IF WS-DENOMINATOR > 0\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-NUMERATOR / WS-DENOMINATOR\\n           ELSE\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-LOAN-AMOUNT / WS-TERM-MONTHS\\n           END-IF.\\n           PERFORM WRITE-APPROVAL-HEADER.\\n           MOVE WS-LOAN-AMOUNT TO WS-REMAINING-BAL.\\n           PERFORM WRITE-SCHEDULE-LINE\\n               V"]
[120.855128, "o", "ARYING WS-MONTH-NUM FROM 1 BY 1\\n               UNTIL WS-MONTH-NUM > WS-TERM-MONTHS.\\n\\n       WRITE-APPROVAL-HEADER.\\n           INITIALIZE WS-OUTPUT-APPROVE.\\n           MOVE WS-ID TO WS-OUT-ID-APP.\\n           MOVE \\\"APPRO\\\" TO WS-OUT-STATUS-APP.\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE.\\n\\n       WRITE-SCHEDULE-LINE.\\n           COMPUTE WS-INTEREST-PART ROUNDED =\\n               WS-REMAINING-BAL * WS-MONTHLY-RATE.\\n           IF WS-MONTH-NUM = WS-TERM-MONTHS\\n               MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\\n               ADD WS-INTEREST-PART TO WS-PRINCIPAL-PART\\n                   GIVING WS-PAYMENT-AMT ROUNDED\\n               MOVE 0 TO WS-REMAINING-BAL\\n           ELSE\\n               MOVE WS-MONTHLY-PAYMENT TO WS-PAYMENT-AMT\\n               COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n                   WS-PAYMENT-AMT - WS-INTEREST-PART\\n               COMPUTE WS-REMAINING-BAL ROUNDED =\\n                   WS-REMAINING-BAL - WS-PRINCIPAL-PART\\n           END-IF.\\n           INITIALIZE W"]
