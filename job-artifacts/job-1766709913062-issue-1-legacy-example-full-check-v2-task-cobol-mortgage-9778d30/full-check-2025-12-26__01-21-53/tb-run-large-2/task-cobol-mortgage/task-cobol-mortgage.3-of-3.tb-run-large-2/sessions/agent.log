 MOVE 1 TO WS-TEMP-IDX\n               ELSE\n                   IF WS-CHAR NOT = SPACE OR WS-FIELD-NUM = 2\n                       MOVE WS-CHAR TO WS-TEMP-STRING(WS-TEMP-IDX:1)\n                       ADD 1 TO WS-TEMP-IDX\n                   END-IF\n               END-IF\n           END-PERFORM\n           IF WS-FIELD-NUM = 7\n               PERFORM STORE-FIELD\n           END-IF.\n\n       STORE-FIELD.\n           EVALUATE WS-FIELD-NUM\n               WHEN 1 MOVE WS-TEMP-STRING(1:10) TO WS-ID\n               WHEN 2 MOVE WS-TEMP-STRING(1:30) TO WS-NAME\n               WHEN 3 MOVE WS-TEMP-STRING TO WS-LOAN-AMOUNT\n               WHEN 4 MOVE WS-TEMP-STRING TO WS-PROPERTY-VALUE\n               WHEN 5 MOVE WS-TEMP-STRING TO WS-DOWN-PAYMENT\n               WHEN 6 MOVE WS-TEMP-STRING TO WS-TERM\n               WHEN 7 MOVE WS-TEMP-STRING TO WS-RATE\n           END-EVALUATE.\n\n       VALIDATE-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED =\n               WS-PROPERTY-VALUE * 0.15\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n               PERFORM REJECT-APPLICATION\n           ELSE\n               PERFORM APPROVE-APPLICATION\n           END-IF.\n\n       REJECT-APPLICATION.\n           INITIALIZE WS-OUTPUT-REJECT\n           MOVE WS-ID TO WS-REJ-ID\n           MOVE \"DENY \" TO WS-REJ-STATUS\n           MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REJ-REASON\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-REJECT.\n\n       APPROVE-APPLICATION.\n           INITIALIZE WS-OUTPUT-APPROVE\n           MOVE WS-ID TO WS-APP-ID\n           MOVE \"APPRO\" TO WS-APP-STATUS\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE\n           PERFORM CALCULATE-PAYMENT\n           PERFORM GENERATE-SCHEDULE.\n\n       CALCULATE-PAYMENT.\n           MOVE WS-TERM TO WS-TERM-MONTHS\n           COMPUTE WS-MONTHLY-RATE ROUNDED =\n               WS-RATE / 1200\n           COMPUTE WS-POWER-RESULT ROUNDED =\n               (1 + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\n           COMPUTE WS-DENOMINATOR ROUNDED =\n               1 - WS-POWER-RESULT\n           IF WS-DENOMINATOR = 0\n               MOVE 0 TO WS-MONTHLY-PAYMENT\n           ELSE\n               COMPUTE WS-NUMERATOR ROUNDED =\n                   WS-LOAN-AMOUNT * WS-MONTHLY-RATE\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-NUMERATOR / WS-DENOMINATOR\n           END-IF\n           MOVE WS-LOAN-AMOUNT TO WS-REMAINING-BAL.\n\n       GENERATE-SCHEDULE.\n           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\n               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\n               PERFORM WRITE-SCHEDULE-LINE\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           INITIALIZE WS-OUTPUT-SCHEDULE\n           COMPUTE WS-INTEREST-PART ROUNDED =\n               WS-REMAINING-BAL * WS-MONTHLY-RATE\n           COMPUTE WS-PRINCIPAL-PART ROUNDED =\n               WS-MONTHLY-PAYMENT - WS-INTEREST-PART\n           IF WS-MONTH-CTR = WS-TERM-MONTHS\n               MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-PRINCIPAL-PART + WS-INTEREST-PART\n           END-IF\n           COMPUTE WS-REMAINING-BAL ROUNDED =\n               WS-REMAINING-BAL - WS-PRINCIPAL-PART\n           IF WS-REMAINING-BAL < 0\n               MOVE 0 TO WS-REMAINING-BAL\n           END-IF\n           MOVE WS-MONTH-CTR TO WS-SCH-MONTH\n           MOVE WS-MONTHLY-PAYMENT TO WS-SCH-PAYMENT\n           MOVE WS-INTEREST-PART TO WS-SCH-INTEREST\n           MOVE WS-PRINCIPAL-PART TO WS-SCH-PRINCIPAL\n           MOVE WS-REMAINING-BAL TO WS-SCH-BALANCE\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\n","structuredPatch":[{"oldStart":169,"oldLines":7,"newStart":169,"newLines":7,"lines":["            PERFORM GENERATE-SCHEDULE."," ","        CALCULATE-PAYMENT.","-           MOVE WS-TERM TO WS-TERM-MONTHS","+           COMPUTE WS-TERM-MONTHS ROUNDED = WS-TERM * 12","            COMPUTE WS-MONTHLY-RATE ROUNDED =","                WS-RATE 