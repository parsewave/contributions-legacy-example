IC X(100).\n\n       WORKING-STORAGE SECTION.\n       01 WS-INPUT-STATUS              PIC XX.\n       01 WS-OUTPUT-STATUS             PIC XX.\n       01 WS-EOF                       PIC 9 VALUE 0.\n\n       01 WS-INPUT-FIELDS.\n           05 WS-ID                    PIC X(10).\n           05 WS-NAME                  PIC X(30).\n           05 WS-LOAN-AMOUNT           PIC 9(10).\n           05 WS-PROPERTY-VALUE        PIC 9(10).\n           05 WS-DOWN-PAYMENT          PIC 9(10).\n           05 WS-TERM                  PIC 9(2).\n           05 WS-RATE                  PIC 9(3)V9(2).\n\n       01 WS-CALC-FIELDS.\n           05 WS-MIN-DOWN              PIC 9(12)V9(4).\n           05 WS-MONTHLY-RATE          PIC 9V9(10).\n           05 WS-MONTHLY-PAYMENT       PIC 9(10)V9(4).\n           05 WS-TEMP-CALC             PIC 9(15)V9(10).\n           05 WS-POWER-RESULT          PIC 9(5)V9(15).\n           05 WS-DENOMINATOR           PIC 9(5)V9(15).\n           05 WS-NUMERATOR             PIC 9(15)V9(10).\n           05 WS-REMAINING-BAL         PIC 9(12)V9(4).\n           05 WS-INTEREST-PART         PIC 9(10)V9(4).\n           05 WS-PRINCIPAL-PART        PIC 9(10)V9(4).\n           05 WS-MONTH-CTR             PIC 9(3).\n           05 WS-TERM-MONTHS           PIC 9(4).\n\n       01 WS-OUTPUT-REJECT.\n           05 WS-REJ-ID                PIC X(10).\n           05 WS-REJ-STATUS            PIC X(5).\n           05 FILLER                   PIC X VALUE SPACE.\n           05 WS-REJ-REASON            PIC X(50).\n\n       01 WS-OUTPUT-APPROVE.\n           05 WS-APP-ID                PIC X(10).\n           05 WS-APP-STATUS            PIC X(5).\n\n       01 WS-OUTPUT-SCHEDULE.\n           05 WS-SCH-MONTH             PIC 9(3).\n           05 FILLER                   PIC X VALUE SPACE.\n           05 WS-SCH-PAYMENT           PIC 9(8).99.\n           05 FILLER                   PIC X VALUE SPACE.\n           05 WS-SCH-INTEREST          PIC 9(8).99.\n           05 FILLER                   PIC X VALUE SPACE.\n           05 WS-SCH-PRINCIPAL         PIC 9(8).99.\n           05 FILLER                   PIC X VALUE SPACE.\n           05 WS-SCH-BALANCE           PIC 9(10).99.\n\n       01 WS-PARSE-POS                 PIC 9(3).\n       01 WS-FIELD-NUM                 PIC 9.\n       01 WS-TEMP-STRING               PIC X(50).\n       01 WS-TEMP-IDX                  PIC 9(3).\n       01 WS-CHAR                      PIC X.\n       01 WS-RATE-TEMP                 PIC 9(5).\n\n       PROCEDURE DIVISION.\n       MAIN-PROCEDURE.\n           PERFORM OPEN-FILES\n           PERFORM PROCESS-RECORDS UNTIL WS-EOF = 1\n           PERFORM CLOSE-FILES\n           STOP RUN.\n\n       OPEN-FILES.\n           OPEN INPUT INPUT-FILE\n           IF WS-INPUT-STATUS NOT = \"00\"\n               DISPLAY \"ERROR OPENING INPUT FILE: \" WS-INPUT-STATUS\n               STOP RUN\n           END-IF\n           OPEN OUTPUT OUTPUT-FILE\n           IF WS-OUTPUT-STATUS NOT = \"00\"\n               DISPLAY \"ERROR OPENING OUTPUT FILE: \" WS-OUTPUT-STATUS\n               STOP RUN\n           END-IF.\n\n       CLOSE-FILES.\n           CLOSE INPUT-FILE\n           CLOSE OUTPUT-FILE.\n\n       PROCESS-RECORDS.\n           READ INPUT-FILE INTO INPUT-RECORD\n               AT END\n                   MOVE 1 TO WS-EOF\n               NOT AT END\n                   PERFORM PARSE-INPUT-RECORD\n                   PERFORM VALIDATE-APPLICATION\n           END-READ.\n\n       PARSE-INPUT-RECORD.\n           INITIALIZE WS-INPUT-FIELDS\n           MOVE 1 TO WS-PARSE-POS\n           MOVE 1 TO WS-FIELD-NUM\n           INITIALIZE WS-TEMP-STRING\n           MOVE 1 TO WS-TEMP-IDX\n\n           PERFORM VARYING WS-PARSE-POS FROM 1 BY 1\n               UNTIL WS-PARSE-POS > 200 OR WS-FIELD-NUM > 7\n               MOVE INPUT-RECORD(WS-PARSE-POS:1) TO WS-CHAR\n               IF WS-CHAR = \";\"\n                   PERFORM STORE-FIELD\n                   ADD 1 TO WS-FIELD-NUM\n                   INITIALIZE WS-TEMP-STRING\n                   MOVE 1 TO WS-TEMP-IDX\n               ELSE\n                   IF WS-CHAR NOT = SPACE OR WS-FIELD-NUM = 2\n                       MOVE WS-CHAR TO WS-TEMP-STRING(WS-TEMP-IDX:1)\n                       ADD 1 TO WS-TEMP-IDX\n                   END-IF\n               END-IF\n           END-PERFORM\n           IF WS-FIELD-NUM = 7\n               PERFORM STORE-FIELD\n           END-IF.\n\n       STORE-FIELD.\n           EVALUATE WS-FIELD-NUM\n               WHEN 1 MOVE WS-TEMP-STRING(1:10) TO WS-ID\n               WHEN 2 MOVE WS-TEMP-STRING(1:30) TO WS-NAME\n               WHEN 3 MOVE WS-TEMP-STRING TO WS-LOAN-AMOUNT\n               WHEN 4 MOVE WS-TEMP-STRING TO WS-PROPERTY-VALUE\n               WHEN 5 MOVE WS-TEMP-STRING TO WS-DOWN-PAYMENT\n               WHEN 6 MOVE WS-TEMP-STRING TO WS-TERM\n               WHEN 7 MOVE WS-TEMP-STRING TO WS-RATE\n           END-EVALUATE.\n\n       VALIDATE-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED =\n               WS-PROPERTY-VALUE * 0.15\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n               PERFORM REJECT-APPLICATION\n           ELSE\n               PERFORM APPROVE-APPLICATION\n           END-IF.\n\n       REJECT-APPLICATION.\n           INITIALIZE WS-OUTPUT-REJECT\n           MOVE WS-ID TO WS-REJ-ID\n           MOVE \"DENY \" TO WS-REJ-STATUS\n           MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REJ-REASON\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-REJECT.\n\n       APPROVE-APPLICATION.\n           INITIALIZE WS-OUTPUT-APPROVE\n           MOVE WS-ID TO WS-APP-ID\n           MOVE \"APPRO\" TO WS-APP-STATUS\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE\n           PERFORM CALCULATE-PAYMENT\n           PERFORM GENERATE-SCHEDULE.\n\n       CALCULATE-PAYMENT.\n           COMPUTE WS-TERM-MONTHS ROUNDED = WS-TERM * 12\n           COMPUTE WS-MONTHLY-RATE ROUNDED =\n               WS-RATE / 1200\n           COMPUTE WS-POWER-RESULT ROUNDED =\n               (1 + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\n           COMPUTE WS-DENOMINATOR ROUNDED =\n               1 - WS-POWER-RESULT\n           IF WS-DENOMINATOR = 0\n               MOVE 0 TO WS-MONTHLY-PAYMENT\n           ELSE\n               COMPUTE WS-NUMERATOR ROUNDED =\n                   WS-LOAN-AMOUNT * WS-MONTHLY-RATE\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-NUMERATOR / WS-DENOMINATOR\n           END-IF\n           MOVE WS-LOAN-AMOUNT TO WS-REMAINING-BAL.\n\n       GENERATE-SCHEDULE.\n           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\n               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\n               PERFORM WRITE-SCHEDULE-LINE\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           INITIALIZE WS-OUTPUT-SCHEDULE\n           COMPUTE WS-INTEREST-PART ROUNDED =\n               WS-REMAINING-BAL * WS-MONTHLY-RATE\n           COMPUTE WS-PRINCIPAL-PART ROUNDED =\n               WS-MONTHLY-PAYMENT - WS-INTEREST-PART\n           IF WS-MONTH-CTR = WS-TERM-MONTHS\n               MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-PRINCIPAL-PART + WS-INTEREST-PART\n           END-IF\n           COMPUTE WS-REMAINING-BAL ROUNDED =\n               WS-REMAINING-BAL - WS-PRINCIPAL-PART\n           IF WS-REMAINING-BAL < 0\n               MOVE 0 TO WS-REMAINING-BAL\n           END-IF\n           MOVE WS-MONTH-CTR TO WS-SCH-MONTH\n           MOVE WS-MONTHLY-PAYMENT TO WS-SCH-PAYMENT\n           MOVE WS-INTEREST-PART TO WS-SCH-INTEREST\n           MOVE WS-PRINCIPAL-PART TO WS-SCH-PRINCIPAL\n           MOVE WS-REMAINING-BAL TO WS-SCH-BALANCE\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\n","structuredPatch":[{"oldStart":142,"oldLines":7,"newStart":142,"newLines":9,"lines":["                WHEN 4 MOVE WS-TEMP-STRING TO WS-PROPERTY-VALUE","                WHEN 5 MOVE WS-TEMP-STRING TO WS-DOWN-PAYMENT","                WHEN 6 MOVE WS-TEMP-STRING TO WS-TERM","-               WHEN 7 MOVE WS-TEM