[212.775041, "o", "String\":\"       PROCESS-RECORDS.\\n           READ INPUT-FILE INTO INPUT-RECORD\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\",\"newString\":\"       PROCESS-RECORDS.\\n           READ INPUT-FILE\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\",\"originalFile\":\"       IDENTIFICATION DIVISION.\\n       PROGRAM-ID. MORTGAGE-PROCESSOR.\\n\\n       ENVIRONMENT DIVISION.\\n       INPUT-OUTPUT SECTION.\\n       FILE-CONTROL.\\n           SELECT INPUT-FILE ASSIGN TO \\\"INPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-INPUT-STATUS.\\n           SELECT OUTPUT-FILE ASSIGN TO \\\"../data/OUTPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-"]
[212.775051, "o", "OUTPUT-STATUS.\\n\\n       DATA DIVISION.\\n       FILE SECTION.\\n       FD INPUT-FILE.\\n       01 INPUT-RECORD                 PIC X(200).\\n\\n       FD OUTPUT-FILE.\\n       01 OUTPUT-RECORD                PIC X(100).\\n\\n       WORKING-STORAGE SECTION.\\n       01 WS-INPUT-STATUS              PIC XX.\\n       01 WS-OUTPUT-STATUS             PIC XX.\\n       01 WS-EOF                       PIC 9 VALUE 0.\\n\\n       01 WS-INPUT-FIELDS.\\n           05 WS-ID                    PIC X(10).\\n           05 WS-NAME                  PIC X(30).\\n           05 WS-LOAN-AMOUNT           PIC 9(10).\\n           05 WS-PROPERTY-VALUE        PIC 9(10).\\n           05 WS-DOWN-PAYMENT          PIC 9(10).\\n           05 WS-TERM                  PIC 9(2).\\n           05 WS-RATE                  PIC 9(3)V9(2).\\n\\n       01 WS-CALC-FIELDS.\\n           05 WS-MIN-DOWN              PIC 9(12)V9(4).\\n           05 WS-MONTHLY-RATE          PIC 9V9(10).\\n           05 WS-MONTHLY-PAYMENT       PIC 9(10)V9(4).\\n           05 WS-TEMP-CALC            "]
