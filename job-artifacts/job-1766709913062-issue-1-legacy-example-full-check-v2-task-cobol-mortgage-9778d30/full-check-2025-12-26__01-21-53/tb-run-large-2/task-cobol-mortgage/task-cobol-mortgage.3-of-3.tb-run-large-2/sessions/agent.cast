[163.930695, "o", "LOSE-FILES.\\n           CLOSE INPUT-FILE\\n           CLOSE OUTPUT-FILE.\\n\\n       PROCESS-RECORDS.\\n           READ INPUT-FILE INTO INPUT-RECORD\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\\n\\n       PARSE-INPUT-RECORD.\\n           INITIALIZE WS-INPUT-FIELDS\\n           MOVE 1 TO WS-PARSE-POS\\n           MOVE 1 TO WS-FIELD-NUM\\n           INITIALIZE WS-TEMP-STRING\\n           MOVE 1 TO WS-TEMP-IDX\\n\\n           PERFORM VARYING WS-PARSE-POS FROM 1 BY 1\\n               UNTIL WS-PARSE-POS > 200 OR WS-FIELD-NUM > 7\\n               MOVE INPUT-RECORD(WS-PARSE-POS:1) TO WS-CHAR\\n               IF WS-CHAR = \\\";\\\"\\n                   PERFORM STORE-FIELD\\n                   ADD 1 TO WS-FIELD-NUM\\n                   INITIALIZE WS-TEMP-STRING\\n                   MOVE 1 TO WS-TEMP-IDX\\n               ELSE\\n                   IF WS-CHAR NOT = SPACE OR WS-FIELD-NUM ="]
[163.930786, "o", " 2\\n                       MOVE WS-CHAR TO WS-TEMP-STRING(WS-TEMP-IDX:1)\\n                       ADD 1 TO WS-TEMP-IDX\\n                   END-IF\\n               END-IF\\n           END-PERFORM\\n           IF WS-FIELD-NUM = 7\\n               PERFORM STORE-FIELD\\n           END-IF.\\n\\n       STORE-FIELD.\\n           EVALUATE WS-FIELD-NUM\\n               WHEN 1 MOVE WS-TEMP-STRING(1:10) TO WS-ID\\n               WHEN 2 MOVE WS-TEMP-STRING(1:30) TO WS-NAME\\n               WHEN 3 MOVE WS-TEMP-STRING TO WS-LOAN-AMOUNT\\n               WHEN 4 MOVE WS-TEMP-STRING TO WS-PROPERTY-VALUE\\n               WHEN 5 MOVE WS-TEMP-STRING TO WS-DOWN-PAYMENT\\n               WHEN 6 MOVE WS-TEMP-STRING TO WS-TERM\\n               WHEN 7 MOVE WS-TEMP-STRING TO WS-RATE\\n           END-EVALUATE.\\n\\n       VALIDATE-APPLICATION.\\n           COMPUTE WS-MIN-DOWN ROUNDED =\\n               WS-PROPERTY-VALUE * 0.15\\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n               PERFORM REJECT-APPLICATION\\n           ELSE\\n               PERFORM APPR"]
[163.930816, "o", "OVE-APPLICATION\\n           END-IF.\\n\\n       REJECT-APPLICATION.\\n           INITIALIZE WS-OUTPUT-REJECT\\n           MOVE WS-ID TO WS-REJ-ID\\n           MOVE \\\"DENY \\\" TO WS-REJ-STATUS\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\" TO WS-REJ-REASON\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-REJECT.\\n\\n       APPROVE-APPLICATION.\\n           INITIALIZE WS-OUTPUT-APPROVE\\n           MOVE WS-ID TO WS-APP-ID\\n           MOVE \\\"APPRO\\\" TO WS-APP-STATUS\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE\\n           PERFORM CALCULATE-PAYMENT\\n           PERFORM GENERATE-SCHEDULE.\\n\\n       CALCULATE-PAYMENT.\\n           COMPUTE WS-TERM-MONTHS ROUNDED = WS-TERM * 12\\n           COMPUTE WS-MONTHLY-RATE ROUNDED =\\n               WS-RATE / 1200\\n           COMPUTE WS-POWER-RESULT ROUNDED =\\n               (1 + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\\n           COMPUTE WS-DENOMINATOR ROUNDED =\\n               1 - WS-POWER-RESULT\\n           IF WS-DENOMINATOR = 0\\n               MOVE 0 TO WS-MONTHLY-P"]
[163.930854, "o", "AYMENT\\n           ELSE\\n               COMPUTE WS-NUMERATOR ROUNDED =\\n                   WS-LOAN-AMOUNT * WS-MONTHLY-RATE\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-NUMERATOR / WS-DENOMINATOR\\n           END-IF\\n           MOVE WS-LOAN-AMOUNT TO WS-REMAINING-BAL.\\n\\n       GENERATE-SCHEDULE.\\n           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\\n               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\\n               PERFORM WRITE-SCHEDULE-LINE\\n           END-PERFORM.\\n\\n       WRITE-SCHEDULE-LINE.\\n           INITIALIZE WS-OUTPUT-SCHEDULE\\n           COMPUTE WS-INTEREST-PART ROUNDED =\\n               WS-REMAINING-BAL * WS-MONTHLY-RATE\\n           COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n               WS-MONTHLY-PAYMENT - WS-INTEREST-PART\\n           IF WS-MONTH-CTR = WS-TERM-MONTHS\\n               MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-PRINCIPAL-PART + WS-INTEREST-PART\\n           END-IF\\n           COMP"]
