[449.313859, "i", "cat >> /app/src/BankBatchJob.java <<'EOF'\n  private static BigDecimal fee(Fee fr, BigDecimal amtCcy) {\n    if (fr==null) return bd(\"0\").setScale(2,RM);\n    int s = amtCcy.signum(); boolean debit=s<0, credit=s>0;\n    boolean applies = \"ALL\".equals(fr.applies) || (\"DEBIT\".equals(fr.applies)&&debit) || (\"CREDIT\".equals(fr.applies)&&credit);\n    if (!applies) return bd(\"0\").setScale(2,RM);\n    BigDecimal base = fr.flat.add(fr.pct.multiply(amtCcy.abs()));\n    BigDecimal f = base.setScale(2,RM);\n    if (f.compareTo(fr.min)<0) f=fr.min;\n    if (f.compareTo(fr.max)>0) f=fr.max;\n    return f.setScale(2,RM);\n  }\n\n  private static Fx latest(List<Fx> all, String from, String to, Date eff) {\n    Fx best=null;\n    for (Fx r: all) {\n      if (!r.f.equals(from) || !r.t.equals(to)) continue;\n      if (r.d.after(eff)) continue;\n      if (best==null || r.d.after(best.d)) best=r;\n    }\n    return best;\n  }\n\n  private static BigDecimal leg(List<Fx> all, String from, String to, Date eff) {\n    Fx d = latest(all, from, to, eff);\n  "]
[449.314097, "i", "  Fx rev = latest(all, to, from, eff);\n    if (d==null && rev==null) return null;\n    if (d!=null && rev==null) return d.r.setScale(10,RM);\n    if (d==null && rev!=null) return bd(\"1\").divide(rev.r,10,RM);\n    int cmp = d.d.compareTo(rev.d);\n    if (cmp>0) return d.r.setScale(10,RM);\n    if (cmp<0) return bd(\"1\").divide(rev.r,10,RM);\n    return d.r.setScale(10,RM);\n  }\n\n  private static BigDecimal fxRate(List<Fx> all, List<String> pivots, String from, String to, Date eff) {\n    BigDecimal x = leg(all,from,to,eff);\n    if (x!=null) return x;\n    for (String p: pivots) {\n      if (p.equals(from) || p.equals(to)) continue;\n      BigDecimal a = leg(all,from,p,eff); if (a==null) continue;\n      BigDecimal b = leg(all,p,to,eff); if (b==null) continue;\n      return a.multiply(b).setScale(10,RM);\n    }\n    return null;\n  }\n\n  private static void writeInterest(File f, Date biz, Map<String,Acct> accts) throws Exception {\n    List<String> ids=new ArrayList<String>(accts.keySet()); Collections.sort(ids);\n    Writer w=new"]
