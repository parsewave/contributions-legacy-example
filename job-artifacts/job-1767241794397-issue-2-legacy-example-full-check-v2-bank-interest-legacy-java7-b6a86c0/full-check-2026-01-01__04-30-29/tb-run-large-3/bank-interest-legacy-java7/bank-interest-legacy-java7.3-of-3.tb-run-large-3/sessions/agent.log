  private static void writeExceptions(File f, List<Txn> txns) throws Exception {
    Writer w=new OutputStreamWriter(new FileOutputStream(f),"UTF-8");
    try{
      w.write("row_num,tx_id,reason\n");
      for(Txn t: txns) if(!t.valid) w.write(t.row+","+t.txId+","+t.reason+"\n");
    } finally { w.close(); }
  }

  private static String md5hex(File f) throws Exception {
    MessageDigest md=MessageDigest.getInstance("MD5");
    InputStream is=new FileInputStream(f);
    try{ byte[] buf=new byte[8192]; int n; while((n=is.read(buf))>0) md.update(buf,0,n); }
    finally{ is.close(); }
    byte[] d=md.digest();
    StringBuilder sb=new StringBuilder();
    for(int i=0;i<d.length;i++){ int b=d[i]&0xFF; String h=Integer.toHexString(b); if(h.length()==1) sb.append('0'); sb.append(h); }
    return sb.toString();
  }

  private static void writeStats(File f, Date biz, int accounts, int valid, int skipped, BigDecimal total, String md5) throws Exception {
    String s = "{\"business_date\":\""+fmt(biz)+"\",\"accounts\":"+accounts+",\"valid_txs\":"+valid+",\"skipped_txs\":"+skipped+",\"total_interest\":"+total.setScale(2,RM).toPlainString()+",\"report_md5\":\""+md5+"\"}";
    OutputStream os=new FileOutputStream(f);
    try{ os.write(s.getBytes("UTF-8")); } finally { os.close(); }
  }

