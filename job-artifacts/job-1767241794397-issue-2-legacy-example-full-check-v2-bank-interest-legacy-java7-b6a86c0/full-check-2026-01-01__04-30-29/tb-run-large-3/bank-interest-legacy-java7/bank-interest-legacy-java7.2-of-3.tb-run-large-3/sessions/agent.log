    private static void safeExecute(Statement st, String sql) {
        try {
            st.execute(sql);
        } catch (SQLException ignored) {
        }
    }

    private static String readFirstLine(File f) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));
        try {
            String s = br.readLine();
            if (s == null) return "";
            return s;
        } finally {
            br.close();
        }
    }

    private static BigDecimal bd(String s) {
        return new BigDecimal(s);
    }

    // yyyy-MM-dd -> day number using UTC to avoid DST surprises
    private static int parseDay(String yyyyMmDd) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");
            sdf.setLenient(false);
            sdf.setTimeZone(TimeZone.getTimeZone("UTC"));
            Date d = sdf.parse(yyyyMmDd);
            long ms = d.getTime();
            return (int) (ms / 86400000L);
        } catch (ParseException e) {
            throw new RuntimeException("Bad date: " + yyyyMmDd, e);
        }
    }

    private static String[] splitCsv(String line) {
        // Inputs are simple (no quoted commas)
        return line.split(",", -1);
    }

    private static class Account {
        String accountId;
        String openedAt;
        int openedDay;
        BigDecimal startBalance;
        BigDecimal baseApr;
        BigDecimal promoApr;
        int promoDays;
        BigDecimal tierThreshold;
        BigDecimal tierApr;
        String currency;
        String feePlan;
    }

    private static class Txn {
        int rowNum;
        String txId;
        String accountId;
        String effectiveDate;
        int effectiveDay;
        BigDecimal amount;
        String currency;
        String status;
        String reversalOf;
    }

    private static class FeeRule {
        String feePlan;
        String appliesTo;
        BigDecimal flatFee;
        BigDecimal pctFee;
        BigDecimal minFee;
        BigDecimal maxFee;
    }

    private static class ExceptionRow {
        int rowNum;
        String txId;
        String reason;
        ExceptionRow(int rowNum, String txId, String reason) {
            this.rowNum = rowNum;
            this.txId = txId;
            this.reason = reason;
        }
    }

    private static class InterestAndTotals {
        byte[] interestCsvBytes;
        BigDecimal totalInterest2dp;
    }
