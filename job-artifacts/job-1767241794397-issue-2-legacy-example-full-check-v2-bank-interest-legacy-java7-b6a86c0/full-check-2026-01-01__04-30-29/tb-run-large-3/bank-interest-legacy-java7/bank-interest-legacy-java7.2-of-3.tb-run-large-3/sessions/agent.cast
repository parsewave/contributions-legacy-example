[374.256014, "i", "cat > /app/src/BankBatchJob.java <<'JAVA'\nimport java.io.*;\nimport java.math.*;\nimport java.nio.charset.Charset;\nimport java.security.MessageDigest;\nimport java.sql.*;\nimport java.text.ParseException;\nimport java.text.SimpleDateFormat;\nimport java.util.*;\n\npublic class BankBatchJob {\n\n    private static final Charset UTF8 = Charset.forName(\"UTF-8\");\n    private static final RoundingMode HALF_EVEN = RoundingMode.HALF_EVEN;\n\n    private static final File DATA_DIR = new File(\"/app/data\");\n    private static final File OUT_DIR = new File(\"/app/output\");\n\n    // Must be a single literal string containing MODE=DB2 and /app/output/bankdb\n    private static final String JDBC_URL = \"jdbc:h2:/app/output/bankdb;MODE=DB2\";\n\n    public static void main(String[] args) throws Exception {\n        ensureCleanOutputDir();\n\n        String bizDate = readFirstLine(new File(DATA_DIR, \"biz_date.txt\")).trim();\n        int bizDay = parseDay(bizDate);\n\n        Map<String, FeeRule> feeRules = loadFeeRules(new File(DATA_DIR, \"fee_rules."]
[374.256065, "i", "csv\"));\n        List<String> pivots = loadPivots(new File(DATA_DIR, \"fx_pivots.csv\"));\n        FxBook fxBook = loadFxRates(new File(DATA_DIR, \"fx_rates.csv\"));\n\n        LinkedHashMap<String, Account> accounts = loadAccounts(new File(DATA_DIR, \"accounts.csv\"));\n        List<Txn> txns = loadTxns(new File(DATA_DIR, \"transactions.csv\"));\n\n        // Precompute reversal relationships: if reversal_of points to any tx_id in file -> both rows REVERSED\n        HashSet<String> allTxIds = new HashSet<String>();\n        for (Txn t : txns) allTxIds.add(t.txId);\n        HashSet<String> reversedTxIds = new HashSet<String>();\n        for (Txn t : txns) {\n            if (t.reversalOf != null && t.reversalOf.length() > 0 && allTxIds.contains(t.reversalOf)) {\n                reversedTxIds.add(t.txId);\n                reversedTxIds.add(t.reversalOf);\n            }\n        }\n\n        // H2 DB: create and load ACCOUNTS + TXNS (all rows)\n        createAndLoadDb(accounts, txns);\n\n        // Process txns into exceptions + per-account"]
[374.256245, "i", " adjustments\n        LinkedHashMap<String, BigDecimal> acctAdjSum = new LinkedHashMap<String, BigDecimal>();\n        for (String acctId : accounts.keySet()) {\n            acctAdjSum.put(acctId, bd(\"0.00\"));\n        }\n\n        List<ExceptionRow> exceptions = new ArrayList<ExceptionRow>();\n        int validTxs = 0;\n        int skippedTxs = 0;\n\n        HashSet<String> seenTxIds = new HashSet<String>();\n\n        for (Txn t : txns) {\n            boolean isDup = seenTxIds.contains(t.txId);\n            if (!isDup) seenTxIds.add(t.txId);\n\n            String reason = null;\n\n            // Reasons in required precedence order\n            if (reversedTxIds.contains(t.txId)) {\n                reason = \"REVERSED\";\n            } else if (t.reversalOf != null && t.reversalOf.length() > 0 && !allTxIds.contains(t.reversalOf)) {\n                reason = \"REVERSAL_MISSING\";\n            } else {\n                Account acct = accounts.get(t.accountId);\n                if (acct == null) {\n                    // Not specified in t"]
[374.25633, "o", "cat > /app/src/BankBatchJob.java <<'JAVA'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.256358, "i", "he required list; still record a skip reason\n                    reason = \"ACCOUNT_MISSING\";\n                } else {\n                    BigDecimal fx = null;\n                    if (!t.currency.equals(acct.currency)) {\n                        fx = fxBook.resolveRate(t.currency, acct.currency, t.effectiveDay, pivots);\n                        if (fx == null) {\n                            reason = \"FX_MISSING\";\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (t.effectiveDay > bizDay) {\n                            reason = \"AFTER_BIZ_DATE\";\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (!\"POSTED\".equals(t.status)) {\n                            reason = t.status;\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (isDup) {\n                            reason = \"DUPLICATE\";\n                        }\n         "]
[374.256417, "o", "import java.io.*;\r\n\u001b[?2004l\r\u001b[?2004h> import java.math.*;\r\n\u001b[?2004l\r"]
[374.256438, "i", "           }\n\n                    if (reason == null) {\n                        // Valid: convert to account ccy, then fee, then add adjusted amount\n                        BigDecimal amtAcc10;\n                        if (fx != null) {\n                            amtAcc10 = t.amount.multiply(fx).setScale(10, HALF_EVEN);\n                        } else {\n                            amtAcc10 = t.amount.setScale(10, HALF_EVEN);\n                        }\n\n                        FeeRule rule = feeRules.get(acct.feePlan);\n                        BigDecimal adjusted = applyFee(rule, amtAcc10);\n\n                        BigDecimal cur = acctAdjSum.get(acct.accountId);\n                        if (cur == null) cur = bd(\"0.00\");\n                        acctAdjSum.put(acct.accountId, cur.add(adjusted).setScale(2, HALF_EVEN));\n                        validTxs++;\n                    }\n                }\n            }\n\n            if (reason != null) {\n                exceptions.add(new ExceptionRow(t.rowNum, t.txId, reason))"]
[374.256482, "o", "\u001b[?2004h> "]
[374.2565, "i", ";\n                skippedTxs++;\n            }\n        }\n\n        // Build interest.csv bytes (to compute md5 from the exact bytes written)\n        InterestAndTotals it = buildInterestCsv(accounts, acctAdjSum, bizDate, bizDay);\n\n        // Write interest.csv (LF + trailing newline)\n        writeBytes(new File(OUT_DIR, \"interest.csv\"), it.interestCsvBytes);\n\n        String reportMd5 = md5Hex(it.interestCsvBytes);\n\n        // Write exceptions.csv (LF + trailing newline)\n        writeExceptionsCsv(new File(OUT_DIR, \"exceptions.csv\"), exceptions);\n\n        // Write stats.json (single line, no newline)\n        writeStatsJson(new File(OUT_DIR, \"stats.json\"), bizDate, accounts.size(), validTxs, skippedTxs, it.totalInterest2dp, reportMd5);\n\n        // Insert RUN_AUDIT row (must be exactly one row)\n        insertRunAudit(bizDate, accounts.size(), validTxs, skippedTxs, reportMd5);\n    }\nJAVA\n"]
