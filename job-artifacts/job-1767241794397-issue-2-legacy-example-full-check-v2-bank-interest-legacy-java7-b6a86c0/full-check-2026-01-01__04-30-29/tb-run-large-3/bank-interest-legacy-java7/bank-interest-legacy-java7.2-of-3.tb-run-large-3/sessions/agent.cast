[374.668858, "o", "            Date d = sdf.parse(yyyyMmDd);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.668942, "o", "            long ms = d.getTime();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.669054, "o", "            return (int) (ms / 86400000L);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.669138, "o", "        } catch (ParseException e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
