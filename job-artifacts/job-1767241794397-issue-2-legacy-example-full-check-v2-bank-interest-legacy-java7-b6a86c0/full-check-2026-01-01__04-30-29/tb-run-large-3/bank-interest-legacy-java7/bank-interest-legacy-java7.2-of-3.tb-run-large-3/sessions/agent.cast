[374.394495, "i", "cat >> /app/src/BankBatchJob.java <<'JAVA'\n\n    private static void ensureCleanOutputDir() throws IOException {\n        if (!OUT_DIR.exists()) {\n            if (!OUT_DIR.mkdirs()) throw new IOException(\"Failed to create /app/output\");\n        }\n        // Clear known output files to keep reruns deterministic\n        deleteIfExists(new File(OUT_DIR, \"interest.csv\"));\n        deleteIfExists(new File(OUT_DIR, \"exceptions.csv\"));\n        deleteIfExists(new File(OUT_DIR, \"stats.json\"));\n        deleteIfExists(new File(OUT_DIR, \"bankdb.h2.db\"));\n        deleteIfExists(new File(OUT_DIR, \"bankdb.lock.db\"));\n    }\n\n    private static void deleteIfExists(File f) {\n        try {\n            if (f.exists()) f.delete();\n        } catch (Exception ignored) {\n        }\n    }\n\n    private static LinkedHashMap<String, Account> loadAccounts(File f) throws IOException {\n        LinkedHashMap<String, Account> out = new LinkedHashMap<String, Account>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new File"]
[374.394545, "i", "InputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException(\"accounts.csv missing header\");\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                String[] a = splitCsv(line);\n                Account acct = new Account();\n                acct.accountId = a[0];\n                acct.openedAt = a[1];\n                acct.openedDay = parseDay(acct.openedAt);\n                acct.startBalance = bd(a[2]).setScale(2, HALF_EVEN);\n                acct.baseApr = bd(a[3]);\n                acct.promoApr = bd(a[4]);\n                acct.promoDays = Integer.parseInt(a[5]);\n                acct.tierThreshold = bd(a[6]).setScale(2, HALF_EVEN);\n                acct.tierApr = bd(a[7]);\n                acct.currency = a[8];\n                acct.feePlan = a[9];\n                out.put(acct.accountId, acct);\n            }\n        } f"]
[374.394713, "i", "inally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static List<Txn> loadTxns(File f) throws IOException {\n        ArrayList<Txn> out = new ArrayList<Txn>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException(\"transactions.csv missing header\");\n            String line;\n            int rowNum = 0;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                rowNum++;\n                String[] a = splitCsv(line);\n                Txn t = new Txn();\n                t.rowNum = rowNum;\n                t.txId = a[0];\n                t.accountId = a[1];\n                t.effectiveDate = a[2];\n                t.effectiveDay = parseDay(t.effectiveDate);\n                t.amount = bd(a[3]).setScale(2, HALF_EVEN);\n                t.currency ="]
