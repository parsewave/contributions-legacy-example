[374.458902, "i", "cat >> /app/src/BankBatchJob.java <<'JAVA'\n\n    private static BigDecimal applyFee(FeeRule rule, BigDecimal amtAcc10) {\n        if (rule == null) return amtAcc10.setScale(2, HALF_EVEN);\n\n        boolean isDebit = amtAcc10.compareTo(BigDecimal.ZERO) < 0;\n        boolean isCredit = amtAcc10.compareTo(BigDecimal.ZERO) > 0;\n        boolean applies;\n\n        if (\"ALL\".equals(rule.appliesTo)) {\n            applies = true;\n        } else if (\"DEBIT\".equals(rule.appliesTo)) {\n            applies = isDebit;\n        } else if (\"CREDIT\".equals(rule.appliesTo)) {\n            applies = isCredit;\n        } else {\n            applies = false;\n        }\n\n        if (!applies) {\n            return amtAcc10.setScale(2, HALF_EVEN);\n        }\n\n        BigDecimal abs = amtAcc10.abs();\n        BigDecimal feeRaw = rule.flatFee.add(rule.pctFee.multiply(abs));\n        BigDecimal fee = feeRaw.setScale(2, HALF_EVEN);\n        if (fee.compareTo(rule.minFee) < 0) fee = rule.minFee;\n        if (fee.compareTo(rule.maxFee) > 0) fee = rule.ma"]
[374.458938, "i", "xFee;\n\n        BigDecimal adjusted = amtAcc10.subtract(fee);\n        return adjusted.setScale(2, HALF_EVEN);\n    }\n\n    private static InterestAndTotals buildInterestCsv(LinkedHashMap<String, Account> accounts,\n                                                     Map<String, BigDecimal> acctAdjSum,\n                                                     String bizDate,\n                                                     int bizDay) throws IOException {\n        ByteArrayOutputStream baos = new ByteArrayOutputStream();\n        OutputStreamWriter osw = new OutputStreamWriter(baos, UTF8);\n        BufferedWriter bw = new BufferedWriter(osw);\n\n        BigDecimal totalInterestRawSum10dp = BigDecimal.ZERO.setScale(10, HALF_EVEN);\n\n        bw.write(\"account_id,biz_date,eod_balance,apr,daily_interest\\n\");\n\n        // Sorted by account_id\n        ArrayList<String> acctIds = new ArrayList<String>(accounts.keySet());\n        Collections.sort(acctIds);\n\n        for (String acctId : acctIds) {\n            Account a = accounts"]
[374.458947, "i", ".get(acctId);\n            BigDecimal adj = acctAdjSum.get(acctId);\n            if (adj == null) adj = bd(\"0.00\");\n\n            BigDecimal eod = a.startBalance.add(adj).setScale(2, HALF_EVEN);\n\n            BigDecimal apr = a.baseApr;\n            if (eod.compareTo(a.tierThreshold) >= 0) {\n                apr = apr.add(a.tierApr);\n            }\n            int daysSince = bizDay - a.openedDay;\n            if (a.promoDays > 0 && daysSince < a.promoDays) {\n                apr = apr.add(a.promoApr);\n            }\n\n            BigDecimal principal = eod;\n            if (principal.compareTo(BigDecimal.ZERO) < 0) principal = BigDecimal.ZERO.setScale(2, HALF_EVEN);\n\n            BigDecimal dailyInterestRaw = principal.multiply(apr).divide(bd(\"365\"), 10, HALF_EVEN);\n            BigDecimal dailyInterestCsv = dailyInterestRaw.setScale(2, HALF_EVEN);\n            totalInterestRawSum10dp = totalInterestRawSum10dp.add(dailyInterestRaw).setScale(10, HALF_EVEN);\n\n            bw.write(a.accountId);\n            bw.write(\",\");\n    "]
[374.459129, "i", "        bw.write(bizDate);\n            bw.write(\",\");\n            bw.write(eod.setScale(2, HALF_EVEN).toPlainString());\n            bw.write(\",\");\n            bw.write(apr.setScale(6, HALF_EVEN).toPlainString());\n            bw.write(\",\");\n            bw.write(dailyInterestCsv.toPlainString());\n            bw.write(\"\\n\");\n        }\n\n        bw.flush();\n\n        InterestAndTotals out = new InterestAndTotals();\n        out.interestCsvBytes = baos.toByteArray();\n        out.totalInterest2dp = totalInterestRawSum10dp.setScale(2, HALF_EVEN);\n        return out;\n    }\n\n    private static void writeExceptionsCsv(File f, List<ExceptionRow> rows) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(f), UTF8));\n        try {\n            bw.write(\"row_num,tx_id,reason\\n\");\n            for (ExceptionRow r : rows) {\n                bw.write(Integer.toString(r.rowNum));\n                bw.write(\",\");\n                bw.write(r.txId);\n                bw.write(\",\");\n"]
[374.459167, "o", "cat >> /app/src/BankBatchJob.java <<'JAVA'\r\n\u001b[?2004l\r"]
[374.459241, "i", "                bw.write(r.reason);\n                bw.write(\"\\n\");\n            }\n        } finally {\n            bw.close();\n        }\n    }\n\n    private static void writeStatsJson(File f,\n                                      String bizDate,\n                                      int accounts,\n                                      int validTxs,\n                                      int skippedTxs,\n                                      BigDecimal totalInterest2dp,\n                                      String reportMd5) throws IOException {\n        // single line, no newline\n        String json =\n                \"{\" +\n                \"\\\"business_date\\\":\\\"\" + escapeJson(bizDate) + \"\\\",\" +\n                \"\\\"accounts\\\":\" + accounts + \",\" +\n                \"\\\"valid_txs\\\":\" + validTxs + \",\" +\n                \"\\\"skipped_txs\\\":\" + skippedTxs + \",\" +\n                \"\\\"total_interest\\\":\\\"\" + escapeJson(totalInterest2dp.setScale(2, HALF_EVEN).toPlainString()) + \"\\\",\" +\n                \"\\\"report_md5\\\":\\\"\" + escapeJson("]
