[374.459373, "i", "reportMd5) + \"\\\"\" +\n                \"}\";\n\n        OutputStream os = new FileOutputStream(f);\n        try {\n            os.write(json.getBytes(UTF8));\n        } finally {\n            os.close();\n        }\n    }\n\n    private static String escapeJson(String s) {\n        if (s == null) return \"\";\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            if (c == '\"') sb.append(\"\\\\\\\"\");\n            else if (c == '\\\\') sb.append(\"\\\\\\\\\");\n            else sb.append(c);\n        }\n        return sb.toString();\n    }\nJAVA\n"]
