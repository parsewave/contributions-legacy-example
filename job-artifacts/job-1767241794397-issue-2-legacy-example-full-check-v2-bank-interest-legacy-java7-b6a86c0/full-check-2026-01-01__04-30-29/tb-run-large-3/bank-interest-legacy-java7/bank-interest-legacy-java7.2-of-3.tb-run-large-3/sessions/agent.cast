[374.796336, "o", "        private RatePick pickLatest(String from, String to, int effectiveDay) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.796477, "o", "            ArrayList<FxRate> lst = rates.get(key(from, to));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.796586, "o", "            if (lst == null) return null;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[374.796642, "o", "\u001b[?2004h> "]
[374.796707, "o", "            int bestDay = Integer.MIN_VALUE;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.796807, "o", "            BigDecimal bestRate = null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.796862, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.796947, "o", "            for (int i = 0; i < lst.size(); i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.797017, "o", "> "]
[374.797083, "o", "                FxRate r = lst.get(i);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.79722, "o", "                if (r.rateDay <= effectiveDay && r.rateDay > bestDay) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.797275, "o", "> "]
[374.797338, "o", "                    bestDay = r.rateDay;\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.797397, "o", "> "]
[374.797461, "o", "                    bestRate = r.rate;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.797519, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.797542, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[374.797618, "o", "\u001b[?2004h> "]
[374.797685, "o", "            if (bestRate == null) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.797753, "o", "            RatePick p = new RatePick();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.797853, "o", "            p.rateDay = bestDay;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.797916, "o", "            p.rate = bestRate;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798003, "o", "            return p;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798075, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.79819, "o", "        private BigDecimal invert(BigDecimal rate) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798292, "o", "            // reverse 1/rate (HALF_EVEN 10dp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798428, "o", "            return BigDecimal.ONE.divide(rate, 10, HALF_EVEN);\r\n\u001b[?2004l\r\u001b[?2004h"]
[374.798492, "o", ">         }\r\n\u001b[?2004l\r"]
[374.798552, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798634, "o", "        private String key(String from, String to) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798726, "o", "            return from + \"|\" + to;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798795, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798851, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.798906, "o", "        private static class FxRate {\r\n\u001b[?2004l\r"]
[374.798953, "o", "\u001b[?2004h> "]
[374.799036, "o", "            int rateDay;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799093, "o", "            BigDecimal rate;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799148, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799219, "o", "        private static class RatePick {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799297, "o", "            int rateDay;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799387, "o", "            BigDecimal rate;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799451, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.799505, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
