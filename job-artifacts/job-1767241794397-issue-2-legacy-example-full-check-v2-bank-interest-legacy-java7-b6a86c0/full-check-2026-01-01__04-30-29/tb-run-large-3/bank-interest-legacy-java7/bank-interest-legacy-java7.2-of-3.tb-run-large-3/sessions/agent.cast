[374.787375, "i", "cat >> /app/src/BankBatchJob.java <<'JAVA'\n\n    private static class FxBook {\n        // key: from|to -> list of (rateDay, rate)\n        private final HashMap<String, ArrayList<FxRate>> rates = new HashMap<String, ArrayList<FxRate>>();\n\n        void add(int rateDay, String from, String to, BigDecimal rate) {\n            String k = key(from, to);\n            ArrayList<FxRate> lst = rates.get(k);\n            if (lst == null) {\n                lst = new ArrayList<FxRate>();\n                rates.put(k, lst);\n            }\n            FxRate r = new FxRate();\n            r.rateDay = rateDay;\n            r.rate = rate;\n            lst.add(r);\n        }\n\n        BigDecimal resolveRate(String from, String to, int effectiveDay, List<String> pivots) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, HALF_EVEN);\n\n            // direct and reverse candidates\n            RatePick direct = pickLatest(from, to, effectiveDay);\n            RatePick reverse = pickLatest(to, from, effectiveDay);\n\n           "]
[374.787527, "i", " if (direct != null && reverse != null) {\n                if (direct.rateDay > reverse.rateDay) {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                } else if (reverse.rateDay > direct.rateDay) {\n                    return invert(reverse.rate);\n                } else {\n                    // tied -> choose direct\n                    return direct.rate.setScale(10, HALF_EVEN);\n                }\n            } else if (direct != null) {\n                return direct.rate.setScale(10, HALF_EVEN);\n            } else if (reverse != null) {\n                return invert(reverse.rate);\n            }\n\n            // pivot search in order\n            for (int i = 0; i < pivots.size(); i++) {\n                String p = pivots.get(i);\n                if (p.equals(from) || p.equals(to)) continue;\n\n                BigDecimal leg1 = resolveRateNoPivot(from, p, effectiveDay);\n                if (leg1 == null) continue;\n                BigDecimal leg2 = resolveRateNoPivot(p, to, effectiveDay);\n   "]
[374.787552, "o", "cat >> /app/src/BankBatchJob.java <<'JAVA'\r\n\u001b[?2004l\r"]
[374.7876, "i", "             if (leg2 == null) continue;\n\n                BigDecimal combined = leg1.multiply(leg2).setScale(10, HALF_EVEN);\n                return combined;\n            }\n\n            return null;\n        }\n\n        private BigDecimal resolveRateNoPivot(String from, String to, int effectiveDay) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, HALF_EVEN);\n\n            RatePick direct = pickLatest(from, to, effectiveDay);\n            RatePick reverse = pickLatest(to, from, effectiveDay);\n\n            if (direct != null && reverse != null) {\n                if (direct.rateDay > reverse.rateDay) {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                } else if (reverse.rateDay > direct.rateDay) {\n                    return invert(reverse.rate);\n                } else {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                }\n            } else if (direct != null) {\n                return direct.rate.setScale(10, HALF_EVEN);\n            } els"]
[374.787659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.787678, "i", "e if (reverse != null) {\n                return invert(reverse.rate);\n            }\n            return null;\n        }\n\n        private RatePick pickLatest(String from, String to, int effectiveDay) {\n            ArrayList<FxRate> lst = rates.get(key(from, to));\n            if (lst == null) return null;\n\n            int bestDay = Integer.MIN_VALUE;\n            BigDecimal bestRate = null;\n\n            for (int i = 0; i < lst.size(); i++) {\n                FxRate r = lst.get(i);\n                if (r.rateDay <= effectiveDay && r.rateDay > bestDay) {\n                    bestDay = r.rateDay;\n                    bestRate = r.rate;\n                }\n            }\n\n            if (bestRate == null) return null;\n            RatePick p = new RatePick();\n            p.rateDay = bestDay;\n            p.rate = bestRate;\n            return p;\n        }\n\n        private BigDecimal invert(BigDecimal rate) {\n            // reverse 1/rate (HALF_EVEN 10dp)\n            return BigDecimal.ONE.divide(rate, 10, HALF_EVEN);\n        }\n"]
[374.787742, "o", "    private static class FxBook {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[374.78776, "i", "\n        private String key(String from, String to) {\n            return from + \"|\" + to;\n        }\n\n        private static class FxRate {\n            int rateDay;\n            BigDecimal rate;\n        }\n\n        private static class RatePick {\n            int rateDay;\n            BigDecimal rate;\n        }\n    }\n}\nJAVA\n"]
