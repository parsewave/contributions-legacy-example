[454.044523, "i", "tic void del(File f){ if(f.exists()) f.delete(); }\n\n  private static void cleanOutput() throws Exception {\n    if(!OUT_DIR.exists() && !OUT_DIR.mkdirs()) throw new IOException(\"cannot create \" + OUT_DIR);\n    del(INTEREST_CSV); del(EXCEPTIONS_CSV); del(STATS_JSON);\n    del(new File(OUT_DIR, \"bankdb.h2.db\"));\n    del(new File(OUT_DIR, \"bankdb.trace.db\"));\n    del(new File(OUT_DIR, \"bankdb.lock.db\"));\n  }\n\n  private static String read1(File f) throws Exception {\n    BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n    try { String s = br.readLine(); return s==null?\"\":s.trim(); } finally { br.close(); }\n  }\n\n  private static String[] split(String line){\n    ArrayList<String> parts = new ArrayList<String>();\n    int s=0;\n    for(int i=0;i<line.length();i++) if(line.charAt(i)==','){ parts.add(line.substring(s,i)); s=i+1; }\n    parts.add(line.substring(s));\n    String[] out = new String[parts.size()];\n    for(int i=0;i<parts.size();i++) out[i]=parts.get(i);\n    return out"]
