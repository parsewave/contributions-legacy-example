[456.054896, "i", "eportMd5) throws Exception {\n    Class.forName(\"org.h2.Driver\");\n    Connection c = DriverManager.getConnection(JDBC_URL, \"sa\", \"\");\n    try{\n      c.setAutoCommit(false);\n      Statement st=c.createStatement();\n      try{\n        safeExec(st,\"DROP TABLE RUN_AUDIT\");\n        safeExec(st,\"DROP TABLE TXNS\");\n        safeExec(st,\"DROP TABLE ACCOUNTS\");\n        st.execute(\"CREATE TABLE ACCOUNTS(ACCOUNT_ID VARCHAR(64) PRIMARY KEY,OPENED_AT VARCHAR(10),START_BALANCE DECIMAL(18,2),BASE_APR DECIMAL(18,10),PROMO_APR DECIMAL(18,10),PROMO_DAYS INT,TIER_THRESHOLD DECIMAL(18,2),TIER_APR DECIMAL(18,10),CURRENCY VARCHAR(8),FEE_PLAN VARCHAR(32))\");\n        st.execute(\"CREATE TABLE TXNS(ROW_NUM INT PRIMARY KEY,TX_ID VARCHAR(64),ACCOUNT_ID VARCHAR(64),EFFECTIVE_DATE VARCHAR(10),AMOUNT DECIMAL(18,2),CURRENCY VARCHAR(8),STATUS VARCHAR(16),REVERSAL_OF VARCHAR(64))\");\n        st.execute(\"CREATE TABLE RUN_AUDIT(JDBC_URL VARCHAR(255),BIZ_DATE VARCHAR(10),ACCOUNTS INT,VALID_TXS INT,SKIPPED_TXS INT,REPORT_MD5 VARCHAR(64))\");\n      } f"]
[456.054959, "i", "inally { st.close(); }\n\n      PreparedStatement pa=c.prepareStatement(\"INSERT INTO ACCOUNTS(ACCOUNT_ID,OPENED_AT,START_BALANCE,BASE_APR,PROMO_APR,PROMO_DAYS,TIER_THRESHOLD,TIER_APR,CURRENCY,FEE_PLAN) VALUES(?,?,?,?,?,?,?,?,?,?)\");\n      try{\n        ArrayList<String> ids=new ArrayList<String>(accts.keySet());\n        Collections.sort(ids);\n        for(int i=0;i<ids.size();i++){\n          Account a=accts.get(ids.get(i));\n          pa.setString(1,a.id);\n          pa.setString(2, DF.format(new Date(((long)a.openedDay)*86400000L)));\n          pa.setBigDecimal(3,a.start2);\n          pa.setBigDecimal(4,a.baseApr);\n          pa.setBigDecimal(5,a.promoApr);\n          pa.setInt(6,a.promoDays);\n          pa.setBigDecimal(7,a.tierThr2);\n          pa.setBigDecimal(8,a.tierApr);\n          pa.setString(9,a.ccy);\n          pa.setString(10,a.feePlan);\n          pa.executeUpdate();\n        }\n      } finally { pa.close(); }\n\n      PreparedStatement pt=c.prepareStatement(\"INSERT INTO TXNS(ROW_NUM,TX_ID,ACCOUNT_ID,EFFECTIVE_DATE"]
[456.055013, "o", "  private static String pair(String f,String t){ return f+\"|\"+t; }\r\n\u001b[?2004l\r"]
[456.055051, "i", ",AMOUNT,CURRENCY,STATUS,REVERSAL_OF) VALUES(?,?,?,?,?,?,?,?)\");\n      try{\n        for(int i=0;i<txns.size();i++){\n          Txn t=txns.get(i);\n          pt.setInt(1,t.rowNum);\n          pt.setString(2,t.txId);\n          pt.setString(3,t.acctId);\n          pt.setString(4,t.effStr);\n          pt.setBigDecimal(5,t.amt2);\n          pt.setString(6,t.ccy);\n          pt.setString(7,t.status);\n          pt.setString(8,t.reversalOf==null?\"\":t.reversalOf);\n          pt.executeUpdate();\n        }\n      } finally { pt.close(); }\n\n      PreparedStatement pr=c.prepareStatement(\"INSERT INTO RUN_AUDIT(JDBC_URL,BIZ_DATE,ACCOUNTS,VALID_TXS,SKIPPED_TXS,REPORT_MD5) VALUES(?,?,?,?,?,?)\");\n      try{\n        pr.setString(1,JDBC_URL);\n        pr.setString(2,bizDate);\n        pr.setInt(3,accounts);\n        pr.setInt(4,valid);\n        pr.setInt(5,skipped);\n        pr.setString(6,reportMd5);\n        pr.executeUpdate();\n      } finally { pr.close(); }\n\n      c.commit();\n    } finally {\n      try{ c.close(); }catch(Exception e){}\n    }"]
