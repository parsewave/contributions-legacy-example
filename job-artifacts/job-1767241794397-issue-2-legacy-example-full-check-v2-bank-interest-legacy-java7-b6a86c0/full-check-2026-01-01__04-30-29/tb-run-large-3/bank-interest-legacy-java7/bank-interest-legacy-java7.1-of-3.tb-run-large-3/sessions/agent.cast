[456.05438, "i", "cat >> /app/src/BankBatchJob.java <<'EOF'\n  private static String pair(String f,String t){ return f+\"|\"+t; }\n\n  private static FxRate latestLE(Map<String,List<FxRate>> byPair, String from, String to, int effDay){\n    List<FxRate> lst = byPair.get(pair(from,to));\n    if(lst==null) return null;\n    FxRate best=null;\n    for(int i=0;i<lst.size();i++){\n      FxRate r=lst.get(i);\n      if(r.day<=effDay) best=r; else break;\n    }\n    return best;\n  }\n\n  private static BigDecimal resolveDirectOrReverse(Map<String,List<FxRate>> byPair, String from, String to, int effDay){\n    if(from.equals(to)) return BigDecimal.ONE.setScale(10, RM);\n    FxRate direct = latestLE(byPair, from, to, effDay);\n    FxRate reverse = latestLE(byPair, to, from, effDay);\n    if(direct==null && reverse==null) return null;\n\n    boolean useDirect;\n    if(direct!=null && reverse!=null){\n      if(direct.day>reverse.day) useDirect=true;\n      else if(direct.day<reverse.day) useDirect=false;\n      else useDirect=true; // tie => direct\n    } else use"]
[456.054586, "i", "Direct = (direct!=null);\n\n    if(useDirect) return direct.rate.setScale(10, RM);\n    return BigDecimal.ONE.divide(reverse.rate, 10, RM);\n  }\n\n  private static BigDecimal resolveFx(Map<String,List<FxRate>> byPair, List<String> pivots, String from, String to, int effDay){\n    BigDecimal r = resolveDirectOrReverse(byPair, from, to, effDay);\n    if(r!=null) return r;\n    for(int i=0;i<pivots.size();i++){\n      String p=pivots.get(i);\n      if(p.equals(from) || p.equals(to)) continue;\n      BigDecimal a = resolveDirectOrReverse(byPair, from, p, effDay);\n      if(a==null) continue;\n      BigDecimal b = resolveDirectOrReverse(byPair, p, to, effDay);\n      if(b==null) continue;\n      return a.multiply(b).setScale(10, RM);\n    }\n    return null;\n  }\n\n  private static void safeExec(Statement st, String sql){ try{ st.execute(sql);}catch(SQLException e){} }\n\n  private static void buildDb(Map<String,Account> accts, List<Txn> txns,\n                              String bizDate, int accounts, int valid, int skipped, String r"]
