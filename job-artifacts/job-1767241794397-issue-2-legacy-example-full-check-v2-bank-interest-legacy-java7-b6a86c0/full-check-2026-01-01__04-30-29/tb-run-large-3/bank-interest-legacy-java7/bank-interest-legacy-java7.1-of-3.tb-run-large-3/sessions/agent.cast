[455.068943, "i", "cat >> /app/src/BankBatchJob.java <<'EOF'\n  private static Map<String,Account> loadAccounts() throws Exception {\n    List<String[]> rows = readCsv(ACCOUNTS_CSV);\n    Map<String,Integer> h = hdr(rows.get(0));\n    HashMap<String,Account> out = new HashMap<String,Account>();\n    for(int i=1;i<rows.size();i++){\n      String[] r=rows.get(i);\n      Account a=new Account();\n      a.id=col(r,h,\"account_id\");\n      a.openedDay=toDay(col(r,h,\"opened_at\"));\n      a.start2=bd2(col(r,h,\"start_balance\"));\n      a.baseApr=bd(col(r,h,\"base_apr\"));\n      a.promoApr=bd(col(r,h,\"promo_apr\"));\n      a.promoDays=Integer.parseInt(col(r,h,\"promo_days\"));\n      a.tierThr2=bd2(col(r,h,\"tier_threshold\"));\n      a.tierApr=bd(col(r,h,\"tier_apr\"));\n      a.ccy=col(r,h,\"currency\");\n      a.feePlan=col(r,h,\"fee_plan\");\n      out.put(a.id,a);\n    }\n    return out;\n  }\n\n  private static List<Txn> loadTxns() throws Exception {\n    List<String[]> rows = readCsv(TXNS_CSV);\n    Map<String,Integer> h = hdr(rows.get(0));\n    ArrayList<Txn> out = n"]
[455.069012, "i", "ew ArrayList<Txn>();\n    for(int i=1;i<rows.size();i++){\n      String[] r=rows.get(i);\n      Txn t=new Txn();\n      t.rowNum=i;\n      t.txId=col(r,h,\"tx_id\");\n      t.acctId=col(r,h,\"account_id\");\n      t.effStr=col(r,h,\"effective_date\");\n      t.effDay=toDay(t.effStr);\n      t.amt2=bd2(col(r,h,\"amount\"));\n      t.ccy=col(r,h,\"currency\");\n      t.status=col(r,h,\"status\");\n      t.reversalOf=col(r,h,\"reversal_of\");\n      if(t.reversalOf==null) t.reversalOf=\"\";\n      out.add(t);\n    }\n    return out;\n  }\n\n  private static Map<String,FeeRule> loadFees() throws Exception {\n    List<String[]> rows = readCsv(FEE_RULES_CSV);\n    Map<String,Integer> h = hdr(rows.get(0));\n    HashMap<String,FeeRule> out = new HashMap<String,FeeRule>();\n    for(int i=1;i<rows.size();i++){\n      String[] r=rows.get(i);\n      FeeRule fr=new FeeRule();\n      fr.plan=col(r,h,\"fee_plan\");\n      fr.applies=col(r,h,\"applies_to\");\n      fr.flat2=bd2(col(r,h,\"flat_fee\"));\n      fr.pct=bd(col(r,h,\"pct_fee\"));\n      fr.min2=bd2(col(r,h,\"min_fee\")"]
[455.069284, "i", ");\n      fr.max2=bd2(col(r,h,\"max_fee\"));\n      out.put(fr.plan, fr);\n    }\n    return out;\n  }\n\n  private static List<FxRate> loadFxRates() throws Exception {\n    List<String[]> rows = readCsv(FX_RATES_CSV);\n    Map<String,Integer> h = hdr(rows.get(0));\n    ArrayList<FxRate> out = new ArrayList<FxRate>();\n    for(int i=1;i<rows.size();i++){\n      String[] r=rows.get(i);\n      FxRate x=new FxRate();\n      x.day=toDay(col(r,h,\"rate_date\"));\n      x.from=col(r,h,\"from_ccy\");\n      x.to=col(r,h,\"to_ccy\");\n      x.rate=bd(col(r,h,\"rate\"));\n      out.add(x);\n    }\n    return out;\n  }\n\n  private static List<String> loadPivots() throws Exception {\n    List<String[]> rows = readCsv(FX_PIVOTS_CSV);\n    ArrayList<String> out = new ArrayList<String>();\n    for(int i=1;i<rows.size();i++){\n      if(rows.get(i).length==0) continue;\n      String p=rows.get(i)[0];\n      if(p!=null) p=p.trim();\n      if(p!=null && p.length()>0) out.add(p);\n    }\n    return out;\n  }\nEOF\n"]
