[593.958546, "i", "python - <<'PY'\nfrom pathlib import Path\nfor f in ['interest.csv','exceptions.csv','stats.json','bankdb.h2.db']:\n    p=Path('/app/output')/f\n    print(f, 'exists', p.exists(), 'size', p.stat().st_size if p.exists() else None)\n# newline rules\nb=(Path('/app/output')/'stats.json').read_bytes()\nprint('stats.json newline_count', b.count(b'\\n'))\nfor f in ['interest.csv','exceptions.csv']:\n    b=(Path('/app/output')/f).read_bytes()\nprint('interest.csv endswith LF', (Path('/app/output')/'interest.csv').read_bytes()[-1:]==b'\\n')\nprint('exceptions.csv endswith LF', (Path('/app/output')/'exceptions.csv').read_bytes()[-1:]==b'\\n')\nPY\n"]
