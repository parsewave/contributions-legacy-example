[569.699548, "o", "    ex.append(\"row_num,tx_id,reason\\n\");\r\n    for(int i=0;i<exc.size();i++){\r\n      String[] e=exc.get(i);\r\n      ex.append(e[0]).append(',').append(e[1]).append(',').append(e[2]).append(\"\\n\");\r\n    }\r\n    writeUtf8(EXCEPTIONS_CSV, ex.toString());\r\n\r\n    String reportMd5 = md5(readAll(INTEREST_CSV));\r\n    BigDecimal total2 = totalRaw10.setScale(2,RM);\r\n\r\n    String json = \"{\"+\r\n      \"\\\"biz_date\\\":\\\"\"+bizDate+\"\\\",\"+\r\n      \"\\\"accounts\\\":\"+accts.size()+\",\"+\r\n      \"\\\"valid_txs\\\":\"+valid+\",\"+\r\n      \"\\\"skipped_txs\\\":\"+skipped+\",\"+\r\n      \"\\\"total_interest\\\":\"+total2.toPlainString()+\",\"+\r\n      \"\\\"report_md5\\\":\\\"\"+reportMd5+\"\\\"\"+\r\n      \"}\";\r\n    writeUtf8(STATS_JSON, json);\r\n\r\n    buildDb(accts, txns, bizDate, accts.size(), valid, skipped, reportMd5);\r\n    del(new File(OUT_DIR, \"bankdb.trace.db\"));\r\n    del(new File(OUT_DIR, \"bankdb.lock.db\"));\r\n  }\r\n}\r\n"]
