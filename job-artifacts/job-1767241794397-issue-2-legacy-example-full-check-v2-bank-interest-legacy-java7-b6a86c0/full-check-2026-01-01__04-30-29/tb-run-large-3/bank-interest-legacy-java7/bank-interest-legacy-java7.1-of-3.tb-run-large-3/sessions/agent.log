  private static List<String[]> readCsv(File f) throws Exception {
    ArrayList<String[]> rows = new ArrayList<String[]>();
    BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));
    try {
      String line;
      while((line=br.readLine())!=null) rows.add(split(line));
    } finally { br.close(); }
    return rows;
  }

  private static Map<String,Integer> hdr(String[] h){
    HashMap<String,Integer> m = new HashMap<String,Integer>();
    for(int i=0;i<h.length;i++) m.put(h[i], Integer.valueOf(i));
    return m;
  }

  private static String col(String[] r, Map<String,Integer> m, String k){
    Integer i = m.get(k);
    if(i==null) return "";
    int n=i.intValue();
    return (n>=0 && n<r.length) ? r[n] : "";
  }

