    }

    HashSet<String> txIdsInFile = new HashSet<String>();
    for(int i=0;i<txns.size();i++) txIdsInFile.add(txns.get(i).txId);

    // REVERSED: both rows if reversal_of points to any tx_id in file
    HashSet<String> reversed = new HashSet<String>();
    for(int i=0;i<txns.size();i++){
      Txn t=txns.get(i);
      if(t.reversalOf!=null && t.reversalOf.length()>0 && txIdsInFile.contains(t.reversalOf)){
        reversed.add(t.txId);
        reversed.add(t.reversalOf);
      }
    }

    HashSet<String> seen = new HashSet<String>();
    ArrayList<String[]> exc = new ArrayList<String[]>();
    HashMap<String,BigDecimal> sumAdj2 = new HashMap<String,BigDecimal>();
    int valid=0, skipped=0;

    for(int i=0;i<txns.size();i++){
      Txn t=txns.get(i);
      String reason=null;

      if(reversed.contains(t.txId)) reason="REVERSED";
      else if(t.reversalOf!=null && t.reversalOf.length()>0 && !txIdsInFile.contains(t.reversalOf)) reason="REVERSAL_MISSING";
      else {
        Account a=accts.get(t.acctId);
        if(a==null) reason="FX_MISSING";
        else if(!t.ccy.equals(a.ccy)){
          BigDecimal rate=resolveFx(byPair,pivots,t.ccy,a.ccy,t.effDay);
          if(rate==null) reason="FX_MISSING";
        }
      }
      if(reason==null && t.effDay>bizDay) reason="AFTER_BIZ_DATE";
      if(reason==null && !"POSTED".equals(t.status)) reason=t.status;
      if(reason==null && seen.contains(t.txId)) reason="DUPLICATE";

      if(!seen.contains(t.txId)) seen.add(t.txId);

      if(reason!=null){
        skipped++;
        exc.add(new String[]{String.valueOf(t.rowNum), t.txId, reason});
        continue;
      }

      Account a=accts.get(t.acctId);
      BigDecimal amtAcct10;
      if(t.ccy.equals(a.ccy)) amtAcct10=t.amt2.setScale(10,RM);
      else {
        BigDecimal rate=resolveFx(byPair,pivots,t.ccy,a.ccy,t.effDay);
        amtAcct10=t.amt2.setScale(10,RM).multiply(rate).setScale(10,RM);
      }

      FeeRule fr=fees.get(a.feePlan);
      BigDecimal fee2=BD0.setScale(2,RM);
      if(fr!=null){
        boolean isDebit=amtAcct10.signum()<0;
        boolean isCredit=amtAcct10.signum()>0;
        boolean applies = "ALL".equals(fr.applies) || ("DEBIT".equals(fr.applies)&&isDebit) || ("CREDIT".equals(fr.applies)&&isCredit);
        if(applies){
          BigDecimal raw10 = fr.flat2.setScale(10,RM).add(fr.pct.multiply(amtAcct10.abs())).setScale(10,RM);
          BigDecimal f2 = raw10.setScale(2,RM);
          if(f2.compareTo(fr.min2)<0) f2=fr.min2;
          if(f2.compareTo(fr.max2)>0) f2=fr.max2;
          fee2=f2.setScale(2,RM);
        }
      }

      BigDecimal adj2 = amtAcct10.setScale(2,RM).subtract(fee2).setScale(2,RM);
      BigDecimal prev=sumAdj2.get(a.id);
      if(prev==null) prev=BD0.setScale(2,RM);
      sumAdj2.put(a.id, prev.add(adj2).setScale(2,RM));
      valid++;
    }

    ArrayList<String> acctIds=new ArrayList<String>(accts.keySet());
    Collections.sort(acctIds);

