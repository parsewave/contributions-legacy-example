Sending keys: ['cat > /app/src/BankBatchJob.java <<\'JAVA\'\nimport java.io.*;\nimport java.math.*;\nimport java.nio.charset.Charset;\nimport java.security.MessageDigest;\nimport java.sql.*;\nimport java.text.ParseException;\nimport java.text.SimpleDateFormat;\nimport java.util.*;\n\npublic class BankBatchJob {\n\n    private static final Charset UTF8 = Charset.forName("UTF-8");\n    private static final RoundingMode HALF_EVEN = RoundingMode.HALF_EVEN;\n\n    private static final File DATA_DIR = new File("/app/data");\n    private static final File OUT_DIR = new File("/app/output");\n\n    // Must be a single literal string containing MODE=DB2 and /app/output/bankdb\n    private static final String JDBC_URL = "jdbc:h2:/app/output/bankdb;MODE=DB2";\n\n    public static void main(String[] args) throws Exception {\n        ensureCleanOutputDir();\n\n        String bizDate = readFirstLine(new File(DATA_DIR, "biz_date.txt")).trim();\n        int bizDay = parseDay(bizDate);\n\n        Map<String, FeeRule> feeRules = loadFeeRules(new File(DATA_DIR, "fee_rules.csv"));\n        List<String> pivots = loadPivots(new File(DATA_DIR, "fx_pivots.csv"));\n        FxBook fxBook = loadFxRates(new File(DATA_DIR, "fx_rates.csv"));\n\n        LinkedHashMap<String, Account> accounts = loadAccounts(new File(DATA_DIR, "accounts.csv"));\n\n        List<Txn> txns = loadTxns(new File(DATA_DIR, "transactions.csv"));\n\n        // Precompute reversal relationships: if reversal_of points to any tx_id in file -> both rows REVERSED\n        HashSet<String> allTxIds = new HashSet<String>();\n        for (Txn t : txns) allTxIds.add(t.txId);\n        HashSet<String> reversedTxIds = new HashSet<String>();\n        for (Txn t : txns) {\n            if (t.reversalOf != null && t.reversalOf.length() > 0 && allTxIds.contains(t.reversalOf)) {\n                reversedTxIds.add(t.txId);\n                reversedTxIds.add(t.reversalOf);\n            }\n        }\n\n        // H2 DB: create and load ACCOUNTS + TXNS (all rows)\n        createAndLoadDb(accounts, txns, bizDate);\n\n        // Process txns into exceptions + per-account adjustments\n        LinkedHashMap<String, BigDecimal> acctAdjSum = new LinkedHashMap<String, BigDecimal>();\n        for (String acctId : accounts.keySet()) {\n            acctAdjSum.put(acctId, bd("0.00"));\n        }\n\n        List<ExceptionRow> exceptions = new ArrayList<ExceptionRow>();\n        int validTxs = 0;\n        int skippedTxs = 0;\n\n        HashSet<String> seenTxIds = new HashSet<String>();\n\n        for (Txn t : txns) {\n            boolean isDup = seenTxIds.contains(t.txId);\n            if (!isDup) seenTxIds.add(t.txId);\n\n            String reason = null;\n\n            // Reasons in required precedence order\n            if (reversedTxIds.contains(t.txId)) {\n                reason = "REVERSED";\n            } else if (t.reversalOf != null && t.reversalOf.length() > 0 && !allTxIds.contains(t.reversalOf)) {\n                reason = "REVERSAL_MISSING";\n            } else {\n                Account acct = accounts.get(t.accountId);\n                if (acct == null) {\n                    // Not specified in the required list; treat as a skipped record with an explicit reason.\n                    reason = "ACCOUNT_MISSING";\n                } else {\n                    BigDecimal fx = null;\n                    if (!t.currency.equals(acct.currency)) {\n                        fx = fxBook.resolveRate(t.currency, acct.currency, t.effectiveDay, pivots);\n                        if (fx == null) {\n                            reason = "FX_MISSING";\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (t.effectiveDay > bizDay) {\n                            reason = "AFTER_BIZ_DATE";\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (!"POSTED".equals(t.status)) {\n                            reason = t.status;\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (isDup) {\n                            reason = "DUPLICATE";\n                        }\n                    }\n\n                    if (reason == null) {\n                        // Valid: convert to account ccy, then fee, then add adjusted amount\n                        BigDecimal amtAcc = t.amount;\n                        if (fx != null) {\n                            amtAcc = amtAcc.multiply(fx).setScale(10, HALF_EVEN).setScale(2, HALF_EVEN);\n                        } else {\n                            amtAcc = amtAcc.setScale(2, HALF_EVEN);\n                        }\n\n                        FeeRule rule = feeRules.get(acct.feePlan);\n                        BigDecimal adjusted = applyFee(rule, amtAcc);\n\n                        BigDecimal cur = acctAdjSum.get(acct.accountId);\n                        if (cur == null) cur = bd("0.00");\n                        acctAdjSum.put(acct.accountId, cur.add(adjusted).setScale(2, HALF_EVEN));\n                        validTxs++;\n                    }\n                }\n            }\n\n            if (reason != null) {\n                exceptions.add(new ExceptionRow(t.rowNum, t.txId, reason));\n                skippedTxs++;\n            }\n        }\n\n        // Build interest.csv bytes (to compute md5 from the exact bytes written)\n        InterestAndTotals it = buildInterestCsv(accounts, acctAdjSum, bizDate, bizDay);\n\n        // Write interest.csv (LF + trailing newline)\n        writeBytes(new File(OUT_DIR, "interest.csv"), it.interestCsvBytes);\n\n        String reportMd5 = md5Hex(it.interestCsvBytes);\n\n        // Write exceptions.csv (LF + trailing newline)\n        writeExceptionsCsv(new File(OUT_DIR, "exceptions.csv"), exceptions);\n\n        // Write stats.json (single line, no newline)\n        writeStatsJson(new File(OUT_DIR, "stats.json"), bizDate, accounts.size(), validTxs, skippedTxs, it.totalInterest2dp, reportMd5);\n\n        // Insert RUN_AUDIT row\n        insertRunAudit(bizDate, accounts.size(), validTxs, skippedTxs, reportMd5);\n    }\n\n    private static void ensureCleanOutputDir() throws IOException {\n        if (!OUT_DIR.exists()) {\n            if (!OUT_DIR.mkdirs()) throw new IOException("Failed to create /app/output");\n        }\n        // Clear known output files to keep reruns deterministic\n        deleteIfExists(new File(OUT_DIR, "interest.csv"));\n        deleteIfExists(new File(OUT_DIR, "exceptions.csv"));\n        deleteIfExists(new File(OUT_DIR, "stats.json"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.h2.db"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.lock.db"));\n    }\n\n    private static void deleteIfExists(File f) {\n        try {\n            if (f.exists()) f.delete();\n        } catch (Exception ignored) {\n        }\n    }\n\n    private static LinkedHashMap<String, Account> loadAccounts(File f) throws IOException {\n        LinkedHashMap<String, Account> out = new LinkedHashMap<String, Account>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException("accounts.csv missing header");\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                String[] a = splitCsv(line);\n                Account acct = new Account();\n                acct.accountId = a[0];\n                acct.openedAt = a[1];\n                acct.openedDay = parseDay(acct.openedAt);\n                acct.startBalance = bd(a[2]).setScale(2, HALF_EVEN);\n                acct.baseApr = bd(a[3]);\n                acct.promoApr = bd(a[4]);\n                acct.promoDays = Integer.parseInt(a[5]);\n                acct.tierThreshold = bd(a[6]).setScale(2, HALF_EVEN);\n                acct.tierApr = bd(a[7]);\n                acct.currency = a[8];\n                acct.feePlan = a[9];\n                out.put(acct.accountId, acct);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static List<Txn> loadTxns(File f) throws IOException {\n        ArrayList<Txn> out = new ArrayList<Txn>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException("transactions.csv missing header");\n            String line;\n            int rowNum = 0;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                rowNum++;\n                String[] a = splitCsv(line);\n                Txn t = new Txn();\n                t.rowNum = rowNum;\n                t.txId = a[0];\n                t.accountId = a[1];\n                t.effectiveDate = a[2];\n                t.effectiveDay = parseDay(t.effectiveDate);\n                t.amount = bd(a[3]).setScale(2, HALF_EVEN);\n                t.currency = a[4];\n                t.status = a[5];\n                t.reversalOf = (a.length >= 7) ? a[6] : "";\n                if (t.reversalOf == null) t.reversalOf = "";\n                out.add(t);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static Map<String, FeeRule> loadFeeRules(File f) throws IOException {\n        HashMap<String, FeeRule> out = new HashMap<String, FeeRule>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException("fee_rules.csv missing header");\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                String[] a = splitCsv(line);\n                FeeRule r = new FeeRule();\n                r.feePlan = a[0];\n                r.appliesTo = a[1];\n                r.flatFee = bd(a[2]).setScale(2, HALF_EVEN);\n                r.pctFee = bd(a[3]);\n                r.minFee = bd(a[4]).setScale(2, HALF_EVEN);\n                r.maxFee = bd(a[5]).setScale(2, HALF_EVEN);\n                out.put(r.feePlan, r);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static List<String> loadPivots(File f) throws IOException {\n        ArrayList<String> out = new ArrayList<String>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException("fx_pivots.csv missing header");\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                String[] a = splitCsv(line);\n                out.add(a[0]);\n            }\n        } finally {\n            br.close();\n        }\n        return out;\n    }\n\n    private static FxBook loadFxRates(File f) throws IOException {\n        FxBook book = new FxBook();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String header = br.readLine();\n            if (header == null) throw new IOException("fx_rates.csv missing header");\n            String line;\n            while ((line = br.readLine()) != null) {\n                line = line.trim();\n                if (line.length() == 0) continue;\n                String[] a = splitCsv(line);\n                int rateDay = parseDay(a[0]);\n                String from = a[1];\n                String to = a[2];\n                BigDecimal rate = bd(a[3]);\n                book.add(rateDay, from, to, rate);\n            }\n        } finally {\n            br.close();\n        }\n        return book;\n    }\n\n    private static BigDecimal applyFee(FeeRule rule, BigDecimal amtAcc) {\n        if (rule == null) return amtAcc.setScale(2, HALF_EVEN);\n\n        boolean isDebit = amtAcc.compareTo(BigDecimal.ZERO) < 0;\n        boolean isCredit = amtAcc.compareTo(BigDecimal.ZERO) > 0;\n        boolean applies;\n\n        if ("ALL".equals(rule.appliesTo)) {\n            applies = true;\n        } else if ("DEBIT".equals(rule.appliesTo)) {\n            applies = isDebit;\n        } else if ("CREDIT".equals(rule.appliesTo)) {\n            applies = isCredit;\n        } else {\n            applies = false;\n        }\n\n        if (!applies) {\n            return amtAcc.setScale(2, HALF_EVEN);\n        }\n\n        BigDecimal abs = amtAcc.abs();\n        BigDecimal feeRaw = rule.flatFee.add(rule.pctFee.multiply(abs));\n        BigDecimal fee = feeRaw.setScale(2, HALF_EVEN);\n        if (fee.compareTo(rule.minFee) < 0) fee = rule.minFee;\n        if (fee.compareTo(rule.maxFee) > 0) fee = rule.maxFee;\n\n        BigDecimal adjusted = amtAcc.subtract(fee);\n        return adjusted.setScale(2, HALF_EVEN);\n    }\n\n    private static InterestAndTotals buildInterestCsv(LinkedHashMap<String, Account> accounts,\n                                                     Map<String, BigDecimal> acctAdjSum,\n                                                     String bizDate,\n                                                     int bizDay) throws IOException {\n        ByteArrayOutputStream baos = new ByteArrayOutputStream();\n        OutputStreamWriter osw = new OutputStreamWriter(baos, UTF8);\n        BufferedWriter bw = new BufferedWriter(osw);\n\n        BigDecimal totalInterestRawSum10dp = BigDecimal.ZERO.setScale(10, HALF_EVEN);\n\n        bw.write("account_id,biz_date,eod_balance,apr,daily_interest\\n");\n\n        // Sorted by account_id\n        ArrayList<String> acctIds = new ArrayList<String>(accounts.keySet());\n        Collections.sort(acctIds);\n\n        for (String acctId : acctIds) {\n            Account a = accounts.get(acctId);\n            BigDecimal adj = acctAdjSum.get(acctId);\n            if (adj == null) adj = bd("0.00");\n\n            BigDecimal eod = a.startBalance.add(adj).setScale(2, HALF_EVEN);\n\n            BigDecimal apr = a.baseApr;\n            if (eod.compareTo(a.tierThreshold) >= 0) {\n                apr = apr.add(a.tierApr);\n            }\n            int daysSince = bizDay - a.openedDay;\n            if (a.promoDays > 0 && daysSince < a.promoDays) {\n                apr = apr.add(a.promoApr);\n            }\n\n            BigDecimal principal = eod;\n            if (principal.compareTo(BigDecimal.ZERO) < 0) principal = BigDecimal.ZERO.setScale(2, HALF_EVEN);\n\n            BigDecimal dailyInterestRaw = principal.multiply(apr).divide(bd("365"), 10, HALF_EVEN);\n            BigDecimal dailyInterestCsv = dailyInterestRaw.setScale(2, HALF_EVEN);\n            totalInterestRawSum10dp = totalInterestRawSum10dp.add(dailyInterestRaw).setScale(10, HALF_EVEN);\n\n            bw.write(a.accountId);\n            bw.write(",");\n            bw.write(bizDate);\n            bw.write(",");\n            bw.write(eod.setScale(2, HALF_EVEN).toPlainString());\n            bw.write(",");\n            bw.write(apr.setScale(6, HALF_EVEN).toPlainString());\n            bw.write(",");\n            bw.write(dailyInterestCsv.toPlainString());\n            bw.write("\\n");\n        }\n\n        bw.flush();\n\n        InterestAndTotals out = new InterestAndTotals();\n        out.interestCsvBytes = baos.toByteArray();\n        out.totalInterest2dp = totalInterestRawSum10dp.setScale(2, HALF_EVEN);\n        return out;\n    }\n\n    private static void writeExceptionsCsv(File f, List<ExceptionRow> rows) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(f), UTF8));\n        try {\n            bw.write("row_num,tx_id,reason\\n");\n            for (ExceptionRow r : rows) {\n                bw.write(Integer.toString(r.rowNum));\n                bw.write(",");\n                bw.write(r.txId);\n                bw.write(",");\n                bw.write(r.reason);\n                bw.write("\\n");\n            }\n        } finally {\n            bw.close();\n        }\n    }\n\n    private static void writeStatsJson(File f,\n                                      String bizDate,\n                                      int accounts,\n                                      int validTxs,\n                                      int skippedTxs,\n                                      BigDecimal totalInterest2dp,\n                                      String reportMd5) throws IOException {\n        // single line, no newline\n        String json =\n                "{" +\n                "\\"business_date\\":\\"" + escapeJson(bizDate) + "\\"," +\n                "\\"accounts\\":" + accounts + "," +\n                "\\"valid_txs\\":" + validTxs + "," +\n                "\\"skipped_txs\\":" + skippedTxs + "," +\n                "\\"total_interest\\":\\"" + escapeJson(totalInterest2dp.setScale(2, HALF_EVEN).toPlainString()) + "\\"," +\n                "\\"report_md5\\":\\"" + escapeJson(reportMd5) + "\\"" +\n                "}";\n\n        OutputStream os = new FileOutputStream(f);\n        try {\n            os.write(json.getBytes(UTF8));\n        } finally {\n            os.close();\n        }\n    }\n\n    private static String escapeJson(String s) {\n        if (s == null) return "";\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            if (c == \'"\') sb.append("\\\\\\"");\n            else if (c == \'\\\\\') sb.append("\\\\\\\\");\n            else sb.append(c);\n        }\n        return sb.toString();\n    }\n\n    private static void writeBytes(File f, byte[] bytes) throws IOException {\n        OutputStream os = new FileOutputStream(f);\n        try {\n            os.write(bytes);\n        } finally {\n            os.close();\n        }\n    }\n\n    private static String md5Hex(byte[] bytes) throws Exception {\n        MessageDigest md = MessageDigest.getInstance("MD5");\n        byte[] dig = md.digest(bytes);\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < dig.length; i++) {\n            int b = dig[i] & 0xff;\n            if (b < 16) sb.append(\'0\');\n            sb.append(Integer.toHexString(b));\n        }\n        return sb.toString();\n    }\n\n    private static void createAndLoadDb(LinkedHashMap<String, Account> accounts, List<Txn> txns, String bizDate) throws Exception {\n        Class.forName("org.h2.Driver");\n        Connection c = DriverManager.getConnection(JDBC_URL, "sa", "");\n        try {\n            Statement st = c.createStatement();\n            try {\n                // Drop if exists to ensure deterministic reruns\n                safeExecute(st, "DROP TABLE RUN_AUDIT");\n                safeExecute(st, "DROP TABLE TXNS");\n                safeExecute(st, "DROP TABLE ACCOUNTS");\n\n                st.execute("CREATE TABLE ACCOUNTS (" +\n                        "ACCOUNT_ID VARCHAR(32) PRIMARY KEY, " +\n                        "OPENED_AT DATE, " +\n                        "START_BALANCE DECIMAL(18,2), " +\n                        "BASE_APR DECIMAL(18,10), " +\n                        "PROMO_APR DECIMAL(18,10), " +\n                        "PROMO_DAYS INT, " +\n                        "TIER_THRESHOLD DECIMAL(18,2), " +\n                        "TIER_APR DECIMAL(18,10), " +\n                        "CURRENCY VARCHAR(8), " +\n                        "FEE_PLAN VARCHAR(32)" +\n                        ")");\n\n                st.execute("CREATE TABLE TXNS (" +\n                        "ROW_NUM INT PRIMARY KEY, " +\n                        "TX_ID VARCHAR(64), " +\n                        "ACCOUNT_ID VARCHAR(32), " +\n                        "EFFECTIVE_DATE DATE, " +\n                        "AMOUNT DECIMAL(18,2), " +\n                        "CURRENCY VARCHAR(8), " +\n                        "STATUS VARCHAR(32), " +\n                        "REVERSAL_OF VARCHAR(64)" +\n                        ")");\n\n                st.execute("CREATE TABLE RUN_AUDIT (" +\n                        "JDBC_URL VARCHAR(2000), " +\n                        "BIZ_DATE DATE, " +\n                        "ACCOUNTS INT, " +\n                        "VALID_TXS INT, " +\n                        "SKIPPED_TXS INT, " +\n                        "REPORT_MD5 VARCHAR(64)" +\n                        ")");\n\n            } finally {\n                st.close();\n            }\n\n            PreparedStatement psA = c.prepareStatement(\n                    "INSERT INTO ACCOUNTS (ACCOUNT_ID, OPENED_AT, START_BALANCE, BASE_APR, PROMO_APR, PROMO_DAYS, TIER_THRESHOLD, TIER_APR, CURRENCY, FEE_PLAN) VALUES (?,?,?,?,?,?,?,?,?,?)");\n            try {\n                for (Account a : accounts.values()) {\n                    psA.setString(1, a.accountId);\n                    psA.setDate(2, java.sql.Date.valueOf(a.openedAt));\n                    psA.setBigDecimal(3, a.startBalance);\n                    psA.setBigDecimal(4, a.baseApr);\n                    psA.setBigDecimal(5, a.promoApr);\n                    psA.setInt(6, a.promoDays);\n                    psA.setBigDecimal(7, a.tierThreshold);\n                    psA.setBigDecimal(8, a.tierApr);\n                    psA.setString(9, a.currency);\n                    psA.setString(10, a.feePlan);\n                    psA.executeUpdate();\n                }\n            } finally {\n                psA.close();\n            }\n\n            PreparedStatement psT = c.prepareStatement(\n                    "INSERT INTO TXNS (ROW_NUM, TX_ID, ACCOUNT_ID, EFFECTIVE_DATE, AMOUNT, CURRENCY, STATUS, REVERSAL_OF) VALUES (?,?,?,?,?,?,?,?)");\n            try {\n                for (Txn t : txns) {\n                    psT.setInt(1, t.rowNum);\n                    psT.setString(2, t.txId);\n                    psT.setString(3, t.accountId);\n                    psT.setDate(4, java.sql.Date.valueOf(t.effectiveDate));\n                    psT.setBigDecimal(5, t.amount);\n                    psT.setString(6, t.currency);\n                    psT.setString(7, t.status);\n                    psT.setString(8, (t.reversalOf == null) ? "" : t.reversalOf);\n                    psT.executeUpdate();\n                }\n            } finally {\n                psT.close();\n            }\n        } finally {\n            c.close();\n        }\n    }\n\n    private static void insertRunAudit(String bizDate, int accounts, int validTxs, int skippedTxs, String reportMd5) throws Exception {\n        Connection c = DriverManager.getConnection(JDBC_URL, "sa", "");\n        try {\n            Statement st = c.createStatement();\n            try {\n                safeExecute(st, "DELETE FROM RUN_AUDIT");\n            } finally {\n                st.close();\n            }\n\n            PreparedStatement ps = c.prepareStatement(\n                    "INSERT INTO RUN_AUDIT (JDBC_URL, BIZ_DATE, ACCOUNTS, VALID_TXS, SKIPPED_TXS, REPORT_MD5) VALUES (?,?,?,?,?,?)");\n            try {\n                ps.setString(1, JDBC_URL);\n                ps.setDate(2, java.sql.Date.valueOf(bizDate));\n                ps.setInt(3, accounts);\n                ps.setInt(4, validTxs);\n                ps.setInt(5, skippedTxs);\n                ps.setString(6, reportMd5);\n                ps.executeUpdate();\n            } finally {\n                ps.close();\n            }\n        } finally {\n            c.close();\n        }\n    }\n\n    private static void safeExecute(Statement st, String sql) {\n        try {\n            st.execute(sql);\n        } catch (SQLException ignored) {\n        }\n    }\n\n    private static String readFirstLine(File f) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String s = br.readLine();\n            if (s == null) return "";\n            return s;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static BigDecimal bd(String s) {\n        return new BigDecimal(s);\n    }\n\n    // yyyy-MM-dd -> day number using UTC to avoid DST surprises\n    private static int parseDay(String yyyyMmDd) {\n        try {\n            SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");\n            sdf.setLenient(false);\n            sdf.setTimeZone(TimeZone.getTimeZone("UTC"));\n            Date d = sdf.parse(yyyyMmDd);\n            long ms = d.getTime();\n            return (int) (ms / 86400000L);\n        } catch (ParseException e) {\n            throw new RuntimeException("Bad date: " + yyyyMmDd, e);\n        }\n    }\n\n    private static String[] splitCsv(String line) {\n        // Inputs are simple (no quoted commas)\n        return line.split(",", -1);\n    }\n\n    private static class Account {\n        String accountId;\n        String openedAt;\n        int openedDay;\n        BigDecimal startBalance;\n        BigDecimal baseApr;\n        BigDecimal promoApr;\n        int promoDays;\n        BigDecimal tierThreshold;\n        BigDecimal tierApr;\n        String currency;\n        String feePlan;\n    }\n\n    private static class Txn {\n        int rowNum;\n        String txId;\n        String accountId;\n        String effectiveDate;\n        int effectiveDay;\n        BigDecimal amount;\n        String currency;\n        String status;\n        String reversalOf;\n    }\n\n    private static class FeeRule {\n        String feePlan;\n        String appliesTo;\n        BigDecimal flatFee;\n        BigDecimal pctFee;\n        BigDecimal minFee;\n        BigDecimal maxFee;\n    }\n\n    private static class ExceptionRow {\n        int rowNum;\n        String txId;\n        String reason;\n        ExceptionRow(int rowNum, String txId, String reason) {\n            this.rowNum = rowNum;\n            this.txId = txId;\n            this.reason = reason;\n        }\n    }\n\n    private static class InterestAndTotals {\n        byte[] interestCsvBytes;\n        BigDecimal totalInterest2dp;\n    }\n\n    private static class FxBook {\n        // key: from|to -> list of (rateDay, rate)\n        private final HashMap<String, ArrayList<FxRate>> rates = new HashMap<String, ArrayList<FxRate>>();\n\n        void add(int rateDay, String from, String to, BigDecimal rate) {\n            String k = key(from, to);\n            ArrayList<FxRate> lst = rates.get(k);\n            if (lst == null) {\n                lst = new ArrayList<FxRate>();\n                rates.put(k, lst);\n            }\n            FxRate r = new FxRate();\n            r.rateDay = rateDay;\n            r.rate = rate;\n            lst.add(r);\n        }\n\n        BigDecimal resolveRate(String from, String to, int effectiveDay, List<String> pivots) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, HALF_EVEN);\n\n            // direct and reverse candidates\n            RatePick direct = pickLatest(from, to, effectiveDay);\n            RatePick reverse = pickLatest(to, from, effectiveDay);\n\n            if (direct != null && reverse != null) {\n                if (direct.rateDay > reverse.rateDay) {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                } else if (reverse.rateDay > direct.rateDay) {\n                    return invert(reverse.rate);\n                } else {\n                    // tied -> choose direct\n                    return direct.rate.setScale(10, HALF_EVEN);\n                }\n            } else if (direct != null) {\n                return direct.rate.setScale(10, HALF_EVEN);\n            } else if (reverse != null) {\n                return invert(reverse.rate);\n            }\n\n            // pivot search in order\n            for (int i = 0; i < pivots.size(); i++) {\n                String p = pivots.get(i);\n                if (p.equals(from) || p.equals(to)) continue;\n\n                BigDecimal leg1 = resolveRateNoPivot(from, p, effectiveDay);\n                if (leg1 == null) continue;\n                BigDecimal leg2 = resolveRateNoPivot(p, to, effectiveDay);\n                if (leg2 == null) continue;\n\n                BigDecimal combined = leg1.multiply(leg2).setScale(10, HALF_EVEN);\n                return combined;\n            }\n\n            return null;\n        }\n\n        private BigDecimal resolveRateNoPivot(String from, String to, int effectiveDay) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, HALF_EVEN);\n\n            RatePick direct = pickLatest(from, to, effectiveDay);\n            RatePick reverse = pickLatest(to, from, effectiveDay);\n\n            if (direct != null && reverse != null) {\n                if (direct.rateDay > reverse.rateDay) {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                } else if (reverse.rateDay > direct.rateDay) {\n                    return invert(reverse.rate);\n                } else {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                }\n            } else if (direct != null) {\n                return direct.rate.setScale(10, HALF_EVEN);\n            } else if (reverse != null) {\n                return invert(reverse.rate);\n            }\n            return null;\n        }\n\n        private RatePick pickLatest(String from, String to, int effectiveDay) {\n            ArrayList<FxRate> lst = rates.get(key(from, to));\n            if (lst == null) return null;\n\n            int bestDay = Integer.MIN_VALUE;\n            BigDecimal bestRate = null;\n\n            for (int i = 0; i < lst.size(); i++) {\n                FxRate r = lst.get(i);\n                if (r.rateDay <= effectiveDay && r.rateDay > bestDay) {\n                    bestDay = r.rateDay;\n                    bestRate = r.rate;\n                }\n            }\n\n            if (bestRate == null) return null;\n            RatePick p = new RatePick();\n            p.rateDay = bestDay;\n            p.rate = bestRate;\n            return p;\n        }\n\n        private BigDecimal invert(BigDecimal rate) {\n            // reverse 1/rate (HALF_EVEN 10dp)\n            return BigDecimal.ONE.divide(rate, 10, HALF_EVEN);\n        }\n\n        private String key(String from, String to) {\n            return from + "|" + to;\n        }\n\n        private static class FxRate {\n            int rateDay;\n            BigDecimal rate;\n        }\n\n        private static class RatePick {\n            int rateDay;\n            BigDecimal rate;\n        }\n    }\n}\nJAVA\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
