o");\n      fr.flat2=bd2(col(r,h,"flat_fee"));\n      fr.pct=bd(col(r,h,"pct_fee"));\n      fr.min2=bd2(col(r,h,"min_fee"));\n      fr.max2=bd2(col(r,h,"max_fee"));\n      out.put(fr.plan, fr);\n    }\n    return out;\n  }\n\n  private static List<FxRate> loadFxRates() throws Exception {\n    List<String[]> rows = readCsv(FX_RATES_CSV);\n    Map<String,Integer> h = hdr(rows.get(0));\n    ArrayList<FxRate> out = new ArrayList<FxRate>();\n    for(int i=1;i<rows.size();i++){\n      String[] r=rows.get(i);\n      FxRate x=new FxRate();\n      x.day=toDay(col(r,h,"rate_date"));\n      x.from=col(r,h,"from_ccy");\n      x.to=col(r,h,"to_ccy");\n      x.rate=bd(col(r,h,"rate"));\n      out.add(x);\n    }\n    return out;\n  }\n\n  private static List<String> loadPivots() throws Exception {\n    List<String[]> rows = readCsv(FX_PIVOTS_CSV);\n    ArrayList<String> out = new ArrayList<String>();\n    for(int i=1;i<rows.size();i++){\n      if(rows.get(i).length==0) continue;\n      String p=rows.get(i)[0];\n      if(p!=null) p=p.trim();\n      if(p!=null && p.length()>0) out.add(p);\n    }\n    return out;\n  }\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat >> /app/src/BankBatchJob.java <<\'EOF\'\n  private static String pair(String f,String t){ return f+"|"+t; }\n\n  private static FxRate latestLE(Map<String,List<FxRate>> byPair, String from, String to, int effDay){\n    List<FxRate> lst = byPair.get(pair(from,to));\n    if(lst==null) return null;\n    FxRate best=null;\n    for(int i=0;i<lst.size();i++){\n      FxRate r=lst.get(i);\n      if(r.day<=effDay) best=r; else break;\n    }\n    return best;\n  }\n\n  private static BigDecimal resolveDirectOrReverse(Map<String,List<FxRate>> byPair, String from, String to, int effDay){\n    if(from.equals(to)) return BigDecimal.ONE.setScale(10, RM);\n    FxRate direct = latestLE(byPair, from, to, effDay);\n    FxRate reverse = latestLE(byPair, to, from, effDay);\n    if(direct==null && reverse==null) return null;\n\n    boolean useDirect;\n    if(direct!=null && reverse!=null){\n      if(direct.day>reverse.day) useDirect=true;\n      else if(direct.day<reverse.day) useDirect=false;\n      else useDirect=true; // tie => direct\n    } else useDirect = (direct!=null);\n\n    if(useDirect) return direct.rate.setScale(10, RM);\n    return BigDecimal.ONE.divide(reverse.rate, 10, RM);\n  }\n\n  private static BigDecimal resolveFx(Map<String,List<FxRate>> byPair, List<String> pivots, String from, String to, int effDay){\n    BigDecimal r = resolveDirectOrReverse(byPair, from, to, effDay);\n    if(r!=null) return r;\n    for(int i=0;i<pivots.size();i++){\n      String p=pivots.get(i);\n      if(p.equals(from) || p.equals(to)) continue;\n      BigDecimal a = resolveDirectOrReverse(byPair, from, p, effDay);\n      if(a==null) continue;\n      BigDecimal b = resolveDirectOrReverse(byPair, p, to, effDay);\n      if(b==null) continue;\n      return a.multiply(b).setScale(10, RM);\n    }\n    return null;\n  }\n\n  private static void safeExec(Statement st, String sql){ try{ st.execute(sql);}catch(SQLException e){} }\n\n  private static void buildDb(Map<String,Account> accts, List<Txn> txns,\n                              String bizDate, int accounts, int valid, int skipped, String reportMd5) throws Exception {\n    Class.forName("org.h2.Driver");\n    Connection c = DriverManager.getConnection(JDBC_URL, "sa", "");\n    try{\n      c.setAutoCommit(false);\n      Statement st=c.createStatement();\n      try{\n        safeExec(st,"DROP TABLE RUN_AUDIT");\n        safeExec(st,"DROP TABLE TXNS");\n        safeExec(st,"DROP TABLE ACCOUNTS");\n        st.execute("CREATE TABLE ACCOUNTS(ACCOUNT_ID VARCHAR(64) PRIMARY KEY,OPENED_AT VARCHAR(10),START_BALANCE DECIMAL(18,2),BASE_APR DECIMAL(18,10),PROMO_APR DECIMAL(18,10),PROMO_DAYS INT,TIER_THRESHOLD DECIMAL(18,2),TIER_APR DECIMAL(18,10),CURRENCY VARCHAR(8),FEE_PLAN VARCHAR(32))");\n        st.execute("CREATE TABLE TXNS(ROW_NUM INT PRIMARY KEY,TX_ID VARCHAR(64),ACCOUNT_ID VARCHAR(64),EFFECTIVE_DATE VARCHAR(10),AMOUNT DECIMAL(18,2),CURRENCY VARCHAR(8),STATUS VARCHAR(16),REVERSAL_OF VARCHAR(64))");\n        st.execute("CREATE TABLE RUN_AUDIT(JDBC_URL VARCHAR(255),BIZ_DATE VARCHAR(10),ACCOUNTS INT,VALID_TXS INT,SKIPPED_TXS INT,REPORT_MD5 VARCHAR(64))");\n      } finally { st.close(); }\n\n      PreparedStatement pa=c.prepareStatement("INSERT INTO ACCOUNTS(ACCOUNT_ID,OPENED_AT,START_BALANCE,BASE_APR,PROMO_APR,PROMO_DAYS,TIER_THRESHOLD,TIER_APR,CURRENCY,FEE_PLAN) VALUES(?,?,?,?,?,?,?,?,?,?)");\n      try{\n        ArrayList<String> ids=new ArrayList<String>(accts.keySet());\n        Collections.sort(ids);\n        for(int i=0;i<ids.size();i++){\n          Account a=accts.get(ids.get(i));\n          pa.setString(1,a.id);\n          pa.setString(2, DF.format(new Date(((long)a.openedDay)*86400000L)));\n          pa.setBigDecimal(3,a.start2);\n          pa.setBigDecimal(4,a.baseApr);\n          pa.setBigDecimal(5,a.promoApr);\n          pa.setInt(6,a.promoDays);\n          pa.setBigDecimal(7,a.tierThr2);\n          pa.setBigDecimal(8,a.tierApr);\n          pa.setString(9,a.ccy);\n          pa.setString(10,a.feePlan);\n          pa.executeUpdate();\n        }\n      } finally { pa.close(); }\n\n      PreparedStatement pt=c.prepareStatement("INSERT INTO TXNS(ROW_NUM,TX_ID,ACCOUNT_ID,EFFECTIVE_DATE,AMOUNT,CURRENCY,STATUS,REVERSAL_OF) VALUES(?,?,?,?,?,?,?,?)");\n      try{\n        for(int i=0;i<txns.size();i++){\n          Txn t=txns.get(i);\n          pt.setInt(1,t.rowNum);\n          pt.setString(2,t.txId);\n          pt.setString(3,t.acctId);\n          pt.setString(4,t.effStr);\n          pt.setBigDecimal(5,t.amt2);\n          pt.setString(6,t.ccy);\n          pt.setString(7,t.status);\n          pt.setString(8,t.reversalOf==null?"":t.reversalOf);\n          pt.executeUpdate();\n        }\n      } finally { pt.close(); }\n\n      PreparedStatement pr=c.prepareStatement("INSERT INTO RUN_AUDIT(JDBC_URL,BIZ_DATE,ACCOUNTS,VALID_TXS,SKIPPED_TXS,REPORT_MD5) VALUES(?,?,?,?,?,?)");\n      try{\n        pr.setString(1,JDBC_URL);\n        pr.setString(2,bizDate);\n        pr.setInt(3,accounts);\n        pr.setInt(4,valid);\n        pr.setInt(5,skipped);\n        pr.setString(6,reportMd5);\n        pr.executeUpdate();\n      } finally { pr.close(); }\n\n      c.commit();\n    } finally {\n      try{ c.close(); }catch(Exception e){}\n    }\n  }\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat >> /app/src/BankBatchJob.java <<\'EOF\'\n  public static void main(String[] args) throws Exception {\n    cleanOutput();\n    String bizDate = read1(BIZ_DATE_TXT);\n    int bizDay = toDay(bizDate);\n\n    Map<String,Account> accts = loadAccounts();\n    List<Txn> txns = loadTxns();\n    Map<String,FeeRule> fees = loadFees();\n    List<FxRate> fxRates = loadFxRates();\n    List<String> pivots = loadPivots();\n\n    // index fx rates by pair, sorted by day\n    HashMap<String,List<FxRate>> byPair = new HashMap<String,List<FxRate>>();\n    for(int i=0;i<fxRates.size();i++){\n      FxRate r=fxRates.get(i);\n      String k=pair(r.from,r.to);\n      List<FxRate> lst=byPair.get(k);\n      if(lst==null){ lst=new ArrayList<FxRate>(); byPair.put(k,lst); }\n      lst.add(r);\n    }\n    for(Iterator<Map.Entry<String,List<FxRate>>> it=byPair.entrySet().iterator(); it.hasNext(); ){\n      Map.Entry<String,List<FxRate>> e=it.next();\n      Collections.sort(e.getValue(), new Comparator<FxRate>(){ public int compare(FxRate a, FxRate b){ return a.day-b.day; }});\n    }\n\n    HashSet<String> txIdsInFile = new HashSet<String>();\n    for(int i=0;i<txns.size();i++) txIdsInFile.add(txns.get(i).txId);\n\n    // REVERSED: both rows if reversal_of points to any tx_id in file\n    HashSet<String> reversed = new HashSet<String>();\n    for(int i=0;i<txns.size();i++){\n      Txn t=txns.get(i);\n      if(t.reversalOf!=null && t.reversalOf.length()>0 && txIdsInFile.contains(t.reversalOf)){\n        reversed.add(t.txId);\n        reversed.add(t.reversalOf);\n      }\n    }\n\n    HashSet<String> seen = new HashSet<String>();\n    ArrayList<String[]> exc = new ArrayList<String[]>();\n    HashMap<String,BigDecimal> sumAdj2 = new HashMap<String,BigDecimal>();\n    int valid=0, skipped=0;\n\n    for(int i=0;i<txns.size();i++){\n      Txn t=txns.get(i);\n      String reason=null;\n\n      if(reversed.contains(t.txId)) reason="REVERSED";\n      else if(t.reversalOf!=null && t.reversalOf.length()>0 && !txIdsInFile.contains(t.reversalOf)) reason="REVERSAL_MISSING";\n      else {\n        Account a=accts.get(t.acctId);\n        if(a==null) reason="FX_MISSING";\n        else if(!t.ccy.equals(a.ccy)){\n          BigDecimal rate=resolveFx(byPair,pivots,t.ccy,a.ccy,t.effDay);\n          if(rate==null) reason="FX_MISSING";\n        }\n      }\n      if(reason==null && t.effDay>bizDay) reason="AFTER_BIZ_DATE";\n      if(reason==null && !"POSTED".equals(t.status)) reason=t.status;\n      if(reason==null && seen.contains(t.txId)) reason="DUPLICATE";\n\n      if(!seen.contains(t.txId)) seen.add(t.txId);\n\n      if(reason!=null){\n        skipped++;\n        exc.add(new String[]{String.valueOf(t.rowNum), t.txId, reason});\n        continue;\n      }\n\n      Account a=accts.get(t.acctId);\n      BigDecimal amtAcct10;\n      if(t.ccy.equals(a.ccy)) amtAcct10=t.amt2.setScale(10,RM);\n      else {\n        BigDecimal rate=resolveFx(byPair,pivots,t.ccy,a.ccy,t.effDay);\n        amtAcct10=t.amt2.setScale(10,RM).multiply(rate).setScale(10,RM);\n      }\n\n      FeeRule fr=fees.get(a.feePlan);\n      BigDecimal fee2=BD0.setScale(2,RM);\n      if(fr!=null){\n        boolean isDebit=amtAcct10.signum()<0;\n        boolean isCredit=amtAcct10.signum()>0;\n        boolean applies = "ALL".equals(fr.applies) || ("DEBIT".equals(fr.applies)&&isDebit) || ("CREDIT".equals(fr.applies)&&isCredit);\n        if(applies){\n          BigDecimal raw10 = fr.flat2.setScale(10,RM).add(fr.pct.multiply(amtAcct10.abs())).setScale(10,RM);\n          BigDecimal f2 = raw10.setScale(2,RM);\n          if(f2.compareTo(fr.min2)<0) f2=fr.min2;\n          if(f2.compareTo(fr.max2)>0) f2=fr.max2;\n          fee2=f2.setScale(2,RM);\n        }\n      }\n\n      BigDecimal adj2 = amtAcct10.setScale(2,RM).subtract(fee2).setScale(2,RM);\n      BigDecimal prev=sumAdj2.get(a.id);\n      if(prev==null) prev=BD0.setScale(2,RM);\n      sumAdj2.put(a.id, prev.add(adj2).setScale(2,RM));\n      valid++;\n    }\n\n    ArrayList<String> acctIds=new ArrayList<String>(accts.keySet());\n    Collections.sort(acctIds);\n\n    StringBuilder interest=new StringBuilder();\n    interest.append("account_id,biz_date,eod_balance,apr,daily_interest\\n");\n    BigDecimal totalRaw10=BD0.setScale(10,RM);\n\n    for(int i=0;i<acctIds.size();i++){\n      Account a=accts.get(acctIds.get(i));\n      BigDecimal adj=sumAdj2.get(a.id); if(adj==null) adj=BD0.setScale(2,RM);\n      BigDecimal eod2=a.start2.add(adj).setScale(2,RM);\n\n      int daysSince = bizDay - a.openedDay;\n      boolean promo = a.promoDays>0 && daysSince < a.promoDays;\n      boolean tier = eod2.compareTo(a.tierThr2) >= 0;\n\n      BigDecimal apr=a.baseApr;\n      if(tier) apr=apr.add(a.tierApr);\n      if(promo) apr=apr.add(a.promoApr);\n      BigDecimal apr6=apr.setScale(6,RM);\n\n      BigDecimal principal2 = eod2.compareTo(BD0)>0 ? eod2 : BD0.setScale(2,RM);\n      BigDecimal dailyRaw10 = principal2.setScale(10,RM).multiply(apr.setScale(10,RM)).setScale(10,RM).divide(BD365,10,RM);\n      BigDecimal daily2 = dailyRaw10.setScale(2,RM);\n      totalRaw10 = totalRaw10.add(dailyRaw10).setScale(10,RM);\n\n      interest.append(a.id).append(\',\').append(bizDate).append(\',\')\n        .append(eod2.toPlainString()).append(\',\').append(apr6.toPlainString()).append(\',\')\n        .append(daily2.toPlainString()).append("\\n");\n    }\n\n    writeUtf8(INTEREST_CSV, interest.toString());\n\n    StringBuilder ex=new StringBuilder();\n    ex.append("row_num,tx_id,reason\\n");\n    for(int i=0;i<exc.size();i++){\n      String[] e=exc.get(i);\n      ex.append(e[0]).append(\',\').append(e[1]).append(\',\').append(e[2]).append("\\n");\n    }\n    writeUtf8(EXCEPTIONS_CSV, ex.toString());\n\n    String reportMd5 = md5(readAll(INTEREST_CSV));\n    BigDecimal total2 = totalRaw10.setScale(2,RM);\n\n    String json = "{"+\n      "\\"biz_date\\":\\""+bizDate+"\\","+\n      "\\"accounts\\":"+accts.size()+","+\n      "\\"valid_txs\\":"+valid+","+\n      "\\"skipped_txs\\":"+skipped+","+\n      "\\"total_interest\\":\\""+total2.toPlainString()+"\\","+\n      "\\"report_md5\\":\\""+reportMd5+"\\""+\n      "}";\n    writeUtf8(STATS_JSON, json);\n\n    buildDb(accts, txns, bizDate, accts.size(), valid, skipped, reportMd5);\n  }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
