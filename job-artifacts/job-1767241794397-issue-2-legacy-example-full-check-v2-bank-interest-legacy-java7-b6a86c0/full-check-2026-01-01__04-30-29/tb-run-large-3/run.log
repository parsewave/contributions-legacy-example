bd2(String s){ return new BigDecimal(s).setScale(2, RM); }\n  private static BigDecimal bd(String s){ return new BigDecimal(s); }\n\n  private static int toDay(String yyyyMmDd) throws Exception {\n    Date d = DF.parse(yyyyMmDd);\n    Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));\n    c.setTime(d);\n    c.set(Calendar.HOUR_OF_DAY,0); c.set(Calendar.MINUTE,0); c.set(Calendar.SECOND,0); c.set(Calendar.MILLISECOND,0);\n    return (int)(c.getTimeInMillis()/86400000L);\n  }\n\n  private static byte[] readAll(File f) throws Exception {\n    ByteArrayOutputStream baos = new ByteArrayOutputStream();\n    InputStream in = new FileInputStream(f);\n    try {\n      byte[] buf = new byte[8192];\n      int n;\n      while((n=in.read(buf))!=-1) baos.write(buf,0,n);\n    } finally { in.close(); }\n    return baos.toByteArray();\n  }\n\n  private static String md5(byte[] b) throws Exception {\n    MessageDigest md = MessageDigest.getInstance("MD5");\n    md.update(b);\n    byte[] d = md.digest();\n    StringBuilder sb = new StringBuilder();\n    for(int i=0;i<d.length;i++){\n      int x=d[i]&0xff;\n      if(x<16) sb.append(\'0\');\n      sb.append(Integer.toHexString(x));\n    }\n    return sb.toString();\n  }\n\n  private static void writeUtf8(File f, String s) throws Exception {\n    Writer w = new OutputStreamWriter(new FileOutputStream(f), UTF8);\n    try { w.write(s); } finally { w.close(); }\n  }\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
