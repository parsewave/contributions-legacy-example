> reversed = new HashSet<String>();\n    for (Txn t: txns) {\n      if (t.revOf.length()>0 && txIds.contains(t.revOf)) { reversed.add(t.txId); reversed.add(t.revOf); }\n    }\n\n    Set<String> seen = new HashSet<String>();\n    int valid=0, skipped=0;\n\n    for (Txn t: txns) {\n      boolean dup = seen.contains(t.txId); seen.add(t.txId);\n      String reason=null;\n\n      if (reversed.contains(t.txId)) reason="REVERSED";\n      else if (t.revOf.length()>0 && !txIds.contains(t.revOf)) reason="REVERSAL_MISSING";\n      else {\n        Acct a = accts.get(t.acctId);\n        if (a==null) reason="ACCOUNT_MISSING";\n        else {\n          BigDecimal rate;\n          if (t.ccy.equals(a.ccy)) rate = BigDecimal.ONE.setScale(10,RM);\n          else {\n            rate = fxRate(fx,pivots,t.ccy,a.ccy,t.eff);\n            if (rate==null) reason="FX_MISSING";\n          }\n          if (reason==null) {\n            if (t.eff.after(biz)) reason="AFTER_BIZ_DATE";\n            else if (!"POSTED".equals(t.status)) reason=t.status;\n            else if (dup) reason="DUPLICATE";\n            else {\n              // convert first, keep 10dp, then fee uses converted amount\n              t.convRaw = t.amt.multiply(rate).setScale(10,RM);\n              Fee fr = fees.get(a.feePlan);\n              t.fee = fee(fr, t.convRaw);\n              t.adj = t.convRaw.setScale(2,RM).subtract(t.fee).setScale(2,RM);\n              t.valid=true; valid++;\n            }\n          }\n        }\n      }\n\n      if (reason!=null) { t.valid=false; t.reason=reason; skipped++; }\n    }\n\n    for (Acct a: accts.values()) {\n      BigDecimal sum = bd("0").setScale(2,RM);\n      for (Txn t: txns) if (t.valid && a.id.equals(t.acctId)) sum = sum.add(t.adj).setScale(2,RM);\n      a.eod = a.start.add(sum).setScale(2,RM);\n\n      boolean promo=false;\n      if (a.promoDays>0) promo = daysBetween(a.opened,biz) < a.promoDays;\n\n      BigDecimal apr=a.baseApr;\n      if (a.eod.compareTo(a.tierTh)>=0) apr=apr.add(a.tierApr);\n      if (promo) apr=apr.add(a.promoApr);\n      a.apr=apr;\n\n      BigDecimal principal = a.eod.max(bd("0").setScale(2,RM));\n      BigDecimal dailyRate = a.apr.divide(bd("365"),10,RM);\n      a.diRaw = principal.multiply(dailyRate).setScale(10,RM);\n    }\n\n    File interest = new File(OUT_DIR,"interest.csv");\n    writeInterest(interest,biz,accts);\n    String md5 = md5hex(interest);\n\n    writeExceptions(new File(OUT_DIR,"exceptions.csv"), txns);\n\n    BigDecimal totalRaw = bd("0").setScale(10,RM);\n    for (Acct a: accts.values()) totalRaw = totalRaw.add(a.diRaw).setScale(10,RM);\n    BigDecimal total = totalRaw.setScale(2,RM);\n\n    writeStats(new File(OUT_DIR,"stats.json"), biz, accts.size(), valid, skipped, total, md5);\n    writeDb(biz, accts, txns, valid, skipped, md5);\n  }\n\n  private static void del(String name){ File f=new File(OUT_DIR,name); if(f.exists()) f.delete(); }\n  private static BigDecimal bd(String s){ return new BigDecimal(s); }\n  private static Date parse(String s) throws Exception { synchronized(DF){ return DF.parse(s);} }\n  private static String fmt(Date d){ synchronized(DF){ return DF.format(d);} }\n  private static int daysBetween(Date s, Date e){ return (int)((e.getTime()-s.getTime())/86400000L); }\n\n  private static String readAll(File f) throws Exception {\n    BufferedReader br=new BufferedReader(new InputStreamReader(new FileInputStream(f),"UTF-8"));\n    try{ StringBuilder sb=new StringBuilder(); String line; while((line=br.readLine())!=null) sb.append(line); return sb.toString(); }\n    finally{ br.close(); }\n  }\n\n  private static List<String[]> csv(File f) throws Exception {\n    BufferedReader br=new BufferedReader(new InputStreamReader(new FileInputStream(f),"UTF-8"));\n    try{\n      List<String[]> rows=new ArrayList<String[]>();\n      String line; while((line=br.readLine())!=null){\n        String[] p=line.split(",",-1);\n        for(int i=0;i<p.length;i++) p[i]=p[i].trim();\n        rows.add(p);\n      }\n      return rows;\n    } finally { br.close(); }\n  }\n\n  private static Map<String,Acct> readAccounts(File f) throws Exception {\n    List<String[]> r=csv(f); Map<String,Acct> m=new HashMap<String,Acct>();\n    for(int i=1;i<r.size();i++){\n      String[] x=r.get(i);\n      Acct a=new Acct();\n      a.id=x[0]; a.opened=parse(x[1]); a.start=bd(x[2]).setScale(2,RM);\n      a.baseApr=bd(x[3]); a.promoApr=bd(x[4]); a.promoDays=Integer.parseInt(x[5]);\n      a.tierTh=bd(x[6]).setScale(2,RM); a.tierApr=bd(x[7]); a.ccy=x[8]; a.feePlan=x[9];\n      m.put(a.id,a);\n    }\n    return m;\n  }\n\n  private static Map<String,Fee> readFees(File f) throws Exception {\n    List<String[]> r=csv(f); Map<String,Fee> m=new HashMap<String,Fee>();\n    for(int i=1;i<r.size();i++){\n      String[] x=r.get(i);\n      Fee fr=new Fee(); fr.plan=x[0]; fr.applies=x[1];\n      fr.flat=bd(x[2]); fr.pct=bd(x[3]); fr.min=bd(x[4]); fr.max=bd(x[5]);\n      m.put(fr.plan,fr);\n    }\n    return m;\n  }\n\n  private static List<String> readPivots(File f) throws Exception {\n    List<String[]> r=csv(f); List<String> p=new ArrayList<String>();\n    for(int i=1;i<r.size();i++) p.add(r.get(i)[0]);\n    return p;\n  }\n\n  private static List<Fx> readFx(File f) throws Exception {\n    List<String[]> r=csv(f); List<Fx> list=new ArrayList<Fx>();\n    for(int i=1;i<r.size();i++){\n      String[] x=r.get(i);\n      Fx k=new Fx(); k.d=parse(x[0]); k.f=x[1]; k.t=x[2]; k.r=bd(x[3]);\n      list.add(k);\n    }\n    return list;\n  }\n\n  private static List<Txn> readTxns(File f) throws Exception {\n    List<String[]> r=csv(f); List<Txn> list=new ArrayList<Txn>();\n    for(int i=1;i<r.size();i++){\n      String[] x=r.get(i);\n      Txn t=new Txn();\n      t.row=i; t.txId=x[0]; t.acctId=x[1]; t.eff=parse(x[2]); t.amt=bd(x[3]).setScale(2,RM);\n      t.ccy=x[4]; t.status=x[5]; t.revOf=(x.length>6?x[6]:""); if(t.revOf==null) t.revOf="";\n      list.add(t);\n    }\n    return list;\n  }\nEOF\n'] min_tim