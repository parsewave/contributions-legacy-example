       if (leg1 == null) continue;\n                BigDecimal leg2 = resolveRateNoPivot(p, to, effectiveDay);\n                if (leg2 == null) continue;\n\n                BigDecimal combined = leg1.multiply(leg2).setScale(10, HALF_EVEN);\n                return combined;\n            }\n\n            return null;\n        }\n\n        private BigDecimal resolveRateNoPivot(String from, String to, int effectiveDay) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, HALF_EVEN);\n\n            RatePick direct = pickLatest(from, to, effectiveDay);\n            RatePick reverse = pickLatest(to, from, effectiveDay);\n\n            if (direct != null && reverse != null) {\n                if (direct.rateDay > reverse.rateDay) {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                } else if (reverse.rateDay > direct.rateDay) {\n                    return invert(reverse.rate);\n                } else {\n                    return direct.rate.setScale(10, HALF_EVEN);\n                }\n            } else if (direct != null) {\n                return direct.rate.setScale(10, HALF_EVEN);\n            } else if (reverse != null) {\n                return invert(reverse.rate);\n            }\n            return null;\n        }\n\n        private RatePick pickLatest(String from, String to, int effectiveDay) {\n            ArrayList<FxRate> lst = rates.get(key(from, to));\n            if (lst == null) return null;\n\n            int bestDay = Integer.MIN_VALUE;\n            BigDecimal bestRate = null;\n\n            for (int i = 0; i < lst.size(); i++) {\n                FxRate r = lst.get(i);\n                if (r.rateDay <= effectiveDay && r.rateDay > bestDay) {\n                    bestDay = r.rateDay;\n                    bestRate = r.rate;\n                }\n            }\n\n            if (bestRate == null) return null;\n            RatePick p = new RatePick();\n            p.rateDay = bestDay;\n            p.rate = bestRate;\n            return p;\n        }\n\n        private BigDecimal invert(BigDecimal rate) {\n            // reverse 1/rate (HALF_EVEN 10dp)\n            return BigDecimal.ONE.divide(rate, 10, HALF_EVEN);\n        }\n\n        private String key(String from, String to) {\n            return from + "|" + to;\n        }\n\n        private static class FxRate {\n            int rateDay;\n            BigDecimal rate;\n        }\n\n        private static class RatePick {\n            int rateDay;\n            BigDecimal rate;\n        }\n    }\n}\nJAVA\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
