Sending keys: ['cat > /app/src/BankBatchJob.java <<\'EOF\'\nimport java.io.*;\nimport java.math.*;\nimport java.security.*;\nimport java.sql.*;\nimport java.text.*;\nimport java.util.*;\n\npublic class BankBatchJob {\n\n    // Must be a single literal string and used at runtime.\n    private static final String JDBC_URL = "jdbc:h2:/app/output/bankdb;MODE=DB2";\n\n    private static final File DATA_DIR = new File("/app/data");\n    private static final File OUT_DIR = new File("/app/output");\n\n    private static final RoundingMode RM = RoundingMode.HALF_EVEN;\n    private static final TimeZone UTC = TimeZone.getTimeZone("UTC");\n\n    private static final SimpleDateFormat YYYY_MM_DD = new SimpleDateFormat("yyyy-MM-dd");\n    static {\n        YYYY_MM_DD.setLenient(false);\n        YYYY_MM_DD.setTimeZone(UTC);\n    }\n\n    private static class Account {\n        String accountId;\n        Date openedAt;\n        BigDecimal startBalance;\n        BigDecimal baseApr;\n        BigDecimal promoApr;\n        int promoDays;\n        BigDecimal tierThreshold;\n        BigDecimal tierApr;\n        String currency;\n        String feePlan;\n\n        BigDecimal eodBalance;\n        BigDecimal apr;\n        BigDecimal dailyInterestRaw;\n    }\n\n    private static class FeeRule {\n        String feePlan;\n        String appliesTo; // DEBIT/CREDIT/ALL\n        BigDecimal flatFee;\n        BigDecimal pctFee;\n        BigDecimal minFee;\n        BigDecimal maxFee;\n    }\n\n    private static class Txn {\n        int rowNum; // 1-based data row\n        String txId;\n        String accountId;\n        Date effectiveDate;\n        BigDecimal amount;\n        String currency;\n        String status;\n        String reversalOf;\n\n        boolean valid;\n        String reason;\n\n        BigDecimal amountAcct; // 2dp\n        BigDecimal fee;       // 2dp\n        BigDecimal adjusted;  // 2dp\n    }\n\n    private static class FxRate {\n        Date rateDate;\n        String from;\n        String to;\n        BigDecimal rate;\n    }\n\n    public static void main(String[] args) throws Exception {\n        OUT_DIR.mkdirs();\n\n        // Deterministic reruns: remove old outputs.\n        deleteIfExists(new File(OUT_DIR, "interest.csv"));\n        deleteIfExists(new File(OUT_DIR, "exceptions.csv"));\n        deleteIfExists(new File(OUT_DIR, "stats.json"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.h2.db"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.trace.db"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.lock.db"));\n\n        Date bizDate = readBizDate(new File(DATA_DIR, "biz_date.txt"));\n\n        Map<String, Account> accounts = readAccounts(new File(DATA_DIR, "accounts.csv"));\n        Map<String, FeeRule> feeRules = readFeeRules(new File(DATA_DIR, "fee_rules.csv"));\n        List<String> pivots = readPivots(new File(DATA_DIR, "fx_pivots.csv"));\n        List<FxRate> fxRates = readFxRates(new File(DATA_DIR, "fx_rates.csv"));\n        List<Txn> txns = readTxns(new File(DATA_DIR, "transactions.csv"));\n\n        Set<String> txIdSet = new HashSet<String>();\n        for (Txn t : txns) txIdSet.add(t.txId);\n\n        // REVERSED: both rows if reversal_of points to any tx_id in file (even if referenced row appears later)\n        Set<String> reversedTxIds = new HashSet<String>();\n        for (Txn t : txns) {\n            if (t.reversalOf != null && t.reversalOf.length() > 0) {\n                if (txIdSet.contains(t.reversalOf)) {\n                    reversedTxIds.add(t.txId);\n                    reversedTxIds.add(t.reversalOf);\n                }\n            }\n        }\n\n        Set<String> seen = new HashSet<String>();\n\n        int validTxs = 0;\n        int skippedTxs = 0;\n\n        for (Txn t : txns) {\n            boolean isDuplicate = seen.contains(t.txId);\n            seen.add(t.txId);\n\n            String reason = null;\n\n            // Reasons in required precedence.\n            if (reversedTxIds.contains(t.txId)) {\n                reason = "REVERSED";\n            } else if (t.reversalOf != null && t.reversalOf.length() > 0 && !txIdSet.contains(t.reversalOf)) {\n                reason = "REVERSAL_MISSING";\n            } else {\n                Account acct = accounts.get(t.accountId);\n                if (acct == null) {\n                    // Not specified in the provided reason list, but needed to account for missing accounts.\n                    reason = "ACCOUNT_MISSING";\n                } else {\n                    BigDecimal fx;\n                    if (t.currency.equals(acct.currency)) {\n                        fx = BigDecimal.ONE.setScale(10, RM);\n                    } else {\n                        fx = resolveFxRate(fxRates, pivots, t.currency, acct.currency, t.effectiveDate);\n                        if (fx == null) {\n                            reason = "FX_MISSING";\n                        }\n                    }\n\n                    if (reason == null) {\n                        if (t.effectiveDate.after(bizDate)) {\n                            reason = "AFTER_BIZ_DATE";\n                        } else if (!"POSTED".equals(t.status)) {\n                            reason = t.status;\n                        } else if (isDuplicate) {\n                            reason = "DUPLICATE";\n                        } else {\n                            t.amountAcct = t.amount.multiply(fx).setScale(2, RM);\n                            FeeRule fr = feeRules.get(acct.feePlan);\n                            t.fee = computeFee(fr, t.amountAcct);\n                            t.adjusted = t.amountAcct.subtract(t.fee).setScale(2, RM);\n                            t.valid = true;\n                            validTxs++;\n                        }\n                    }\n                }\n            }\n\n            if (reason != null) {\n                t.valid = false;\n                t.reason = reason;\n                skippedTxs++;\n            }\n        }\n\n        // Compute EOD balances / APR / interest.\n        for (Account a : accounts.values()) {\n            BigDecimal sum = BigDecimal.ZERO.setScale(2, RM);\n            for (Txn t : txns) {\n                if (t.valid && a.accountId.equals(t.accountId)) {\n                    sum = sum.add(t.adjusted).setScale(2, RM);\n                }\n            }\n            a.eodBalance = a.startBalance.add(sum).setScale(2, RM);\n\n            boolean promoActive = false;\n            if (a.promoDays > 0) {\n                int days = daysBetween(a.openedAt, bizDate);\n                promoActive = days < a.promoDays;\n            }\n\n            BigDecimal apr = a.baseApr;\n            if (a.eodBalance.compareTo(a.tierThreshold) >= 0) {\n                apr = apr.add(a.tierApr);\n            }\n            if (promoActive) {\n                apr = apr.add(a.promoApr);\n            }\n            a.apr = apr;\n\n            BigDecimal principal = a.eodBalance.max(BigDecimal.ZERO);\n            BigDecimal dailyRate = a.apr.divide(new BigDecimal("365"), 10, RM);\n            a.dailyInterestRaw = principal.multiply(dailyRate).setScale(10, RM);\n        }\n\n        File interestFile = new File(OUT_DIR, "interest.csv");\n        writeInterestCsv(interestFile, bizDate, accounts);\n\n        String reportMd5 = md5HexOfFile(interestFile);\n\n        File exceptionsFile = new File(OUT_DIR, "exceptions.csv");\n        writeExceptionsCsv(exceptionsFile, txns);\n\n        BigDecimal totalInterestRaw = BigDecimal.ZERO.setScale(10, RM);\n        for (Account a : accounts.values()) {\n            totalInterestRaw = totalInterestRaw.add(a.dailyInterestRaw).setScale(10, RM);\n        }\n        BigDecimal totalInterest = totalInterestRaw.setScale(2, RM);\n\n        File statsFile = new File(OUT_DIR, "stats.json");\n        writeStatsJsonNoNewline(statsFile, bizDate, accounts.size(), validTxs, skippedTxs, totalInterest, reportMd5);\n\n        writeH2Db(bizDate, accounts, txns, validTxs, skippedTxs, reportMd5);\n    }\n\n    private static void deleteIfExists(File f) {\n        if (f.exists()) f.delete();\n    }\n\n    private static Date readBizDate(File f) throws Exception {\n        String s = readAllTrimmed(f);\n        return parseDate(s);\n    }\n\n    private static String readAllTrimmed(File f) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), "UTF-8"));\n        try {\n            StringBuilder sb = new StringBuilder();\n            String line;\n            while ((line = br.readLine()) != null) sb.append(line);\n            return sb.toString().trim();\n        } finally {\n            br.close();\n        }\n    }\n\n    private static List<String[]> readCsv(File f) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), "UTF-8"));\n        try {\n            List<String[]> rows = new ArrayList<String[]>();\n            String line;\n            while ((line = br.readLine()) != null) {\n                String[] parts = line.split(",", -1);\n                for (int i = 0; i < parts.length; i++) parts[i] = parts[i].trim();\n                rows.add(parts);\n            }\n            return rows;\n        } finally {\n            br.close();\n        }\n    }\n\n    private static Map<String, Account> readAccounts(File f) throws Exception {\n        List<String[]> rows = readCsv(f);\n        Map<String, Account> m = new HashMap<String, Account>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            Account a = new Account();\n            a.accountId = r[0];\n            a.openedAt = parseDate(r[1]);\n            a.startBalance = new BigDecimal(r[2]).setScale(2, RM);\n            a.baseApr = new BigDecimal(r[3]);\n            a.promoApr = new BigDecimal(r[4]);\n            a.promoDays = Integer.parseInt(r[5]);\n            a.tierThreshold = new BigDecimal(r[6]).setScale(2, RM);\n            a.tierApr = new BigDecimal(r[7]);\n            a.currency = r[8];\n            a.feePlan = r[9];\n            m.put(a.accountId, a);\n        }\n        return m;\n    }\n\n    private static Map<String, FeeRule> readFeeRules(File f) throws Exception {\n        List<String[]> rows = readCsv(f);\n        Map<String, FeeRule> m = new HashMap<String, FeeRule>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            FeeRule fr = new FeeRule();\n            fr.feePlan = r[0];\n            fr.appliesTo = r[1];\n            fr.flatFee = new BigDecimal(r[2]);\n            fr.pctFee = new BigDecimal(r[3]);\n            fr.minFee = new BigDecimal(r[4]);\n            fr.maxFee = new BigDecimal(r[5]);\n            m.put(fr.feePlan, fr);\n        }\n        return m;\n    }\n\n    private static List<String> readPivots(File f) throws Exception {\n        List<String[]> rows = readCsv(f);\n        List<String> pivots = new ArrayList<String>();\n        for (int i = 1; i < rows.size(); i++) pivots.add(rows.get(i)[0]);\n        return pivots;\n    }\n\n    private static List<FxRate> readFxRates(File f) throws Exception {\n        List<String[]> rows = readCsv(f);\n        List<FxRate> list = new ArrayList<FxRate>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            FxRate fr = new FxRate();\n            fr.rateDate = parseDate(r[0]);\n            fr.from = r[1];\n            fr.to = r[2];\n            fr.rate = new BigDecimal(r[3]);\n            list.add(fr);\n        }\n        return list;\n    }\n\n    private static List<Txn> readTxns(File f) throws Exception {\n        List<String[]> rows = readCsv(f);\n        List<Txn> list = new ArrayList<Txn>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            Txn t = new Txn();\n            t.rowNum = i;\n            t.txId = r[0];\n            t.accountId = r[1];\n            t.effectiveDate = parseDate(r[2]);\n            t.amount = new BigDecimal(r[3]).setScale(2, RM);\n            t.currency = r[4];\n            t.status = r[5];\n            t.reversalOf = (r.length > 6 ? r[6] : "");\n            if (t.reversalOf == null) t.reversalOf = "";\n            list.add(t);\n        }\n        return list;\n    }\n\n    private static Date parseDate(String s) throws ParseException {\n        synchronized (YYYY_MM_DD) {\n            return YYYY_MM_DD.parse(s);\n        }\n    }\n\n    private static String formatDate(Date d) {\n        synchronized (YYYY_MM_DD) {\n            return YYYY_MM_DD.format(d);\n        }\n    }\n\n    private static int daysBetween(Date start, Date end) {\n        long ms = end.getTime() - start.getTime();\n        return (int)(ms / 86400000L);\n    }\n\n    private static BigDecimal computeFee(FeeRule fr, BigDecimal amountAcct) {\n        if (fr == null) return BigDecimal.ZERO.setScale(2, RM);\n\n        int sign = amountAcct.signum();\n        boolean debit = sign < 0;\n        boolean credit = sign > 0;\n\n        boolean applies;\n        if ("ALL".equals(fr.appliesTo)) applies = true;\n        else if ("DEBIT".equals(fr.appliesTo) && debit) applies = true;\n        else if ("CREDIT".equals(fr.appliesTo) && credit) applies = true;\n        else applies = false;\n\n        if (!applies) return BigDecimal.ZERO.setScale(2, RM);\n\n        BigDecimal base = fr.flatFee.add(fr.pctFee.multiply(amountAcct.abs()));\n        BigDecimal fee = base.setScale(2, RM);\n        if (fee.compareTo(fr.minFee) < 0) fee = fr.minFee;\n        if (fee.compareTo(fr.maxFee) > 0) fee = fr.maxFee;\n        return fee.setScale(2, RM);\n    }\n\n    private static BigDecimal resolveFxRate(List<FxRate> allRates, List<String> pivots, String from, String to, Date effectiveDate) {\n        BigDecimal direct = resolveFxLeg(allRates, from, to, effectiveDate);\n        if (direct != null) return direct;\n\n        for (int i = 0; i < pivots.size(); i++) {\n            String p = pivots.get(i);\n            if (p.equals(from) || p.equals(to)) continue;\n            BigDecimal leg1 = resolveFxLeg(allRates, from, p, effectiveDate);\n            if (leg1 == null) continue;\n            BigDecimal leg2 = resolveFxLeg(allRates, p, to, effectiveDate);\n            if (leg2 == null) continue;\n            return leg1.multiply(leg2).setScale(10, RM);\n        }\n        return null;\n    }\n\n    private static BigDecimal resolveFxLeg(List<FxRate> allRates, String from, String to, Date effectiveDate) {\n        FxRate bestDirect = latestRate(allRates, from, to, effectiveDate);\n        FxRate bestReverse = latestRate(allRates, to, from, effectiveDate);\n\n        if (bestDirect == null && bestReverse == null) return null;\n        if (bestDirect != null && bestReverse == null) return bestDirect.rate.setScale(10, RM);\n        if (bestDirect == null && bestReverse != null) return BigDecimal.ONE.divide(bestReverse.rate, 10, RM);\n\n        int cmp = bestDirect.rateDate.compareTo(bestReverse.rateDate);\n        if (cmp > 0) return bestDirect.rate.setScale(10, RM);\n        if (cmp < 0) return BigDecimal.ONE.divide(bestReverse.rate, 10, RM);\n        return bestDirect.rate.setScale(10, RM);\n    }\n\n    private static FxRate latestRate(List<FxRate> allRates, String from, String to, Date effectiveDate) {\n        FxRate best = null;\n        for (int i = 0; i < allRates.size(); i++) {\n            FxRate r = allRates.get(i);\n            if (!r.from.equals(from)) continue;\n            if (!r.to.equals(to)) continue;\n            if (r.rateDate.after(effectiveDate)) continue;\n            if (best == null || r.rateDate.after(best.rateDate)) best = r;\n        }\n        return best;\n    }\n\n    private static void writeInterestCsv(File f, Date bizDate, Map<String, Account> accounts) throws Exception {\n        List<String> ids = new ArrayList<String>(accounts.keySet());\n        Collections.sort(ids);\n\n        Writer w = new OutputStreamWriter(new FileOutputStream(f), "UTF-8");\n        try {\n            w.write("account_id,biz_date,eod_balance,apr,daily_interest\\n");\n            for (int i = 0; i < ids.size(); i++) {\n                Account a = accounts.get(ids.get(i));\n                BigDecimal apr6 = a.apr.setScale(6, RM);\n                BigDecimal di2 = a.dailyInterestRaw.setScale(2, RM);\n                w.write(a.accountId);\n                w.write(\',\');\n                w.write(formatDate(bizDate));\n                w.write(\',\');\n                w.write(a.eodBalance.setScale(2, RM).toPlainString());\n                w.write(\',\');\n                w.write(apr6.toPlainString());\n                w.write(\',\');\n                w.write(di2.toPlainString());\n                w.write("\\n");\n            }\n        } finally {\n            w.close();\n        }\n    }\n\n    private static void writeExceptionsCsv(File f, List<Txn> txns) throws Exception {\n        Writer w = new OutputStreamWriter(new FileOutputStream(f), "UTF-8");\n        try {\n            w.write("row_num,tx_id,reason\\n");\n            for (int i = 0; i < txns.size(); i++) {\n                Txn t = txns.get(i);\n                if (t.valid) continue;\n                w.write(Integer.toString(t.rowNum));\n                w.write(\',\');\n                w.write(t.txId);\n                w.write(\',\');\n                w.write(t.reason);\n                w.write("\\n");\n            }\n        } finally {\n            w.close();\n        }\n    }\n\n    private static String md5HexOfFile(File f) throws Exception {\n        MessageDigest md = MessageDigest.getInstance("MD5");\n        InputStream is = new FileInputStream(f);\n        try {\n            byte[] buf = new byte[8192];\n            int n;\n            while ((n = is.read(buf)) > 0) md.update(buf, 0, n);\n        } finally {\n            is.close();\n        }\n        byte[] dig = md.digest();\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < dig.length; i++) {\n            int b = dig[i] & 0xFF;\n            String hx = Integer.toHexString(b);\n            if (hx.length() == 1) sb.append(\'0\');\n            sb.append(hx);\n        }\n        return sb.toString();\n    }\n\n    private static void writeStatsJsonNoNewline(File f, Date bizDate, int accounts, int validTxs, int skippedTxs,\n                                               BigDecimal totalInterest, String reportMd5) throws Exception {\n        // single line, no trailing newline\n        StringBuilder sb = new StringBuilder();\n        sb.append(\'{\');\n        sb.append("\\"business_date\\":\\"").append(formatDate(bizDate)).append("\\"");\n        sb.append(",\\"accounts\\":").append(accounts);\n        sb.append(",\\"valid_txs\\":").append(validTxs);\n        sb.append(",\\"skipped_txs\\":").append(skippedTxs);\n        sb.append(",\\"total_interest\\":").append(totalInterest.setScale(2, RM).toPlainString());\n        sb.append(",\\"report_md5\\":\\"").append(reportMd5).append("\\"");\n        sb.append(\'}\');\n\n        OutputStream os = new FileOutputStream(f);\n        try {\n            os.write(sb.toString().getBytes("UTF-8"));\n        } finally {\n            os.close();\n        }\n    }\n\n    private static void writeH2Db(Date bizDate, Map<String, Account> accounts, List<Txn> txns,\n                                  int validTxs, int skippedTxs, String reportMd5) throws Exception {\n        Class.forName("org.h2.Driver");\n        Connection conn = DriverManager.getConnection(JDBC_URL, "sa", "");\n        try {\n            conn.setAutoCommit(false);\n            Statement st = conn.createStatement();\n            try {\n                safeExec(st, "DROP TABLE RUN_AUDIT");\n                safeExec(st, "DROP TABLE TXNS");\n                safeExec(st, "DROP TABLE ACCOUNTS");\n\n                st.execute("CREATE TABLE ACCOUNTS (" +\n                        "ACCOUNT_ID VARCHAR(20) PRIMARY KEY," +\n                        "OPENED_AT VARCHAR(10)," +\n                        "START_BALANCE DECIMAL(18,2)," +\n                        "BASE_APR DECIMAL(18,8)," +\n                        "PROMO_APR DECIMAL(18,8)," +\n                        "PROMO_DAYS INTEGER," +\n                        "TIER_THRESHOLD DECIMAL(18,2)," +\n                        "TIER_APR DECIMAL(18,8)," +\n                        "CURRENCY VARCHAR(3)," +\n                        "FEE_PLAN VARCHAR(20)" +\n                        ")");\n\n                st.execute("CREATE TABLE TXNS (" +\n                        "ROW_NUM INTEGER PRIMARY KEY," +\n                        "TX_ID VARCHAR(40)," +\n                        "ACCOUNT_ID VARCHAR(20)," +\n                        "EFFECTIVE_DATE VARCHAR(10)," +\n                        "AMOUNT DECIMAL(18,2)," +\n                        "CURRENCY VARCHAR(3)," +\n                        "STATUS VARCHAR(20)," +\n                        "REVERSAL_OF VARCHAR(40)" +\n                        ")");\n\n                st.execute("CREATE TABLE RUN_AUDIT (" +\n                        "JDBC_URL VARCHAR(200)," +\n                        "BIZ_DATE VARCHAR(10)," +\n                        "ACCOUNTS INTEGER," +\n                        "VALID_TXS INTEGER," +\n                        "SKIPPED_TXS INTEGER," +\n                        "REPORT_MD5 VARCHAR(40)" +\n                        ")");\n            } finally {\n                st.close();\n            }\n\n            PreparedStatement pa = conn.prepareStatement(\n                    "INSERT INTO ACCOUNTS(ACCOUNT_ID,OPENED_AT,START_BALANCE,BASE_APR,PROMO_APR,PROMO_DAYS,TIER_THRESHOLD,TIER_APR,CURRENCY,FEE_PLAN) VALUES (?,?,?,?,?,?,?,?,?,?)");\n            try {\n                List<String> ids = new ArrayList<String>(accounts.keySet());\n                Collections.sort(ids);\n                for (int i = 0; i < ids.size(); i++) {\n                    Account a = accounts.get(ids.get(i));\n                    pa.setString(1, a.accountId);\n                    pa.setString(2, formatDate(a.openedAt));\n                    pa.setBigDecimal(3, a.startBalance.setScale(2, RM));\n                    pa.setBigDecimal(4, a.baseApr);\n                    pa.setBigDecimal(5, a.promoApr);\n                    pa.setInt(6, a.promoDays);\n                    pa.setBigDecimal(7, a.tierThreshold.setScale(2, RM));\n                    pa.setBigDecimal(8, a.tierApr);\n                    pa.setString(9, a.currency);\n                    pa.setString(10, a.feePlan);\n                    pa.executeUpdate();\n                }\n            } finally {\n                pa.close();\n            }\n\n            PreparedStatement pt = conn.prepareStatement(\n                    "INSERT INTO TXNS(ROW_NUM,TX_ID,ACCOUNT_ID,EFFECTIVE_DATE,AMOUNT,CURRENCY,STATUS,REVERSAL_OF) VALUES (?,?,?,?,?,?,?,?)");\n            try {\n                for (int i = 0; i < txns.size(); i++) {\n                    Txn t = txns.get(i);\n                    pt.setInt(1, t.rowNum);\n                    pt.setString(2, t.txId);\n                    pt.setString(3, t.accountId);\n                    pt.setString(4, formatDate(t.effectiveDate));\n                    pt.setBigDecimal(5, t.amount.setScale(2, RM));\n                    pt.setString(6, t.currency);\n                    pt.setString(7, t.status);\n                    pt.setString(8, (t.reversalOf == null ? "" : t.reversalOf));\n                    pt.executeUpdate();\n                }\n            } finally {\n                pt.close();\n            }\n\n            PreparedStatement pr = conn.prepareStatement(\n                    "INSERT INTO RUN_AUDIT(JDBC_URL,BIZ_DATE,ACCOUNTS,VALID_TXS,SKIPPED_TXS,REPORT_MD5) VALUES (?,?,?,?,?,?)");\n            try {\n                pr.setString(1, JDBC_URL);\n                pr.setString(2, formatDate(bizDate));\n                pr.setInt(3, accounts.size());\n                pr.setInt(4, validTxs);\n                pr.setInt(5, skippedTxs);\n                pr.setString(6, reportMd5);\n                pr.executeUpdate();\n            } finally {\n                pr.close();\n            }\n\n            conn.commit();\n        } finally {\n            try { conn.close(); } catch (Exception e) { /* ignore */ }\n        }\n    }\n\n    private static void safeExec(Statement st, String sql) {\n        try {\n            st.execute(sql);\n        } catch (SQLException e) {\n            // ignore\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
