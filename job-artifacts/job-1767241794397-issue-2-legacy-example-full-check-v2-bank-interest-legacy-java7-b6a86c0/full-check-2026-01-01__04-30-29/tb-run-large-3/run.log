Sending keys: ['cat > /app/src/BankBatchJob.java <<\'EOF\'\nimport java.io.*;\nimport java.math.*;\nimport java.nio.charset.Charset;\nimport java.security.MessageDigest;\nimport java.sql.*;\nimport java.text.ParseException;\nimport java.text.SimpleDateFormat;\nimport java.util.*;\n\npublic class BankBatchJob {\n\n    // Single literal string; must start with jdbc:h2: and include MODE=DB2 and /app/output/bankdb\n    private static final String JDBC_URL = "jdbc:h2:/app/output/bankdb;MODE=DB2";\n\n    private static final Charset UTF8 = Charset.forName("UTF-8");\n\n    private static final File DATA_DIR = new File("/app/data");\n    private static final File OUT_DIR = new File("/app/output");\n\n    private static final File ACCOUNTS_CSV = new File(DATA_DIR, "accounts.csv");\n    private static final File TXNS_CSV = new File(DATA_DIR, "transactions.csv");\n    private static final File BIZ_DATE_TXT = new File(DATA_DIR, "biz_date.txt");\n    private static final File FX_RATES_CSV = new File(DATA_DIR, "fx_rates.csv");\n    private static final File FX_PIVOTS_CSV = new File(DATA_DIR, "fx_pivots.csv");\n    private static final File FEE_RULES_CSV = new File(DATA_DIR, "fee_rules.csv");\n\n    private static final File INTEREST_CSV = new File(OUT_DIR, "interest.csv");\n    private static final File EXCEPTIONS_CSV = new File(OUT_DIR, "exceptions.csv");\n    private static final File STATS_JSON = new File(OUT_DIR, "stats.json");\n\n    private static final BigDecimal BD_0 = new BigDecimal("0");\n    private static final BigDecimal BD_365 = new BigDecimal("365");\n\n    private static final RoundingMode RM = RoundingMode.HALF_EVEN;\n\n    private static final SimpleDateFormat DATE_FMT = new SimpleDateFormat("yyyy-MM-dd");\n    static {\n        DATE_FMT.setLenient(false);\n        DATE_FMT.setTimeZone(TimeZone.getTimeZone("UTC"));\n    }\n\n    private static class Account {\n        String accountId;\n        int openedEpochDay;\n        BigDecimal startBalance2;\n        BigDecimal baseApr;\n        BigDecimal promoApr;\n        int promoDays;\n        BigDecimal tierThreshold2;\n        BigDecimal tierApr;\n        String currency;\n        String feePlan;\n    }\n\n    private static class Txn {\n        int rowNum; // 1-based data row\n        String txId;\n        String accountId;\n        int effectiveEpochDay;\n        String effectiveDateStr;\n        BigDecimal amount2;\n        String currency;\n        String status;\n        String reversalOf;\n    }\n\n    private static class FeeRule {\n        String plan;\n        String appliesTo; // DEBIT/CREDIT/ALL\n        BigDecimal flat2;\n        BigDecimal pct;\n        BigDecimal min2;\n        BigDecimal max2;\n    }\n\n    private static class FxRate {\n        int rateEpochDay;\n        String rateDateStr;\n        String from;\n        String to;\n        BigDecimal rate;\n    }\n\n    private static class FxResolver {\n        private final Map<String, List<FxRate>> byPair = new HashMap<String, List<FxRate>>();\n        private final List<String> pivots;\n\n        FxResolver(List<FxRate> rates, List<String> pivots) {\n            this.pivots = pivots;\n            for (int i = 0; i < rates.size(); i++) {\n                FxRate r = rates.get(i);\n                String k = key(r.from, r.to);\n                List<FxRate> lst = byPair.get(k);\n                if (lst == null) {\n                    lst = new ArrayList<FxRate>();\n                    byPair.put(k, lst);\n                }\n                lst.add(r);\n            }\n            for (Iterator<Map.Entry<String, List<FxRate>>> it = byPair.entrySet().iterator(); it.hasNext(); ) {\n                Map.Entry<String, List<FxRate>> e = it.next();\n                Collections.sort(e.getValue(), new Comparator<FxRate>() {\n                    public int compare(FxRate a, FxRate b) {\n                        return a.rateEpochDay - b.rateEpochDay;\n                    }\n                });\n            }\n        }\n\n        private static String key(String from, String to) {\n            return from + "|" + to;\n        }\n\n        private FxRate latestLE(String from, String to, int effectiveEpochDay) {\n            List<FxRate> lst = byPair.get(key(from, to));\n            if (lst == null || lst.isEmpty()) return null;\n            FxRate best = null;\n            for (int i = 0; i < lst.size(); i++) {\n                FxRate r = lst.get(i);\n                if (r.rateEpochDay <= effectiveEpochDay) {\n                    best = r;\n                } else {\n                    break;\n                }\n            }\n            return best;\n        }\n\n        private BigDecimal resolveDirectOrReverse(String from, String to, int effectiveEpochDay) {\n            if (from.equals(to)) return BigDecimal.ONE.setScale(10, RM);\n\n            FxRate direct = latestLE(from, to, effectiveEpochDay);\n            FxRate reverse = latestLE(to, from, effectiveEpochDay);\n\n            if (direct == null && reverse == null) return null;\n\n            boolean useDirect;\n            if (direct != null && reverse != null) {\n                if (direct.rateEpochDay > reverse.rateEpochDay) {\n                    useDirect = true;\n                } else if (direct.rateEpochDay < reverse.rateEpochDay) {\n                    useDirect = false;\n                } else {\n                    useDirect = true; // tie => direct\n                }\n            } else {\n                useDirect = (direct != null);\n            }\n\n            if (useDirect) {\n                return direct.rate.setScale(10, RM);\n            }\n            return BigDecimal.ONE.divide(reverse.rate, 10, RM);\n        }\n\n        BigDecimal resolve(String from, String to, int effectiveEpochDay) {\n            BigDecimal r = resolveDirectOrReverse(from, to, effectiveEpochDay);\n            if (r != null) return r;\n\n            for (int i = 0; i < pivots.size(); i++) {\n                String p = pivots.get(i);\n                if (p.equals(from) || p.equals(to)) continue;\n                BigDecimal leg1 = resolveDirectOrReverse(from, p, effectiveEpochDay);\n                if (leg1 == null) continue;\n                BigDecimal leg2 = resolveDirectOrReverse(p, to, effectiveEpochDay);\n                if (leg2 == null) continue;\n                return leg1.multiply(leg2).setScale(10, RM);\n            }\n            return null;\n        }\n    }\n\n    private static int toEpochDay(String yyyyMmDd) throws ParseException {\n        Date d = DATE_FMT.parse(yyyyMmDd);\n        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));\n        c.setTime(d);\n        c.set(Calendar.HOUR_OF_DAY, 0);\n        c.set(Calendar.MINUTE, 0);\n        c.set(Calendar.SECOND, 0);\n        c.set(Calendar.MILLISECOND, 0);\n        long millis = c.getTimeInMillis();\n        return (int) (millis / 86400000L);\n    }\n\n    private static String epochDayToDateStr(int epochDay) {\n        long millis = ((long) epochDay) * 86400000L;\n        return DATE_FMT.format(new Date(millis));\n    }\n\n    private static String readTrimmed(File f) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String s = br.readLine();\n            if (s == null) return "";\n            return s.trim();\n        } finally {\n            br.close();\n        }\n    }\n\n    private static String[] splitCsvLine(String line) {\n        // Minimal CSV (no quoting)\n        List<String> parts = new ArrayList<String>();\n        int start = 0;\n        for (int i = 0; i < line.length(); i++) {\n            if (line.charAt(i) == \',\') {\n                parts.add(line.substring(start, i));\n                start = i + 1;\n            }\n        }\n        parts.add(line.substring(start));\n        String[] out = new String[parts.size()];\n        for (int i = 0; i < parts.size(); i++) out[i] = parts.get(i);\n        return out;\n    }\n\n    private static List<String[]> readCsv(File f) throws IOException {\n        List<String[]> rows = new ArrayList<String[]>();\n        BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), UTF8));\n        try {\n            String line;\n            while ((line = br.readLine()) != null) {\n                rows.add(splitCsvLine(line));\n            }\n        } finally {\n            br.close();\n        }\n        return rows;\n    }\n\n    private static Map<String, Integer> headerIndex(String[] header) {\n        Map<String, Integer> idx = new HashMap<String, Integer>();\n        for (int i = 0; i < header.length; i++) {\n            idx.put(header[i], Integer.valueOf(i));\n        }\n        return idx;\n    }\n\n    private static String get(String[] row, Map<String, Integer> idx, String col) {\n        Integer i = idx.get(col);\n        if (i == null) return "";\n        int n = i.intValue();\n        if (n < 0 || n >= row.length) return "";\n        return row[n];\n    }\n\n    private static BigDecimal bd2(String s) {\n        return new BigDecimal(s).setScale(2, RM);\n    }\n\n    private static BigDecimal bd(String s) {\n        return new BigDecimal(s);\n    }\n\n    private static void deleteIfExists(File f) {\n        if (f.exists()) f.delete();\n    }\n\n    private static void ensureCleanOutputDir() throws IOException {\n        if (!OUT_DIR.exists()) {\n            if (!OUT_DIR.mkdirs()) throw new IOException("Failed to create " + OUT_DIR);\n        }\n        deleteIfExists(INTEREST_CSV);\n        deleteIfExists(EXCEPTIONS_CSV);\n        deleteIfExists(STATS_JSON);\n        deleteIfExists(new File(OUT_DIR, "bankdb.h2.db"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.trace.db"));\n        deleteIfExists(new File(OUT_DIR, "bankdb.lock.db"));\n    }\n\n    private static void writeUtf8(File f, String content, boolean endWithNewline) throws IOException {\n        OutputStream out = new FileOutputStream(f);\n        Writer w = new OutputStreamWriter(out, UTF8);\n        try {\n            w.write(content);\n            if (endWithNewline) w.write("\\n");\n        } finally {\n            try { w.close(); } catch (Exception ignored) {}\n        }\n    }\n\n    private static byte[] readAllBytes(File f) throws IOException {\n        ByteArrayOutputStream baos = new ByteArrayOutputStream();\n        InputStream in = new FileInputStream(f);\n        try {\n            byte[] buf = new byte[8192];\n            int n;\n            while ((n = in.read(buf)) != -1) {\n                baos.write(buf, 0, n);\n            }\n        } finally {\n            in.close();\n        }\n        return baos.toByteArray();\n    }\n\n    private static String md5Hex(byte[] bytes) throws Exception {\n        MessageDigest md = MessageDigest.getInstance("MD5");\n        md.update(bytes);\n        byte[] dig = md.digest();\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < dig.length; i++) {\n            int b = dig[i] & 0xff;\n            if (b < 16) sb.append(\'0\');\n            sb.append(Integer.toHexString(b));\n        }\n        return sb.toString();\n    }\n\n    private static Map<String, Account> loadAccounts() throws Exception {\n        List<String[]> rows = readCsv(ACCOUNTS_CSV);\n        if (rows.isEmpty()) throw new IOException("accounts.csv empty");\n        Map<String, Integer> idx = headerIndex(rows.get(0));\n        Map<String, Account> out = new HashMap<String, Account>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            Account a = new Account();\n            a.accountId = get(r, idx, "account_id");\n            a.openedEpochDay = toEpochDay(get(r, idx, "opened_at"));\n            a.startBalance2 = bd2(get(r, idx, "start_balance"));\n            a.baseApr = bd(get(r, idx, "base_apr"));\n            a.promoApr = bd(get(r, idx, "promo_apr"));\n            a.promoDays = Integer.parseInt(get(r, idx, "promo_days"));\n            a.tierThreshold2 = bd2(get(r, idx, "tier_threshold"));\n            a.tierApr = bd(get(r, idx, "tier_apr"));\n            a.currency = get(r, idx, "currency");\n            a.feePlan = get(r, idx, "fee_plan");\n            out.put(a.accountId, a);\n        }\n        return out;\n    }\n\n    private static List<Txn> loadTxns() throws Exception {\n        List<String[]> rows = readCsv(TXNS_CSV);\n        if (rows.isEmpty()) throw new IOException("transactions.csv empty");\n        Map<String, Integer> idx = headerIndex(rows.get(0));\n        List<Txn> out = new ArrayList<Txn>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            Txn t = new Txn();\n            t.rowNum = i; // 1-based data row\n            t.txId = get(r, idx, "tx_id");\n            t.accountId = get(r, idx, "account_id");\n            t.effectiveDateStr = get(r, idx, "effective_date");\n            t.effectiveEpochDay = toEpochDay(t.effectiveDateStr);\n            t.amount2 = bd2(get(r, idx, "amount"));\n            t.currency = get(r, idx, "currency");\n            t.status = get(r, idx, "status");\n            t.reversalOf = get(r, idx, "reversal_of");\n            if (t.reversalOf == null) t.reversalOf = "";\n            out.add(t);\n        }\n        return out;\n    }\n\n    private static List<FxRate> loadFxRates() throws Exception {\n        List<String[]> rows = readCsv(FX_RATES_CSV);\n        if (rows.isEmpty()) throw new IOException("fx_rates.csv empty");\n        Map<String, Integer> idx = headerIndex(rows.get(0));\n        List<FxRate> out = new ArrayList<FxRate>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            FxRate fr = new FxRate();\n            fr.rateDateStr = get(r, idx, "rate_date");\n            fr.rateEpochDay = toEpochDay(fr.rateDateStr);\n            fr.from = get(r, idx, "from_ccy");\n            fr.to = get(r, idx, "to_ccy");\n            fr.rate = bd(get(r, idx, "rate"));\n            out.add(fr);\n        }\n        return out;\n    }\n\n    private static List<String> loadPivots() throws Exception {\n        List<String[]> rows = readCsv(FX_PIVOTS_CSV);\n        List<String> pivots = new ArrayList<String>();\n        for (int i = 1; i < rows.size(); i++) {\n            if (rows.get(i).length == 0) continue;\n            String p = rows.get(i)[0];\n            if (p != null) p = p.trim();\n            if (p != null && p.length() > 0) pivots.add(p);\n        }\n        return pivots;\n    }\n\n    private static Map<String, FeeRule> loadFeeRules() throws Exception {\n        List<String[]> rows = readCsv(FEE_RULES_CSV);\n        if (rows.isEmpty()) throw new IOException("fee_rules.csv empty");\n        Map<String, Integer> idx = headerIndex(rows.get(0));\n        Map<String, FeeRule> out = new HashMap<String, FeeRule>();\n        for (int i = 1; i < rows.size(); i++) {\n            String[] r = rows.get(i);\n            FeeRule fr = new FeeRule();\n            fr.plan = get(r, idx, "fee_plan");\n            fr.appliesTo = get(r, idx, "applies_to");\n            fr.flat2 = bd2(get(r, idx, "flat_fee"));\n            fr.pct = bd(get(r, idx, "pct_fee"));\n            fr.min2 = bd2(get(r, idx, "min_fee"));\n            fr.max2 = bd2(get(r, idx, "max_fee"));\n            out.put(fr.plan, fr);\n        }\n        return out;\n    }\n\n    private static void safeExec(Statement st, String sql) {\n        try {\n            st.execute(sql);\n        } catch (SQLException ignored) {\n        }\n    }\n\n    private static void buildDb(Map<String, Account> accounts,\n                                List<Txn> txns,\n                                String bizDateStr,\n                                int accountsCount,\n                                int validTxs,\n                                int skippedTxs,\n                                String reportMd5) throws Exception {\n        Class.forName("org.h2.Driver");\n        Connection conn = DriverManager.getConnection(JDBC_URL, "sa", "");\n        try {\n            conn.setAutoCommit(false);\n            Statement st = conn.createStatement();\n            try {\n                safeExec(st, "DROP TABLE RUN_AUDIT");\n                safeExec(st, "DROP TABLE TXNS");\n                safeExec(st, "DROP TABLE ACCOUNTS");\n\n                st.execute("CREATE TABLE ACCOUNTS (" +\n                        "ACCOUNT_ID VARCHAR(64) PRIMARY KEY," +\n                        "OPENED_AT VARCHAR(10)," +\n                        "START_BALANCE DECIMAL(18,2)," +\n                        "BASE_APR DECIMAL(18,10)," +\n                        "PROMO_APR DECIMAL(18,10)," +\n                        "PROMO_DAYS INT," +\n                        "TIER_THRESHOLD DECIMAL(18,2)," +\n                        "TIER_APR DECIMAL(18,10)," +\n                        "CURRENCY VARCHAR(8)," +\n                        "FEE_PLAN VARCHAR(32)" +\n                        ")");\n\n                st.execute("CREATE TABLE TXNS (" +\n                        "ROW_NUM INT PRIMARY KEY," +\n                        "TX_ID VARCHAR(64)," +\n                        "ACCOUNT_ID VARCHAR(64)," +\n                        "EFFECTIVE_DATE VARCHAR(10)," +\n                        "AMOUNT DECIMAL(18,2)," +\n                        "CURRENCY VARCHAR(8)," +\n                        "STATUS VARCHAR(16)," +\n                        "REVERSAL_OF VARCHAR(64)" +\n                        ")");\n\n                st.execute("CREATE TABLE RUN_AUDIT (" +\n                        "JDBC_URL VARCHAR(255)," +\n                        "BIZ_DATE VARCHAR(10)," +\n                        "ACCOUNTS INT," +\n                        "VALID_TXS INT," +\n                        "SKIPPED_TXS INT," +\n                        "REPORT_MD5 VARCHAR(64)" +\n                        ")");\n            } finally {\n                st.close();\n            }\n\n            PreparedStatement pa = conn.prepareStatement(\n                    "INSERT INTO ACCOUNTS (ACCOUNT_ID, OPENED_AT, START_BALANCE, BASE_APR, PROMO_APR, PROMO_DAYS, TIER_THRESHOLD, TIER_APR, CURRENCY, FEE_PLAN)" +\n                            " VALUES (?,?,?,?,?,?,?,?,?,?)");\n            try {\n                List<String> ids = new ArrayList<String>(accounts.keySet());\n                Collections.sort(ids);\n                for (int i = 0; i < ids.size(); i++) {\n                    Account a = accounts.get(ids.get(i));\n                    pa.setString(1, a.accountId);\n                    pa.setString(2, epochDayToDateStr(a.openedEpochDay));\n                    pa.setBigDecimal(3, a.startBalance2);\n                    pa.setBigDecimal(4, a.baseApr);\n                    pa.setBigDecimal(5, a.promoApr);\n                    pa.setInt(6, a.promoDays);\n                    pa.setBigDecimal(7, a.tierThreshold2);\n                    pa.setBigDecimal(8, a.tierApr);\n                    pa.setString(9, a.currency);\n                    pa.setString(10, a.feePlan);\n                    pa.executeUpdate();\n                }\n            } finally {\n                pa.close();\n            }\n\n            PreparedStatement pt = conn.prepareStatement(\n                    "INSERT INTO TXNS (ROW_NUM, TX_ID, ACCOUNT_ID, EFFECTIVE_DATE, AMOUNT, CURRENCY, STATUS, REVERSAL_OF)" +\n                            " VALUES (?,?,?,?,?,?,?,?)");\n            try {\n                for (int i = 0; i < txns.size(); i++) {\n                    Txn t = txns.get(i);\n                    pt.setInt(1, t.rowNum);\n                    pt.setString(2, t.txId);\n                    pt.setString(3, t.accountId);\n                    pt.setString(4, t.effectiveDateStr);\n                    pt.setBigDecimal(5, t.amount2);\n                    pt.setString(6, t.currency);\n                    pt.setString(7, t.status);\n                    pt.setString(8, t.reversalOf == null ? "" : t.reversalOf);\n                    pt.executeUpdate();\n                }\n            } finally {\n                pt.close();\n            }\n\n            PreparedStatement pr = conn.prepareStatement(\n                    "INSERT INTO RUN_AUDIT (JDBC_URL, BIZ_DATE, ACCOUNTS, VALID_TXS, SKIPPED_TXS, REPORT_MD5) VALUES (?,?,?,?,?,?)");\n            try {\n                pr.setString(1, JDBC_URL);\n                pr.setString(2, bizDateStr);\n                pr.setInt(3, accountsCount);\n                pr.setInt(4, validTxs);\n                pr.setInt(5, skippedTxs);\n                pr.setString(6, reportMd5);\n                pr.executeUpdate();\n            } finally {\n                pr.close();\n            }\n\n            conn.commit();\n        } finally {\n            try { conn.close(); } catch (Exception ignored) {}\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        ensureCleanOutputDir();\n\n        String bizDateStr = readTrimmed(BIZ_DATE_TXT);\n        int bizEpochDay = toEpochDay(bizDateStr);\n\n        Map<String, Account> accounts = loadAccounts();\n        List<Txn> txns = loadTxns();\n        List<FxRate> fxRates = loadFxRates();\n        List<String> pivots = loadPivots();\n        FxResolver fx = new FxResolver(fxRates, pivots);\n        Map<String, FeeRule> feeRules = loadFeeRules();\n\n        Set<String> txIdsInFile = new HashSet<String>();\n        for (int i = 0; i < txns.size(); i++) txIdsInFile.add(txns.get(i).txId);\n\n        Set<String> reversedTxIds = new HashSet<String>();\n        for (int i = 0; i < txns.size(); i++) {\n            Txn t = txns.get(i);\n            if (t.reversalOf != null && t.reversalOf.length() > 0) {\n                if (txIdsInFile.contains(t.reversalOf)) {\n                    reversedTxIds.add(t.txId);\n                    reversedTxIds.add(t.reversalOf);\n                }\n            }\n        }\n\n        Set<String> seenTxIds = new HashSet<String>();\n        List<String[]> exceptions = new ArrayList<String[]>();\n        Map<String, BigDecimal> adjustedSumByAccount = new HashMap<String, BigDecimal>();\n\n        int validTxs = 0;\n        int skippedTxs = 0;\n\n        for (int i = 0; i < txns.size(); i++) {\n            Txn t = txns.get(i);\n            String reason = null;\n\n            // reasons in required order\n            if (reversedTxIds.contains(t.txId)) {\n                reason = "REVERSED";\n            } else if (t.reversalOf != null && t.reversalOf.length() > 0 && !txIdsInFile.contains(t.reversalOf)) {\n                reason = "REVERSAL_MISSING";\n            } else {\n                Account a = accounts.get(t.accountId);\n                if (a == null) {\n                    reason = "FX_MISSING";\n                } else if (!t.currency.equals(a.currency)) {\n                    BigDecimal rate = fx.resolve(t.currency, a.currency, t.effectiveEpochDay);\n                    if (rate == null) reason = "FX_MISSING";\n                }\n            }\n\n            if (reason == null && t.effectiveEpochDay > bizEpochDay) {\n                reason = "AFTER_BIZ_DATE";\n            }\n            if (reason == null && !"POSTED".equals(t.status)) {\n                reason = t.status;\n            }\n            if (reason == null && seenTxIds.contains(t.txId)) {\n                reason = "DUPLICATE";\n            }\n\n            // mark seen regardless of validity (after checking DUPLICATE for this row)\n            if (!seenTxIds.contains(t.txId)) seenTxIds.add(t.txId);\n\n            if (reason != null) {\n                skippedTxs++;\n                exceptions.add(new String[]{String.valueOf(t.rowNum), t.txId, reason});\n                continue;\n            }\n\n            Account a = accounts.get(t.accountId);\n\n            BigDecimal amountAcct10;\n            if (t.currency.equals(a.currency)) {\n                amountAcct10 = t.amount2.setScale(10, RM);\n            } else {\n                BigDecimal rate = fx.resolve(t.currency, a.currency, t.effectiveEpochDay);\n                amountAcct10 = t.amount2.setScale(10, RM).multiply(rate).setScale(10, RM);\n            }\n\n            FeeRule fr = feeRules.get(a.feePlan);\n            BigDecimal fee2 = BD_0.setScale(2, RM);\n            if (fr != null) {\n                boolean isDebit = amountAcct10.signum() < 0;\n                boolean isCredit = amountAcct10.signum() > 0;\n                boolean applies;\n                if ("ALL".equals(fr.appliesTo)) applies = true;\n                else if ("DEBIT".equals(fr.appliesTo)) applies = isDebit;\n                else if ("CREDIT".equals(fr.appliesTo)) applies = isCredit;\n                else applies = false;\n\n                if (applies) {\n                    BigDecimal absAmt10 = amountAcct10.abs();\n                    BigDecimal rawFee10 = fr.flat2.setScale(10, RM).add(fr.pct.multiply(absAmt10)).setScale(10, RM);\n                    BigDecimal feeRounded2 = rawFee10.setScale(2, RM);\n                    if (feeRounded2.compareTo(fr.min2) < 0) feeRounded2 = fr.min2;\n                    if (feeRounded2.compareTo(fr.max2) > 0) feeRounded2 = fr.max2;\n                    fee2 = feeRounded2.setScale(2, RM);\n                }\n            }\n\n            BigDecimal adjusted2 = amountAcct10.setScale(2, RM).subtract(fee2).setScale(2, RM);\n\n            BigDecimal prev = adjustedSumByAccount.get(a.accountId);\n            if (prev == null) prev = BD_0.setScale(2, RM);\n            adjustedSumByAccount.put(a.accountId, prev.add(adjusted2).setScale(2, RM));\n\n            validTxs++;\n        }\n\n        // interest report\n        List<String> accountIds = new ArrayList<String>(accounts.keySet());\n        Collections.sort(accountIds);\n\n        BigDecimal totalInterestRaw10 = BD_0.setScale(10, RM);\n\n        StringBuilder interest = new StringBuilder();\n        interest.append("account_id,biz_date,eod_balance,apr,daily_interest\\n");\n\n        for (int i = 0; i < accountIds.size(); i++) {\n            String aid = accountIds.get(i);\n            Account a = accounts.get(aid);\n\n            BigDecimal sumAdj2 = adjustedSumByAccount.get(aid);\n            if (sumAdj2 == null) sumAdj2 = BD_0.setScale(2, RM);\n\n            BigDecimal eod2 = a.startBalance2.add(sumAdj2).setScale(2, RM);\n\n            int daysSinceOpened = bizEpochDay - a.openedEpochDay;\n            boolean promo = (a.promoDays > 0) && (daysSinceOpened < a.promoDays);\n            boolean tier = eod2.compareTo(a.tierThreshold2) >= 0;\n\n            BigDecimal apr = a.baseApr;\n            if (tier) apr = apr.add(a.tierApr);\n            if (promo) apr = apr.add(a.promoApr);\n            BigDecimal apr6 = apr.setScale(6, RM);\n\n            BigDecimal principal2 = (eod2.compareTo(BD_0) > 0) ? eod2 : BD_0.setScale(2, RM);\n            BigDecimal dailyRaw10 = principal2.setScale(10, RM)\n                    .multiply(apr.setScale(10, RM)).setScale(10, RM)\n                    .divide(BD_365, 10, RM);\n            BigDecimal daily2 = dailyRaw10.setScale(2, RM);\n\n            totalInterestRaw10 = totalInterestRaw10.add(dailyRaw10).setScale(10, RM);\n\n            interest.append(aid).append(\',\')\n                    .append(bizDateStr).append(\',\')\n                    .append(eod2.toPlainString()).append(\',\')\n                    .append(apr6.toPlainString()).append(\',\')\n                    .append(daily2.toPlainString())\n                    .append("\\n");\n        }\n\n        // files must be LF + trailing newline (already ends with \\n)\n        writeUtf8(INTEREST_CSV, interest.toString(), false);\n\n        StringBuilder exc = new StringBuilder();\n        exc.append("row_num,tx_id,reason\\n");\n        for (int i = 0; i < exceptions.size(); i++) {\n            String[] e = exceptions.get(i);\n            exc.append(e[0]).append(\',\').append(e[1]).append(\',\').append(e[2]).append("\\n");\n        }\n        writeUtf8(EXCEPTIONS_CSV, exc.toString(), false);\n\n        byte[] interestBytes = readAllBytes(INTEREST_CSV);\n        String reportMd5 = md5Hex(interestBytes);\n\n        BigDecimal totalInterest2 = totalInterestRaw10.setScale(2, RM);\n\n        // stats.json single-line JSON without newline\n        String json = "{" +\n                "\\"biz_date\\":\\"" + bizDateStr + "\\"," +\n                "\\"accounts\\":" + accounts.size() + "," +\n                "\\"valid_txs\\":" + validTxs + "," +\n                "\\"skipped_txs\\":" + skippedTxs + "," +\n                "\\"total_interest\\":\\"" + totalInterest2.toPlainString() + "\\"," +\n                "\\"report_md5\\":\\"" + reportMd5 + "\\"" +\n                "}";\n        writeUtf8(STATS_JSON, json, false);\n\n        buildDb(accounts, txns, bizDateStr, accounts.size(), validTxs, skippedTxs, reportMd5);\n    }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
