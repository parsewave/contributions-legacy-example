\\"%s\\",\\"accounts\\":%d,\\"valid_txs\\":%d,\\"skipped_txs\\":%d,\\"total_interest\\":%s,\\"report_md5\\":\\"%s\\"}", bizDateStr, accounts.size(), totalValid, totalSkipped, totalInterest.toPlainString(), md5Hex);\n        Files.write(outputDir.resolve("stats.json"), json.getBytes());\n        // Insert audit row\n        try (Connection conn = DriverManager.getConnection(jdbcUrl, "sa", "")) {\n            try (PreparedStatement ps = conn.prepareStatement("INSERT INTO RUN_AUDIT (jdbc_url,biz_date,accounts,valid_txs,skipped_txs,report_md5) VALUES (?,?,?,?,?,?)")) {\n                ps.setString(1, jdbcUrl);\n                ps.setDate(2, new java.sql.Date(bizDate.getTime()));\n                ps.setInt(3, accounts.size());\n                ps.setInt(4, totalValid);\n                ps.setInt(5, totalSkipped);\n                ps.setString(6, md5Hex);\n                ps.executeUpdate();\n            }\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
