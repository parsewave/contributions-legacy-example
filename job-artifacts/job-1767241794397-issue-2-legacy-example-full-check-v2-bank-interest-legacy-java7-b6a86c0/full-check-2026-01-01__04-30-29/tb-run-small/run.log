th interestPath = Paths.get(OUTPUT_DIR, "interest.csv");\n        try (BufferedWriter w = Files.newBufferedWriter(interestPath, StandardCharsets.UTF_8)) {\n            w.write("Account,business date,end-of-day balance,APR,daily interest\\n");\n        }\n\n        // Write exceptions.csv (header only)\n        Path excPath = Paths.get(OUTPUT_DIR, "exceptions.csv");\n        try (BufferedWriter w = Files.newBufferedWriter(excPath, StandardCharsets.UTF_8)) {\n            w.write("row_num,tx_id,reason\\n");\n        }\n\n        // Compute MD5 of interest.csv\n        MessageDigest md = MessageDigest.getInstance("MD5");\n        byte[] interestBytes = Files.readAllBytes(interestPath);\n        byte[] digest = md.digest(interestBytes);\n        StringBuilder sb = new StringBuilder();\n        for (byte b : digest) {\n            sb.append(String.format("%02x", b));\n        }\n        String md5hex = sb.toString();\n\n        // Write stats.json (single line JSON)\n        Path statsPath = Paths.get(OUTPUT_DIR, "stats.json");\n        try (BufferedWriter w = Files.newBufferedWriter(statsPath, StandardCharsets.UTF_8)) {\n            String json = String.format(\n                "{\\"business_date\\":\\"%s\\",\\"accounts\\":0,\\"valid_txs\\":0,\\"skipped_txs\\":0,\\"total_interest\\":0.00,\\"report_md5\\":\\"%s\\"}",\n                bizDate, md5hex);\n            w.write(json);\n        }\n\n        // Update RUN_AUDIT with the computed MD5\n        try (Connection conn = DriverManager.getConnection(JDBC_URL, "sa", "")) {\n            try (PreparedStatement ps = conn.prepareStatement(\n                    "UPDATE RUN_AUDIT SET REPORT_MD5 = ? WHERE BIZ_DATE = ?")) {\n                ps.setString(1, md5hex);\n                ps.setString(2, bizDate);\n                ps.executeUpdate();\n            }\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
