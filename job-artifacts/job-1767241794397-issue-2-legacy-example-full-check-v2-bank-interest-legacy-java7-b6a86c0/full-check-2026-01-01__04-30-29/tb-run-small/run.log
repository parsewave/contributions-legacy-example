Sending keys: ['cat > /app/src/BankBatchJob.java <<\'EOF\'\nimport java.io.*;\nimport java.math.*;\nimport java.nio.file.*;\nimport java.security.*;\nimport java.sql.*;\nimport java.text.*;\nimport java.util.*;\n\npublic class BankBatchJob {\n    // Helper classes\n    static class Account {\n        String accountId;\n        String currency;\n        BigDecimal startBalance;\n        BigDecimal baseApr;\n        BigDecimal tierThreshold;\n        BigDecimal tierApr;\n        BigDecimal promoApr;\n        int promoDays;\n        Date openedAt;\n        // other fields as needed\n    }\n    static class Transaction {\n        int rowNum; // 1-based data row\n        String txId;\n        String accountId;\n        String status;\n        String type; // DEBIT or CREDIT\n        BigDecimal amount;\n        String currency;\n        Date effectiveDate;\n        String reversalOf; // may be null\n        // other fields as needed\n    }\n    static class FxRate {\n        String from;\n        String to;\n        Date rateDate;\n        BigDecimal rate;\n    }\n    static class FxPivot {\n        String from;\n        String to;\n        String via;\n    }\n    static class FeeRule {\n        String accountId;\n        String feePlan; // e.g., ALL, DEBIT, CREDIT\n        BigDecimal flatFee;\n        BigDecimal percentFee; // as decimal (e.g., 0.001 for 0.1%) \n        BigDecimal minFee;\n        BigDecimal maxFee;\n    }\n\n    // Rounding helpers\n    private static BigDecimal roundHalfEven(BigDecimal value, int scale) {\n        return value.setScale(scale, RoundingMode.HALF_EVEN);\n    }\n\n    public static void main(String[] args) throws Exception {\n        // Paths\n        Path dataDir = Paths.get("/app/data");\n        Path outputDir = Paths.get("/app/output");\n        Files.createDirectories(outputDir);\n\n        // Load business date\n        String bizDateStr = new String(Files.readAllBytes(dataDir.resolve("biz_date.txt"))."trim"());\n        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd");\n        Date bizDate = sdf.parse(bizDateStr);\n\n        // Load accounts\n        Map<String, Account> accounts = new HashMap<String, Account>();\n        try (BufferedReader br = Files.newBufferedReader(dataDir.resolve("accounts.csv"))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.isEmpty()) continue;\n                String[] parts = line.split(",");\n                // Expected columns: account_id,currency,start_balance,base_apr,tier_threshold,tier_apr,promo_apr,promo_days,opened_at\n                Account acc = new Account();\n                acc.accountId = parts[0];\n                acc.currency = parts[1];\n                acc.startBalance = new BigDecimal(parts[2]);\n                acc.baseApr = new BigDecimal(parts[3]);\n                acc.tierThreshold = new BigDecimal(parts[4]);\n                acc.tierApr = new BigDecimal(parts[5]);\n                acc.promoApr = new BigDecimal(parts[6]);\n                acc.promoDays = Integer.parseInt(parts[7]);\n                acc.openedAt = sdf.parse(parts[8]);\n                accounts.put(acc.accountId, acc);\n            }\n        }\n\n        // Load fee rules\n        Map<String, FeeRule> feeRules = new HashMap<String, FeeRule>();\n        try (BufferedReader br = Files.newBufferedReader(dataDir.resolve("fee_rules.csv"))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.isEmpty()) continue;\n                String[] p = line.split(",");\n                // account_id,fee_plan,flat_fee,percent_fee,min_fee,max_fee\n                FeeRule fr = new FeeRule();\n                fr.accountId = p[0];\n                fr.feePlan = p[1];\n                fr.flatFee = new BigDecimal(p[2]);\n                fr.percentFee = new BigDecimal(p[3]);\n                fr.minFee = new BigDecimal(p[4]);\n                fr.maxFee = new BigDecimal(p[5]);\n                feeRules.put(fr.accountId, fr);\n            }\n        }\n\n        // Load FX rates\n        List<FxRate> fxRates = new ArrayList<FxRate>();\n        try (BufferedReader br = Files.newBufferedReader(dataDir.resolve("fx_rates.csv"))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.isEmpty()) continue;\n                String[] p = line.split(",");\n                // from,to,rate_date,rate\n                FxRate r = new FxRate();\n                r.from = p[0];\n                r.to = p[1];\n                r.rateDate = sdf.parse(p[2]);\n                r.rate = new BigDecimal(p[3]);\n                fxRates.add(r);\n            }\n        }\n        // Load FX pivots (order matters)\n        List<FxPivot> fxPivots = new ArrayList<FxPivot>();\n        try (BufferedReader br = Files.newBufferedReader(dataDir.resolve("fx_pivots.csv"))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.isEmpty()) continue;\n                String[] p = line.split(",");\n                // from,to,via\n                FxPivot fp = new FxPivot();\n                fp.from = p[0];\n                fp.to = p[1];\n                fp.via = p[2];\n                fxPivots.add(fp);\n            }\n        }\n\n        // Load transactions\n        List<Transaction> transactions = new ArrayList<Transaction>();\n        try (BufferedReader br = Files.newBufferedReader(dataDir.resolve("transactions.csv"))) {\n            String line;\n            int rowNum = 0;\n            while ((line = br.readLine()) != null) {\n                rowNum++;\n                if (line.isEmpty()) continue;\n                String[] p = line.split(",");\n                // Expected columns: tx_id,account_id,status,type,amount,currency,effective_date,reversal_of (may be empty)\n                Transaction tx = new Transaction();\n                tx.rowNum = rowNum;\n                tx.txId = p[0];\n                tx.accountId = p[1];\n                tx.status = p[2];\n                tx.type = p[3];\n                tx.amount = new BigDecimal(p[4]);\n                tx.currency = p[5];\n                tx.effectiveDate = sdf.parse(p[6]);\n                tx.reversalOf = (p.length > 7 && !p[7].isEmpty()) ? p[7] : null;\n                transactions.add(tx);\n            }\n        }\n\n        // Prepare H2 database\n        String jdbcUrl = "jdbc:h2:/app/output/bankdb;MODE=DB2";\n        Class.forName("org.h2.Driver"); // ensure driver loaded (H2 is on classpath in this image)\n        try (Connection conn = DriverManager.getConnection(jdbcUrl, "sa", "")) {\n            try (Statement st = conn.createStatement()) {\n                st.execute("DROP TABLE IF EXISTS ACCOUNTS");\n                st.execute("DROP TABLE IF EXISTS TXNS");\n                st.execute("DROP TABLE IF EXISTS RUN_AUDIT");\n                st.execute("CREATE TABLE ACCOUNTS (account_id VARCHAR PRIMARY KEY, currency VARCHAR, start_balance DECIMAL, base_apr DECIMAL, tier_threshold DECIMAL, tier_apr DECIMAL, promo_apr DECIMAL, promo_days INT, opened_at DATE)");\n                st.execute("CREATE TABLE TXNS (row_num INT PRIMARY KEY, tx_id VARCHAR, account_id VARCHAR, status VARCHAR, type VARCHAR, amount DECIMAL, currency VARCHAR, effective_date DATE, reversal_of VARCHAR)");\n                st.execute("CREATE TABLE RUN_AUDIT (jdbc_url VARCHAR, biz_date DATE, accounts INT, valid_txs INT, skipped_txs INT, report_md5 VARCHAR)");\n                // Insert accounts\n                String accInsert = "INSERT INTO ACCOUNTS (account_id,currency,start_balance,base_apr,tier_threshold,tier_apr,promo_apr,promo_days,opened_at) VALUES (?,?,?,?,?,?,?,?,?)";\n                try (PreparedStatement ps = conn.prepareStatement(accInsert)) {\n                    for (Account acc : accounts.values()) {\n                        ps.setString(1, acc.accountId);\n                        ps.setString(2, acc.currency);\n                        ps.setBigDecimal(3, acc.startBalance);\n                        ps.setBigDecimal(4, acc.baseApr);\n                        ps.setBigDecimal(5, acc.tierThreshold);\n                        ps.setBigDecimal(6, acc.tierApr);\n                        ps.setBigDecimal(7, acc.promoApr);\n                        ps.setInt(8, acc.promoDays);\n                        ps.setDate(9, new java.sql.Date(acc.openedAt.getTime()));\n                        ps.addBatch();\n                    }\n                    ps.executeBatch();\n                }\n                // Insert transactions (raw, before validation)\n                String txInsert = "INSERT INTO TXNS (row_num,tx_id,account_id,status,type,amount,currency,effective_date,reversal_of) VALUES (?,?,?,?,?,?,?,?,?)";\n                try (PreparedStatement ps = conn.prepareStatement(txInsert)) {\n                    for (Transaction tx : transactions) {\n                        ps.setInt(1, tx.rowNum);\n                        ps.setString(2, tx.txId);\n                        ps.setString(3, tx.accountId);\n                        ps.setString(4, tx.status);\n                        ps.setString(5, tx.type);\n                        ps.setBigDecimal(6, tx.amount);\n                        ps.setString(7, tx.currency);\n                        ps.setDate(8, new java.sql.Date(tx.effectiveDate.getTime()));\n                        ps.setString(9, tx.reversalOf);\n                        ps.addBatch();\n                    }\n                    ps.executeBatch();\n                }\n            }\n        }\n\n        // Validation and processing\n        Set<String> seenTxIds = new HashSet<String>();\n        Map<String, Transaction> txIdMap = new HashMap<String, Transaction>(); // for reversal lookup\n        for (Transaction tx : transactions) {\n            txIdMap.put(tx.txId, tx);\n        }\n        List<String[]> exceptionRows = new ArrayList<String[]>();\n        List<Transaction> validTxs = new ArrayList<Transaction>();\n        for (Transaction tx : transactions) {\n            // REVERSED: if any transaction has reversal_of pointing to this tx_id\n            boolean isReversed = false;\n            for (Transaction other : transactions) {\n                if (other.reversalOf != null && other.reversalOf.equals(tx.txId)) {\n                    isReversed = true;\n                    break;\n                }\n            }\n            if (isReversed) {\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "REVERSED"});\n                continue;\n            }\n            // REVERSAL_MISSING: if this transaction is a reversal but the original tx_id does not exist\n            if (tx.reversalOf != null && !txIdMap.containsKey(tx.reversalOf)) {\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "REVERSAL_MISSING"});\n                continue;\n            }\n            // FX_MISSING: will be checked later when converting currency\n            // AFTER_BIZ_DATE\n            if (tx.effectiveDate.after(bizDate)) {\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "AFTER_BIZ_DATE"});\n                continue;\n            }\n            // status != POSTED\n            if (!"POSTED".equalsIgnoreCase(tx.status)) {\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "status"});\n                continue;\n            }\n            // DUPLICATE\n            if (seenTxIds.contains(tx.txId)) {\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "DUPLICATE"});\n                continue;\n            }\n            seenTxIds.add(tx.txId);\n            validTxs.add(tx);\n        }\n\n        // Process valid transactions: currency conversion, fees, balance updates\n        Map<String, BigDecimal> accountBalances = new HashMap<String, BigDecimal>();\n        for (Account acc : accounts.values()) {\n            accountBalances.put(acc.accountId, acc.startBalance);\n        }\n        BigDecimal totalInterestRaw = BigDecimal.ZERO;\n        for (Transaction tx : validTxs) {\n            Account acc = accounts.get(tx.accountId);\n            if (acc == null) {\n                // unknown account, treat as exception\n                exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "UNKNOWN_ACCOUNT"});\n                continue;\n            }\n            // Determine FX rate to account currency if needed\n            BigDecimal amountInAccCurr = null;\n            if (!tx.currency.equals(acc.currency)) {\n                // Find direct rate\n                FxRate direct = null;\n                for (FxRate r : fxRates) {\n                    if (r.from.equals(tx.currency) && r.to.equals(acc.currency) && !r.rateDate.after(tx.effectiveDate)) {\n                        if (direct == null || r.rateDate.after(direct.rateDate)) {\n                            direct = r;\n                        }\n                    }\n                }\n                // Find reverse rate\n                FxRate reverse = null;\n                for (FxRate r : fxRates) {\n                    if (r.from.equals(acc.currency) && r.to.equals(tx.currency) && !r.rateDate.after(tx.effectiveDate)) {\n                        if (reverse == null || r.rateDate.after(reverse.rateDate)) {\n                            reverse = r;\n                        }\n                    }\n                }\n                BigDecimal rateToUse = null;\n                boolean useDirect = false;\n                if (direct != null && reverse != null) {\n                    int cmp = direct.rateDate.compareTo(reverse.rateDate);\n                    if (cmp > 0) { useDirect = true; }\n                    else if (cmp < 0) { useDirect = false; }\n                    else { useDirect = true; }\n                } else if (direct != null) {\n                    useDirect = true;\n                } else if (reverse != null) {\n                    useDirect = false;\n                }\n                if (useDirect) {\n                    rateToUse = direct.rate;\n                } else if (reverse != null) {\n                    // invert rate\n                    rateToUse = BigDecimal.ONE.divide(reverse.rate, 20, RoundingMode.HALF_EVEN);\n                }\n                if (rateToUse != null) {\n                    amountInAccCurr = roundHalfEven(tx.amount.multiply(rateToUse), 10);\n                } else {\n                    // Try pivots\n                    boolean pivotFound = false;\n                    for (FxPivot fp : fxPivots) {\n                        if (fp.from.equals(tx.currency) && fp.to.equals(acc.currency)) {\n                            // solve leg1 (from -> via)\n                            BigDecimal leg1 = null;\n                            // direct leg1\n                            for (FxRate r : fxRates) {\n                                if (r.from.equals(fp.from) && r.to.equals(fp.via) && !r.rateDate.after(tx.effectiveDate)) {\n                                    if (leg1 == null || r.rateDate.after(((FxRate)leg1).rateDate)) {\n                                        leg1 = r.rate;\n                                    }\n                                }\n                            }\n                            // reverse leg1\n                            if (leg1 == null) {\n                                for (FxRate r : fxRates) {\n                                    if (r.from.equals(fp.via) && r.to.equals(fp.from) && !r.rateDate.after(tx.effectiveDate)) {\n                                        leg1 = BigDecimal.ONE.divide(r.rate, 20, RoundingMode.HALF_EVEN);\n                                        break;\n                                    }\n                                }\n                            }\n                            // solve leg2 (via -> to)\n                            BigDecimal leg2 = null;\n                            for (FxRate r : fxRates) {\n                                if (r.from.equals(fp.via) && r.to.equals(fp.to) && !r.rateDate.after(tx.effectiveDate)) {\n                                    if (leg2 == null || r.rateDate.after(((FxRate)leg2).rateDate)) {\n                                        leg2 = r.rate;\n                                    }\n                                }\n                            }\n                            if (leg2 == null) {\n                                for (FxRate r : fxRates) {\n                                    if (r.from.equals(fp.to) && r.to.equals(fp.via) && !r.rateDate.after(tx.effectiveDate)) {\n                                        leg2 = BigDecimal.ONE.divide(r.rate, 20, RoundingMode.HALF_EVEN);\n                                        break;\n                                    }\n                                }\n                            }\n                            if (leg1 != null && leg2 != null) {\n                                BigDecimal combined = leg1.multiply(leg2);\n                                amountInAccCurr = roundHalfEven(tx.amount.multiply(combined), 10);\n                                pivotFound = true;\n                                break;\n                            }\n                        }\n                    }\n                    if (!pivotFound) {\n                        exceptionRows.add(new String[]{String.valueOf(tx.rowNum), tx.txId, "FX_MISSING"});\n                        continue;\n                    }\n                }\n            } else {\n                amountInAccCurr = roundHalfEven(tx.amount, 10);\n            }\n            // Apply fee\n            FeeRule fr = feeRules.get(acc.accountId);\n            if (fr == null) {\n                // No fee rule, treat as zero fee\n                fr = new FeeRule();\n                fr.flatFee = BigDecimal.ZERO;\n                fr.percentFee = BigDecimal.ZERO;\n                fr.minFee = BigDecimal.ZERO;\n                fr.maxFee = BigDecimal.ZERO;\n                fr.feePlan = "ALL";\n            }\n            boolean applyFee = false;\n            if ("ALL".equalsIgnoreCase(fr.feePlan)) applyFee = true;\n            else if ("DEBIT".equalsIgnoreCase(fr.feePlan) && "DEBIT".equalsIgnoreCase(tx.type)) applyFee = true;\n            else if ("CREDIT".equalsIgnoreCase(fr.feePlan) && "CREDIT".equalsIgnoreCase(tx.type)) applyFee = true;\n            BigDecimal fee = BigDecimal.ZERO;\n            if (applyFee) {\n                BigDecimal pctPart = fr.percentFee.multiply(amountInAccCurr.abs());\n                fee = fr.flatFee.add(pctPart);\n                fee = roundHalfEven(fee, 2);\n                if (fee.compareTo(fr.minFee) < 0) fee = fr.minFee;\n                if (fee.compareTo(fr.maxFee) > 0) fee = fr.maxFee;\n            }\n            // Adjusted amount (sign stays as original)\n            BigDecimal adjusted = amountInAccCurr.subtract(fee);\n            adjusted = roundHalfEven(adjusted, 2);\n            // Update balance\n            BigDecimal prevBal = accountBalances.get(acc.accountId);\n            BigDecimal newBal = prevBal.add(adjusted);\n            accountBalances.put(acc.accountId, newBal);\n        }\n\n        // Compute interest and write interest.csv\n        List<String[]> interestRows = new ArrayList<String[]>();\n        for (Account acc : accounts.values()) {\n            BigDecimal eodBal = accountBalances.get(acc.accountId);\n            eodBal = roundHalfEven(eodBal, 2);\n            // Determine APR\n            BigDecimal apr = acc.baseApr;\n            if (eodBal.compareTo(acc.tierThreshold) >= 0) {\n                apr = apr.add(acc.tierApr);\n            }\n            // Promo APR\n            long daysSinceOpened = (bizDate.getTime() - acc.openedAt.getTime()) / (1000L*60*60*24);\n            if (acc.promoDays > 0 && daysSinceOpened < acc.promoDays) {\n                apr = apr.add(acc.p