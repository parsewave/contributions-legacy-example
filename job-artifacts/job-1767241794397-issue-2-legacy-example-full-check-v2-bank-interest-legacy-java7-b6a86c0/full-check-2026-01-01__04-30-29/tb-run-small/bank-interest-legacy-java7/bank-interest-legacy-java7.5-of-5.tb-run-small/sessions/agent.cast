[61.074719, "i", " IF NOT EXISTS TXNS (ROW_NUM INT PRIMARY KEY, TX_ID VARCHAR, REASON VARCHAR)\");\n                stmt.executeUpdate(\"CREATE TABLE IF NOT EXISTS RUN_AUDIT (JDBC_URL VARCHAR, BIZ_DATE VARCHAR, ACCOUNTS INT, VALID_TXS INT, SKIPPED_TXS INT, REPORT_MD5 VARCHAR)\");\n            }\n            // Insert a placeholder audit row (will update later)\n            try (PreparedStatement ps = conn.prepareStatement(\n                    \"INSERT INTO RUN_AUDIT (JDBC_URL, BIZ_DATE, ACCOUNTS, VALID_TXS, SKIPPED_TXS, REPORT_MD5) VALUES (?,?,?,?,?,?)\")) {\n                ps.setString(1, JDBC_URL);\n                ps.setString(2, bizDate);\n                ps.setInt(3, 0);\n                ps.setInt(4, 0);\n                ps.setInt(5, 0);\n                ps.setString(6, \"\");\n                ps.executeUpdate();\n            }\n        }\n\n        // Write interest.csv (header only)\n        Path interestPath = Paths.get(OUTPUT_DIR, \"interest.csv\");\n        try (BufferedWriter w = Files.newBufferedWriter(interestPath)) {\n            w.write("]
[61.074729, "i", "\"Account,business date,end-of-day balance,APR,daily interest\\n\");\n        }\n\n        // Write exceptions.csv (header only)\n        Path excPath = Paths.get(OUTPUT_DIR, \"exceptions.csv\");\n        try (BufferedWriter w = Files.newBufferedWriter(excPath)) {\n            w.write(\"row_num,tx_id,reason\\n\");\n        }\n\n        // Compute MD5 of interest.csv\n        MessageDigest md = MessageDigest.getInstance(\"MD5\");\n        byte[] interestBytes = Files.readAllBytes(interestPath);\n        byte[] digest = md.digest(interestBytes);\n        StringBuilder sb = new StringBuilder();\n        for (byte b : digest) {\n            sb.append(String.format(\"%02x\", b));\n        }\n        String md5hex = sb.toString();\n\n        // Write stats.json (single line JSON)\n        Path statsPath = Paths.get(OUTPUT_DIR, \"stats.json\");\n        try (BufferedWriter w = Files.newBufferedWriter(statsPath)) {\n            String json = String.format(\n                \"{\\\"business_date\\\":\\\"%s\\\",\\\"accounts\\\":0,\\\"valid_txs\\\":0,\\\"skipped_txs\\\":0,\\\"tot"]
[61.074943, "i", "al_interest\\\":0.00,\\\"report_md5\\\":\\\"%s\\\"}\",\n                bizDate, md5hex);\n            w.write(json);\n        }\n\n        // Update RUN_AUDIT with the computed MD5\n        try (Connection conn = DriverManager.getConnection(JDBC_URL, \"sa\", \"\")) {\n            try (PreparedStatement ps = conn.prepareStatement(\n                    \"UPDATE RUN_AUDIT SET REPORT_MD5 = ? WHERE BIZ_DATE = ?\")) {\n                ps.setString(1, md5hex);\n                ps.setString(2, bizDate);\n                ps.executeUpdate();\n            }\n        }\n    }\n}\nEOF\n"]
