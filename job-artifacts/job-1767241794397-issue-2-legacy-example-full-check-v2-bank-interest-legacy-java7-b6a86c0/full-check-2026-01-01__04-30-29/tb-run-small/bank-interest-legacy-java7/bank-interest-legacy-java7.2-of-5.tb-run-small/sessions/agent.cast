[190.394152, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.394173, "o", "\u001b[?2004h> "]
[190.394537, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         Path out = Paths.get(\"/app/output\");\r\n\u001b[?2004l\r\u001b[?2004h>         Files.createDirectories(out);\r\n\u001b[?2004l\r\u001b[?2004h>         // Write placeholder CSV and JSON files\r\n\u001b[?2004l\r"]
[190.394702, "o", "\u001b[?2004h> "]
[190.394899, "o", "        try (BufferedWriter bw = Files.newBufferedWriter(out.resolve(\"interest.csv\"), Charset.forName(\"UTF-8\"))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.394994, "o", "            bw.write(\"Account,business date,end-of-day balance,APR,daily interest\\n\");\r\n\u001b[?2004l\r"]
[190.39509, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.395267, "o", "        try (BufferedWriter bw = Files.newBufferedWriter(out.resolve(\"exceptions.csv\"), Charset.forName(\"UTF-8\"))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.395381, "o", "            bw.write(\"row_num,tx_id,reason\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[190.395417, "o", "\u001b[?2004h> "]
[190.395655, "o", "        try (BufferedWriter bw = Files.newBufferedWriter(out.resolve(\"stats.json\"), Charset.forName(\"UTF-8\"))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.395802, "o", "            bw.write(\"{}\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.395911, "o", "        // Create H2 database and insert dummy audit row\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.396027, "o", "        String jdbc = \"jdbc:h2:/app/output/bankdb;MODE=DB2\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.396117, "o", "        Class.forName(\"org.h2.Driver\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.396296, "o", "        try (Connection con = DriverManager.getConnection(jdbc, \"sa\", \"\")) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.396415, "o", "            try (Statement st = con.createStatement()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.396745, "o", "                st.execute(\"CREATE TABLE IF NOT EXISTS RUN_AUDIT (jdbc_url VARCHAR, biz_date DATE, accounts INT, valid_txs INT, skipped_txs INT, report_md5 VARCHAR)\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.397092, "o", "                String sql = \"INSERT INTO RUN_AUDIT (jdbc_url,biz_date,accounts,valid_txs,skipped_txs,report_md5) VALUES ('\" + jdbc + \"', CURRENT_DATE(), 0, 0, 0, '')\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.397178, "o", "                st.execute(sql);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.397207, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[190.397287, "o", "        }"]
