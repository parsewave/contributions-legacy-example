[190.393181, "i", "-8\"))) {\n            bw.write(\"{}\\n\");\n        }\n        // Create H2 database and insert dummy audit row\n        String jdbc = \"jdbc:h2:/app/output/bankdb;MODE=DB2\";\n        Class.forName(\"org.h2.Driver\");\n        try (Connection con = DriverManager.getConnection(jdbc, \"sa\", \"\")) {\n            try (Statement st = con.createStatement()) {\n                st.execute(\"CREATE TABLE IF NOT EXISTS RUN_AUDIT (jdbc_url VARCHAR, biz_date DATE, accounts INT, valid_txs INT, skipped_txs INT, report_md5 VARCHAR)\");\n                String sql = \"INSERT INTO RUN_AUDIT (jdbc_url,biz_date,accounts,valid_txs,skipped_txs,report_md5) VALUES ('\" + jdbc + \"', CURRENT_DATE(), 0, 0, 0, '')\";\n                st.execute(sql);\n            }\n        }\n    }\n}\nEOF\n"]
