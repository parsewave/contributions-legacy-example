[11.221021, "o", "  There is one row in RUN_AUDIT: jdbc_url, biz_date, accounts, valid_txs, skipped_txs, and report_md5.\r\n\u001b[?2004l\r"]
[11.221924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
