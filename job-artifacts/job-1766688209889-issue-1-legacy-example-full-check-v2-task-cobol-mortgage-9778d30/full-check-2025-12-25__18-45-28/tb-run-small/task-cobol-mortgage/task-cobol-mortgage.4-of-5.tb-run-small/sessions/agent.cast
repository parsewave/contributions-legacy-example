[88.397014, "o", "\u001b[?2004h> "]
[88.397101, "o", "               *--- Approved application ---*\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.397204, "o", "               MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.397369, "o", "               STRING \"APPRO\" DELIMITED BY SIZE INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.397481, "o", "               WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.397587, "o", "               *--- Compute payment schedule ---*\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.397604, "o", "> "]
[88.397734, "o", "               COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.397879, "o", "               COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.398048, "o", "                     / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.39815, "o", "               MOVE WS-LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.398316, "o", "               PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.398494, "o", "                   COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.398642, "o", "                   COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.398782, "o", "                   COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.398823, "o", "> "]
[88.398931, "o", "                   * Build output line for this month *\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399036, "o", "                   MOVE MON-NUM TO LINE-OUT(1:3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399148, "o", "                   MOVE \" \" TO LINE-OUT(4:4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399276, "o", "                   MOVE MONTHLY-PMT TO LINE-OUT(5:14)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399389, "o", "                   MOVE \" \" TO LINE-OUT(15:15)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399526, "o", "                   MOVE INTEREST TO LINE-OUT(16:25)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.39964, "o", "                   MOVE \" \" TO LINE-OUT(26:26)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399765, "o", "                   MOVE PRINCIPAL TO LINE-OUT(27:36)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.399873, "o", "                   MOVE \" \" TO LINE-OUT(37:37)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.399922, "o", "> "]
[88.400014, "o", "                   MOVE BALANCE TO LINE-OUT(38:47)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.400122, "o", "                   MOVE LINE-OUT TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.400239, "o", "                   WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.400319, "o", "               END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.400384, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.400421, "o", "EOF\r\n\u001b[?2004l\r"]
