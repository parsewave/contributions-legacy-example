[88.394399, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r"]
[88.394418, "o", "\u001b[?2004h> "]
[88.394523, "o", "           PERFORM UNTIL END-OF-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
