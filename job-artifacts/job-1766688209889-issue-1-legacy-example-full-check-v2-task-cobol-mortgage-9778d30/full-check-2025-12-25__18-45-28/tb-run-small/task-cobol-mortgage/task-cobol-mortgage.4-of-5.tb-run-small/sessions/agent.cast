[88.395342, "o", ">        PROCESS-RECORD."]
[88.39536, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.395472, "o", "           UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.39555, "o", "               INTO WS-ID,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.395617, "o", "                    WS-NAME,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.395719, "o", "                    WS-LOAN-AMT,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.395813, "o", "                    WS-PROP-VALUE,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.395901, "o", "                    WS-DOWN-PAY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.396001, "o", "                    WS-TERM,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.396089, "o", "                    WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.396156, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.396268, "o", "           COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.396368, "o", "           IF WS-DOWN-PAY < MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
