[2.910603, "i", "clear\r"]
[2.91086, "o", "clear\r\n\u001b[?2004l\r"]
[2.912165, "o", "\u001b[H\u001b[J\u001b[3J"]
[2.912386, "m", "Episode 0: 1 commands"]
[2.912386, "o", "\u001b[?2004hroot@1a131b779730:/app# "]
[5.741402, "i", "ls -R /app\n"]
[5.741602, "o", "ls -R /app\r\n\u001b[?2004l\r"]
[5.742861, "o", "/app:\r\ndata  src\r\n"]
[5.743048, "o", "\r\n/app/data:\r\nOUTPUT.DAT\r\n\r\n/app/src:\r\nINPUT.DAT\r\n"]
[5.743195, "m", "Episode 1: 4 commands"]
[5.743195, "o", "\u001b[?2004hroot@1a131b779730:/app# "]
[32.538602, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. MORTGAGE.\n\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INFILE ASSIGN TO '/app/src/INPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTFILE ASSIGN TO '/app/data/OUTPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n\nDATA DIVISION.\nFILE SECTION.\nFD INFILE.\n01 IN-REC PIC X(200).\nFD OUTFILE.\n01 OUT-REC PIC X(200).\n\nWORKING-STORAGE SECTION.\n01 WS-EOF        PIC X VALUE 'N'.\n   88 END-OF-FILE VALUE 'Y'.\n01 WS-ID         PIC X(10).\n01 WS-NAME       PIC X(30).\n01 WS-LOAN-AMT   PIC 9(10)V99.\n01 WS-PROP-VALUE PIC 9(10)V99.\n01 WS-DOWN-PAY   PIC 9(10)V99.\n01 WS-TERM       PIC 9(2).\n01 WS-RATE       PIC 9(3)V99.\n01 MIN-DOWN     PIC 9(10)V99.\n01 MONTHLY-RATE PIC V9(6).\n01 MONTHLY-PMT  PIC 9(10)V99.\n01 BALANCE      PIC 9(10)V99.\n01 INTEREST     PIC 9(10)V99.\n01 PRINCIPAL    PIC 9(10)V99.\n01 MON-NUM      PIC 9(3).\n01 LINE-OUT.\n   05 FILLER     PIC X(200).\n\nPROCEDURE DIVISION.\n    OPEN INPUT INFILE\n    OPEN OUTPUT OUT"]
[32.538652, "i", "FILE\n    PERFORM UNTIL END-OF-FILE\n        READ INFILE INTO IN-REC\n            AT END MOVE 'Y' TO WS-EOF\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE INFILE OUTFILE\n    STOP RUN.\n\nPROCESS-RECORD.\n    UNSTRING IN-REC DELIMITED BY ';'\n        INTO WS-ID,\n             WS-NAME,\n             WS-LOAN-AMT,\n             WS-PROP-VALUE,\n             WS-DOWN-PAY,\n             WS-TERM,\n             WS-RATE\n    END-UNSTRING\n    COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAY < MIN-DOWN\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING \"DENY\" DELIMITED BY SIZE\n               \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n               INTO OUT-REC(11:)\n        WRITE OUTFILE FROM OUT-REC\n    ELSE\n        *--- Approved application ---*\n        MOVE WS-ID TO OUT-REC(1:10)\n        STRING \"APPRO\" DELIMITED BY SIZE INTO OUT-REC(11:)\n        WRITE OUTFILE FROM OUT-REC\n        *--- Compute payment schedule ---*\n        COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n  "]
[32.538908, "i", "      COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\n            / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\n        MOVE WS-LOAN-AMT TO BALANCE\n        PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\n            COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\n            COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\n            COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\n            * Build output line: mon-num payment interest principal balance\n            MOVE MON-NUM TO LINE-OUT(1:3)\n            MOVE \" \" TO LINE-OUT(4:4)\n            MOVE MONTHLY-PMT TO LINE-OUT(5:14)\n            MOVE \" \" TO LINE-OUT(15:15)\n            MOVE INTEREST TO LINE-OUT(16:25)\n            MOVE \" \" TO LINE-OUT(26:26)\n            MOVE PRINCIPAL TO LINE-OUT(27:36)\n            MOVE \" \" TO LINE-OUT(37:37)\n            MOVE BALANCE TO LINE-OUT(38:47)\n            MOVE LINE-OUT TO OUT-REC\n            WRITE OUTFILE FROM OUT-REC\n        END-PERFORM\n    END-IF.\nEOF\n"]
[32.538986, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.539054, "o", "IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r      COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\r\n            / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\r\n        MOVE WS-LOAN-AMT TO BALANCE\r\n        PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\r\n            COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n            COMPUTE PRINCIPAL ="]
[32.539109, "o", " MONTHLY-PMT - INTEREST ROUNDED\r\n            COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\r\n            * Build output line: mon-num payment interest principal balance\r\n            MOVE MON-NUM TO LINE-OUT(1:3)\r\n            MOVE \" \" TO LINE-OUT(4:4)\r\n            MOVE MONTHLY-PMT TO LINE-OUT(5:14)\r\n            MOVE \" \" TO LINE-OUT(15:"]
[32.539219, "o", "15)\r\n            MOVE INTEREST TO LINE-OUT(16:25)\r\n          "]
[32.539244, "o", "  MOVE \" \" TO LINE-OUT(26:26)\r\n            MOVE PRINCIPAL TO LINE-OUT(27:36)\r\n            MOVE \" \" TO LINE-OUT(37:37)\r\n            MOVE BALANCE TO LINE-OUT(38:47)\r\n            MOVE LINE-OUT TO OUT-REC\r\n            WRITE OUTFILE FROM OUT-REC\r\n        END-PERFORM\r\n    END-IF.\r\nEOF\r\n"]
[32.53932, "o", "\u001b[?2004h> "]
[32.539409, "o", "PROGRAM-ID. MORTGAGE.\r\n\u001b[?2004l\r"]
[32.539483, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.539562, "o", "ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.539584, "o", "> "]
[32.539735, "o", "INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.539832, "o", "    SELECT INFILE ASSIGN TO '/app/src/INPUT.DAT'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.539956, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.54002, "o", "> "]
[32.540142, "o", "    SELECT OUTFILE ASSIGN TO '/app/data/OUTPUT.DAT'\r\n\u001b[?2004l\r"]
[32.540168, "o", "\u001b[?2004h> "]
[32.54027, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.540285, "o", "\u001b[?2004h> "]
[32.540346, "o", "DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.540408, "o", "FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54054, "o", "FD INFILE.\r\n\u001b[?2004l\r\u001b[?2004h> 01 IN-REC PIC X(200).\r\n\u001b[?2004l\r"]
[32.540613, "o", "\u001b[?2004h> "]
[32.540661, "o", "FD OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.540705, "o", "01 OUT-REC PIC X(200).\r\n\u001b[?2004l\r"]
[32.540745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.540786, "o", "\u001b[?2004h> "]
[32.540838, "o", "WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.540948, "o", "01 WS-EOF        PIC X VALUE 'N'.\r\n\u001b[?2004l\r"]
[32.540962, "o", "\u001b[?2004h> "]
[32.541044, "o", "   88 END-OF-FILE VALUE 'Y'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.541184, "o", "01 WS-ID         PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.541312, "o", "01 WS-NAME       PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.541337, "o", "01 WS-LOAN-AMT   PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54141, "o", "01 WS-PROP-VALUE PIC 9(10)V99.\r\n\u001b[?2004l\r"]
[32.541429, "o", "\u001b[?2004h"]
[32.541532, "o", "> 01 WS-DOWN-PAY   PIC 9(10)V99.\r\n\u001b[?2004l\r"]
[32.541593, "o", "\u001b[?2004h> "]
[32.541664, "o", "01 WS-TERM       PIC 9(2).\r\n\u001b[?2004l\r"]
[32.541734, "o", "\u001b[?2004h> "]
[32.54176, "o", "01 WS-RATE       PIC 9(3)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.541864, "o", "01 MIN-DOWN     PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.541918, "o", "01 MONTHLY-RATE PIC V9(6).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542007, "o", "01 MONTHLY-PMT  PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54212, "o", "01 BALANCE      PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54223, "o", "01 INTEREST     PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542319, "o", "01 PRINCIPAL    PIC 9(10)V99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542395, "o", "01 MON-NUM      PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.542465, "o", "> "]
[32.54252, "o", "01 LINE-OUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542541, "o", "   05 FILLER     PIC X(200).\r\n\u001b[?2004l\r"]
[32.542592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54265, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542748, "o", "    OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54286, "o", "    OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.542972, "o", "    PERFORM UNTIL END-OF-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.543067, "o", "        READ INFILE INTO IN-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.543177, "o", "            AT END MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.543255, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.543275, "o", "> "]
[32.543337, "o", "            PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.543406, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.543425, "o", "> "]
[32.543511, "o", "    END-PERFORM\r\n\u001b[?2004l\r"]
[32.543573, "o", "\u001b[?2004h> "]
[32.543594, "o", "    CLOSE INFILE OUTFILE\r\n\u001b[?2004l\r"]
[32.543663, "o", "\u001b[?2004h>     STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.543679, "o", "> \r\n\u001b[?2004l\r"]
[32.543717, "o", "\u001b[?2004h> "]
[32.543736, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r"]
[32.543813, "o", "\u001b[?2004h> "]
[32.543832, "o", "    UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.543905, "o", ">         INTO WS-ID,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.544, "o", "             WS-NAME,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.544055, "o", "             WS-LOAN-AMT,\r\n\u001b[?2004l\r"]
[32.544099, "o", "\u001b[?2004h> "]
[32.544173, "o", "             WS-PROP-VALUE,\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.544192, "o", "> "]
[32.544288, "o", "             WS-DOWN-PAY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.544349, "o", "             WS-TERM,\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.5444, "o", "> "]
[32.54447, "o", "             WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.544536, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.544557, "o", "> "]
[32.54467, "o", "    COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.544696, "o", "> "]
[32.54477, "o", "    IF WS-DOWN-PAY < MIN-DOWN\r\n\u001b[?2004l\r"]
[32.544789, "o", "\u001b[?2004h> "]
[32.544901, "o", "        MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r"]
[32.544932, "o", "\u001b[?2004h> "]
[32.545059, "o", "        STRING \"DENY\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.545181, "o", "               \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.545199, "o", "> "]
[32.545286, "o", "               INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.54538, "o", "        WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.545471, "o", "    ELSE\r\n\u001b[?2004l\r"]
[32.545492, "o", "\u001b[?2004h> "]
[32.545604, "o", "        *--- Approved application ---*\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.545707, "o", "        MOVE WS-ID TO OUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.545861, "o", "        STRING \"APPRO\" DELIMITED BY SIZE INTO OUT-REC(11:)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.545967, "o", "        WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.545985, "o", "> "]
[32.546097, "o", "        *--- Compute payment schedule ---*\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.546273, "o", "        COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r"]
[32.546293, "o", "\u001b[?2004h> "]
[32.546432, "o", "        COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.546589, "o", "            / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.546676, "o", "        MOVE WS-LOAN-AMT TO BALANCE\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.546695, "o", "> "]
[32.546843, "o", "        PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\r\n\u001b[?2004l\r"]
[32.546867, "o", "\u001b[?2004h> "]
[32.547049, "o", "            COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.547194, "o", "            COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.547214, "o", "> "]
[32.547357, "o", "            COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.547557, "o", "            * Build output line: mon-num payment interest principal balance\r\n\u001b[?2004l\r"]
[32.547578, "o", "\u001b[?2004h> "]
[32.547708, "o", "            MOVE MON-NUM TO LINE-OUT(1:3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.547819, "o", "            MOVE \" \" TO LINE-OUT(4:4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.547944, "o", "            MOVE MONTHLY-PMT TO LINE-OUT(5:14)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.547966, "o", "> "]
[32.548072, "o", "            MOVE \" \" TO LINE-OUT(15:15)\r\n\u001b[?2004l\r"]
[32.548089, "o", "\u001b[?2004h> "]
[32.548207, "o", "            MOVE INTEREST TO LINE-OUT(16:25)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.548227, "o", "> "]
[32.548349, "o", "            MOVE \" \" TO LINE-OUT(26:26)\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.548371, "o", "> "]
[32.548507, "o", "            MOVE PRINCIPAL TO LINE-OUT(27:36)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.548606, "o", "            MOVE \" \" TO LINE-OUT(37:37)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.548721, "o", "            MOVE BALANCE TO LINE-OUT(38:47)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.548844, "o", "            MOVE LINE-OUT TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.548961, "o", "            WRITE OUTFILE FROM OUT-REC\r\n\u001b[?2004l\r"]
[32.549045, "o", "\u001b[?2004h>         END-PERFORM\r\n\u001b[?2004l\r"]
[32.549062, "o", "\u001b[?2004h> "]
[32.549147, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[32.55059, "o", "\u001b[?2004hroot@1a131b779730:/app# "]
