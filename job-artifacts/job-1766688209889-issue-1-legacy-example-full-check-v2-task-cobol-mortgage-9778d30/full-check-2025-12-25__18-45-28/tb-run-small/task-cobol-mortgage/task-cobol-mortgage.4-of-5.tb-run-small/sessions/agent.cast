[88.390371, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. MORTGAGE.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO '/app/src/INPUT.DAT'\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO '/app/data/OUTPUT.DAT'\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD INFILE.\n       01 IN-REC PIC X(200).\n       FD OUTFILE.\n       01 OUT-REC PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       01 WS-EOF        PIC X VALUE 'N'.\n          88 END-OF-FILE VALUE 'Y'.\n       01 WS-ID         PIC X(10).\n       01 WS-NAME       PIC X(30).\n       01 WS-LOAN-AMT   PIC 9(10)V99.\n       01 WS-PROP-VALUE PIC 9(10)V99.\n       01 WS-DOWN-PAY   PIC 9(10)V99.\n       01 WS-TERM       PIC 9(2).\n       01 WS-RATE       PIC 9(3)V99.\n       01 MIN-DOWN      PIC 9(10)V99.\n       01 MONTHLY-RATE  PIC V9(6).\n       01 MONTHLY-PMT   PIC 9(10)V99.\n       01 BALANCE    "]
[88.390471, "i", "   PIC 9(10)V99.\n       01 INTEREST      PIC 9(10)V99.\n       01 PRINCIPAL     PIC 9(10)V99.\n       01 MON-NUM       PIC 9(3).\n       01 LINE-OUT      PIC X(200).\n\n       PROCEDURE DIVISION.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n           PERFORM UNTIL END-OF-FILE\n               READ INFILE INTO IN-REC\n                   AT END MOVE 'Y' TO WS-EOF\n               NOT AT END\n                   PERFORM PROCESS-RECORD\n               END-READ\n           END-PERFORM\n           CLOSE INFILE OUTFILE\n           STOP RUN.\n\n       PROCESS-RECORD.\n           UNSTRING IN-REC DELIMITED BY ';'\n               INTO WS-ID,\n                    WS-NAME,\n                    WS-LOAN-AMT,\n                    WS-PROP-VALUE,\n                    WS-DOWN-PAY,\n                    WS-TERM,\n                    WS-RATE\n           END-UNSTRING\n           COMPUTE MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n           IF WS-DOWN-PAY < MIN-DOWN\n               MOVE WS-ID TO OUT-REC(1:10)\n               STRING \"DENY\" DELIMITED "]
[88.390774, "i", "BY SIZE\n                      \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n                      INTO OUT-REC(11:)\n               WRITE OUTFILE FROM OUT-REC\n           ELSE\n               *--- Approved application ---*\n               MOVE WS-ID TO OUT-REC(1:10)\n               STRING \"APPRO\" DELIMITED BY SIZE INTO OUT-REC(11:)\n               WRITE OUTFILE FROM OUT-REC\n               *--- Compute payment schedule ---*\n               COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n               COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\n                     / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\n               MOVE WS-LOAN-AMT TO BALANCE\n               PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\n                   COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\n                   COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\n                   COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\n                   * Build output line for this month *\n                   MOVE MON-NUM TO LI"]
[88.390988, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\rBY SIZE\r\n                      \" INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n                      INTO OUT-REC(11:)\r\n               WRITE OUTFILE FROM OUT-REC\r\n           ELSE\r\n               *--- Approved application ---*\r\n               MOVE WS-ID TO OUT-REC(1:10)\r\n               STRING \"APPRO\" DELIMITED BY SIZE INTO OUT-REC(11:)\r\n               WRITE OUTFILE FROM OUT-REC\r\n               *--- Compute payment schedule ---*\r\n               COMPUTE MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n               COMPUTE MONTHLY-PMT = WS-LOAN-AMT * MONTHLY-RATE\r\n                     / (1 - (1 + MONTHLY-RATE) ** (-WS-TERM)) ROUNDED\r\n               MOVE WS-LOAN-AMT TO BALANCE\r\n               PERFORM VARYING MON-NUM FROM 1 BY 1 UNTIL MON-NUM > WS-TERM\r\n                   COMPUTE INTEREST = BALANCE * MONTHLY-RATE ROUNDED\r\n                   COMPUTE PRINCIPAL = MONTHLY-PMT - INTEREST ROUNDED\r\n                   COMPUTE BALANCE = BALANCE - PRINCIPAL ROUNDED\r\n                   * Build out"]
[88.391032, "i", "NE-OUT(1:3)\n                   MOVE \" \" TO LINE-OUT(4:4)\n                   MOVE MONTHLY-PMT TO LINE-OUT(5:14)\n                   MOVE \" \" TO LINE-OUT(15:15)\n                   MOVE INTEREST TO LINE-OUT(16:25)\n                   MOVE \" \" TO LINE-OUT(26:26)\n                   MOVE PRINCIPAL TO LINE-OUT(27:36)\n                   MOVE \" \" TO LINE-OUT(37:37)\n                   MOVE BALANCE TO LINE-OUT(38:47)\n                   MOVE LINE-OUT TO OUT-REC\n                   WRITE OUTFILE FROM OUT-REC\n               END-PERFORM\n           END-IF.\nEOF\n"]
[88.391146, "o", "put line for this month *\r\n                   MOVE MON-NUM TO LI\u001b[?2004h>        IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
