[34.18221, "i", "mkdir -p /app/src /app/data\n"]
[34.18247, "o", "mkdir -p /app/src /app/data\r\n\u001b[?2004l\r"]
[34.184016, "o", "\u001b[?2004hroot@7f1b4e49b628:/app# "]
[34.286478, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. PROGRAM.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INPUT-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTPUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD INPUT-FILE.\n01 INPUT-REC PIC X(200).\nFD OUTPUT-FILE.\n01 OUTPUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01 WS-EOF PIC X VALUE 'N'.\n01 WS-ID PIC X(10).\n01 WS-NAME PIC X(30).\n01 WS-LOAN-AMOUNT PIC 9(10).\n01 WS-PROP-VALUE PIC 9(10).\n01 WS-DOWN-PAYMENT PIC 9(10).\n01 WS-TERM PIC 9(2).\n01 WS-RATE PIC 9(3)V9(2).\n01 WS-MIN-DOWN PIC 9(10)V9(2).\n01 WS-MONTHLY-RATE PIC 9(5)V9(6).\n01 WS-MONTHLY-PAYMENT PIC 9(8)V9(2).\n01 WS-BALANCE PIC 9(10)V9(2).\n01 WS-INTEREST PIC 9(8)V9(2).\n01 WS-PRINCIPAL PIC 9(8)V9(2).\n01 WS-MONTH-NUM PIC 9(3).\n01 WS-MONTH-NUM-ED PIC 9(3).\n01 WS-MONTHLY-PAYMENT-ED PIC 9(8).99.\n01 WS-INTEREST-ED PIC 9(8).99.\n01 WS-PRINCIPAL-ED PIC 9(8).99.\n01 WS-"]
[34.286669, "i", "BALANCE-ED PIC 9(10).99.\nPROCEDURE DIVISION.\n    OPEN INPUT INPUT-FILE\n    OPEN OUTPUT OUTPUT-FILE\n    PERFORM UNTIL WS-EOF = 'Y'\n        READ INPUT-FILE\n            AT END MOVE 'Y' TO WS-EOF\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE INPUT-FILE\n    CLOSE OUTPUT-FILE\n    STOP RUN.\nPROCESS-RECORD.\n    UNSTRING INPUT-REC DELIMITED BY ALL ';'\n        INTO WS-ID\n             WS-NAME\n             WS-LOAN-AMOUNT\n             WS-PROP-VALUE\n             WS-DOWN-PAYMENT\n             WS-TERM\n             WS-RATE\n    END-UNSTRING\n    * Minimum down payment (15% of property value)\n    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n        * Rejected application\n        MOVE WS-ID TO OUTPUT-REC(1:10)\n        STRING \"DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n            DELIMITED BY SIZE\n            INTO OUTPUT-REC(11:200)\n        END-STRING\n        WRITE OUTPUT-REC\n    ELSE\n        * Approved application\n        MOVE WS-ID TO OU"]
[34.286695, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[34.286778, "i", "TPUT-REC(1:10)\n        STRING \"APPRO\"\n            DELIMITED BY SIZE\n            INTO OUTPUT-REC(11:200)\n        END-STRING\n        WRITE OUTPUT-REC\n        * Compute monthly rate and payment\n        COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n        COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\n            (1 - FUNCTION POWER(1 + WS-MONTHLY-RATE, -WS-TERM)) ROUNDED\n        MOVE WS-LOAN-AMOUNT TO WS-BALANCE\n        PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > WS-TERM\n            COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n            COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n            COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\n            * Prepare formatted fields\n            MOVE WS-MONTH-NUM TO WS-MONTH-NUM-ED\n            MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAYMENT-ED\n            MOVE WS-INTEREST TO WS-INTEREST-ED\n            MOVE WS-PRINCIPAL TO WS-PRINCIPAL-ED\n            MOVE WS-BALANCE TO WS-BALANCE-ED\n        "]
[34.286822, "o", "\u001b[?2004h> IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r"]
[34.28684, "i", "    STRING WS-MONTH-NUM-ED \" \"\n                   WS-MONTHLY-PAYMENT-ED \" \"\n                   WS-INTEREST-ED \" \"\n                   WS-PRINCIPAL-ED \" \"\n                   WS-BALANCE-ED DELIMITED BY SIZE\n                   INTO OUTPUT-REC\n            END-STRING\n            WRITE OUTPUT-REC\n        END-PERFORM\n    END-IF.\nEOF\n"]
[34.28685, "o", "\u001b[?2004h> "]
