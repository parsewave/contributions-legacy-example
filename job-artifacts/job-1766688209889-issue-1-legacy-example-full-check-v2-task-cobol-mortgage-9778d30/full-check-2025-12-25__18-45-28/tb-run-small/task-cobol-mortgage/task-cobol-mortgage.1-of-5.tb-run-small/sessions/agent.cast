[34.289478, "o", "01 WS-INTEREST-ED PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289587, "o", "01 WS-PRINCIPAL-ED PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289661, "o", "01 WS-BALANCE-ED PIC 9(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289726, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289806, "o", "    OPEN INPUT INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.289886, "o", "    OPEN OUTPUT OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
