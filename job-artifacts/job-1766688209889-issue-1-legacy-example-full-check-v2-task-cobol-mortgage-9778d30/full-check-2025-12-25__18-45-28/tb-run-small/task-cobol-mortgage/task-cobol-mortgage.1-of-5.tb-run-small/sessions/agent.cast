[34.290494, "o", "    CLOSE INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290559, "o", "    CLOSE OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290636, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.290658, "o", "> "]
[34.290782, "o", "    UNSTRING INPUT-REC DELIMITED BY ALL ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290858, "o", "        INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29088, "o", "             WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.290958, "o", "             WS-LOAN-AMOUNT\r\n\u001b[?2004l\r"]
[34.290988, "o", "\u001b[?2004h> "]
[34.291065, "o", "             WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291152, "o", "             WS-DOWN-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29122, "o", "             WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291286, "o", "             WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291346, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291457, "o", "    * Minimum down payment (15% of property value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291582, "o", "    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291677, "o", "    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291768, "o", "        * Rejected application\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.291861, "o", "        MOVE WS-ID TO OUTPUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292009, "o", "        STRING \"DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292092, "o", "            DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29218, "o", "            INTO OUTPUT-REC(11:200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292244, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292315, "o", "        WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292364, "o", "    ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292462, "o", "        * Approved application\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292555, "o", "        MOVE WS-ID TO OUTPUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29262, "o", "        STRING \"APPRO\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292702, "o", "            DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292795, "o", "            INTO OUTPUT-REC(11:200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292859, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292935, "o", "        WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.292955, "o", "> "]
[34.293055, "o", "        * Compute monthly rate and payment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293187, "o", "        COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293343, "o", "        COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293522, "o", "            (1 - FUNCTION POWER(1 + WS-MONTHLY-RATE, -WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29362, "o", "        MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293791, "o", "        PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293945, "o", "            COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29414, "o", "            COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294265, "o", "            COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294364, "o", "            * Prepare formatted fields\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294487, "o", "            MOVE WS-MONTH-NUM TO WS-MONTH-NUM-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294628, "o", "            MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAYMENT-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294756, "o", "            MOVE WS-INTEREST TO WS-INTEREST-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294869, "o", "            MOVE WS-PRINCIPAL TO WS-PRINCIPAL-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294991, "o", "            MOVE WS-BALANCE TO WS-BALANCE-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295094, "o", "            STRING WS-MONTH-NUM-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295203, "o", "                   WS-MONTHLY-PAYMENT-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295357, "o", "                   WS-INTEREST-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295436, "o", "                   WS-PRINCIPAL-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29558, "o", "                   WS-BALANCE-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295681, "o", "                   INTO OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295779, "o", "            END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295843, "o", "            WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295909, "o", "        END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.295991, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.296011, "o", "EOF\r\n\u001b[?2004l\r"]
