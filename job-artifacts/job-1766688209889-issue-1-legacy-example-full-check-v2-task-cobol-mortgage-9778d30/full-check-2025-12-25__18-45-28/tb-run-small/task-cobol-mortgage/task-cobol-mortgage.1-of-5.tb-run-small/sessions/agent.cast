[59.038557, "o", "\u001b[?2004hroot@7f1b4e49b628:/app# "]
[59.139246, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID.    PROGRAM.\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INPUT-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTPUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INPUT-FILE.\n       01  INPUT-REC            PIC X(200).\n       FD  OUTPUT-FILE.\n       01  OUTPUT-REC           PIC X(200).\n       WORKING-STORAGE SECTION.\n       01  WS-EOF               PIC X VALUE 'N'.\n       01  WS-ID                PIC X(10).\n       01  WS-NAME              PIC X(30).\n       01  WS-LOAN-AMOUNT       PIC 9(10)V9(2).\n       01  WS-PROP-VALUE        PIC 9(10)V9(2).\n       01  WS-DOWN-PAYMENT      PIC 9(10)V9(2).\n       01  WS-TERM              PIC 9(2).\n       01  WS-RATE              PIC 9(3)V9(2).\n       01  WS-MIN-DOWN          PIC 9(10)V9(2).\n  "]
[59.139298, "i", "     01  WS-MONTHLY-RATE      PIC 9(5)V9(6).\n       01  WS-MONTHLY-PAYMENT   PIC 9(8)V9(2).\n       01  WS-BALANCE           PIC 9(10)V9(2).\n       01  WS-INTEREST          PIC 9(8)V9(2).\n       01  WS-PRINCIPAL         PIC 9(8)V9(2).\n       01  WS-MONTH-NUM         PIC 9(3).\n       01  WS-MONTH-NUM-ED      PIC Z(3).\n       01  WS-MONTHLY-PAY-ED    PIC Z(8).99.\n       01  WS-INTEREST-ED       PIC Z(8).99.\n       01  WS-PRINCIPAL-ED      PIC Z(8).99.\n       01  WS-BALANCE-ED        PIC Z(10).99.\n       PROCEDURE DIVISION.\n           OPEN INPUT INPUT-FILE\n           OPEN OUTPUT OUTPUT-FILE\n           PERFORM UNTIL WS-EOF = 'Y'\n               READ INPUT-FILE\n                   AT END MOVE 'Y' TO WS-EOF\n               NOT AT END\n                   PERFORM PROCESS-RECORD\n               END-READ\n           END-PERFORM\n           CLOSE INPUT-FILE\n           CLOSE OUTPUT-FILE\n           STOP RUN.\n       PROCESS-RECORD.\n           UNSTRING INPUT-REC DELIMITED BY ALL ';'\n               INTO WS-ID\n                    WS-"]
[59.139499, "i", "NAME\n                    WS-LOAN-AMOUNT\n                    WS-PROP-VALUE\n                    WS-DOWN-PAYMENT\n                    WS-TERM\n                    WS-RATE\n           END-UNSTRING\n           COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n               MOVE WS-ID TO OUTPUT-REC(1:10)\n               STRING \"DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n                   DELIMITED BY SIZE\n                   INTO OUTPUT-REC(11:200)\n               END-STRING\n               WRITE OUTPUT-REC\n           ELSE\n               MOVE WS-ID TO OUTPUT-REC(1:10)\n               STRING \"APPRO\"\n                   DELIMITED BY SIZE\n                   INTO OUTPUT-REC(11:200)\n               END-STRING\n               WRITE OUTPUT-REC\n               COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\n               COMPUTE WS-MONTHLY-PAYMENT =\n                   WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\n                   (1 - FUNCTION POWER(1 + WS-MONTHLY-RATE, -WS-TERM)) ROUNDED\n        "]
[59.139688, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.139717, "i", "       MOVE WS-LOAN-AMOUNT TO WS-BALANCE\n               PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > WS-TERM\n                   COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n                   COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n                   COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\n                   MOVE WS-MONTH-NUM TO WS-MONTH-NUM-ED\n                   MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAY-ED\n                   MOVE WS-INTEREST TO WS-INTEREST-ED\n                   MOVE WS-PRINCIPAL TO WS-PRINCIPAL-ED\n                   MOVE WS-BALANCE TO WS-BALANCE-ED\n                   STRING WS-MONTH-NUM-ED \" \"\n                          WS-MONTHLY-PAY-ED \" \"\n                          WS-INTEREST-ED \" \"\n                          WS-PRINCIPAL-ED \" \"\n                          WS-BALANCE-ED DELIMITED BY SIZE\n                          INTO OUTPUT-REC\n                   END-STRING\n                   WRITE OUTPUT-REC\n               END-PERFORM\n   "]
[59.13973, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID.    PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.139737, "i", "        END-IF.\nEOF\n"]
[59.139863, "o", "       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.13994, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.140058, "o", "           SELECT INPUT-FILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.140167, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.140342, "o", "           SELECT OUTPUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.140398, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r"]
[59.140462, "o", "\u001b[?2004h> "]
[59.140514, "o", "       DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.140533, "o", "> "]
[59.140594, "o", "       FILE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14065, "o", "       FD  INPUT-FILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
