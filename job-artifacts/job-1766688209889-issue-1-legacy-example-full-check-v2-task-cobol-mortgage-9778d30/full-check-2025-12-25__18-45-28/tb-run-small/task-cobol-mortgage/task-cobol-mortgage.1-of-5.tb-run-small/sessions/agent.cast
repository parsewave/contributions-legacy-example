[59.141694, "o", "       01  WS-DOWN-PAYMENT      PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.141788, "o", "       01  WS-TERM              PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.141903, "o", "       01  WS-RATE              PIC 9(3)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.141922, "o", "> "]
[59.142046, "o", "       01  WS-MIN-DOWN          PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142164, "o", "       01  WS-MONTHLY-RATE      PIC 9(5)V9(6).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142263, "o", "       01  WS-MONTHLY-PAYMENT   PIC 9(8)V9(2).\r\n\u001b[?2004l\r"]
[59.142326, "o", "\u001b[?2004h> "]
[59.142395, "o", "       01  WS-BALANCE           PIC 9(10)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142519, "o", "       01  WS-INTEREST          PIC 9(8)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142631, "o", "       01  WS-PRINCIPAL         PIC 9(8)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142743, "o", "       01  WS-MONTH-NUM         PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142835, "o", "       01  WS-MONTH-NUM-ED      PIC Z(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.142945, "o", "       01  WS-MONTHLY-PAY-ED    PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143083, "o", "       01  WS-INTEREST-ED       PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143179, "o", "       01  WS-PRINCIPAL-ED      PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143292, "o", "       01  WS-BALANCE-ED        PIC Z(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143363, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143462, "o", "           OPEN INPUT INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.143481, "o", "> "]
[59.143556, "o", "           OPEN OUTPUT OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143657, "o", "           PERFORM UNTIL WS-EOF = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143744, "o", "               READ INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.143852, "o", "                   AT END MOVE 'Y' TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14393, "o", "               NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144049, "o", "                   PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144121, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144194, "o", "           END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144274, "o", "           CLOSE INPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144355, "o", "           CLOSE OUTPUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144423, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144508, "o", "       PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144627, "o", "           UNSTRING INPUT-REC DELIMITED BY ALL ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144703, "o", "               INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144783, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.144875, "o", "                    WS-LOAN-AMOUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145008, "o", "                    WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145098, "o", "                    WS-DOWN-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145177, "o", "                    WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145257, "o", "                    WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14533, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145486, "o", "           COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145597, "o", "           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145708, "o", "               MOVE WS-ID TO OUTPUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145857, "o", "               STRING \"DENY INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.145951, "o", "                   DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146084, "o", "                   INTO OUTPUT-REC(11:200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146163, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146296, "o", "               WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146367, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146487, "o", "               MOVE WS-ID TO OUTPUT-REC(1:10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146573, "o", "               STRING \"APPRO\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14667, "o", "                   DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146775, "o", "                   INTO OUTPUT-REC(11:200)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.146851, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14694, "o", "               WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147099, "o", "               COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147208, "o", "               COMPUTE WS-MONTHLY-PAYMENT =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147334, "o", "                   WS-LOAN-AMOUNT * WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147521, "o", "                   (1 - FUNCTION POWER(1 + WS-MONTHLY-RATE, -WS-TERM)) ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147638, "o", "               MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147812, "o", "               PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.147989, "o", "                   COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148172, "o", "                   COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148318, "o", "                   COMPUTE WS-BALANCE = WS-BALANCE - WS-PRINCIPAL ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148499, "o", "                   MOVE WS-MONTH-NUM TO WS-MONTH-NUM-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148573, "o", "                   MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAY-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148706, "o", "                   MOVE WS-INTEREST TO WS-INTEREST-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.148865, "o", "                   MOVE WS-PRINCIPAL TO WS-PRINCIPAL-ED\r\n\u001b[?2004l\r"]
[59.148885, "o", "\u001b[?2004h> "]
[59.149019, "o", "                   MOVE WS-BALANCE TO WS-BALANCE-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14913, "o", "                   STRING WS-MONTH-NUM-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149246, "o", "                          WS-MONTHLY-PAY-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149343, "o", "                          WS-INTEREST-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149507, "o", "                          WS-PRINCIPAL-ED \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149613, "o", "                          WS-BALANCE-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149682, "o", "                          INTO OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.14976, "o", "                   END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149863, "o", "                   WRITE OUTPUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149948, "o", "               END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.149994, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.150061, "o", "> EOF\r\n\u001b[?2004l\r"]
