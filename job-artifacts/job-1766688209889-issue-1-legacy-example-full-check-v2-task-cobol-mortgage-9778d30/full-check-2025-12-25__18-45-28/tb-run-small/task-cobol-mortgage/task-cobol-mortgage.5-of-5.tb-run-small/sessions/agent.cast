[68.876979, "o", "\u001b[?2004hroot@907522a370a1:/app/src# "]
[68.996314, "i", "cat > /app/src/program.cbl <<'EOF'\n      IDENTIFICATION DIVISION.\n      PROGRAM-ID. MORTGAGE-PROCESSOR.\n\n      ENVIRONMENT DIVISION.\n      INPUT-OUTPUT SECTION.\n      FILE-CONTROL.\n          SELECT INPUT-FILE ASSIGN TO '/app/src/INPUT.DAT'\n              ORGANIZATION IS LINE SEQUENTIAL.\n          SELECT OUTPUT-FILE ASSIGN TO '/app/data/OUTPUT.DAT'\n              ORGANIZATION IS LINE SEQUENTIAL.\n\n      DATA DIVISION.\n      FILE SECTION.\n      FD  INPUT-FILE.\n      01  INPUT-REC.\n          05  IN-ID               PIC X(10).\n          05  IN-NAME             PIC X(30).\n          05  IN-LOAN-AMOUNT      PIC 9(10).\n          05  IN-PROP-VALUE       PIC 9(10).\n          05  IN-DOWN-PAYMENT     PIC 9(10).\n          05  IN-TERM             PIC 9(2).\n          05  IN-RATE             PIC 9(3)V9(2).\n      FD  OUTPUT-FILE.\n      01  OUTPUT-REC            PIC X(200).\n\n      WORKING-STORAGE SECTION.\n      01  EOF-FLAG                 PIC X VALUE 'N'.\n      01  WS-MIN-DOWN              PIC 9(10)V9(2).\n      01  WS-MONTHLY-RA"]
[68.996562, "i", "TE         PIC 9(5)V9(6).\n      01  WS-MONTHLY-PAYMENT      PIC 9(10)V9(2).\n      01  WS-DENOMINATOR          PIC 9(10)V9(6).\n      01  WS-BALANCE              PIC 9(10)V9(2).\n      01  WS-INTEREST             PIC 9(10)V9(2).\n      01  WS-PRINCIPAL            PIC 9(10)V9(2).\n      01  WS-MONTH-NUM            PIC 9(3).\n      01  WS-SPACE                PIC X VALUE SPACE.\n      01  WS-STATUS               PIC X(5).\n      01  WS-REASON               PIC X(50).\n\n      PROCEDURE DIVISION.\n          OPEN INPUT INPUT-FILE\n          OPEN OUTPUT OUTPUT-FILE\n          PERFORM UNTIL EOF-FLAG = 'Y'\n              READ INPUT-FILE AT END MOVE 'Y' TO EOF-FLAG\n                  NOT AT END\n                      PERFORM PROCESS-RECORD\n              END-READ\n          END-PERFORM\n          CLOSE INPUT-FILE\n          CLOSE OUTPUT-FILE\n          STOP RUN.\n\n      PROCESS-RECORD.\n          UNSTRING INPUT-REC DELIMITED BY ';'\n              INTO IN-ID, IN-NAME, IN-LOAN-AMOUNT, IN-PROP-VALUE,\n                   IN-DOWN-PAYMENT, IN-TERM"]
[68.996687, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.996782, "i", ", IN-RATE.\n          COMPUTE WS-MIN-DOWN = IN-PROP-VALUE * 0.15 ROUNDED.\n          IF IN-DOWN-PAYMENT < WS-MIN-DOWN\n              MOVE 'DENY' TO WS-STATUS\n              MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO WS-REASON\n              STRING IN-ID WS-SPACE WS-STATUS WS-SPACE WS-REASON\n                  INTO OUTPUT-REC\n              END-STRING\n              WRITE OUTPUT-REC\n          ELSE\n              MOVE 'APPRO' TO WS-STATUS\n              STRING IN-ID WS-SPACE WS-STATUS INTO OUTPUT-REC END-STRING\n              WRITE OUTPUT-REC\n              MOVE IN-LOAN-AMOUNT TO WS-BALANCE\n              COMPUTE WS-MONTHLY-RATE = IN-RATE / 1200 ROUNDED\n              COMPUTE WS-DENOMINATOR = 1 - (1 + WS-MONTHLY-RATE) ** (-IN-TERM)\n              COMPUTE WS-MONTHLY-PAYMENT = IN-LOAN-AMOUNT * WS-MONTHLY-RATE /\n                      WS-DENOMINATOR ROUNDED\n              PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > IN-TERM\n                  COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n           "]
[68.996869, "o", "      IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.996944, "i", "       COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n                  SUBTRACT WS-PRINCIPAL FROM WS-BALANCE GIVING WS-BALANCE ROUNDED\n                  STRING WS-MONTH-NUM WS-SPACE WS-MONTHLY-PAYMENT WS-SPACE\n                         WS-INTEREST WS-SPACE WS-PRINCIPAL WS-SPACE WS-BALANCE\n                      INTO OUTPUT-REC\n                  END-STRING\n                  WRITE OUTPUT-REC\n              END-PERFORM\n          END-IF.\nEOF\n"]
[68.997049, "o", "      PROGRAM-ID. MORTGAGE-PROCESSOR.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r"]
