[17.548112, "o", "\u001b[?2004hroot@907522a370a1:/app# "]
[17.657781, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. MORTGAGE-PROCESSOR.\nAUTHOR. CHATGPT.\n\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INPUT-FILE ASSIGN TO '/app/src/INPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTPUT-FILE ASSIGN TO '/app/data/OUTPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n\nDATA DIVISION.\nFILE SECTION.\nFD  INPUT-FILE.\n01  INPUT-REC.\n    05  IN-ID               PIC X(10).\n    05  IN-NAME             PIC X(30).\n    05  IN-LOAN-AMOUNT      PIC 9(10).\n    05  IN-PROP-VALUE       PIC 9(10).\n    05  IN-DOWN-PAYMENT     PIC 9(10).\n    05  IN-TERM             PIC 9(2).\n    05  IN-RATE             PIC 9(3)V9(2).\nFD  OUTPUT-FILE.\n01  OUTPUT-REC            PIC X(200).\n\nWORKING-STORAGE SECTION.\n01  WS-MIN-DOWN            PIC 9(10)V9(2).\n01  WS-MONTHLY-RATE       PIC 9(5)V9(6).\n01  WS-MONTHLY-PAYMENT    PIC 9(10)V9(2).\n01  WS-BALANCE            PIC 9(10)V9(2).\n01  WS-INTEREST           PIC 9(10)V9(2).\n01  WS-PRINCIPAL          PIC 9(10)V9"]
[17.65796, "i", "(2).\n01  WS-MONTH-NUM          PIC 9(3).\n01  WS-REASON             PIC X(50).\n01  WS-STATUS             PIC X(5).\n01  WS-SPACE              PIC X VALUE SPACE.\n\nPROCEDURE DIVISION.\n    OPEN INPUT INPUT-FILE\n    OPEN OUTPUT OUTPUT-FILE\n    PERFORM UNTIL EOF\n        READ INPUT-FILE AT END SET EOF TO TRUE\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE INPUT-FILE\n    CLOSE OUTPUT-FILE\n    STOP RUN.\n\nPROCESS-RECORD.\n    UNSTRING INPUT-REC DELIMITED BY ';'\n        INTO IN-ID, IN-NAME, IN-LOAN-AMOUNT, IN-PROP-VALUE,\n             IN-DOWN-PAYMENT, IN-TERM, IN-RATE.\n    COMPUTE WS-MIN-DOWN = IN-PROP-VALUE * 0.15 ROUNDED.\n    IF IN-DOWN-PAYMENT < WS-MIN-DOWN\n        MOVE 'DENY' TO WS-STATUS\n        MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO WS-REASON\n        STRING IN-ID WS-STATUS WS-SPACE WS-REASON\n            INTO OUTPUT-REC\n        END-STRING\n        WRITE OUTPUT-REC\n    ELSE\n        MOVE 'APPRO' TO WS-STATUS\n        STRING IN-ID WS-STATUS INTO OUTPUT-REC END-STRING"]
[17.658037, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[17.658188, "i", "\n        WRITE OUTPUT-REC\n        MOVE IN-LOAN-AMOUNT TO WS-BALANCE\n        COMPUTE WS-MONTHLY-RATE = IN-RATE / 1200 ROUNDED\n        COMPUTE WS-MONTHLY-PAYMENT = IN-LOAN-AMOUNT * WS-MONTHLY-RATE /\n            (1 - (1 + WS-MONTHLY-RATE) ** (- IN-TERM)) ROUNDED\n        PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1 UNTIL WS-MONTH-NUM > IN-TERM\n            COMPUTE WS-INTEREST = WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n            COMPUTE WS-PRINCIPAL = WS-MONTHLY-PAYMENT - WS-INTEREST ROUNDED\n            SUBTRACT WS-PRINCIPAL FROM WS-BALANCE GIVING WS-BALANCE ROUNDED\n            MOVE WS-MONTH-NUM TO WS-MONTH-NUM\n            STRING\n                FUNCTION REVERSE(FUNCTION TRIM(WS-MONTH-NUM))\n                \" \"\n                WS-MONTHLY-PAYMENT \" \"\n                WS-INTEREST \" \"\n                WS-PRINCIPAL \" \"\n                WS-BALANCE\n                INTO OUTPUT-REC\n            END-STRING\n            WRITE OUTPUT-REC\n        END-PERFORM\n    END-IF.\nEOF\n"]
