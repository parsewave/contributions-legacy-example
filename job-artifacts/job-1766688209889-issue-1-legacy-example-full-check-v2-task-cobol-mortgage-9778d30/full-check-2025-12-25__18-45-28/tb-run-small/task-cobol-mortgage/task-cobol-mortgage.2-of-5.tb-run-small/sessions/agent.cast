[40.435363, "o", "\u001b[?2004h> "]
[40.435537, "o", "01 LOAN-AMOUNT         PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.435559, "o", "01 PROP-VALUE          PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.435699, "o", "01 DOWN-PAYMENT        PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
