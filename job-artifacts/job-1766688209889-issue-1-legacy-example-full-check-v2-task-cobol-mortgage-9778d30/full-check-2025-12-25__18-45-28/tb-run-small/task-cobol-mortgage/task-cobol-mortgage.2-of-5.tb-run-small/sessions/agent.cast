[2.920065, "m", "Episode 0: 2 commands"]
[2.920065, "o", "\u001b[?2004hroot@2236b2ba61bb:/app# "]
[40.345309, "i", "mkdir -p /app/src /app/data\n"]
[40.345529, "o", "mkdir -p /app/src /app/data\r\n\u001b[?2004l\r"]
[40.347092, "o", "\u001b[?2004hroot@2236b2ba61bb:/app# "]
[40.433124, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. MORTGAGE-PROCESS.\nAUTHOR. CHATGPT.\n\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n\nDATA DIVISION.\nFILE SECTION.\nFD INFILE.\n01 IN-REC PIC X(200).\nFD OUTFILE.\n01 OUT-REC PIC X(200).\n\nWORKING-STORAGE SECTION.\n01 WS-ID               PIC X(10).\n01 WS-NAME             PIC X(30).\n01 WS-LOAN-AMT-STR     PIC X(10).\n01 WS-PROP-VALUE-STR   PIC X(10).\n01 WS-DOWN-PAY-STR     PIC X(10).\n01 WS-TERM-STR         PIC X(2).\n01 WS-RATE-STR         PIC X(6).\n\n01 LOAN-AMOUNT         PIC 9(10)V99 COMP-3.\n01 PROP-VALUE          PIC 9(10)V99 COMP-3.\n01 DOWN-PAYMENT        PIC 9(10)V99 COMP-3.\n01 TERM-MONTHS         PIC 9(2) COMP-3.\n01 ANNUAL-RATE         PIC 9(3)V99 COMP-3.\n\n01 MIN-DOWN            PIC 9(10)V99 COMP-3.\n01 MONTHLY-RATE        PIC 9(5)V9999 COMP-3.\n01 MONTHL"]
[40.433389, "i", "Y-PAYMENT    PIC 9(10)V99 COMP-3.\n01 INTEREST-PART      PIC 9(10)V99 COMP-3.\n01 PRINCIPAL-PART     PIC 9(10)V99 COMP-3.\n01 REMAINING-BAL       PIC 9(10)V99 COMP-3.\n01 MON-COUNTER         PIC 9(3) COMP-3.\n\n01 REASON-REJ          PIC X(50) VALUE\n   \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\".\n\nPROCEDURE DIVISION.\n    OPEN INPUT INFILE\n    OPEN OUTPUT OUTFILE.\n    PERFORM UNTIL EOF-FLAG = 1\n        READ INFILE\n            AT END SET EOF-FLAG TO 1\n            NOT AT END\n                PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM.\n    CLOSE INFILE\n    CLOSE OUTFILE.\n    STOP RUN.\n\nPROCESS-RECORD.\n    UNSTRING IN-REC DELIMITED BY ';'\n        INTO WS-ID, WS-NAME, WS-LOAN-AMT-STR,\n             WS-PROP-VALUE-STR, WS-DOWN-PAY-STR,\n             WS-TERM-STR, WS-RATE-STR.\n    MOVE FUNCTION NUMVAL(WS-LOAN-AMT-STR) TO LOAN-AMOUNT.\n    MOVE FUNCTION NUMVAL(WS-PROP-VALUE-STR) TO PROP-VALUE.\n    MOVE FUNCTION NUMVAL(WS-DOWN-PAY-STR) TO DOWN-PAYMENT.\n    MOVE FUNCTION NUMVAL(WS-TERM-STR) TO TERM-MONTHS.\n    MOVE FUNCTION "]
[40.433553, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r"]
[40.433608, "i", "NUMVAL(WS-RATE-STR) TO ANNUAL-RATE.\n\n    COMPUTE MIN-DOWN = PROP-VALUE * 0.15 ROUNDED.\n    IF DOWN-PAYMENT < MIN-DOWN THEN\n        STRING WS-ID DELIMITED BY SIZE\n               \" \"\n               REASON-REJ DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    ELSE\n        STRING WS-ID DELIMITED BY SIZE\n               \" APPRO\"\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n        PERFORM CALCULATE-SCHEDULE\n    END-IF.\n\nCALCULATE-SCHEDULE.\n    COMPUTE MONTHLY-RATE = ANNUAL-RATE / 1200 ROUNDED.\n    COMPUTE MONTHLY-PAYMENT = LOAN-AMOUNT * MONTHLY-RATE /\n        (1 - FUNCTION POWER(1 + MONTHLY-RATE, -TERM-MONTHS))\n        ROUNDED.\n    MOVE LOAN-AMOUNT TO REMAINING-BAL.\n    PERFORM VARYING MON-COUNTER FROM 1 BY 1 UNTIL MON-COUNTER > TERM-MONTHS\n        COMPUTE INTEREST-PART = REMAINING-BAL * MONTHLY-RATE ROUNDED.\n        COMPUTE PRINCIPAL-PART = MONTHLY-PAYMENT - INTEREST-PART ROUNDED.\n        SUBTRACT PRINCIPAL-PART FROM REMAINING-BAL.\n        STRING MON"]
[40.433714, "o", "\u001b[?2004h> PROGRAM-ID. MORTGAGE-PROCESS.\r\n\u001b[?2004l\r\u001b[?2004h> AUTHOR. CHATGPT.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.433735, "i", "-COUNTER DELIMITED BY SIZE\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(MONTHLY-PAYMENT, \"ZZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(INTEREST-PART, \"ZZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(PRINCIPAL-PART, \"ZZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(REMAINING-BAL, \"ZZZZZZZZZZ9.99\"))\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    END-PERFORM.\n\nEOF\n"]
[40.43381, "o", "ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
