[40.435828, "o", "01 TERM-MONTHS         PIC 9(2) COMP-3.\r\n\u001b[?2004l\r"]
[40.435896, "o", "\u001b[?2004h> "]
[40.435995, "o", "01 ANNUAL-RATE         PIC 9(3)V99 COMP-3.\r\n\u001b[?2004l\r"]
[40.436016, "o", "\u001b[?2004h> "]
[40.436073, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.436184, "o", "01 MIN-DOWN            PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.436318, "o", "01 MONTHLY-RATE        PIC 9(5)V9999 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.436473, "o", "01 MONTHLY-PAYMENT    PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[40.436531, "o", "\u001b[?2004h> "]
[40.436656, "o", "01 INTEREST-PART      PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[40.436674, "o", "\u001b[?2004h> "]
[40.436836, "o", "01 PRINCIPAL-PART     PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[40.436903, "o", "\u001b[?2004h> "]
[40.437017, "o", "01 REMAINING-BAL       PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[40.437036, "o", "\u001b[?2004h> "]
[40.437139, "o", "01 MON-COUNTER         PIC 9(3) COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.437158, "o", "\r\n\u001b[?2004l\r"]
[40.437198, "o", "\u001b[?2004h> "]
[40.437272, "o", "01 REASON-REJ          PIC X(50) VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.43739, "o", "   \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.437406, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.437453, "o", "> "]
[40.437472, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.43748, "o", "> "]
[40.437556, "o", "    OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.43763, "o", "    OPEN OUTPUT OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.437715, "o", "    PERFORM UNTIL EOF-FLAG = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.437798, "o", "        READ INFILE\r\n\u001b[?2004l\r"]
[40.437889, "o", "\u001b[?2004h> "]
[40.437965, "o", "            AT END SET EOF-FLAG TO 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438137, "o", "            NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438276, "o", "                PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438337, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438428, "o", "    END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438504, "o", "    CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438556, "o", "    CLOSE OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438603, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438665, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438764, "o", "    UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.438887, "o", "        INTO WS-ID, WS-NAME, WS-LOAN-AMT-STR,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439009, "o", "             WS-PROP-VALUE-STR, WS-DOWN-PAY-STR,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439109, "o", "             WS-TERM-STR, WS-RATE-STR.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439262, "o", "    MOVE FUNCTION NUMVAL(WS-LOAN-AMT-STR) TO LOAN-AMOUNT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439404, "o", "    MOVE FUNCTION NUMVAL(WS-PROP-VALUE-STR) TO PROP-VALUE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439567, "o", "    MOVE FUNCTION NUMVAL(WS-DOWN-PAY-STR) TO DOWN-PAYMENT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439667, "o", "    MOVE FUNCTION NUMVAL(WS-TERM-STR) TO TERM-MONTHS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439779, "o", "    MOVE FUNCTION NUMVAL(WS-RATE-STR) TO ANNUAL-RATE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.439829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.439895, "o", "> "]
[40.439959, "o", "    COMPUTE MIN-DOWN = PROP-VALUE * 0.15 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.440059, "o", "    IF DOWN-PAYMENT < MIN-DOWN THEN\r\n\u001b[?2004l\r"]
[40.440108, "o", "\u001b[?2004h> "]
[40.440171, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.44026, "o", "               \" \"\r\n\u001b[?2004l\r"]
[40.440279, "o", "\u001b[?2004h> "]
[40.440412, "o", "               REASON-REJ DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[40.440431, "o", "\u001b[?2004h> "]
[40.440528, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.440591, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.440662, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.440681, "o", "    ELSE\r\n\u001b[?2004l\r"]
[40.440738, "o", "\u001b[?2004h> "]
[40.440798, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.440871, "o", "               \" APPRO\"\r\n\u001b[?2004l\r"]
[40.440892, "o", "\u001b[?2004h> "]
[40.440964, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441033, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441096, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441194, "o", "        PERFORM CALCULATE-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441257, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441325, "o", "CALCULATE-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441463, "o", "    COMPUTE MONTHLY-RATE = ANNUAL-RATE / 1200 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441596, "o", "    COMPUTE MONTHLY-PAYMENT = LOAN-AMOUNT * MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441734, "o", "        (1 - FUNCTION POWER(1 + MONTHLY-RATE, -TERM-MONTHS))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441789, "o", "        ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.441905, "o", "    MOVE LOAN-AMOUNT TO REMAINING-BAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.442067, "o", "    PERFORM VARYING MON-COUNTER FROM 1 BY 1 UNTIL MON-COUNTER > TERM-MONTHS\r\n\u001b[?2004l\r"]
[40.442086, "o", "\u001b[?2004h> "]
[40.442226, "o", "        COMPUTE INTEREST-PART = REMAINING-BAL * MONTHLY-RATE ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.4424, "o", "        COMPUTE PRINCIPAL-PART = MONTHLY-PAYMENT - INTEREST-PART ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h"]
[40.442422, "o", "> "]
[40.442552, "o", "        SUBTRACT PRINCIPAL-PART FROM REMAINING-BAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.442655, "o", "        STRING MON-COUNTER DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.442697, "o", "               \" \"\r\n\u001b[?2004l\r"]
[40.442717, "o", "\u001b[?2004h> "]
[40.442892, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(MONTHLY-PAYMENT, \"ZZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.442955, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443121, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(INTEREST-PART, \"ZZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443186, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443348, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(PRINCIPAL-PART, \"ZZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443439, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443628, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(REMAINING-BAL, \"ZZZZZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443695, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.44376, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443831, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443898, "o", "    END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.443916, "o", "\r\n\u001b[?2004l\r"]
[40.443994, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[40.445358, "m", "Episode 1: 1 commands"]
[40.445358, "o", "\u001b[?2004hroot@2236b2ba61bb:/app# "]
[70.442086, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. MORTGAGE-PROCESS.\nAUTHOR. CHATGPT.\n\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n        ORGANIZATION IS LINE SEQUENTIAL.\n\nDATA DIVISION.\nFILE SECTION.\nFD INFILE.\n01 IN-REC PIC X(200).\nFD OUTFILE.\n01 OUT-REC PIC X(200).\n\nWORKING-STORAGE SECTION.\n01 EOF-FLAG        PIC 9 VALUE 0.\n01 WS-ID           PIC X(10).\n01 WS-NAME         PIC X(30).\n01 WS-LOAN-STR     PIC X(10).\n01 WS-PROP-STR     PIC X(10).\n01 WS-DOWN-STR     PIC X(10).\n01 WS-TERM-STR     PIC X(2).\n01 WS-RATE-STR     PIC X(6).\n\n01 LOAN-AMOUNT     PIC 9(10)V99 COMP-3.\n01 PROP-VALUE      PIC 9(10)V99 COMP-3.\n01 DOWN-PAYMENT    PIC 9(10)V99 COMP-3.\n01 TERM-MONTHS     PIC 9(2) COMP-3.\n01 ANNUAL-RATE     PIC 9(3)V99 COMP-3.\n\n01 MIN-DOWN        PIC 9(10)V99 COMP-3.\n01 MONTHLY-RATE    PIC 9(5)V9999 COMP-3.\n01 MONTHLY-PAY     PIC 9(10)V99"]
[70.442139, "i", " COMP-3.\n01 INTEREST-PART  PIC 9(10)V99 COMP-3.\n01 PRINCIPAL-PART PIC 9(10)V99 COMP-3.\n01 REM-BALANCE     PIC 9(10)V99 COMP-3.\n01 MON-COUNTER     PIC 9(3) COMP-3.\n\n01 REASON-REJ      PIC X(50) VALUE\n   \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\".\n\nPROCEDURE DIVISION.\n    OPEN INPUT INFILE.\n    OPEN OUTPUT OUTFILE.\n    PERFORM UNTIL EOF-FLAG = 1\n        READ INFILE\n            AT END SET EOF-FLAG TO 1\n            NOT AT END\n                PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM.\n    CLOSE INFILE.\n    CLOSE OUTFILE.\n    STOP RUN.\n\nPROCESS-RECORD.\n    UNSTRING IN-REC DELIMITED BY ';'\n        INTO WS-ID, WS-NAME, WS-LOAN-STR,\n             WS-PROP-STR, WS-DOWN-STR,\n             WS-TERM-STR, WS-RATE-STR.\n    MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO LOAN-AMOUNT.\n    MOVE FUNCTION NUMVAL(WS-PROP-STR) TO PROP-VALUE.\n    MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO DOWN-PAYMENT.\n    MOVE FUNCTION NUMVAL(WS-TERM-STR) TO TERM-MONTHS.\n    MOVE FUNCTION NUMVAL(WS-RATE-STR) TO ANNUAL-RATE.\n\n    COMPUTE MIN-DOWN = PROP-VALUE "]
[70.442304, "i", "* 0.15 ROUNDED.\n    IF DOWN-PAYMENT < MIN-DOWN THEN\n        STRING WS-ID DELIMITED BY SIZE\n               \" \"\n               REASON-REJ DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC.\n    ELSE\n        STRING WS-ID DELIMITED BY SIZE\n               \" APPRO\"\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC.\n        PERFORM CALC-SCHEDULE.\n    END-IF.\n\nCALC-SCHEDULE.\n    COMPUTE MONTHLY-RATE = ANNUAL-RATE / 1200 ROUNDED.\n    COMPUTE MONTHLY-PAY = LOAN-AMOUNT * MONTHLY-RATE /\n        (1 - FUNCTION POWER(1 + MONTHLY-RATE, -TERM-MONTHS))\n        ROUNDED.\n    MOVE LOAN-AMOUNT TO REM-BALANCE.\n    PERFORM VARYING MON-COUNTER FROM 1 BY 1\n        UNTIL MON-COUNTER > TERM-MONTHS\n        COMPUTE INTEREST-PART = REM-BALANCE * MONTHLY-RATE ROUNDED.\n        COMPUTE PRINCIPAL-PART = MONTHLY-PAY - INTEREST-PART ROUNDED.\n        SUBTRACT PRINCIPAL-PART FROM REM-BALANCE.\n        STRING MON-COUNTER DELIMITED BY SIZE\n               \" \"\n               FUNCTION TRIM(FUNCTION "]
[70.442327, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[70.442414, "i", "DISPLAY(MONTHLY-PAY, \"ZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(INTEREST-PART, \"ZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(PRINCIPAL-PART, \"ZZZZZZ9.99\"))\n               \" \"\n               FUNCTION TRIM(FUNCTION DISPLAY(REM-BALANCE, \"ZZZZZZZZ9.99\"))\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC.\n    END-PERFORM.\nEOF\n"]
[70.442435, "o", "\u001b[?2004h> "]
[70.44255, "o", "IDENTIFICATION DIVISION.\r\n\u001b[?2004l\rDISPLAY(MONTHLY-PAY, \"ZZZZZZ9.99\"))\r\n               \" \"\r\n               FUNCTION TRIM(FUNCTION DISPLAY(INTEREST-PART, \"ZZZZZZ9.99\"))\r\n               \" \"\r\n               FUNCTION TRIM(FUNCTION DISPLAY(PRINCIPAL-PART, \"ZZZZZZ9.99\"))\r\n               \" \"\r\n               FUNCTION TRIM(FUNCTION DISPLAY(REM-BALANCE, \"ZZZZZZZZ9.99\"))\r\n      "]
[70.442693, "o", "         INTO OUT-REC\r\n        END-STRING\r\n        WRITE OUT-REC.\r\n    END-PERFORM.\r\nEOF\r\n"]
[70.442775, "o", "\u001b[?2004h> "]
[70.442855, "o", "PROGRAM-ID. MORTGAGE-PROCESS.\r\n\u001b[?2004l\r\u001b[?2004h> AUTHOR. CHATGPT.\r\n\u001b[?2004l\r"]
[70.442919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.442969, "o", "\u001b[?2004h> "]
[70.44301, "o", "ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443182, "o", "INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443316, "o", "FILE-CONTROL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443441, "o", "    SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443608, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443737, "o", "    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r"]
[70.443822, "o", "\u001b[?2004h> "]
[70.443932, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.443987, "o", "\r\n\u001b[?2004l\r"]
[70.444042, "o", "\u001b[?2004h> "]
[70.444143, "o", "DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.444191, "o", "> FILE SECTION.\r\n\u001b[?2004l\r"]
[70.444275, "o", "\u001b[?2004h> "]
[70.444356, "o", "FD INFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.444461, "o", "01 IN-REC PIC X(200).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.444514, "o", "FD OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.444555, "o", "> "]
[70.444607, "o", "01 OUT-REC PIC X(200).\r\n\u001b[?2004l\r"]
[70.44469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.444735, "o", "> "]
[70.444794, "o", "WORKING-STORAGE SECTION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.444862, "o", "> "]
[70.444946, "o", "01 EOF-FLAG        PIC 9 VALUE 0.\r\n\u001b[?2004l\r"]
[70.444976, "o", "\u001b[?2004h> "]
[70.445109, "o", "01 WS-ID           PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.445204, "o", "01 WS-NAME         PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.445278, "o", "> "]
[70.44536, "o", "01 WS-LOAN-STR     PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.445474, "o", "01 WS-PROP-STR     PIC X(10).\r\n\u001b[?2004l\r"]
[70.445546, "o", "\u001b[?2004h> "]
[70.445635, "o", "01 WS-DOWN-STR     PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.445775, "o", "01 WS-TERM-STR     PIC X(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.445868, "o", "01 WS-RATE-STR     PIC X(6).\r\n\u001b[?2004l\r"]
[70.445897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.445912, "o", "\u001b[?2004h"]
[70.445995, "o", "> "]
[70.446098, "o", "01 LOAN-AMOUNT     PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[70.44617, "o", "\u001b[?2004h> "]
[70.446243, "o", "01 PROP-VALUE      PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[70.446265, "o", "\u001b[?2004h> "]
[70.446378, "o", "01 DOWN-PAYMENT    PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.446482, "o", "01 TERM-MONTHS     PIC 9(2) COMP-3.\r\n\u001b[?2004l\r"]
[70.446502, "o", "\u001b[?2004h> "]
[70.446587, "o", "01 ANNUAL-RATE     PIC 9(3)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.446608, "o", "\r\n\u001b[?2004l\r"]
[70.44669, "o", "\u001b[?2004h"]
[70.446712, "o", "> 01 MIN-DOWN        PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[70.446758, "o", "\u001b[?2004h> "]
[70.446846, "o", "01 MONTHLY-RATE    PIC 9(5)V9999 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.446866, "o", "> "]
[70.446954, "o", "01 MONTHLY-PAY     PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.447063, "o", "01 INTEREST-PART  PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r"]
[70.447117, "o", "\u001b[?2004h> "]
[70.447195, "o", "01 PRINCIPAL-PART PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.447298, "o", "01 REM-BALANCE     PIC 9(10)V99 COMP-3.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.447412, "o", "01 MON-COUNTER     PIC 9(3) COMP-3.\r\n\u001b[?2004l\r"]
[70.447468, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.447517, "o", "\u001b[?2004h> "]
[70.447587, "o", "01 REASON-REJ      PIC X(50) VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.447654, "o", "   \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\".\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.447673, "o", "\u001b[?2004h"]
[70.447738, "o", "> "]
[70.447759, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.447819, "o", "    OPEN INPUT INFILE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.447848, "o", "> "]
[70.447932, "o", "    OPEN OUTPUT OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.448024, "o", "    PERFORM UNTIL EOF-FLAG = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.448089, "o", "> "]
[70.448107, "o", "        READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.448166, "o", "> "]
[70.448293, "o", "            AT END SET EOF-FLAG TO 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.448357, "o", "            NOT AT END\r\n\u001b[?2004l\r"]
[70.448434, "o", "\u001b[?2004h> "]
[70.448534, "o", "                PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r"]
[70.448593, "o", "\u001b[?2004h> "]
[70.44864, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.448664, "o", "    END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.448683, "o", "> "]
[70.448774, "o", "    CLOSE INFILE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.448847, "o", "> "]
[70.44891, "o", "    CLOSE OUTFILE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.448968, "o", "    STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.449033, "o", "\u001b[?2004h> "]
[70.449091, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.449155, "o", "    UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.44921, "o", "> "]
[70.44929, "o", "        INTO WS-ID, WS-NAME, WS-LOAN-STR,\r\n\u001b[?2004l\r"]
[70.449347, "o", "\u001b[?2004h> "]
[70.449452, "o", "             WS-PROP-STR, WS-DOWN-STR,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.449565, "o", "             WS-TERM-STR, WS-RATE-STR.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.449719, "o", "    MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO LOAN-AMOUNT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.449866, "o", "    MOVE FUNCTION NUMVAL(WS-PROP-STR) TO PROP-VALUE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.450028, "o", "    MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO DOWN-PAYMENT.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.450089, "o", "> "]
[70.450175, "o", "    MOVE FUNCTION NUMVAL(WS-TERM-STR) TO TERM-MONTHS.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.450233, "o", "> "]
[70.450339, "o", "    MOVE FUNCTION NUMVAL(WS-RATE-STR) TO ANNUAL-RATE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.450361, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.45045, "o", "> "]
[70.45063, "o", "    COMPUTE MIN-DOWN = PROP-VALUE * 0.15 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h>     IF DOWN-PAYMENT < MIN-DOWN THEN\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.450708, "o", "> "]
[70.450769, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.450819, "o", "> "]
[70.450879, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.451037, "o", "               REASON-REJ DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.451139, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.451167, "o", "> "]
[70.451226, "o", "        END-STRING\r\n\u001b[?2004l\r"]
[70.451254, "o", "\u001b[?2004h> "]
[70.451338, "o", "        WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.451424, "o", "    ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.45154, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.451561, "o", "> "]
[70.451661, "o", "               \" APPRO\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.45174, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r"]
[70.451756, "o", "\u001b[?2004h> "]
[70.45188, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452051, "o", "        WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452148, "o", "        PERFORM CALC-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452203, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452227, "o", "CALC-SCHEDULE.\r\n\u001b[?2004l\r"]
[70.452299, "o", "\u001b[?2004h> "]
[70.452466, "o", "    COMPUTE MONTHLY-RATE = ANNUAL-RATE / 1200 ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452588, "o", "    COMPUTE MONTHLY-PAY = LOAN-AMOUNT * MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452716, "o", "        (1 - FUNCTION POWER(1 + MONTHLY-RATE, -TERM-MONTHS))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.452737, "o", "> "]
[70.452785, "o", "        ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.452921, "o", "    MOVE LOAN-AMOUNT TO REM-BALANCE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.453043, "o", "    PERFORM VARYING MON-COUNTER FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.453066, "o", "> "]
[70.453206, "o", "        UNTIL MON-COUNTER > TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.453353, "o", "        COMPUTE INTEREST-PART = REM-BALANCE * MONTHLY-RATE ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.453543, "o", "        COMPUTE PRINCIPAL-PART = MONTHLY-PAY - INTEREST-PART ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.453666, "o", "        SUBTRACT PRINCIPAL-PART FROM REM-BALANCE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.453796, "o", "        STRING MON-COUNTER DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[70.453817, "o", "\u001b[?2004h> "]
[70.45391, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.454089, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(MONTHLY-PAY, \"ZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.45411, "o", "> "]
[70.454187, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.454288, "o", "> "]
[70.454396, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(INTEREST-PART, \"ZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.454411, "o", "> "]
[70.454498, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.454516, "o", "> "]
[70.454693, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(PRINCIPAL-PART, \"ZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.454717, "o", "> "]
[70.454849, "o", "               \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.454991, "o", "               FUNCTION TRIM(FUNCTION DISPLAY(REM-BALANCE, \"ZZZZZZZZ9.99\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.455091, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.455178, "o", "> "]
[70.455239, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.455311, "o", "        WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.455405, "o", "    END-PERFORM.\r\n\u001b[?2004l\r"]
[70.455466, "o", "\u001b[?2004h> "]
[70.45552, "o", "EOF\r\n\u001b[?2004l\r"]
[70.456973, "o", "\u001b[?2004hroot@2236b2ba61bb:/app# "]
