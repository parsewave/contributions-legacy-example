[40.434013, "o", "    SELECT INFILE ASSIGN TO \"/app/src/INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.434036, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.434145, "o", "    SELECT OUTFILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.434235, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
