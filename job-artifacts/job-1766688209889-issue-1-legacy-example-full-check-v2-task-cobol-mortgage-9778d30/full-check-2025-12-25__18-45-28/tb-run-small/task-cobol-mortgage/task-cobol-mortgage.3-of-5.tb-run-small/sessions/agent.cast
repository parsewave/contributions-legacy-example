[6.646517, "o", "ls -R /app\r\n\u001b[?2004l\r"]
[6.659754, "o", "/app:\r\ndata  src\r\n\r\n/app/data:\r\n"]
[6.659863, "o", "OUTPUT.DAT\r\n\r\n/app/src:\r\nINPUT.DAT\r\n"]
[6.660191, "m", "Episode 1: 4 commands"]
[6.660191, "o", "\u001b[?2004hroot@2937f358b7ab:/app# "]
[61.063073, "i", "cat > /app/src/program.cbl <<'EOF'\nIDENTIFICATION DIVISION.\nPROGRAM-ID. PROGRAM.\nENVIRONMENT DIVISION.\nINPUT-OUTPUT SECTION.\nFILE-CONTROL.\n    SELECT IN-FILE ASSIGN TO '/app/src/INPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\n    SELECT OUT-FILE ASSIGN TO '/app/data/OUTPUT.DAT'\n        ORGANIZATION IS LINE SEQUENTIAL.\nDATA DIVISION.\nFILE SECTION.\nFD  IN-FILE.\n01  IN-REC PIC X(200).\nFD  OUT-FILE.\n01  OUT-REC PIC X(200).\nWORKING-STORAGE SECTION.\n01  EOF-FLAG        PIC X VALUE 'N'.\n01  WS-ID           PIC X(10).\n01  WS-NAME         PIC X(30).\n01  WS-LOAN-AMOUNT  PIC 9(10).\n01  WS-PROP-VALUE   PIC 9(10).\n01  WS-DOWN-PAYMENT PIC 9(10).\n01  WS-TERM         PIC 9(2).\n01  WS-RATE         PIC 9(3)V9(2).\n01  WS-MIN-DOWN     PIC 9(10) ROUNDED.\n01  WS-MONTHLY-RATE PIC 9(5)V9(6).\n01  WS-MONTHLY-PAYMENT   PIC 9(8)V9(2) ROUNDED.\n01  WS-BALANCE           PIC 9(10)V9(2) ROUNDED.\n01  WS-INTEREST-PART    PIC 9(8)V9(2) ROUNDED.\n01  WS-PRINCIPAL-PART   PIC 9(8)V9(2) ROUNDED.\n01  WS-MONTH-NUM        PIC 9(3).\n01  WS-REASON   "]
[61.063273, "i", "        PIC X(50).\n01  WS-SPACE            PIC X VALUE SPACE.\n01  WS-MONTHLY-PAY-ED   PIC Z(8).99.\n01  WS-INTEREST-ED      PIC Z(8).99.\n01  WS-PRINCIPAL-ED     PIC Z(8).99.\n01  WS-BALANCE-ED       PIC Z(10).99.\nPROCEDURE DIVISION.\nMAIN-LOGIC.\n    OPEN INPUT IN-FILE\n    OPEN OUTPUT OUT-FILE\n    PERFORM UNTIL EOF-FLAG = 'Y'\n        READ IN-FILE\n            AT END MOVE 'Y' TO EOF-FLAG\n        NOT AT END\n            PERFORM PROCESS-RECORD\n        END-READ\n    END-PERFORM\n    CLOSE IN-FILE\n    CLOSE OUT-FILE\n    STOP RUN.\nPROCESS-RECORD.\n    UNSTRING IN-REC DELIMITED BY ';'\n        INTO WS-ID\n             WS-NAME\n             WS-LOAN-AMOUNT\n             WS-PROP-VALUE\n             WS-DOWN-PAYMENT\n             WS-TERM\n             WS-RATE\n    END-UNSTRING\n    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\n    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\n        MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO WS-REASON\n        STRING WS-ID DELIMITED BY SIZE\n               WS-SPACE\n               WS-REASON DELIMITED BY SIZE\n   "]
[61.063307, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[61.063361, "i", "            INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n    ELSE\n        MOVE WS-LOAN-AMOUNT TO WS-BALANCE\n        COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200\n        COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT *\n            WS-MONTHLY-RATE /\n            (1 - FUNCTION POWER (1 + WS-MONTHLY-RATE, -WS-TERM))\n        STRING WS-ID DELIMITED BY SIZE\n               'APPRO' DELIMITED BY SIZE\n               INTO OUT-REC\n        END-STRING\n        WRITE OUT-REC\n        PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\n                UNTIL WS-MONTH-NUM > WS-TERM\n            COMPUTE WS-INTEREST-PART =\n                WS-BALANCE * WS-MONTHLY-RATE ROUNDED\n            COMPUTE WS-PRINCIPAL-PART =\n                WS-MONTHLY-PAYMENT - WS-INTEREST-PART ROUNDED\n            COMPUTE WS-BALANCE = WS-BALANCE -\n                WS-PRINCIPAL-PART ROUNDED\n            MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAY-ED\n            MOVE WS-INTEREST-PART TO WS-INTEREST-ED\n            MOVE WS-PRINCIPAL-PART TO WS-PRINCIPAL-ED\n            MOVE WS-B"]
[61.063487, "o", "\u001b[?2004h> IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r"]
[61.063502, "i", "ALANCE TO WS-BALANCE-ED\n            STRING WS-MONTH-NUM DELIMITED BY SIZE\n                   WS-SPACE\n                   WS-MONTHLY-PAY-ED DELIMITED BY SIZE\n                   WS-SPACE\n                   WS-INTEREST-ED DELIMITED BY SIZE\n                   WS-SPACE\n                   WS-PRINCIPAL-ED DELIMITED BY SIZE\n                   WS-SPACE\n                   WS-BALANCE-ED DELIMITED BY SIZE\n                   INTO OUT-REC\n            END-STRING\n            WRITE OUT-REC\n        END-PERFORM\n    END-IF.\nEOF\n"]
[61.06372, "o", "\u001b[?2004h> PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r"]
