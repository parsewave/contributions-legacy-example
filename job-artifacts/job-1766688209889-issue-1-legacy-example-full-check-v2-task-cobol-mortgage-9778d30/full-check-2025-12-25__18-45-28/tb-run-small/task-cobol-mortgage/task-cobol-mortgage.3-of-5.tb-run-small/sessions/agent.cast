[61.064282, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.06445, "o", "    SELECT OUT-FILE ASSIGN TO '/app/data/OUTPUT.DAT'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.06458, "o", "        ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
