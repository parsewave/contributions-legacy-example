[61.065256, "o", "01  EOF-FLAG        PIC X VALUE 'N'.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.06534, "o", "01  WS-ID           PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.065416, "o", "01  WS-NAME         PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.065508, "o", "01  WS-LOAN-AMOUNT  PIC 9(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.065618, "o", "01  WS-PROP-VALUE   PIC 9(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.065737, "o", "01  WS-DOWN-PAYMENT PIC 9(10).\r\n\u001b[?2004l\r"]
[61.065836, "o", "\u001b[?2004h> "]
[61.065918, "o", "01  WS-TERM         PIC 9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066023, "o", "01  WS-RATE         PIC 9(3)V9(2).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066123, "o", "01  WS-MIN-DOWN     PIC 9(10) ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066221, "o", "01  WS-MONTHLY-RATE PIC 9(5)V9(6).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066348, "o", "01  WS-MONTHLY-PAYMENT   PIC 9(8)V9(2) ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.066376, "o", "> "]
[61.06648, "o", "01  WS-BALANCE           PIC 9(10)V9(2) ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066591, "o", "01  WS-INTEREST-PART    PIC 9(8)V9(2) ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066684, "o", "01  WS-PRINCIPAL-PART   PIC 9(8)V9(2) ROUNDED.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066796, "o", "01  WS-MONTH-NUM        PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066896, "o", "01  WS-REASON           PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.066999, "o", "01  WS-SPACE            PIC X VALUE SPACE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067097, "o", "01  WS-MONTHLY-PAY-ED   PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067197, "o", "01  WS-INTEREST-ED      PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.0673, "o", "01  WS-PRINCIPAL-ED     PIC Z(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.06738, "o", "01  WS-BALANCE-ED       PIC Z(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067446, "o", "PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067501, "o", "MAIN-LOGIC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067571, "o", "    OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067605, "o", "    OPEN OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067696, "o", "    PERFORM UNTIL EOF-FLAG = 'Y'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067798, "o", "        READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067878, "o", "            AT END MOVE 'Y' TO EOF-FLAG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.067961, "o", "        NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.06804, "o", "            PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068063, "o", "        END-READ\r\n\u001b[?2004l\r\u001b[?2004h>     END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.068141, "o", ">     CLOSE IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068203, "o", "    CLOSE OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h>     STOP RUN.\r\n\u001b[?2004l\r"]
[61.068219, "o", "\u001b[?2004h> "]
[61.068299, "o", "PROCESS-RECORD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068392, "o", "    UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068476, "o", "        INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h>              WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068563, "o", "             WS-LOAN-AMOUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068645, "o", "             WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068727, "o", "             WS-DOWN-PAYMENT\r\n\u001b[?2004l\r\u001b[?2004h>              WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068829, "o", "             WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068907, "o", "    END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.068996, "o", "    COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069085, "o", "    IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069222, "o", "        MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069331, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069425, "o", "               WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069509, "o", "               WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069529, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069603, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069682, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>     ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069778, "o", "        MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.069918, "o", "        COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070037, "o", "        COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT *\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070118, "o", "            WS-MONTHLY-RATE /\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070259, "o", "            (1 - FUNCTION POWER (1 + WS-MONTHLY-RATE, -WS-TERM))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070357, "o", "        STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.07045, "o", "               'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[61.070474, "o", "> "]
[61.070537, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r"]
[61.070556, "o", "\u001b[?2004h> "]
[61.070642, "o", "        END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070668, "o", "        WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070749, "o", "        PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070876, "o", "                UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.070978, "o", "            COMPUTE WS-INTEREST-PART =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.071095, "o", "                WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.071195, "o", "            COMPUTE WS-PRINCIPAL-PART =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.071341, "o", "                WS-MONTHLY-PAYMENT - WS-INTEREST-PART ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.071451, "o", "            COMPUTE WS-BALANCE = WS-BALANCE -\r\n\u001b[?2004l\r"]
[61.071476, "o", "\u001b[?2004h> "]
[61.07159, "o", "                WS-PRINCIPAL-PART ROUNDED\r\n\u001b[?2004l\r"]
[61.071616, "o", "\u001b[?2004h> "]
[61.071806, "o", "            MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAY-ED\r\n\u001b[?2004l\r"]
[61.071894, "o", "\u001b[?2004h> "]
[61.071981, "o", "            MOVE WS-INTEREST-PART TO WS-INTEREST-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.07209, "o", "            MOVE WS-PRINCIPAL-PART TO WS-PRINCIPAL-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072209, "o", "            MOVE WS-BALANCE TO WS-BALANCE-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072323, "o", "            STRING WS-MONTH-NUM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.07242, "o", "                   WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072502, "o", "                   WS-MONTHLY-PAY-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072582, "o", "                   WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072673, "o", "                   WS-INTEREST-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072749, "o", "                   WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.07289, "o", "                   WS-PRINCIPAL-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.072978, "o", "                   WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073081, "o", "                   WS-BALANCE-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073167, "o", "                   INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073273, "o", "            END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073296, "o", "            WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073379, "o", "        END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.073403, "o", "    END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
