[98.010865, "o", "      PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.01089, "o", "> "]
[98.010966, "o", "      MAIN-LOGIC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.011088, "o", "          OPEN INPUT IN-FILE\r\n\u001b[?2004l\r"]
[98.011104, "o", "\u001b[?2004h> "]
[98.011243, "o", "          OPEN OUTPUT OUT-FILE\r\n\u001b[?2004l\r"]
[98.011259, "o", "\u001b[?2004h"]
[98.011311, "o", "> "]
[98.011393, "o", "          PERFORM UNTIL EOF-FLAG = 'Y'\r\n\u001b[?2004l\r"]
[98.011414, "o", "\u001b[?2004h> "]
[98.011505, "o", "              READ IN-FILE\r\n\u001b[?2004l\r"]
[98.011523, "o", "\u001b[?2004h> "]
[98.011676, "o", "                  AT END MOVE 'Y' TO EOF-FLAG\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.011727, "o", "> "]
[98.011805, "o", "              NOT AT END\r\n\u001b[?2004l\r"]
[98.011826, "o", "\u001b[?2004h> "]
[98.011958, "o", "                  PERFORM PROCESS-RECORD\r\n\u001b[?2004l\r"]
[98.011976, "o", "\u001b[?2004h> "]
[98.012051, "o", "              END-READ\r\n\u001b[?2004l\r"]
[98.012068, "o", "\u001b[?2004h> "]
[98.012151, "o", "          END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.012281, "o", "          CLOSE IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.012339, "o", "          CLOSE OUT-FILE\r\n\u001b[?2004l\r"]
[98.012389, "o", "\u001b[?2004h> "]
[98.012438, "o", "          STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.012498, "o", "      PROCESS-RECORD.\r\n\u001b[?2004l\r"]
[98.012516, "o", "\u001b[?2004h> "]
[98.012684, "o", "          UNSTRING IN-REC DELIMITED BY ';'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.012748, "o", "              INTO WS-ID\r\n"]
[98.012846, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.012868, "o", "                   WS-NAME\r\n\u001b[?2004l\r"]
[98.012934, "o", "\u001b[?2004h> "]
[98.012997, "o", "                   WS-LOAN-AMOUNT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.013093, "o", "                   WS-PROP-VALUE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.013193, "o", "                   WS-DOWN-PAYMENT\r\n\u001b[?2004l\r"]
[98.013211, "o", "\u001b[?2004h> "]
[98.01333, "o", "                   WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.013431, "o", "                   WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.013576, "o", "          END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.01371, "o", "          COMPUTE WS-MIN-DOWN = WS-PROP-VALUE * 0.15 ROUNDED\r\n\u001b[?2004l\r"]
[98.01373, "o", "\u001b[?2004h> "]
[98.013903, "o", "          IF WS-DOWN-PAYMENT < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.014107, "o", "              MOVE 'INSUFFICIENT FUNDS FOR DOWN PAYMENT' TO WS-REASON\r\n\u001b[?2004l\r"]
[98.014127, "o", "\u001b[?2004h> "]
[98.014287, "o", "              STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.014415, "o", "                     WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.014598, "o", "                     WS-REASON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.014682, "o", "                     INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.014699, "o", "> "]
[98.014825, "o", "              END-STRING\r\n\u001b[?2004l\r"]
[98.014843, "o", "\u001b[?2004h> "]
[98.014924, "o", "              WRITE OUT-REC\r\n\u001b[?2004l\r"]
[98.014943, "o", "\u001b[?2004h> "]
[98.01501, "o", "          ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.015179, "o", "              MOVE WS-LOAN-AMOUNT TO WS-BALANCE\r\n\u001b[?2004l\r"]
[98.015193, "o", "\u001b[?2004h> "]
[98.015367, "o", "              COMPUTE WS-MONTHLY-RATE = WS-RATE / 1200\r\n\u001b[?2004l\r"]
[98.015391, "o", "\u001b[?2004h> "]
[98.015555, "o", "              COMPUTE WS-MONTHLY-PAYMENT = WS-LOAN-AMOUNT *\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.015578, "o", "> "]
[98.015677, "o", "                  WS-MONTHLY-RATE /\r\n\u001b[?2004l\r"]
[98.015692, "o", "\u001b[?2004h> "]
[98.015973, "o", "                  (1 - FUNCTION POWER (1 + WS-MONTHLY-RATE, -WS-TERM))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.016096, "o", "              STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[98.016111, "o", "\u001b[?2004h> "]
[98.016314, "o", "                     'APPRO' DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.016586, "o", "                     INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h>               WRITE OUT-REC\r\n\u001b[?2004l\r"]
[98.016659, "o", "\u001b[?2004h> "]
[98.016795, "o", "              PERFORM VARYING WS-MONTH-NUM FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.016859, "o", "> "]
[98.016968, "o", "                      UNTIL WS-MONTH-NUM > WS-TERM\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.016984, "o", "> "]
[98.017146, "o", "                  COMPUTE WS-INTEREST-PART =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.017339, "o", "                      WS-BALANCE * WS-MONTHLY-RATE ROUNDED\r\n\u001b[?2004l\r"]
[98.017389, "o", "\u001b[?2004h> "]
[98.017524, "o", "                  COMPUTE WS-PRINCIPAL-PART =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.017715, "o", "                      WS-MONTHLY-PAYMENT - WS-INTEREST-PART ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.017733, "o", "> "]
[98.017962, "o", "                  COMPUTE WS-BALANCE = WS-BALANCE -\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.018096, "o", "                      WS-PRINCIPAL-PART ROUNDED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.018287, "o", "                  MOVE WS-MONTHLY-PAYMENT TO WS-MONTHLY-PAY-ED\r\n\u001b[?2004l\r"]
[98.018305, "o", "\u001b[?2004h> "]
[98.018521, "o", "                  MOVE WS-INTEREST-PART TO WS-INTEREST-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.018679, "o", "                  MOVE WS-PRINCIPAL-PART TO WS-PRINCIPAL-ED\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.018694, "o", "> "]
[98.018884, "o", "                  MOVE WS-BALANCE TO WS-BALANCE-ED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.019039, "o", "                  STRING WS-MONTH-NUM DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.01906, "o", "> "]
[98.019162, "o", "                         WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.019356, "o", "                         WS-MONTHLY-PAY-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.019376, "o", "> "]
[98.019477, "o", "                         WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.019495, "o", "> "]
[98.019663, "o", "                         WS-INTEREST-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.01979, "o", "                         WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.019855, "o", "> "]
[98.019985, "o", "                         WS-PRINCIPAL-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r"]
[98.020006, "o", "\u001b[?2004h> "]
[98.020133, "o", "                         WS-SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.020317, "o", "                         WS-BALANCE-ED DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.020336, "o", "> "]
[98.020438, "o", "                         INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.02054, "o", "                  END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.020557, "o", "> "]
[98.020657, "o", "                  WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.020672, "o", "> "]
[98.020789, "o", "              END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.020807, "o", "> "]
[98.020914, "o", "          END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
