[96.012446, "o", "         05  WS-POWER-CTR                PIC 9(4).\\n\\n       01  WS-OUTPUT-REJECT.\\n           05  WS-REJ-ID                   PIC X(10).\\n           05  WS-REJ-STATUS               PIC X(5).\\n           05  WS-REJ-REASON               PIC X(50).\\n\\n       01  WS-OUTPUT-APPROVE.\\n           05  WS-APP-ID                   PIC X(10).\\n           05  WS-APP-STATUS               PIC X(5).\\n\\n       01  WS-OUTPUT-SCHEDULE.\\n           05  WS-SCH-MONTH                PIC 9(3).\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-SCH-PAYMENT              PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-SCH-INTEREST             PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-SCH-PRINCIPAL            PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-SCH-BALANCE              PIC 9(10).99.\\n\\n       01  WS-PARSE-IDX                    PIC 9(3).\\n       01"]
[96.012552, "o", "  WS-FIELD-IDX                    PIC 9(3).\\n       01  WS-FIELD-NUM                    PIC 9(1).\\n       01  WS-TEMP-FIELD                   PIC X(30).\\n       01  WS-INPUT-LEN                    PIC 9(3).\\n\\n       PROCEDURE DIVISION.\\n       0000-MAIN.\\n           PERFORM 1000-INITIALIZE\\n           PERFORM 2000-PROCESS-FILE\\n           PERFORM 9000-TERMINATE\\n           STOP RUN.\\n\\n       1000-INITIALIZE.\\n           OPEN INPUT INPUT-FILE\\n           IF WS-IN-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING INPUT FILE: \\\" WS-IN-STATUS\\n               STOP RUN\\n           END-IF\\n           OPEN OUTPUT OUTPUT-FILE\\n           IF WS-OUT-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING OUTPUT FILE: \\\" WS-OUT-STATUS\\n               STOP RUN\\n           END-IF.\\n\\n       2000-PROCESS-FILE.\\n           PERFORM UNTIL WS-EOF = 1\\n               READ INPUT-FILE\\n                   AT END\\n                       MOVE 1 TO WS-EOF\\n                   NOT AT END\\n                       PERFORM 3"]
[96.012623, "o", "000-PARSE-RECORD\\n                       PERFORM 4000-VALIDATE-APPLICATION\\n               END-READ\\n           END-PERFORM.\\n\\n       3000-PARSE-RECORD.\\n           INITIALIZE WS-INPUT-FIELDS\\n           MOVE 1 TO WS-PARSE-IDX\\n           MOVE 1 TO WS-FIELD-IDX\\n           MOVE 1 TO WS-FIELD-NUM\\n           INITIALIZE WS-TEMP-FIELD\\n           MOVE FUNCTION LENGTH(FUNCTION TRIM(INPUT-RECORD))\\n               TO WS-INPUT-LEN\\n           PERFORM VARYING WS-PARSE-IDX FROM 1 BY 1\\n               UNTIL WS-PARSE-IDX > WS-INPUT-LEN\\n               IF INPUT-RECORD(WS-PARSE-IDX:1) = \\\";\\\"\\n                   PERFORM 3100-STORE-FIELD\\n                   ADD 1 TO WS-FIELD-NUM\\n                   MOVE 1 TO WS-FIELD-IDX\\n                   INITIALIZE WS-TEMP-FIELD\\n               ELSE\\n                   MOVE INPUT-RECORD(WS-PARSE-IDX:1)\\n                       TO WS-TEMP-FIELD(WS-FIELD-IDX:1)\\n                   ADD 1 TO WS-FIELD-IDX\\n               END-IF\\n           END-PERFORM\\n           PERFORM 3100-STORE-FIELD.\\n\\"]
[96.01264, "o", "n       3100-STORE-FIELD.\\n           EVALUATE WS-FIELD-NUM\\n               WHEN 1\\n                   MOVE WS-TEMP-FIELD TO WS-ID\\n               WHEN 2\\n                   MOVE WS-TEMP-FIELD TO WS-NAME\\n               WHEN 3\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-FIELD)\\n                       TO WS-LOAN-AMOUNT\\n               WHEN 4\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-FIELD)\\n                       TO WS-PROPERTY-VALUE\\n               WHEN 5\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-FIELD)\\n                       TO WS-DOWN-PAYMENT\\n               WHEN 6\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-FIELD)\\n                       TO WS-TERM\\n               WHEN 7\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-FIELD)\\n                       TO WS-RATE-CALC\\n                   DIVIDE WS-RATE-CALC BY 100\\n                       GIVING WS-RATE ROUNDED\\n           END-EVALUATE.\\n\\n       4000-VALIDATE-APPLICATION.\\n           MOVE WS-PROPERTY-VALUE TO WS-PROP-VAL-CALC\\n       "]
[96.012652, "o", "    COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL-CALC * 0.15\\n           MOVE WS-DOWN-PAYMENT TO WS-DOWN-PAY-CALC\\n           IF WS-DOWN-PAY-CALC < WS-MIN-DOWN\\n               PERFORM 5000-WRITE-REJECTION\\n           ELSE\\n               PERFORM 6000-PROCESS-APPROVAL\\n           END-IF.\\n\\n       5000-WRITE-REJECTION.\\n           INITIALIZE WS-OUTPUT-REJECT\\n           MOVE WS-ID TO WS-OUT-ID\\n           MOVE \\\"DENY \\\" TO WS-OUT-STATUS\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\"\\n               TO WS-OUT-REASON\\n           MOVE WS-OUTPUT-REJECT TO OUTPUT-RECORD\\n           WRITE OUTPUT-RECORD.\\n\\n       6000-PROCESS-APPROVAL.\\n           INITIALIZE WS-OUTPUT-APPROVE\\n           MOVE WS-ID TO WS-APP-ID\\n           MOVE \\\"APPRO\\\" TO WS-APP-STATUS\\n           MOVE WS-OUTPUT-APPROVE TO OUTPUT-RECORD\\n           WRITE OUTPUT-RECORD\\n           PERFORM 7000-CALCULATE-PAYMENT\\n           PERFORM 8000-GENERATE-SCHEDULE.\\n\\n       7000-CALCULATE-PAYMENT.\\n           MOVE WS-LOAN-AMOUNT TO WS-LOAN-AMT-CALC\\n "]
[96.012722, "o", "          COMPUTE WS-TERM-MONTHS = WS-TERM * 12\\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\\n           COMPUTE WS-POWER-BASE ROUNDED = 1 + WS-MONTHLY-RATE\\n           MOVE 1 TO WS-POWER-RESULT\\n           PERFORM VARYING WS-POWER-CTR FROM 1 BY 1\\n               UNTIL WS-POWER-CTR > WS-TERM-MONTHS\\n               COMPUTE WS-POWER-RESULT ROUNDED =\\n                   WS-POWER-RESULT * WS-POWER-BASE\\n           END-PERFORM\\n           COMPUTE WS-NUMERATOR ROUNDED =\\n               WS-LOAN-AMT-CALC * WS-MONTHLY-RATE\\n           COMPUTE WS-DENOMINATOR ROUNDED =\\n               1 - (1 / WS-POWER-RESULT)\\n           IF WS-DENOMINATOR > 0\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-NUMERATOR / WS-DENOMINATOR\\n           ELSE\\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                   WS-LOAN-AMT-CALC / WS-TERM-MONTHS\\n           END-IF.\\n\\n       8000-GENERATE-SCHEDULE.\\n           MOVE WS-LOAN-AMT-CALC TO WS-REMAINING-BAL\\n           PERFORM VARYING WS-M"]
[96.012741, "o", "ONTH-CTR FROM 1 BY 1\\n               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\\n               COMPUTE WS-INTEREST-PART ROUNDED =\\n                   WS-REMAINING-BAL * WS-MONTHLY-RATE\\n               COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n                   WS-MONTHLY-PAYMENT - WS-INTEREST-PART\\n               IF WS-MONTH-CTR = WS-TERM-MONTHS\\n                   MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\\n                   COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n                       WS-PRINCIPAL-PART + WS-INTEREST-PART\\n               END-IF\\n               COMPUTE WS-REMAINING-BAL ROUNDED =\\n                   WS-REMAINING-BAL - WS-PRINCIPAL-PART\\n               IF WS-REMAINING-BAL < 0\\n                   MOVE 0 TO WS-REMAINING-BAL\\n               END-IF\\n               INITIALIZE WS-OUTPUT-SCHEDULE\\n               MOVE WS-MONTH-CTR TO WS-SCH-MONTH\\n               MOVE WS-MONTHLY-PAYMENT TO WS-SCH-PAYMENT\\n               MOVE WS-INTEREST-PART TO WS-SCH-INTEREST\\n               MOVE WS-PRINCIPAL-PART TO WS-SCH-PRIN"]
[96.012787, "o", "CIPAL\\n               MOVE WS-REMAINING-BAL TO WS-SCH-BALANCE\\n               MOVE WS-OUTPUT-SCHEDULE TO OUTPUT-RECORD\\n               WRITE OUTPUT-RECORD\\n           END-PERFORM.\\n\\n       9000-TERMINATE.\\n           CLOSE INPUT-FILE\\n           CLOSE OUTPUT-FILE.\\n\",\"structuredPatch\":[{\"oldStart\":172,\"oldLines\":10,\"newStart\":172,\"newLines\":10,\"lines\":[\" \",\"        5000-WRITE-REJECTION.\",\"            INITIALIZE WS-OUTPUT-REJECT\",\"-           MOVE WS-ID TO WS-OUT-ID\",\"-           MOVE \\\"DENY \\\" TO WS-OUT-STATUS\",\"+           MOVE WS-ID TO WS-REJ-ID\",\"+           MOVE \\\"DENY \\\" TO WS-REJ-STATUS\",\"            MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\"\",\"-               TO WS-OUT-REASON\",\"+               TO WS-REJ-REASON\",\"            MOVE WS-OUTPUT-REJECT TO OUTPUT-RECORD\",\"            WRITE OUTPUT-RECORD.\",\" \"]}],\"userModified\":false,\"replaceAll\":false}}\r\n"]
