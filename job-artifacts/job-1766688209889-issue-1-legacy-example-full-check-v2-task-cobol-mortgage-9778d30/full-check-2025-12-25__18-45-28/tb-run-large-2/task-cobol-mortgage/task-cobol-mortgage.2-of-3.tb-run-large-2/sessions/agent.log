           GIVING WS-RATE ROUNDED\n           END-EVALUATE.\n\n       4000-VALIDATE-APPLICATION.\n           MOVE WS-PROPERTY-VALUE TO WS-PROP-VAL-CALC\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL-CALC * 0.15\n           MOVE WS-DOWN-PAYMENT TO WS-DOWN-PAY-CALC\n           IF WS-DOWN-PAY-CALC < WS-MIN-DOWN\n               PERFORM 5000-WRITE-REJECTION\n           ELSE\n               PERFORM 6000-PROCESS-APPROVAL\n           END-IF.\n\n       5000-WRITE-REJECTION.\n           INITIALIZE WS-OUTPUT-REJECT\n           MOVE WS-ID TO WS-OUT-ID\n           MOVE \"DENY \" TO WS-OUT-STATUS\n           MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n               TO WS-OUT-REASON\n           MOVE WS-OUTPUT-REJECT TO OUTPUT-RECORD\n           WRITE OUTPUT-RECORD.\n\n       6000-PROCESS-APPROVAL.\n           INITIALIZE WS-OUTPUT-APPROVE\n           MOVE WS-ID TO WS-APP-ID\n           MOVE \"APPRO\" TO WS-APP-STATUS\n           MOVE WS-OUTPUT-APPROVE TO OUTPUT-RECORD\n           WRITE OUTPUT-RECORD\n           PERFORM 7000-CALCULATE-PAYMENT\n           PERFORM 8000-GENERATE-SCHEDULE.\n\n       7000-CALCULATE-PAYMENT.\n           MOVE WS-LOAN-AMOUNT TO WS-LOAN-AMT-CALC\n           COMPUTE WS-TERM-MONTHS = WS-TERM * 12\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\n           COMPUTE WS-POWER-BASE ROUNDED = 1 + WS-MONTHLY-RATE\n           MOVE 1 TO WS-POWER-RESULT\n           PERFORM VARYING WS-POWER-CTR FROM 1 BY 1\n               UNTIL WS-POWER-CTR > WS-TERM-MONTHS\n               COMPUTE WS-POWER-RESULT ROUNDED =\n                   WS-POWER-RESULT * WS-POWER-BASE\n           END-PERFORM\n           COMPUTE WS-NUMERATOR ROUNDED =\n               WS-LOAN-AMT-CALC * WS-MONTHLY-RATE\n           COMPUTE WS-DENOMINATOR ROUNDED =\n               1 - (1 / WS-POWER-RESULT)\n           IF WS-DENOMINATOR > 0\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-NUMERATOR / WS-DENOMINATOR\n           ELSE\n               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                   WS-LOAN-AMT-CALC / WS-TERM-MONTHS\n           END-IF.\n\n       8000-GENERATE-SCHEDULE.\n           MOVE WS-LOAN-AMT-CALC TO WS-REMAINING-BAL\n           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\n               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\n               COMPUTE WS-INTEREST-PART ROUNDED =\n                   WS-REMAINING-BAL * WS-MONTHLY-RATE\n               COMPUTE WS-PRINCIPAL-PART ROUNDED =\n                   WS-MONTHLY-PAYMENT - WS-INTEREST-PART\n               IF WS-MONTH-CTR = WS-TERM-MONTHS\n                   MOVE WS-REMAINING-BAL TO WS-PRINCIPAL-PART\n                   COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\n                       WS-PRINCIPAL-PART + WS-INTEREST-PART\n               END-IF\n               COMPUTE WS-REMAINING-BAL ROUNDED =\n                   WS-REMAINING-BAL - WS-PRINCIPAL-PART\n               IF WS-REMAINING-BAL < 0\n                   MOVE 0 TO WS-REMAINING-BAL\n               END-IF\n               INITIALIZE WS-OUTPUT-SCHEDULE\n               MOVE WS-MONTH-CTR TO WS-SCH-MONTH\n               MOVE WS-MONTHLY-PAYMENT TO WS-SCH-PAYMENT\n               MOVE WS-INTEREST-PART TO WS-SCH-INTEREST\n               MOVE WS-PRINCIPAL-PART TO WS-SCH-PRINCIPAL\n               MOVE WS-REMAINING-BAL TO WS-SCH-BALANCE\n               MOVE WS-OUTPUT-SCHEDULE TO OUTPUT-RECORD\n               WRITE OUTPUT-RECORD\n           END-PERFORM.\n\n       9000-TERMINATE.\n           CLOSE INPUT-FILE\n           CLOSE OUTPUT-FILE.\n","structuredPatch":[{"oldStart":172,"oldLines":10,"newStart":172,"newLines":10,"lines":[" ","        5000-WRITE-REJECTION.","            INITIALIZE WS-OUTPUT-REJECT","-           MOVE WS-ID TO WS-OUT-ID","-           MOVE \"DENY \" TO WS-OUT-STATUS","+           MOVE WS-ID TO WS-REJ-ID","+           MOVE \"DENY \" TO WS-REJ-STATUS","            MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\"","-               TO WS-OUT-REASON","+               TO WS-REJ-REASON","            MOVE WS-OUTPUT-REJECT TO