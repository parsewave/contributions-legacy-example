[144.175863, "o", "T-PART          PIC 9(8)V99.\\n    42→          05 WS-PRINCIPAL-PART         PIC 9(8)V99.\\n    43→          05 WS-TERM-MONTHS            PIC 9(4).\\n    44→          05 WS-MONTH-CTR              PIC 9(3).\\n    45→          05 WS-POWER-BASE             PIC 9V9(10).\\n    46→          05 WS-POWER-RESULT           PIC 9(5)V9(10).\\n    47→          05 WS-DENOMINATOR            PIC 9(5)V9(10).\\n    48→          05 WS-NUMERATOR              PIC 9(15)V9(10).\\n    49→          05 WS-LOAN-AMT-DEC           PIC 9(10)V99.\\n    50→      *\\n    51→       01 WS-OUTPUT-DENY.\\n    52→          05 WS-OUT-ID                 PIC X(10).\\n    53→          05 WS-OUT-STATUS             PIC X(5).\\n    54→          05 FILLER                    PIC X VALUE SPACE.\\n    55→          05 WS-OUT-REASON             PIC X(50).\\n    56→      *\\n    57→       01 WS-OUTPUT-APPRO.\\n    58→          05 WS-APP-ID                 PIC X(10).\\n    59→          05 WS-APP-STATUS             PIC X(5).\\n    60→      *\\n"]
