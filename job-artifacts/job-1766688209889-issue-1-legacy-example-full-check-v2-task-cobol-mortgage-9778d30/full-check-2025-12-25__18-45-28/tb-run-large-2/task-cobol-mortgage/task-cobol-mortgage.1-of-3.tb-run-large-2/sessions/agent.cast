[199.271271, "o", "            PIC 9(2).\\n       01 WS-RATE-NUM REDEFINES WS-RATE-TEMP PIC 9(3)V9(2).\",\"originalFile\":\"       IDENTIFICATION DIVISION.\\n       PROGRAM-ID. MORTGAGE-PROCESSOR.\\n      *\\n       ENVIRONMENT DIVISION.\\n       INPUT-OUTPUT SECTION.\\n       FILE-CONTROL.\\n           SELECT INPUT-FILE ASSIGN TO \\\"INPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-IN-STATUS.\\n           SELECT OUTPUT-FILE ASSIGN TO \\\"../data/OUTPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-FILE-OUT-STATUS.\\n      *\\n       DATA DIVISION.\\n       FILE SECTION.\\n       FD INPUT-FILE.\\n       01 INPUT-RECORD                 PIC X(200).\\n      *\\n       FD OUTPUT-FILE.\\n       01 OUTPUT-RECORD                PIC X(80).\\n      *\\n       WORKING-STORAGE SECTION.\\n       01 WS-IN-STATUS                 PIC XX.\\n       01 WS-FILE-OUT-STATUS           PIC XX.\\n       01 WS-EOF                       PIC 9 VALUE 0.\\n      *\\n       01 WS-INPUT-DATA.\\n         "]
