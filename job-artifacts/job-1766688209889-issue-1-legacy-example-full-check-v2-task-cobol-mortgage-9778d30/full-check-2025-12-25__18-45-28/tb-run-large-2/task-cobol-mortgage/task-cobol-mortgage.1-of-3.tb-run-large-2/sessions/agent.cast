[144.175971, "o", "E DIVISION.\\n    80→       0000-MAIN.\\n    81→           PERFORM 1000-INIT.\\n    82→           PERFORM 2000-PROCESS UNTIL WS-EOF = 1.\\n    83→           PERFORM 9000-CLOSE.\\n    84→           STOP RUN.\\n    85→      *\\n    86→       1000-INIT.\\n    87→           OPEN INPUT INPUT-FILE.\\n    88→           OPEN OUTPUT OUTPUT-FILE.\\n    89→      *\\n    90→       2000-PROCESS.\\n    91→           READ INPUT-FILE INTO INPUT-RECORD\\n    92→               AT END\\n    93→                   MOVE 1 TO WS-EOF\\n    94→               NOT AT END\\n    95→                   PERFORM 2100-PARSE-RECORD\\n    96→                   PERFORM 3000-EVALUATE-APPLICATION\\n    97→           END-READ.\\n    98→      *\\n    99→       2100-PARSE-RECORD.\\n   100→           INITIALIZE WS-INPUT-DATA.\\n   101→           MOVE 1 TO WS-FIELD-NUM.\\n   102→           MOVE 1 TO WS-FIELD-START.\\n   103→           MOVE FUNCTION LENGTH(FUNCTION TRIM(INPUT-RECORD))\\n   104→               TO WS-REC-LEN.\\n   1"]
[144.176022, "o", "05→           PERFORM VARYING WS-PARSE-IDX FROM 1 BY 1\\n   106→               UNTIL WS-PARSE-IDX > WS-REC-LEN\\n   107→               IF INPUT-RECORD(WS-PARSE-IDX:1) = \\\";\\\"\\n   108→                   COMPUTE WS-FIELD-LEN =\\n   109→                       WS-PARSE-IDX - WS-FIELD-START\\n   110→                   MOVE INPUT-RECORD(WS-FIELD-START:WS-FIELD-LEN)\\n   111→                       TO WS-TEMP-FIELD\\n   112→                   PERFORM 2200-STORE-FIELD\\n   113→                   ADD 1 TO WS-FIELD-NUM\\n   114→                   COMPUTE WS-FIELD-START = WS-PARSE-IDX + 1\\n   115→               END-IF\\n   116→           END-PERFORM.\\n   117→           COMPUTE WS-FIELD-LEN = WS-REC-LEN - WS-FIELD-START + 1.\\n   118→           IF WS-FIELD-LEN > 0\\n   119→               MOVE INPUT-RECORD(WS-FIELD-START:WS-FIELD-LEN)\\n   120→                   TO WS-TEMP-FIELD\\n   121→               PERFORM 2200-STORE-FIELD\\n   122→           END-IF.\\n   123→      *\\n   124→       2200-STORE-F"]
[144.176065, "o", "IELD.\\n   125→           EVALUATE WS-FIELD-NUM\\n   126→               WHEN 1 MOVE WS-TEMP-FIELD TO WS-ID\\n   127→               WHEN 2 MOVE WS-TEMP-FIELD TO WS-NAME\\n   128→               WHEN 3 MOVE WS-TEMP-FIELD TO WS-LOAN-AMOUNT\\n   129→               WHEN 4 MOVE WS-TEMP-FIELD TO WS-PROPERTY-VALUE\\n   130→               WHEN 5 MOVE WS-TEMP-FIELD TO WS-DOWN-PAYMENT\\n   131→               WHEN 6 MOVE WS-TEMP-FIELD TO WS-TERM\\n   132→               WHEN 7 MOVE WS-TEMP-FIELD TO WS-RATE\\n   133→           END-EVALUATE.\\n   134→      *\\n   135→       3000-EVALUATE-APPLICATION.\\n   136→           COMPUTE WS-MIN-DOWN ROUNDED =\\n   137→               WS-PROPERTY-VALUE * 0.15.\\n   138→           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n   139→               PERFORM 4000-WRITE-DENIAL\\n   140→           ELSE\\n   141→               PERFORM 5000-WRITE-APPROVAL\\n   142→           END-IF.\\n   143→      *\\n   144→       4000-WRITE-DENIAL.\\n   145→           INITIALIZE WS-OUTPUT-DENY.\\n   "]
[144.176082, "o", "146→           MOVE WS-ID TO WS-OUT-ID.\\n   147→           MOVE \\\"DENY \\\" TO WS-OUT-STATUS.\\n   148→           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\"\\n   149→               TO WS-OUT-REASON.\\n   150→           WRITE OUTPUT-RECORD FROM WS-OUTPUT-DENY.\\n   151→      *\\n   152→       5000-WRITE-APPROVAL.\\n   153→           INITIALIZE WS-OUTPUT-APPRO.\\n   154→           MOVE WS-ID TO WS-APP-ID.\\n   155→           MOVE \\\"APPRO\\\" TO WS-APP-STATUS.\\n   156→           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPRO.\\n   157→           PERFORM 6000-CALCULATE-SCHEDULE.\\n   158→      *\\n   159→       6000-CALCULATE-SCHEDULE.\\n   160→           COMPUTE WS-TERM-MONTHS = WS-TERM * 12.\\n   161→           COMPUTE WS-MONTHLY-RATE ROUNDED =\\n   162→               WS-RATE / 1200.\\n   163→           COMPUTE WS-LOAN-AMT-DEC = WS-LOAN-AMOUNT.\\n   164→           COMPUTE WS-POWER-BASE = 1 + WS-MONTHLY-RATE.\\n   165→           COMPUTE WS-POWER-RESULT ROUNDED =\\n   166→               WS-POWER-B"]
[144.176128, "o", "ASE ** (0 - WS-TERM-MONTHS).\\n   167→           COMPUTE WS-DENOMINATOR ROUNDED =\\n   168→               1 - WS-POWER-RESULT.\\n   169→           COMPUTE WS-NUMERATOR ROUNDED =\\n   170→               WS-LOAN-AMT-DEC * WS-MONTHLY-RATE.\\n   171→           IF WS-DENOMINATOR > 0\\n   172→               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n   173→                   WS-NUMERATOR / WS-DENOMINATOR\\n   174→           ELSE\\n   175→               COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n   176→                   WS-LOAN-AMT-DEC / WS-TERM-MONTHS\\n   177→           END-IF.\\n   178→           MOVE WS-LOAN-AMT-DEC TO WS-REMAINING-BALANCE.\\n   179→           PERFORM VARYING WS-MONTH-CTR FROM 1 BY 1\\n   180→               UNTIL WS-MONTH-CTR > WS-TERM-MONTHS\\n   181→               PERFORM 6100-CALC-MONTH-PAYMENT\\n   182→           END-PERFORM.\\n   183→      *\\n   184→       6100-CALC-MONTH-PAYMENT.\\n   185→           COMPUTE WS-INTEREST-PART ROUNDED =\\n   186→               WS-REMAINING-BALAN"]
