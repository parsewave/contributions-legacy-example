[20.229216, "o", "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-5-20251101\",\"id\":\"msg_016BZhLJqXNMfBhPyk1TZpEx\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01J1P7PmNqX58Gn1MqKtcsqJ\",\"name\":\"Bash\",\"input\":{\"command\":\"cat /app/src/INPUT.DAT\",\"description\":\"View INPUT.DAT file contents\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":122,\"cache_read_input_tokens\":18619,\"cache_creation\":{\"ephemeral_5m_input_tokens\":122,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":23,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"5759c808-4b46-4dd0-a243-b6cf037c11ca\"}\r\n"]
[21.05502, "o", "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-5-20251101\",\"id\":\"msg_016BZhLJqXNMfBhPyk1TZpEx\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Y59h7yHkQKX7RrTgW4Fipb\",\"name\":\"Bash\",\"input\":{\"command\":\"mkdir -p /app/data\",\"description\":\"Create data directory for output\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":122,\"cache_read_input_tokens\":18619,\"cache_creation\":{\"ephemeral_5m_input_tokens\":122,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":146,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"5b931f4a-239a-4b02-b121-c281499e5a82\"}\r\n"]
[22.697717, "o", "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01J1P7PmNqX58Gn1MqKtcsqJ\",\"type\":\"tool_result\",\"content\":\"APP0000001;Williams David Robert         ;2000000000;3500000000;0500000000;20;00550\\nAPP0000002;John Smith Clark              ;0000005000;0000004000;0000003500;01;00550\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"a83ca132-0698-46b7-8142-70a5cc915e46\",\"tool_use_result\":{\"stdout\":\"APP0000001;Williams David Robert         ;2000000000;3500000000;0500000000;20;00550\\nAPP0000002;John Smith Clark              ;0000005000;0000004000;0000003500;01;00550\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false}}\r\n"]
[24.275469, "o", "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Y59h7yHkQKX7RrTgW4Fipb\",\"type\":\"tool_result\",\"content\":\"\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"ed63f61d-80b4-4f34-863c-296e6849660e\",\"tool_use_result\":{\"stdout\":\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false}}\r\n"]
[27.962214, "o", "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-5-20251101\",\"id\":\"msg_011JAEFtQ6yj3HvHqchfFbuV\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now I understand the input format. Let me create the COBOL program:\"}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":272,\"cache_read_input_tokens\":18741,\"cache_creation\":{\"ephemeral_5m_input_tokens\":272,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"6bb75856-b625-407a-a8a4-73f74b9fa02a\"}\r\n"]
[75.358866, "o", "{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-5-20251101\",\"id\":\"msg_011JAEFtQ6yj3HvHqchfFbuV\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_017F1FWM1M9gizDkSJgH1Qzn\",\"name\":\"Write\",\"input\":{\"file_path\":\"/app/src/program.cbl\",\"content\":\"       IDENTIFICATION DIVISION.\\n       PROGRAM-ID. MORTGAGE-PROCESSOR.\\n\\n       ENVIRONMENT DIVISION.\\n       INPUT-OUTPUT SECTION.\\n       FILE-CONTROL.\\n           SELECT INPUT-FILE ASSIGN TO \\\"INPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-INPUT-STATUS.\\n           SELECT OUTPUT-FILE ASSIGN TO \\\"../data/OUTPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-OUTPUT-STATUS.\\n\\n       DATA DIVISION.\\n       FILE SECTION.\\n       FD  INPUT-FILE.\\n       01  INPUT-RECORD                    PIC X(200).\\n\\n       FD  OUTPUT-FILE.\\n       01  OUTPUT-RECORD                   PIC X(80).\\n\\n       WORKING-STORAGE SECTION.\\n       01  WS-INPUT-STATUS          "]
[75.359147, "o", "       PIC XX.\\n       01  WS-OUTPUT-STATUS                PIC XX.\\n       01  WS-EOF                          PIC 9 VALUE 0.\\n\\n       01  WS-INPUT-DATA.\\n           05  WS-ID                       PIC X(10).\\n           05  WS-NAME                     PIC X(30).\\n           05  WS-LOAN-AMOUNT              PIC 9(10).\\n           05  WS-PROPERTY-VALUE           PIC 9(10).\\n           05  WS-DOWN-PAYMENT             PIC 9(10).\\n           05  WS-TERM                     PIC 9(2).\\n           05  WS-RATE                     PIC 9(3)V9(2).\\n\\n       01  WS-CALCULATIONS.\\n           05  WS-MIN-DOWN                 PIC 9(12)V99.\\n           05  WS-MONTHLY-RATE             PIC 9V9(10).\\n           05  WS-MONTHLY-PAYMENT          PIC 9(10)V99.\\n           05  WS-TERM-MONTHS              PIC 9(4).\\n           05  WS-INTEREST-PART            PIC 9(10)V99.\\n           05  WS-PRINCIPAL-PART           PIC 9(10)V99.\\n           05  WS-REMAINING-BALANCE        PIC 9(12)V99.\\n           05  WS-LOAN-AMT-NUM             PIC 9"]
[75.359246, "o", "(12)V99.\\n           05  WS-TEMP-CALC                PIC 9(10)V9(10).\\n           05  WS-POWER-RESULT             PIC 9(10)V9(10).\\n           05  WS-DENOMINATOR              PIC 9(10)V9(10).\\n\\n       01  WS-MONTH-COUNTER                PIC 9(4).\\n\\n       01  WS-OUTPUT-DENY.\\n           05  WS-OUT-ID-D                 PIC X(10).\\n           05  WS-OUT-STATUS-D             PIC X(5).\\n           05  WS-OUT-REASON               PIC X(50).\\n\\n       01  WS-OUTPUT-APPROVE.\\n           05  WS-OUT-ID-A                 PIC X(10).\\n           05  WS-OUT-STATUS-A             PIC X(5).\\n\\n       01  WS-OUTPUT-SCHEDULE.\\n           05  WS-OUT-MON-NUM              PIC 9(3).\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-PAYMENT              PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-INTEREST             PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-PRINCIPAL            PIC 9"]
[75.35933, "o", "(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-REMAINING            PIC 9(10).99.\\n\\n       01  WS-PARSE-PTR                    PIC 99.\\n       01  WS-FIELD-NUM                    PIC 9.\\n       01  WS-TEMP-STR                     PIC X(50).\\n       01  WS-TEMP-PTR                     PIC 99.\\n       01  WS-CHAR                         PIC X.\\n       01  WS-INPUT-LEN                    PIC 999.\\n\\n       PROCEDURE DIVISION.\\n       MAIN-PROCEDURE.\\n           PERFORM OPEN-FILES\\n           PERFORM PROCESS-RECORDS UNTIL WS-EOF = 1\\n           PERFORM CLOSE-FILES\\n           STOP RUN.\\n\\n       OPEN-FILES.\\n           OPEN INPUT INPUT-FILE\\n           IF WS-INPUT-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING INPUT FILE: \\\" WS-INPUT-STATUS\\n               STOP RUN\\n           END-IF\\n           OPEN OUTPUT OUTPUT-FILE\\n           IF WS-OUTPUT-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING OUTPUT FILE: \\\" WS-OUTPUT-STATUS\\n               ST"]
[75.359412, "o", "OP RUN\\n           END-IF.\\n\\n       CLOSE-FILES.\\n           CLOSE INPUT-FILE\\n           CLOSE OUTPUT-FILE.\\n\\n       PROCESS-RECORDS.\\n           READ INPUT-FILE INTO INPUT-RECORD\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\\n\\n       PARSE-INPUT-RECORD.\\n           INITIALIZE WS-INPUT-DATA\\n           MOVE 1 TO WS-PARSE-PTR\\n           MOVE 1 TO WS-FIELD-NUM\\n           MOVE SPACES TO WS-TEMP-STR\\n           MOVE 1 TO WS-TEMP-PTR\\n           MOVE FUNCTION LENGTH(FUNCTION TRIM(INPUT-RECORD))\\n               TO WS-INPUT-LEN\\n\\n           PERFORM VARYING WS-PARSE-PTR FROM 1 BY 1\\n               UNTIL WS-PARSE-PTR > WS-INPUT-LEN\\n               MOVE INPUT-RECORD(WS-PARSE-PTR:1) TO WS-CHAR\\n               IF WS-CHAR = \\\";\\\"\\n                   PERFORM STORE-FIELD\\n                   ADD 1 TO WS-FIELD-NUM\\n                   MOVE SPACES TO WS-TEMP-STR\\n "]
[75.359478, "o", "                  MOVE 1 TO WS-TEMP-PTR\\n               ELSE\\n                   MOVE WS-CHAR TO WS-TEMP-STR(WS-TEMP-PTR:1)\\n                   ADD 1 TO WS-TEMP-PTR\\n               END-IF\\n           END-PERFORM\\n           PERFORM STORE-FIELD.\\n\\n       STORE-FIELD.\\n           EVALUATE WS-FIELD-NUM\\n               WHEN 1\\n                   MOVE WS-TEMP-STR(1:10) TO WS-ID\\n               WHEN 2\\n                   MOVE WS-TEMP-STR(1:30) TO WS-NAME\\n               WHEN 3\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-LOAN-AMOUNT\\n               WHEN 4\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-PROPERTY-VALUE\\n               WHEN 5\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-DOWN-PAYMENT\\n               WHEN 6\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-TERM\\n               WHEN 7\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-RATE\\n           END-EVALUATE.\\n\\n       VALIDATE-APPLICATION.\\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PR"]
[75.359543, "o", "OPERTY-VALUE * 0.15\\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n               PERFORM WRITE-DENIAL\\n           ELSE\\n               PERFORM PROCESS-APPROVAL\\n           END-IF.\\n\\n       WRITE-DENIAL.\\n           INITIALIZE WS-OUTPUT-DENY\\n           MOVE WS-ID TO WS-OUT-ID-D\\n           MOVE \\\"DENY \\\" TO WS-OUT-STATUS-D\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\" TO WS-OUT-REASON\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-DENY.\\n\\n       PROCESS-APPROVAL.\\n           INITIALIZE WS-OUTPUT-APPROVE\\n           MOVE WS-ID TO WS-OUT-ID-A\\n           MOVE \\\"APPRO\\\" TO WS-OUT-STATUS-A\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE\\n\\n           COMPUTE WS-TERM-MONTHS = WS-TERM * 12\\n           MOVE WS-LOAN-AMOUNT TO WS-LOAN-AMT-NUM\\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\\n           COMPUTE WS-POWER-RESULT ROUNDED =\\n               (1 + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\\n           COMPUTE WS-DENOMINATOR ROUNDED = 1 - WS-POWER-RESULT\\n           COMPUTE WS-MON"]
[75.359607, "o", "THLY-PAYMENT ROUNDED =\\n               WS-LOAN-AMT-NUM * WS-MONTHLY-RATE / WS-DENOMINATOR\\n\\n           MOVE WS-LOAN-AMT-NUM TO WS-REMAINING-BALANCE\\n           PERFORM GENERATE-SCHEDULE\\n               VARYING WS-MONTH-COUNTER FROM 1 BY 1\\n               UNTIL WS-MONTH-COUNTER > WS-TERM-MONTHS.\\n\\n       GENERATE-SCHEDULE.\\n           COMPUTE WS-INTEREST-PART ROUNDED =\\n               WS-REMAINING-BALANCE * WS-MONTHLY-RATE\\n           COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n               WS-MONTHLY-PAYMENT - WS-INTEREST-PART\\n           COMPUTE WS-REMAINING-BALANCE ROUNDED =\\n               WS-REMAINING-BALANCE - WS-PRINCIPAL-PART\\n\\n           IF WS-REMAINING-BALANCE < 0\\n               MOVE 0 TO WS-REMAINING-BALANCE\\n           END-IF\\n\\n           INITIALIZE WS-OUTPUT-SCHEDULE\\n           MOVE WS-MONTH-COUNTER TO WS-OUT-MON-NUM\\n           MOVE WS-MONTHLY-PAYMENT TO WS-OUT-PAYMENT\\n           MOVE WS-INTEREST-PART TO WS-OUT-INTEREST\\n           MOVE WS-PRINCIPAL-PART TO WS-OUT-PRINCIPAL\\n           MOVE WS-"]
[75.359671, "o", "REMAINING-BALANCE TO WS-OUT-REMAINING\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\\n\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"cache_creation_input_tokens\":272,\"cache_read_input_tokens\":18741,\"cache_creation\":{\"ephemeral_5m_input_tokens\":272,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":2758,\"service_tier\":\"standard\"},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"104ced7a-120c-4ba0-8b0f-9309832d277e\"}\r\n"]
[75.398187, "o", "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017F1FWM1M9gizDkSJgH1Qzn\",\"type\":\"tool_result\",\"content\":\"File created successfully at: /app/src/program.cbl\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3b29978c-b06c-4817-86b1-40feacb81a85\",\"uuid\":\"5bf7a245-2ad1-4993-bc06-ed7c97daaa30\",\"tool_use_result\":{\"type\":\"create\",\"filePath\":\"/app/src/program.cbl\",\"content\":\"       IDENTIFICATION DIVISION.\\n       PROGRAM-ID. MORTGAGE-PROCESSOR.\\n\\n       ENVIRONMENT DIVISION.\\n       INPUT-OUTPUT SECTION.\\n       FILE-CONTROL.\\n           SELECT INPUT-FILE ASSIGN TO \\\"INPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-INPUT-STATUS.\\n           SELECT OUTPUT-FILE ASSIGN TO \\\"../data/OUTPUT.DAT\\\"\\n               ORGANIZATION IS LINE SEQUENTIAL\\n               FILE STATUS IS WS-OUTPUT-STATUS.\\n\\n       DATA DIVISION.\\n       FILE SECTION.\\n       FD  INPUT-FILE.\\n       01  INPUT-RECORD                    PIC X(200).\\n\\n       FD  OUTPUT-FILE.\\n       01  O"]
[75.398241, "o", "UTPUT-RECORD                   PIC X(80).\\n\\n       WORKING-STORAGE SECTION.\\n       01  WS-INPUT-STATUS                 PIC XX.\\n       01  WS-OUTPUT-STATUS                PIC XX.\\n       01  WS-EOF                          PIC 9 VALUE 0.\\n\\n       01  WS-INPUT-DATA.\\n           05  WS-ID                       PIC X(10).\\n           05  WS-NAME                     PIC X(30).\\n           05  WS-LOAN-AMOUNT              PIC 9(10).\\n           05  WS-PROPERTY-VALUE           PIC 9(10).\\n           05  WS-DOWN-PAYMENT             PIC 9(10).\\n           05  WS-TERM                     PIC 9(2).\\n           05  WS-RATE                     PIC 9(3)V9(2).\\n\\n       01  WS-CALCULATIONS.\\n           05  WS-MIN-DOWN                 PIC 9(12)V99.\\n           05  WS-MONTHLY-RATE             PIC 9V9(10).\\n           05  WS-MONTHLY-PAYMENT          PIC 9(10)V99.\\n           05  WS-TERM-MONTHS              PIC 9(4).\\n           05  WS-INTEREST-PART            PIC 9(10)V99.\\n           05  WS-PRINCIPAL-PART           PIC 9(1"]
[75.398252, "o", "0)V99.\\n           05  WS-REMAINING-BALANCE        PIC 9(12)V99.\\n           05  WS-LOAN-AMT-NUM             PIC 9(12)V99.\\n           05  WS-TEMP-CALC                PIC 9(10)V9(10).\\n           05  WS-POWER-RESULT             PIC 9(10)V9(10).\\n           05  WS-DENOMINATOR              PIC 9(10)V9(10).\\n\\n       01  WS-MONTH-COUNTER                PIC 9(4).\\n\\n       01  WS-OUTPUT-DENY.\\n           05  WS-OUT-ID-D                 PIC X(10).\\n           05  WS-OUT-STATUS-D             PIC X(5).\\n           05  WS-OUT-REASON               PIC X(50).\\n\\n       01  WS-OUTPUT-APPROVE.\\n           05  WS-OUT-ID-A                 PIC X(10).\\n           05  WS-OUT-STATUS-A             PIC X(5).\\n\\n       01  WS-OUTPUT-SCHEDULE.\\n           05  WS-OUT-MON-NUM              PIC 9(3).\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-PAYMENT              PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-INTEREST             PIC 9(8).99"]
[75.398397, "o", ".\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-PRINCIPAL            PIC 9(8).99.\\n           05  FILLER                      PIC X VALUE SPACE.\\n           05  WS-OUT-REMAINING            PIC 9(10).99.\\n\\n       01  WS-PARSE-PTR                    PIC 99.\\n       01  WS-FIELD-NUM                    PIC 9.\\n       01  WS-TEMP-STR                     PIC X(50).\\n       01  WS-TEMP-PTR                     PIC 99.\\n       01  WS-CHAR                         PIC X.\\n       01  WS-INPUT-LEN                    PIC 999.\\n\\n       PROCEDURE DIVISION.\\n       MAIN-PROCEDURE.\\n           PERFORM OPEN-FILES\\n           PERFORM PROCESS-RECORDS UNTIL WS-EOF = 1\\n           PERFORM CLOSE-FILES\\n           STOP RUN.\\n\\n       OPEN-FILES.\\n           OPEN INPUT INPUT-FILE\\n           IF WS-INPUT-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING INPUT FILE: \\\" WS-INPUT-STATUS\\n               STOP RUN\\n           END-IF\\n           OPEN OUTPUT OUTPUT-FILE\\n           IF WS-OUTP"]
[75.398471, "o", "UT-STATUS NOT = \\\"00\\\"\\n               DISPLAY \\\"ERROR OPENING OUTPUT FILE: \\\" WS-OUTPUT-STATUS\\n               STOP RUN\\n           END-IF.\\n\\n       CLOSE-FILES.\\n           CLOSE INPUT-FILE\\n           CLOSE OUTPUT-FILE.\\n\\n       PROCESS-RECORDS.\\n           READ INPUT-FILE INTO INPUT-RECORD\\n               AT END\\n                   MOVE 1 TO WS-EOF\\n               NOT AT END\\n                   PERFORM PARSE-INPUT-RECORD\\n                   PERFORM VALIDATE-APPLICATION\\n           END-READ.\\n\\n       PARSE-INPUT-RECORD.\\n           INITIALIZE WS-INPUT-DATA\\n           MOVE 1 TO WS-PARSE-PTR\\n           MOVE 1 TO WS-FIELD-NUM\\n           MOVE SPACES TO WS-TEMP-STR\\n           MOVE 1 TO WS-TEMP-PTR\\n           MOVE FUNCTION LENGTH(FUNCTION TRIM(INPUT-RECORD))\\n               TO WS-INPUT-LEN\\n\\n           PERFORM VARYING WS-PARSE-PTR FROM 1 BY 1\\n               UNTIL WS-PARSE-PTR > WS-INPUT-LEN\\n               MOVE INPUT-RECORD(WS-PARSE-PTR:1) TO WS-CHAR\\n               IF WS-CHAR = \\\";\\\"\\n                "]
[75.398501, "o", "   PERFORM STORE-FIELD\\n                   ADD 1 TO WS-FIELD-NUM\\n                   MOVE SPACES TO WS-TEMP-STR\\n                   MOVE 1 TO WS-TEMP-PTR\\n               ELSE\\n                   MOVE WS-CHAR TO WS-TEMP-STR(WS-TEMP-PTR:1)\\n                   ADD 1 TO WS-TEMP-PTR\\n               END-IF\\n           END-PERFORM\\n           PERFORM STORE-FIELD.\\n\\n       STORE-FIELD.\\n           EVALUATE WS-FIELD-NUM\\n               WHEN 1\\n                   MOVE WS-TEMP-STR(1:10) TO WS-ID\\n               WHEN 2\\n                   MOVE WS-TEMP-STR(1:30) TO WS-NAME\\n               WHEN 3\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-LOAN-AMOUNT\\n               WHEN 4\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-PROPERTY-VALUE\\n               WHEN 5\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-DOWN-PAYMENT\\n               WHEN 6\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO WS-TERM\\n               WHEN 7\\n                   MOVE FUNCTION NUMVAL(WS-TEMP-STR) TO"]
[75.398511, "o", " WS-RATE\\n           END-EVALUATE.\\n\\n       VALIDATE-APPLICATION.\\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROPERTY-VALUE * 0.15\\n           IF WS-DOWN-PAYMENT < WS-MIN-DOWN\\n               PERFORM WRITE-DENIAL\\n           ELSE\\n               PERFORM PROCESS-APPROVAL\\n           END-IF.\\n\\n       WRITE-DENIAL.\\n           INITIALIZE WS-OUTPUT-DENY\\n           MOVE WS-ID TO WS-OUT-ID-D\\n           MOVE \\\"DENY \\\" TO WS-OUT-STATUS-D\\n           MOVE \\\"INSUFFICIENT FUNDS FOR DOWN PAYMENT\\\" TO WS-OUT-REASON\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-DENY.\\n\\n       PROCESS-APPROVAL.\\n           INITIALIZE WS-OUTPUT-APPROVE\\n           MOVE WS-ID TO WS-OUT-ID-A\\n           MOVE \\\"APPRO\\\" TO WS-OUT-STATUS-A\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-APPROVE\\n\\n           COMPUTE WS-TERM-MONTHS = WS-TERM * 12\\n           MOVE WS-LOAN-AMOUNT TO WS-LOAN-AMT-NUM\\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\\n           COMPUTE WS-POWER-RESULT ROUNDED =\\n               (1 + WS-MONTHLY-RATE) *"]
[75.398595, "o", "* (0 - WS-TERM-MONTHS)\\n           COMPUTE WS-DENOMINATOR ROUNDED = 1 - WS-POWER-RESULT\\n           COMPUTE WS-MONTHLY-PAYMENT ROUNDED =\\n               WS-LOAN-AMT-NUM * WS-MONTHLY-RATE / WS-DENOMINATOR\\n\\n           MOVE WS-LOAN-AMT-NUM TO WS-REMAINING-BALANCE\\n           PERFORM GENERATE-SCHEDULE\\n               VARYING WS-MONTH-COUNTER FROM 1 BY 1\\n               UNTIL WS-MONTH-COUNTER > WS-TERM-MONTHS.\\n\\n       GENERATE-SCHEDULE.\\n           COMPUTE WS-INTEREST-PART ROUNDED =\\n               WS-REMAINING-BALANCE * WS-MONTHLY-RATE\\n           COMPUTE WS-PRINCIPAL-PART ROUNDED =\\n               WS-MONTHLY-PAYMENT - WS-INTEREST-PART\\n           COMPUTE WS-REMAINING-BALANCE ROUNDED =\\n               WS-REMAINING-BALANCE - WS-PRINCIPAL-PART\\n\\n           IF WS-REMAINING-BALANCE < 0\\n               MOVE 0 TO WS-REMAINING-BALANCE\\n           END-IF\\n\\n           INITIALIZE WS-OUTPUT-SCHEDULE\\n           MOVE WS-MONTH-COUNTER TO WS-OUT-MON-NUM\\n           MOVE WS-MONTHLY-PAYMENT TO WS-OUT-PAYMENT\\n           MO"]
[75.398624, "o", "VE WS-INTEREST-PART TO WS-OUT-INTEREST\\n           MOVE WS-PRINCIPAL-PART TO WS-OUT-PRINCIPAL\\n           MOVE WS-REMAINING-BALANCE TO WS-OUT-REMAINING\\n           WRITE OUTPUT-RECORD FROM WS-OUTPUT-SCHEDULE.\\n\",\"structuredPatch\":[],\"originalFile\":null}}\r\n"]
