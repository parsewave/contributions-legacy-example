[?2004l[?2004h>                    COMPUTE WS-PAYMENT ROUNDED =
[?2004l[?2004h>                        WS-INTEREST + WS-PRINCIPAL
[?2004l[?2004h>                END-IF
[?2004l[?2004h> 
[?2004l[?2004h>                COMPUTE WS-BALANCE ROUNDED =
[?2004l[?2004h>                    WS-BALANCE - WS-PRINCIPAL
[?2004l[?2004h>                IF WS-BALANCE < 0
[?2004l[?2004h>                    MOVE 0 TO WS-BALANCE
[?2004l[?2004h>                END-IF
[?2004l[?2004h> 
[?2004l[?2004h>                PERFORM WRITE-SCHEDULE-LINE
[?2004l[?2004h> 
[?2004l[?2004h>            END-PERFORM.
