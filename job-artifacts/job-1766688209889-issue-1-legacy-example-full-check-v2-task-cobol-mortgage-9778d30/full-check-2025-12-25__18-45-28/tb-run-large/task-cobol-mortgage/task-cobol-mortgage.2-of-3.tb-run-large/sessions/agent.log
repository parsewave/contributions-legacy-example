[?2004l[?2004h>            END-IF
[?2004l[?2004h> 
[?2004l[?2004h>            COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200
[?2004l[?2004h>            MOVE WS-LOAN-AMT TO WS-BALANCE
[?2004l[?2004h> 
[?2004l[?2004h>            IF WS-MONTHLY-RATE = 0
