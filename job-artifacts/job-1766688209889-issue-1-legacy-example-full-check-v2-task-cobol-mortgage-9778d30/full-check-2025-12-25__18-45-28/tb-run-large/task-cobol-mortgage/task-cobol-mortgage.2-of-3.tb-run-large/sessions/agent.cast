[51.67224, "o", "cobc -x program.cbl -o program\r\n\u001b[?2004l\r"]
[51.688351, "o", "program.cbl:7: error: syntax error, unexpected Identifier, expecting COMMA\r\n"]
[51.688977, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
