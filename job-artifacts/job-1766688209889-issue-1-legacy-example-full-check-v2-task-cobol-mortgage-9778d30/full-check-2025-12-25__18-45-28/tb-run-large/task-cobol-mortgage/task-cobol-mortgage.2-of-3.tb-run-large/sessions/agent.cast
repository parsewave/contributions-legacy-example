[101.73713, "o", "           05  FILLER                   PIC X VALUE SPACE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.737338, "o", "           05  SL-PAY                   PIC 9(8).99.\r\n\u001b[?2004l\r \u001b[?2004h> "]
[101.737545, "o", "           05  FILLER                   PIC X VALUE SPACE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.737735, "o", "           05  SL-INT                   PIC 9(8).99.\r\n\u001b[?2004l\r-PAYMENT\u001b[?2004h> "]
[101.738003, "o", "           05  FILLER                   PIC X VALUE SPACE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.738192, "o", "           05  SL-PRN                   PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.738399, "o", "           05  FILLER                   PIC X VALUE SPACE.\r\n\u001b[?2004l\rC\r\n     \u001b[?2004h> "]
[101.738579, "o", "           05  SL-BAL                   PIC 9(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.738622, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.738701, "o", "       MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.738776, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.73884, "o", "                OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.73896, "o", "           PERFORM UNTIL WS-EOF = \"Y\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739011, "o", "               READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739089, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739183, "o", "                       MOVE \"Y\" TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739253, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739343, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739395, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.739412, "o", "> "]
[101.739463, "o", "           END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.739502, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.73954, "o", "> "]
[101.739586, "o", "           CLOSE IN-FILE OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739635, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.739649, "o", "> \r\n\u001b[?2004l\r"]
[101.739707, "o", "\u001b[?2004h> "]
[101.739726, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.739761, "o", "> "]
[101.739818, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.739895, "o", "           PERFORM CONVERT-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.73999, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740047, "o", "> "]
[101.740061, "o", "       PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740068, "o", "> "]
[101.740156, "o", "           MOVE SPACES TO WS-PARSED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740252, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74032, "o", "               INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740392, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740405, "o", "> "]
[101.740484, "o", "                    WS-LOAN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740562, "o", "                    WS-PROP-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74064, "o", "                    WS-DOWN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74074, "o", "                    WS-TERM-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.740823, "o", "                    WS-RATE-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74088, "o", "           END-UNSTRING.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.740894, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.74095, "o", "> "]
[101.740964, "o", "       CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741116, "o", "           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741238, "o", "           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74136, "o", "           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741518, "o", "           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.741534, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.741584, "o", "> "]
[101.74164, "o", "           IF WS-RATE-STR = SPACES\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.741652, "o", "> "]
[101.741737, "o", "               MOVE 0 TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741834, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.741899, "o", "               IF FUNCTION INDEX(WS-RATE-STR \".\") > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74205, "o", "                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742095, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742201, "o", "                   COMPUTE WS-RATE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74232, "o", "                       FUNCTION NUMVAL(WS-RATE-STR) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742391, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742467, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742506, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>        CHECK-APPLICATION.\r\n"]
[101.742564, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[101.742701, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742812, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.742899, "o", "               MOVE \"DENY \" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74306, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743138, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743195, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743279, "o", "               MOVE \"APPRO\" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743372, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743467, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743526, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743595, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.7437, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743801, "o", "           STRING WS-ID WS-STATUS WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743891, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.743989, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744047, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74411, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744127, "o", ">        WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744175, "o", "> "]
[101.744232, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744298, "o", "           STRING WS-ID WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74438, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744457, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74452, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744533, "o", "> "]
[101.744608, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.744619, "o", "> \r\n\u001b[?2004l\r"]
[101.744707, "o", "\u001b[?2004h>        BUILD-SCHEDULE.\r\n\u001b[?2004l\r"]
[101.744772, "o", "\u001b[?2004h> "]
[101.744847, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.744927, "o", "           IF WS-TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745013, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745061, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.745108, "o", "\u001b[?2004h> "]
[101.745222, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745313, "o", "           MOVE WS-LOAN-AMT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.745328, "o", "\u001b[?2004h> "]
[101.745416, "o", "           IF WS-MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745516, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745622, "o", "                   WS-LOAN-AMT / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745684, "o", "           ELSE\r\n\u001b[?2004l\r"]
[101.745694, "o", "\u001b[?2004h> "]
[101.745778, "o", "               COMPUTE WS-POW =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.745922, "o", "                   (WS-ONE + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746055, "o", "               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746151, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746274, "o", "                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746335, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746438, "o", "           PERFORM VARYING WS-MONTH FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.746457, "o", "> "]
[101.746562, "o", "               UNTIL WS-MONTH > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.746575, "o", "> "]
[101.746699, "o", "               COMPUTE WS-INTEREST ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746814, "o", "                   WS-BALANCE * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.746914, "o", "               COMPUTE WS-PRINCIPAL ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747027, "o", "                   WS-PAYMENT - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74714, "o", "               IF WS-MONTH = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74725, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747353, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74746, "o", "                       WS-INTEREST + WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747524, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747638, "o", "               COMPUTE WS-BALANCE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74775, "o", "                   WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747803, "o", "               IF WS-BALANCE < 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.747818, "o", "> "]
[101.747912, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.747989, "o", "               END-IF\r\n\u001b[?2004l\r"]
[101.748007, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748123, "o", "               PERFORM WRITE-SCHEDULE-LINE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.74818, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.748194, "o", "\u001b[?2004h> "]
[101.748292, "o", "       WRITE-SCHEDULE-LINE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748364, "o", "           MOVE WS-MONTH TO SL-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748449, "o", "           MOVE WS-PAYMENT TO SL-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748532, "o", "           MOVE WS-INTEREST TO SL-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748623, "o", "           MOVE WS-PRINCIPAL TO SL-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748732, "o", "           MOVE WS-BALANCE TO SL-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748827, "o", "           MOVE WS-SCHED-LINE TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748893, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.748907, "o", "COB\r\n\u001b[?2004l\r"]
[101.750445, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[101.833512, "i", "cobc -x program.cbl -o program\n"]
[101.83371, "o", "cobc -x program.cbl -o program\r\n\u001b[?2004l\r"]
