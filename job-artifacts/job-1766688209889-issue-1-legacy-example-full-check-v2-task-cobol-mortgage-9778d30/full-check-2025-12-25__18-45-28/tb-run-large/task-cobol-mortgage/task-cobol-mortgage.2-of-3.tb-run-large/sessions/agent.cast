[178.057508, "o", "\u001b[?2004h"]
[178.05755, "o", "> "]
[178.057585, "o", "           CLOSE IN-FILE OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.05769, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.057739, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.057836, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.057952, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058041, "o", "           PERFORM CONVERT-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058177, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058189, "o", "\r\n\u001b[?2004l\r"]
[178.058229, "o", "\u001b[?2004h> "]
[178.058329, "o", "       PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058441, "o", "           MOVE SPACES TO WS-PARSED\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.058456, "o", "> "]
[178.05859, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058707, "o", "               INTO WS-ID\r\n\u001b[?2004l\r"]
[178.058725, "o", "\u001b[?2004h> "]
[178.058822, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.058936, "o", "                    WS-LOAN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.059037, "o", "                    WS-PROP-STR\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.059049, "o", "> "]
[178.059179, "o", "                    WS-DOWN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.05929, "o", "                    WS-TERM-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.059392, "o", "                    WS-RATE-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.059488, "o", "           END-UNSTRING.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.059536, "o", "\u001b[?2004h> "]
[178.059605, "o", "       CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.059641, "o", "> "]
[178.059784, "o", "           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.059801, "o", "> "]
[178.059934, "o", "           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.059945, "o", "> "]
[178.060107, "o", "           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.060286, "o", "           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.060302, "o", "> \r\n\u001b[?2004l\r"]
[178.060341, "o", "\u001b[?2004h"]
[178.060366, "o", "> "]
[178.060433, "o", "           IF WS-RATE-STR = SPACES\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.060445, "o", "> "]
[178.060553, "o", "               MOVE 0 TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.060565, "o", "> "]
[178.060651, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.060798, "o", "               MOVE 0 TO WS-DOT-COUNT\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.060811, "o", "> "]
[178.060992, "o", "               INSPECT WS-RATE-STR TALLYING WS-DOT-COUNT FOR ALL \".\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.061103, "o", "               IF WS-DOT-COUNT > 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.061115, "o", "> "]
[178.061303, "o", "                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.061401, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.061527, "o", "                   COMPUTE WS-RATE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.061539, "o", "> "]
[178.061727, "o", "                       FUNCTION NUMVAL(WS-RATE-STR) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.061831, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.061918, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.061961, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[178.062019, "o", "> "]
[178.062068, "o", "       CHECK-APPLICATION.\r\n\u001b[?2004l\r"]
[178.062086, "o", "\u001b[?2004h> "]
[178.062266, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[178.062278, "o", "\u001b[?2004l\r"]
[178.062284, "o", "\u001b[?2004h"]
[178.062328, "o", "> "]
[178.062423, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.062438, "o", "> "]
[178.062544, "o", "               MOVE \"DENY \" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.062557, "o", "> "]
[178.062755, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.062862, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.062874, "o", "> "]
[178.062953, "o", "           ELSE\r\n\u001b[?2004l\r"]
[178.062964, "o", "\u001b[?2004h> "]
[178.063086, "o", "               MOVE \"APPRO\" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.063134, "o", "> "]
[178.063243, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.063362, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.063374, "o", "> "]
[178.06346, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.063472, "o", "> \r\n\u001b[?2004l\r"]
[178.063509, "o", "\u001b[?2004h> "]
[178.063564, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r"]
[178.063667, "o", "\u001b[?2004h> "]
[178.063684, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r"]
[178.063773, "o", "\u001b[?2004h> "]
[178.06389, "o", "           STRING WS-ID WS-STATUS WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064009, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.06408, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064167, "o", "           END-STRING\r\n\u001b[?2004l\r"]
[178.064246, "o", "\u001b[?2004h> "]
[178.064268, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r"]
[178.064332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064433, "o", "       WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064558, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064695, "o", "           STRING WS-ID WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.064791, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.064803, "o", "> "]
[178.06492, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065044, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065172, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.065202, "o", "\u001b[?2004h> "]
[178.065305, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065426, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065543, "o", "           IF WS-TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065625, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.065648, "o", "> "]
[178.065755, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.065768, "o", "\r\n\u001b[?2004l\r"]
[178.065861, "o", "\u001b[?2004h> "]
[178.065978, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.066135, "o", "           MOVE WS-LOAN-AMT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.066265, "o", "           IF WS-MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.066394, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.066406, "o", "> "]
[178.066546, "o", "                   WS-LOAN-AMT / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.066632, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.066793, "o", "               COMPUTE WS-POW =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.06697, "o", "                   (WS-ONE + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.067122, "o", "               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.067137, "o", "> "]
[178.067272, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.067284, "o", "> "]
[178.067445, "o", "                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.067546, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.067614, "o", "\u001b[?2004h> "]
[178.067755, "o", "           PERFORM VARYING WS-MONTH FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.067912, "o", "               UNTIL WS-MONTH > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.067935, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068078, "o", "               COMPUTE WS-INTEREST ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068242, "o", "                   WS-BALANCE * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068393, "o", "               COMPUTE WS-PRINCIPAL ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068543, "o", "                   WS-PAYMENT - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.068575, "o", "\u001b[?2004h> "]
[178.068708, "o", "               IF WS-MONTH = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068856, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.068952, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069097, "o", "                       WS-INTEREST + WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069219, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.06924, "o", "\r\n\u001b[?2004l\r"]
[178.069295, "o", "\u001b[?2004h> "]
[178.069419, "o", "               COMPUTE WS-BALANCE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069563, "o", "                   WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069676, "o", "               IF WS-BALANCE < 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069802, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.069856, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[178.069938, "o", "> "]
[178.070028, "o", "               PERFORM WRITE-SCHEDULE-LINE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.070041, "o", "\u001b[?2004h> "]
[178.070133, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.070161, "o", "\u001b[?2004h> "]
[178.07027, "o", "       WRITE-SCHEDULE-LINE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.070383, "o", "           MOVE WS-MONTH TO SL-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.070493, "o", "           MOVE WS-PAYMENT TO SL-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.070615, "o", "           MOVE WS-INTEREST TO SL-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.070776, "o", "           MOVE WS-PRINCIPAL TO SL-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.070947, "o", "           MOVE WS-BALANCE TO SL-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.071097, "o", "           MOVE WS-SCHED-LINE TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.071218, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.07125, "o", "COB\r\n\u001b[?2004l\r"]
[178.072746, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
