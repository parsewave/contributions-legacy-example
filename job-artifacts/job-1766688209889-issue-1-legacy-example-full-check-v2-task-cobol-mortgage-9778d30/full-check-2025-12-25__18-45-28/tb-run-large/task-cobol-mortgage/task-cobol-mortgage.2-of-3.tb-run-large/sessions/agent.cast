[136.774897, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.774961, "o", "           PERFORM PARSE-INPUT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775029, "o", "           PERFORM CONVERT-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.775061, "o", "> "]
[136.775147, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.775158, "o", "> \r\n\u001b[?2004l\r"]
[136.775234, "o", "\u001b[?2004h>        PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775315, "o", "           MOVE SPACES TO WS-PARSED\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775414, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.775425, "o", "> "]
[136.775498, "o", "               INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775558, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775635, "o", "                    WS-LOAN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775769, "o", "                    WS-PROP-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77585, "o", "                    WS-DOWN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.775933, "o", "                    WS-TERM-STR\r\n\u001b[?2004l\r"]
[136.775947, "o", "\u001b[?2004h> "]
[136.77602, "o", "                    WS-RATE-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.7761, "o", "           END-UNSTRING.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.776184, "o", "\u001b[?2004h>        CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.776317, "o", "           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.776436, "o", "           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.776605, "o", "           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.776758, "o", "           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.77677, "o", "\u001b[?2004h> "]
[136.776865, "o", "           IF WS-RATE-STR = SPACES\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77695, "o", "               MOVE 0 TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777034, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.77706, "o", "> "]
[136.777128, "o", "               IF FUNCTION INDEX(WS-RATE-STR, \".\") > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777255, "o", "                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777328, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777421, "o", "                   COMPUTE WS-RATE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777548, "o", "                       FUNCTION NUMVAL(WS-RATE-STR) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777719, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h>            END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.777784, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777851, "o", "       CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.777976, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.777987, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778114, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778196, "o", "               MOVE \"DENY \" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778337, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778422, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778487, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77857, "o", "               MOVE \"APPRO\" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77866, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778771, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77884, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.778854, "o", "\u001b[?2004h> "]
[136.778953, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.778967, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.778976, "o", "> "]
[136.779093, "o", "           STRING WS-ID WS-STATUS WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779175, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779252, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.779266, "o", "> "]
[136.779344, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.779361, "o", "> "]
[136.779448, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>        WRITE-APPRO.\r\n\u001b[?2004l\r"]
[136.779462, "o", "\u001b[?2004h> "]
[136.779539, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779642, "o", "           STRING WS-ID WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.77975, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779817, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779895, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.779958, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780061, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780138, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780222, "o", "           IF WS-TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780302, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780379, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780528, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780634, "o", "           MOVE WS-LOAN-AMT TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.78075, "o", "           IF WS-MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780863, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780935, "o", "                   WS-LOAN-AMT / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.780986, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781064, "o", "               COMPUTE WS-POW =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781203, "o", "                   (WS-ONE + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781337, "o", "               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781429, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781562, "o", "                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781612, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781741, "o", "           PERFORM VARYING WS-MONTH FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.781849, "o", "               UNTIL WS-MONTH > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.781862, "o", "\u001b[?2004h> "]
[136.781979, "o", "               COMPUTE WS-INTEREST ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.782094, "o", "                   WS-BALANCE * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.782208, "o", "               COMPUTE WS-PRINCIPAL ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.782305, "o", "                   WS-PAYMENT - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[136.782319, "o", "\u001b[?2004l\r"]
[136.782401, "o", "\u001b[?2004h> "]
[136.782479, "o", "               IF WS-MONTH = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.782557, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.78271, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.7828, "o", "                       WS-INTEREST + WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.782867, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.782879, "o", "\u001b[?2004h> "]
[136.782978, "o", "               COMPUTE WS-BALANCE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783101, "o", "                   WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783164, "o", "               IF WS-BALANCE < 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.78326, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783321, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[136.783398, "o", "\u001b[?2004h> "]
[136.78348, "o", "               PERFORM WRITE-SCHEDULE-LINE\r\n\u001b[?2004l\r\u001b[?2004h"]
[136.783496, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783505, "o", "           END-PERFORM.\r\n\u001b[?2004l\r"]
[136.783591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.78361, "o", "       WRITE-SCHEDULE-LINE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783724, "o", "           MOVE WS-MONTH TO SL-MONTH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783816, "o", "           MOVE WS-PAYMENT TO SL-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.783905, "o", "           MOVE WS-INTEREST TO SL-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.784002, "o", "           MOVE WS-PRINCIPAL TO SL-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.784101, "o", "           MOVE WS-BALANCE TO SL-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.784194, "o", "           MOVE WS-SCHED-LINE TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[136.784269, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> COB\r\n\u001b[?2004l\r"]
[136.786086, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[136.861622, "i", "cobc -x program.cbl -o program\n"]
[136.861877, "o", "cobc -x program.cbl -o program\r\n\u001b[?2004l\r"]
[136.878249, "o", "program.cbl: in paragraph 'CONVERT-FIELDS':\r\nprogram.cbl:112: error: FUNCTION 'INDEX' unknown\r\n"]
[136.879109, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[137.855403, "i", "./program\n"]
[137.855614, "o", "./program\r\n\u001b[?2004l\r"]
[137.855977, "o", "bash: ./program: No such file or directory\r\n"]
[137.856284, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[138.85259, "i", "sed -n '1,120p' /app/data/OUTPUT.DAT\n"]
[138.852843, "o", "sed -n '1,120p' /app/data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[138.854581, "o", "\r\n"]
[138.85483, "o", "\u001b[?2004h"]
[138.854932, "m", "Episode 3: 5 commands"]
[138.854932, "o", "root@acf1ecf3cb49:/app/src# "]
[177.938606, "i", "cd /app/src\n"]
[177.938837, "o", "cd /app/src\r\n\u001b[?2004l\r"]
[177.938962, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[178.04268, "i", "cat > program.cbl <<'COB'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                       PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                      PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       77  WS-EOF                       PIC X VALUE \"N\".\n       77  WS-DOT-COUNT                 PIC 9(4) COMP VALUE 0.\n\n       01  WS-PARSED.\n           05  WS-ID                    PIC X(10).\n           05  WS-NAME                  PIC X(30).\n           05  WS-LOAN-STR              PIC X(40).\n           05  WS-PROP-STR              PIC X(40).\n           05  WS-DOWN-STR              PIC X(40).\n           05  WS-TERM-STR         "]
[178.042758, "i", "     PIC X(10).\n           05  WS-RATE-STR              PIC X(20).\n\n       01  WS-NUM.\n           05  WS-LOAN-AMT              PIC 9(13)V99 COMP-3.\n           05  WS-PROP-VAL              PIC 9(13)V99 COMP-3.\n           05  WS-DOWN-PAY              PIC 9(13)V99 COMP-3.\n           05  WS-MIN-DOWN              PIC 9(13)V99 COMP-3.\n           05  WS-RATE                  PIC 9(3)V9(5)  COMP-3.\n           05  WS-MONTHLY-RATE          PIC 9V9(9)     COMP-3.\n           05  WS-BALANCE               PIC 9(13)V99 COMP-3.\n           05  WS-PAYMENT               PIC 9(13)V99 COMP-3.\n           05  WS-INTEREST              PIC 9(13)V99 COMP-3.\n           05  WS-PRINCIPAL             PIC 9(13)V99 COMP-3.\n\n       01  WS-TERM.\n           05  WS-TERM-YEARS            PIC 9(3) COMP.\n           05  WS-TERM-MONTHS           PIC 9(5) COMP.\n           05  WS-MONTH                 PIC 9(5) COMP.\n\n       01  WS-FORMULA.\n           05  WS-ONE                   PIC 9V9(18) COMP-3 VALUE 1.\n           05  WS-POW                   PIC 9"]
[178.042909, "i", "V9(18) COMP-3.\n           05  WS-DENOM                 PIC 9V9(18) COMP-3.\n\n       01  WS-OUT.\n           05  WS-STATUS                PIC X(5).\n           05  WS-REASON                PIC X(50).\n\n       01  WS-SCHED-LINE.\n           05  SL-MONTH                 PIC 9(3).\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-PAY                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-INT                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-PRN                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-BAL                   PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE\n\n           PERFORM UNTIL WS-EOF = \"Y\"\n               READ IN-FILE\n                   AT END\n                       MOVE \"Y\" TO WS-EOF\n                   NOT AT END\n                       PERFORM PRO"]
[178.04293, "o", "cat > program.cbl <<'COB'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.042999, "i", "CESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE IN-FILE OUT-FILE\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-INPUT\n           PERFORM CONVERT-FIELDS\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-PARSED\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-STR\n                    WS-PROP-STR\n                    WS-DOWN-STR\n                    WS-TERM-STR\n                    WS-RATE-STR\n           END-UNSTRING.\n\n       CONVERT-FIELDS.\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\n           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\n\n           IF WS-RATE-STR = SPACES\n               MOVE 0 TO WS-RATE\n           ELSE\n               MOVE 0 TO WS-DOT-COUNT\n               INSPECT WS-RATE-STR TALLYING WS-DOT-COUNT FO"]
[178.04302, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r"]
[178.043086, "i", "R ALL \".\"\n               IF WS-DOT-COUNT > 0\n                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\n               ELSE\n                   COMPUTE WS-RATE ROUNDED =\n                       FUNCTION NUMVAL(WS-RATE-STR) / 100\n               END-IF\n           END-IF.\n\n       CHECK-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\n\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n               MOVE \"DENY \" TO WS-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               MOVE \"APPRO\" TO WS-STATUS\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS WS-REASON\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS\n               DELIMITED BY SIZE"]
[178.043105, "o", "\u001b[?2004h> "]
[178.043157, "i", "\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\n           IF WS-TERM-MONTHS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\n           MOVE WS-LOAN-AMT TO WS-BALANCE\n\n           IF WS-MONTHLY-RATE = 0\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN-AMT / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-POW =\n                   (WS-ONE + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\n               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\n           END-IF\n\n           PERFORM VARYING WS-MONTH FROM 1 BY 1\n               UNTIL WS-MONTH > WS-TERM-MONTHS\n\n               COMPUTE WS-INTEREST ROUNDED =\n                   WS-BALANCE * WS-MONTHLY-RATE\n               COMPUTE WS-PRINCIPAL ROUNDED =\n                   WS-"]
[178.04318, "o", "       PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[178.043218, "i", "PAYMENT - WS-INTEREST\n\n               IF WS-MONTH = WS-TERM-MONTHS\n                   MOVE WS-BALANCE TO WS-PRINCIPAL\n                   COMPUTE WS-PAYMENT ROUNDED =\n                       WS-INTEREST + WS-PRINCIPAL\n               END-IF\n\n               COMPUTE WS-BALANCE ROUNDED =\n                   WS-BALANCE - WS-PRINCIPAL\n               IF WS-BALANCE < 0\n                   MOVE 0 TO WS-BALANCE\n               END-IF\n\n               PERFORM WRITE-SCHEDULE-LINE\n\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           MOVE WS-MONTH TO SL-MONTH\n           MOVE WS-PAYMENT TO SL-PAY\n           MOVE WS-INTEREST TO SL-INT\n           MOVE WS-PRINCIPAL TO SL-PRN\n           MOVE WS-BALANCE TO SL-BAL\n           MOVE WS-SCHED-LINE TO OUT-REC\n           WRITE OUT-REC.\nCOB\n"]
[178.04327, "o", "> "]
[178.043355, "o", "       ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.043537, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r"]
[178.043554, "o", "\u001b[?2004h> "]
[178.043725, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\rS-RATE R\u001b[?2004h> "]
