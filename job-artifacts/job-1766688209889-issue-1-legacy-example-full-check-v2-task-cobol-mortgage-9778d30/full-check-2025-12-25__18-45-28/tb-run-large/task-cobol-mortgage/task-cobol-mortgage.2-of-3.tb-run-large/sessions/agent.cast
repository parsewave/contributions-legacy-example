[136.761444, "i", "     CLOSE IN-FILE OUT-FILE\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-INPUT\n           PERFORM CONVERT-FIELDS\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-PARSED\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-STR\n                    WS-PROP-STR\n                    WS-DOWN-STR\n                    WS-TERM-STR\n                    WS-RATE-STR\n           END-UNSTRING.\n\n       CONVERT-FIELDS.\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\n           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\n\n           IF WS-RATE-STR = SPACES\n               MOVE 0 TO WS-RATE\n           ELSE\n               IF FUNCTION INDEX(WS-RATE-STR, \".\") > 0\n                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\n               ELSE\n                   CO"]
[136.761458, "o", "    PIC 9(13)V99 COMP-3.\r\n           05  WS-PAYMENT            "]
[136.761609, "i", "MPUTE WS-RATE ROUNDED =\n                       FUNCTION NUMVAL(WS-RATE-STR) / 100\n               END-IF\n           END-IF.\n\n       CHECK-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\n\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n               MOVE \"DENY \" TO WS-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               MOVE \"APPRO\" TO WS-STATUS\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS WS-REASON\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS"]
