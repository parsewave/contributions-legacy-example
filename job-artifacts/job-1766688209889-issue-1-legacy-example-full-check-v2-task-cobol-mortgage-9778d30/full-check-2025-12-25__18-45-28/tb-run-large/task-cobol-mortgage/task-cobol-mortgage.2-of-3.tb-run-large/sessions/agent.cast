[102.828087, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[103.821621, "i", "sed -n '1,80p' /app/data/OUTPUT.DAT\n"]
[103.821839, "o", "sed -n '1,80p' /app/data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[103.823523, "o", "\r\n"]
[103.823823, "m", "Episode 2: 6 commands"]
[103.823823, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[136.554197, "i", "cd /app/src\n"]
[136.554392, "o", "cd /app/src\r\n\u001b[?2004l\r"]
[136.554538, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[136.65887, "i", "grep -n '^[>]' -n program.cbl | head\n"]
[136.659147, "o", "grep -n '^[>]' -n program.cbl | head\r\n\u001b[?2004l\r"]
[136.661289, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[136.761141, "i", "cat > program.cbl <<'COB'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                       PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                      PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       77  WS-EOF                       PIC X VALUE \"N\".\n\n       01  WS-PARSED.\n           05  WS-ID                    PIC X(10).\n           05  WS-NAME                  PIC X(30).\n           05  WS-LOAN-STR              PIC X(40).\n           05  WS-PROP-STR              PIC X(40).\n           05  WS-DOWN-STR              PIC X(40).\n           05  WS-TERM-STR              PIC X(10).\n           05  WS-RATE-STR              PIC X(2"]
[136.761299, "i", "0).\n\n       01  WS-NUM.\n           05  WS-LOAN-AMT              PIC 9(13)V99 COMP-3.\n           05  WS-PROP-VAL              PIC 9(13)V99 COMP-3.\n           05  WS-DOWN-PAY              PIC 9(13)V99 COMP-3.\n           05  WS-MIN-DOWN              PIC 9(13)V99 COMP-3.\n           05  WS-RATE                  PIC 9(3)V9(5)  COMP-3.\n           05  WS-MONTHLY-RATE          PIC 9V9(9)     COMP-3.\n           05  WS-BALANCE               PIC 9(13)V99 COMP-3.\n           05  WS-PAYMENT               PIC 9(13)V99 COMP-3.\n           05  WS-INTEREST              PIC 9(13)V99 COMP-3.\n           05  WS-PRINCIPAL             PIC 9(13)V99 COMP-3.\n\n       01  WS-TERM.\n           05  WS-TERM-YEARS            PIC 9(3) COMP.\n           05  WS-TERM-MONTHS           PIC 9(5) COMP.\n           05  WS-MONTH                 PIC 9(5) COMP.\n\n       01  WS-FORMULA.\n           05  WS-ONE                   PIC 9V9(18) COMP-3 VALUE 1.\n           05  WS-POW                   PIC 9V9(18) COMP-3.\n           05  WS-DENOM                 PIC 9V9("]
[136.761327, "o", "cat > program.cbl <<'COB'\r\n\u001b[?2004l\r"]
