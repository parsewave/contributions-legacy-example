[51.475411, "o", "> "]
[51.475473, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.475485, "o", "\u001b[?2004h> "]
[51.475551, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.475601, "o", "> "]
[51.475678, "o", "           PERFORM PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.475745, "o", "           PERFORM CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.475865, "o", "           PERFORM CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.475966, "o", "       PARSE-INPUT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476072, "o", "           MOVE SPACES TO WS-PARSED.\r\n\u001b[?2004l\r"]
[51.476088, "o", "\u001b[?2004h> "]
[51.476203, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476274, "o", "               INTO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476355, "o", "                    WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476434, "o", "                    WS-LOAN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476545, "o", "                    WS-PROP-STR\r\n\u001b[?2004l\r"]
[51.476556, "o", "\u001b[?2004h> "]
[51.476658, "o", "                    WS-DOWN-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476757, "o", "                    WS-TERM-STR\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.476772, "o", "> "]
[51.476868, "o", "                    WS-RATE-STR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.476941, "o", "           END-UNSTRING.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.476988, "o", "\u001b[?2004h> "]
[51.477057, "o", "       CONVERT-FIELDS.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.477159, "o", "           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.477292, "o", "           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.477416, "o", "           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.477555, "o", "           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.477576, "o", "> \r\n\u001b[?2004l\r"]
[51.477652, "o", "\u001b[?2004h> "]
[51.477726, "o", "           IF WS-RATE-STR = SPACES\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.477746, "o", "> "]
[51.477832, "o", "               MOVE 0 TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.477863, "o", "           ELSE\r\n\u001b[?2004l\r"]
[51.477876, "o", "\u001b[?2004h> "]
[51.477989, "o", "               IF WS-RATE-STR CONTAINS \".\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478131, "o", "                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.4782, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478323, "o", "                   COMPUTE WS-RATE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.47845, "o", "                       FUNCTION NUMVAL(WS-RATE-STR) / 100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478474, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478559, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478655, "o", "       CHECK-APPLICATION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.478836, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.478891, "o", "\u001b[?2004h> "]
[51.478963, "o", "           IF WS-DOWN-PAY < WS-MIN-DOWN\r\n\u001b[?2004l\r"]
[51.479033, "o", "\u001b[?2004h> "]
[51.479095, "o", "               MOVE \"DENY \" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.47924, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.479337, "o", "               PERFORM WRITE-DENY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.479392, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.479461, "o", "               MOVE \"APPRO\" TO WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.479519, "o", "> "]
[51.479535, "o", "               PERFORM WRITE-APPRO\r\n\u001b[?2004l\r"]
[51.479568, "o", "\u001b[?2004h> "]
[51.479657, "o", "               PERFORM BUILD-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.479761, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.479851, "o", "       WRITE-DENY.\r\n\u001b[?2004l\r"]
[51.479894, "o", "\u001b[?2004h> "]
[51.47998, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480066, "o", "           STRING WS-ID WS-STATUS SPACE WS-REASON\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.480139, "o", "> "]
[51.480182, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48022, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480283, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48035, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480365, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.480402, "o", "> "]
[51.480444, "o", "       WRITE-APPRO.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480523, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.4806, "o", "           STRING WS-ID WS-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.480638, "o", "> "]
[51.480708, "o", "               DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480836, "o", "               INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48089, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.480948, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.480964, "o", "\u001b[?2004h> "]
[51.481029, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481149, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481242, "o", "           IF WS-TERM-MONTHS <= 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48132, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481375, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.481415, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.481455, "o", "> "]
[51.481542, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481646, "o", "           MOVE WS-LOAN-AMT TO WS-BALANCE.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.481684, "o", "\u001b[?2004h> "]
[51.48178, "o", "           IF WS-MONTHLY-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481936, "o", "               COMPUTE WS-PAYMENT ROUNDED = WS-LOAN-AMT / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.481989, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482108, "o", "               COMPUTE WS-POW = (WS-ONE + WS-MONTHLY-RATE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482207, "o", "                   ** (0 - WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48233, "o", "               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482432, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482554, "o", "                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482603, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.482756, "o", "           PERFORM VARYING WS-MONTH FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48287, "o", "               UNTIL WS-MONTH > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.482886, "o", "> "]
[51.483047, "o", "               COMPUTE WS-INTEREST ROUNDED = WS-BALANCE * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.483238, "o", "               COMPUTE WS-PRINCIPAL ROUNDED = WS-PAYMENT - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[51.483251, "o", "> "]
[51.483378, "o", "               IF WS-MONTH = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.483484, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.483631, "o", "                   COMPUTE WS-PAYMENT ROUNDED = WS-INTEREST + WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.483683, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.483733, "o", "\u001b[?2004h> "]
[51.483877, "o", "               COMPUTE WS-BALANCE ROUNDED = WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.483971, "o", "               IF WS-BALANCE < 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484073, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484137, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484247, "o", "               PERFORM WRITE-SCHEDULE-LINE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.484314, "o", "\u001b[?2004h> "]
[51.484387, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.484431, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484504, "o", "       WRITE-SCHEDULE-LINE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48459, "o", "           MOVE WS-MONTH TO SL-MONTH.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484694, "o", "           MOVE WS-PAYMENT TO SL-PAY.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484793, "o", "           MOVE WS-INTEREST TO SL-INT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484909, "o", "           MOVE WS-PRINCIPAL TO SL-PRN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.484998, "o", "           MOVE WS-BALANCE TO SL-BAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.48509, "o", "           MOVE WS-SCHED-LINE TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.485147, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> COB\r\n"]
[51.485159, "o", "\u001b[?2004l\r"]
[51.486933, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app# "]
[51.577053, "i", "cd /app/src\n"]
[51.577255, "o", "cd /app/src\r\n\u001b[?2004l\r"]
[51.577371, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
