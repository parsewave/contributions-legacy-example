[53.670378, "o", "sed -n '1,80p' /app/data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[53.671568, "o", "\r\n"]
[53.671825, "m", "Episode 1: 6 commands"]
[53.671825, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[101.519111, "i", "cd /app/src\n"]
[101.519318, "o", "cd /app/src\r\n\u001b[?2004l\r"]
[101.519481, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[101.612983, "i", "nl -ba program.cbl | sed -n '1,120p'\n"]
[101.613199, "o", "nl -ba program.cbl | sed -n '1,120p'\r\n\u001b[?2004l\r"]
[101.614918, "o", "     1\t       IDENTIFICATION DIVISION.\r\n     2\t       PROGRAM-ID. PROGRAM.\r\n     3\t\r\n     4\t       ENVIRONMENT DIVISION.\r\n     5\t       CONFIGURATION SECTION.\r\n     6\t       SPECIAL-NAMES.\r\n     7\t           DECIMAL-POINT IS DOT.\r\n     8\t\r\n     9\t       INPUT-OUTPUT SECTION.\r\n    10\t       FILE-CONTROL.\r\n    11\t           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\r\n    12\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    13\t           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n    14\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    15\t\r\n    16\t       DATA DIVISION.\r\n    17\t       FILE SECTION.\r\n    18\t       FD  IN-FILE.\r\n    19\t       01  IN-REC                      PIC X(256).\r\n    20\t\r\n    21\t       FD  OUT-FILE.\r\n    22\t       01  OUT-REC                     PIC X(200).\r\n    23\t\r\n"]
[101.615085, "o", "    24\t       WORKING-STORAGE SECTION.\r\n    25\t       77  WS-EOF                      PIC X VALUE \"N\".\r\n    26\t\r\n    27\t       01  WS-PARSED.\r\n    28\t           05  WS-ID                   PIC X(10).\r\n    29\t           05  WS-NAME                 PIC X(30).\r\n    30\t           05  WS-LOAN-STR             PIC X(40).\r\n    31\t           05  WS-PROP-STR             PIC X(40).\r\n    32\t           05  WS-DOWN-STR             PIC X(40).\r\n    33\t           05  WS-TERM-STR             PIC X(10).\r\n    34\t           05  WS-RATE-STR             PIC X(20).\r\n    35\t\r\n    36\t       01  WS-NUM.\r\n    37\t           05  WS-LOAN-AMT             PIC 9(11)V99 COMP-3.\r\n    38\t           05  WS-PROP-VAL             PIC 9(11)V99 COMP-3.\r\n    39\t           05  WS-DOWN-PAY             PIC 9(11)V99 COMP-3.\r\n    40\t           05  WS-MIN-DOWN             PIC 9(11)V99 COMP-3.\r\n"]
[101.61521, "o", "    41\t           05  WS-RATE                 PIC 9(3)V9(5) COMP-3.\r\n    42\t           05  WS-MONTHLY-RATE         PIC 9V9(9) COMP-3.\r\n    43\t           05  WS-BALANCE              PIC 9(11)V99 COMP-3.\r\n    44\t           05  WS-PAYMENT              PIC 9(11)V99 COMP-3.\r\n    45\t           05  WS-INTEREST             PIC 9(11)V99 COMP-3.\r\n    46\t           05  WS-PRINCIPAL            PIC 9(11)V99 COMP-3.\r\n    47\t\r\n    48\t       01  WS-TERM.\r\n    49\t           05  WS-TERM-YEARS           PIC 9(3) COMP.\r\n    50\t           05  WS-TERM-MONTHS          PIC 9(5) COMP.\r\n    51\t           05  WS-MONTH                PIC 9(5) COMP.\r\n    52\t\r\n    53\t       01  WS-FORMULA.\r\n    54\t           05  WS-ONE                  PIC 9V9(9) COMP-3 VALUE 1.\r\n    55\t           05  WS-DENOM                PIC 9V9(9) COMP-3.\r\n    56\t           05  WS-POW                  PIC 9V9(9) COMP-3.\r\n    57\t\r\n    58\t       01  WS-OUT.\r\n    59\t           05  WS-STATUS               PIC X(5).\r\n    60\t           05  WS-REASON               PIC X(50)"]
[101.615293, "o", ".\r\n    61\t\r\n    62\t       01  WS-SCHED-LINE.\r\n    63\t           05  SL-MONTH                PIC 9(3).\r\n    64\t           05  FILLER                  PIC X VALUE SPACE.\r\n    65\t           05  SL-PAY                  PIC 9(8).99.\r\n    66\t           05  FILLER                  PIC X VALUE SPACE.\r\n    67\t           05  SL-INT                  PIC 9(8).99.\r\n    68\t           05  FILLER                  PIC X VALUE SPACE.\r\n    69\t           05  SL-PRN                  PIC 9(8).99.\r\n    70\t           05  FILLER                  PIC X VALUE SPACE.\r\n    71\t           05  SL-BAL                  PIC 9(10).99.\r\n    72\t\r\n    73\t       PROCEDURE DIVISION.\r\n    74\t       MAIN.\r\n    75\t           OPEN INPUT IN-FILE\r\n    76\t                OUTPUT OUT-FILE.\r\n    77\t\r\n    78\t           PERFORM UNTIL WS-EOF = \"Y\"\r\n    79\t               READ IN-FILE\r\n    80\t                   AT END\r\n    81\t                       MOVE \"Y\" TO WS-EOF\r\n    82\t                   NOT AT END\r\n    83\t                       PERFORM PROCESS-REC\r\n    84\t "]
[101.61537, "o", "              END-READ\r\n    85\t           END-PERFORM.\r\n    86\t\r\n    87\t           CLOSE IN-FILE OUT-FILE.\r\n    88\t           STOP RUN.\r\n    89\t\r\n    90\t       PROCESS-REC.\r\n    91\t           PERFORM PARSE-INPUT.\r\n    92\t           PERFORM CONVERT-FIELDS.\r\n    93\t           PERFORM CHECK-APPLICATION.\r\n    94\t\r\n    95\t       PARSE-INPUT.\r\n    96\t           MOVE SPACES TO WS-PARSED.\r\n    97\t           UNSTRING IN-REC DELIMITED BY \";\"\r\n    98\t               INTO WS-ID\r\n    99\t                    WS-NAME\r\n   100\t                    WS-LOAN-STR\r\n   101\t                    WS-PROP-STR\r\n   102\t                    WS-DOWN-STR\r\n   103\t                    WS-TERM-STR\r\n   104\t                    WS-RATE-STR\r\n   105\t           END-UNSTRING.\r\n   106\t\r\n   107\t       CONVERT-FIELDS.\r\n   108\t           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT.\r\n   109\t           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL.\r\n   110\t           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY.\r\n   111\t           MOVE FUNCTION NUMVA"]
[101.615456, "o", "L(WS-TERM-STR) TO WS-TERM-YEARS.\r\n   112\t\r\n   113\t           IF WS-RATE-STR = SPACES\r\n   114\t               MOVE 0 TO WS-RATE\r\n   115\t           ELSE\r\n   116\t               IF WS-RATE-STR CONTAINS \".\"\r\n   117\t                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\r\n   118\t               ELSE\r\n   119\t                   COMPUTE WS-RATE ROUNDED =\r\n   120\t                       FUNCTION NUMVAL(WS-RATE-STR) / 100\r\n"]
[101.615607, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app/src# "]
[101.726372, "i", "cat > program.cbl <<'COB'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       CONFIGURATION SECTION.\n       SPECIAL-NAMES.\n           DECIMAL-POINT IS DOT.\n\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                       PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                      PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       77  WS-EOF                       PIC X VALUE \"N\".\n\n       01  WS-PARSED.\n           05  WS-ID                    PIC X(10).\n           05  WS-NAME                  PIC X(30).\n           05  WS-LOAN-STR              PIC X(40).\n           05  WS-PROP-STR              PIC X(40).\n           05  WS-DOWN-STR              PIC X(40).\n           0"]
[101.72656, "i", "5  WS-TERM-STR              PIC X(10).\n           05  WS-RATE-STR              PIC X(20).\n\n       01  WS-NUM.\n           05  WS-LOAN-AMT              PIC 9(13)V99 COMP-3.\n           05  WS-PROP-VAL              PIC 9(13)V99 COMP-3.\n           05  WS-DOWN-PAY              PIC 9(13)V99 COMP-3.\n           05  WS-MIN-DOWN              PIC 9(13)V99 COMP-3.\n           05  WS-RATE                  PIC 9(3)V9(5)  COMP-3.\n           05  WS-MONTHLY-RATE          PIC 9V9(9)     COMP-3.\n           05  WS-BALANCE               PIC 9(13)V99 COMP-3.\n           05  WS-PAYMENT               PIC 9(13)V99 COMP-3.\n           05  WS-INTEREST              PIC 9(13)V99 COMP-3.\n           05  WS-PRINCIPAL             PIC 9(13)V99 COMP-3.\n\n       01  WS-TERM.\n           05  WS-TERM-YEARS            PIC 9(3) COMP.\n           05  WS-TERM-MONTHS           PIC 9(5) COMP.\n           05  WS-MONTH                 PIC 9(5) COMP.\n\n       01  WS-FORMULA.\n           05  WS-ONE                   PIC 9V9(18) COMP-3 VALUE 1.\n           05  WS-POW "]
[101.726623, "o", "cat > program.cbl <<'COB'\r\n\u001b[?2004l\r"]
[101.726734, "i", "                  PIC 9V9(18) COMP-3.\n           05  WS-DENOM                 PIC 9V9(18) COMP-3.\n\n       01  WS-OUT.\n           05  WS-STATUS                PIC X(5).\n           05  WS-REASON                PIC X(50).\n\n       01  WS-SCHED-LINE.\n           05  SL-MONTH                 PIC 9(3).\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-PAY                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-INT                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-PRN                   PIC 9(8).99.\n           05  FILLER                   PIC X VALUE SPACE.\n           05  SL-BAL                   PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE\n\n           PERFORM UNTIL WS-EOF = \"Y\"\n               READ IN-FILE\n                   AT END\n                       MOVE \"Y\" TO WS-EOF\n                   NOT AT END\n           "]
[101.726852, "o", "5  WS-TERM-STR              PIC X(10).\r\n           05  WS-RATE-STR              PIC X(20).\r\n\r\n       01  WS-NUM.\r\n           05  WS-LOAN-AMT              PIC 9(13)V99 COMP-3.\r\n           05  WS-PROP-VAL              PIC 9(13)V99 COMP-3.\r\n           05  WS-DOWN-PAY              PIC 9(13)V99 COMP-3.\r\n           05  WS-MIN-DOWN              PIC 9(13)V99 COMP-3.\r\n           05  WS-RATE                  PIC 9(3)V9(5)  COMP-3.\r\n           05  WS-MONTHLY-RATE          PIC 9V9(9)     COMP-3.\r\n           05  WS-BALANCE               PIC 9(13)V99 COMP-3.\r\n           05  WS-PAYMENT               PIC 9(13)V99 COMP-3.\r\n           05  WS-INTEREST              PIC 9(13)V99 COMP-3.\r\n           05  WS-PRINCIPAL             PIC 9(13)V99 COMP-3.\r\n\r\n       01  WS-TERM.\r\n           05  WS-TERM-YEARS            PIC 9(3) COMP.\r\n           "]
[101.726874, "i", "            PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE IN-FILE OUT-FILE\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-INPUT\n           PERFORM CONVERT-FIELDS\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-PARSED\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-STR\n                    WS-PROP-STR\n                    WS-DOWN-STR\n                    WS-TERM-STR\n                    WS-RATE-STR\n           END-UNSTRING.\n\n       CONVERT-FIELDS.\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\n           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\n\n           IF WS-RATE-STR = SPACES\n               MOVE 0 TO WS-RATE\n           ELSE\n               IF FUNCTION INDEX(WS-RATE-STR \".\") > 0\n                   M"]
[101.726964, "o", "05  WS-TERM-MONTHS           PIC 9(5) COMP.\r\n           05  WS-MONTH                 PIC 9(5) COMP.\r\n\r\n       01  WS-FORMULA.\r\n           05  WS-ONE                   PIC 9V9(18) COMP-3 VALUE 1.\r\n           05  WS-POW                   PIC 9V9(18) COMP-3.\r\n           05  WS-DENOM                 PIC 9V9(18) COMP-3.\r\n\r\n       01  WS-OUT.\r\n           05  WS-STATUS  "]
[101.726983, "i", "OVE FUNCTION NUMVAL(WS-RATE-STR) TO WS-RATE\n               ELSE\n                   COMPUTE WS-RATE ROUNDED =\n                       FUNCTION NUMVAL(WS-RATE-STR) / 100\n               END-IF\n           END-IF.\n\n       CHECK-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15\n\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n               MOVE \"DENY \" TO WS-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               MOVE \"APPRO\" TO WS-STATUS\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS WS-REASON\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRI"]
[101.727073, "o", "              PIC X(5).\r\n           05  WS-REASON                PIC X(50).\r\n\r\n       01  WS-SCHED-LINE.\r\n           05  SL-MONTH                 PIC 9(3).\r\n           05  FILLER                   PIC X VALUE SPACE.\r\n           05  SL-PAY                   PIC 9(8).99.\r\n           05  FILLER                   PIC X VALUE SPACE.\r\n           05  SL-INT    "]
[101.727094, "i", "TE OUT-REC.\n\n       BUILD-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\n           IF WS-TERM-MONTHS <= 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\n           MOVE WS-LOAN-AMT TO WS-BALANCE\n\n           IF WS-MONTHLY-RATE = 0\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN-AMT / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-POW =\n                   (WS-ONE + WS-MONTHLY-RATE) ** (0 - WS-TERM-MONTHS)\n               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\n           END-IF\n\n           PERFORM VARYING WS-MONTH FROM 1 BY 1\n               UNTIL WS-MONTH > WS-TERM-MONTHS\n\n               COMPUTE WS-INTEREST ROUNDED =\n                   WS-BALANCE * WS-MONTHLY-RATE\n               COMPUTE WS-PRINCIPAL ROUNDED =\n                   WS-PAYMENT - WS-INTEREST\n\n               IF WS-MONTH = WS-TERM-MONTH"]
[101.727162, "o", "               PIC 9(8).99.\r\n           05  FILLER                   PIC X VALUE SPACE.\r\n           05  SL-PRN                   PIC 9(8).99.\r\n           05  FILLER                   PIC X VALUE SPACE.\r\n           05  SL-BAL                   PIC 9(10).99.\r\n\r\n       PROCEDURE DIVISION.\r\n       MAIN.\r\n           OPEN INPUT IN-FILE\r\n                OUTPUT OUT-FILE\r\n\r\n           PERFORM UNTIL WS-EOF = \"Y\"\r\n               READ IN-FILE\r\n                  "]
[101.727178, "i", "S\n                   MOVE WS-BALANCE TO WS-PRINCIPAL\n                   COMPUTE WS-PAYMENT ROUNDED =\n                       WS-INTEREST + WS-PRINCIPAL\n               END-IF\n\n               COMPUTE WS-BALANCE ROUNDED =\n                   WS-BALANCE - WS-PRINCIPAL\n               IF WS-BALANCE < 0\n                   MOVE 0 TO WS-BALANCE\n               END-IF\n\n               PERFORM WRITE-SCHEDULE-LINE\n\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           MOVE WS-MONTH TO SL-MONTH\n           MOVE WS-PAYMENT TO SL-PAY\n           MOVE WS-INTEREST TO SL-INT\n           MOVE WS-PRINCIPAL TO SL-PRN\n           MOVE WS-BALANCE TO SL-BAL\n           MOVE WS-SCHED-LINE TO OUT-REC\n           WRITE OUT-REC.\nCOB\n"]
[101.7272, "o", " AT END\r\n                       MOVE \"Y\" TO WS-EOF\r\n                   NOT AT END\r\n           "]
[101.727286, "o", "            PERFORM PROCESS-REC\r\n               END-READ\r\n           END-PERFORM\r\n\r\n           CLOSE IN-FILE OUT-FILE\r\n           STOP RUN.\r\n\r\n       PROCESS-REC.\r\n           PERFORM PARSE-INPUT\r\n           PERFORM CONVERT-FIELDS\r\n           PERFORM CHECK-APPLICATION.\r\n\r\n       PARSE-INPUT.\r\n           MOVE SPACES TO WS-PARSED\r\n           UNSTRING IN-REC DELIMITED BY \";\"\r\n               INTO WS-ID\r\n                    WS-NAME\r\n                    WS-LOAN-STR\r\n                    WS-PROP-STR\r\n  "]
[101.727348, "o", "                  WS-DOWN-STR\r\n                    WS-TERM-STR\r\n                    WS-RATE-STR\r\n           END-UNSTRING.\r\n\r\n       CONVERT-FIELDS.\r\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT\r\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL\r\n           MOVE FUNCTION NUMVAL(WS-DOWN-ST"]
[101.727399, "o", "R) TO WS-DOWN-PAY\r\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS\r\n\r\n           IF WS-RATE-STR = SPACES\r\n            "]
