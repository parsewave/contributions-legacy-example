[178.055892, "o", "\u001b[?2004h> "]
[178.055984, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r"]
[178.055997, "o", "\u001b[?2004h> "]
[178.056077, "o", "       MAIN.\r\n\u001b[?2004l\r"]
[178.0561, "o", "\u001b[?2004h> "]
[178.056249, "o", "           OPEN INPUT IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.056381, "o", "                OUTPUT OUT-FILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[178.05644, "o", "\u001b[?2004h> "]
[178.056553, "o", "           PERFORM UNTIL WS-EOF = \"Y\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.056658, "o", "               READ IN-FILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.056707, "o", "> "]
[178.05682, "o", "                   AT END\r\n\u001b[?2004l\r"]
[178.056888, "o", "\u001b[?2004h> "]
[178.056979, "o", "                       MOVE \"Y\" TO WS-EOF\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.056998, "o", "> "]
[178.057112, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.057257, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.057346, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.057362, "o", "> "]
[178.057441, "o", "           END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> "]
