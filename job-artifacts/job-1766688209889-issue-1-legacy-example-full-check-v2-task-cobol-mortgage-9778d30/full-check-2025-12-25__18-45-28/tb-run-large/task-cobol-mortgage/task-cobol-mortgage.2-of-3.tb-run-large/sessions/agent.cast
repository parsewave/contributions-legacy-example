[51.363541, "o", "\u001b[?2004hroot@acf1ecf3cb49:/app# "]
[51.462958, "i", "cat > /app/src/program.cbl <<'COB'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       CONFIGURATION SECTION.\n       SPECIAL-NAMES.\n           DECIMAL-POINT IS DOT.\n\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                      PIC X(256).\n\n       FD  OUT-FILE.\n       01  OUT-REC                     PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       77  WS-EOF                      PIC X VALUE \"N\".\n\n       01  WS-PARSED.\n           05  WS-ID                   PIC X(10).\n           05  WS-NAME                 PIC X(30).\n           05  WS-LOAN-STR             PIC X(40).\n           05  WS-PROP-STR             PIC X(40).\n           05  WS-DOWN-STR             PIC X(40).\n           "]
[51.463035, "i", "05  WS-TERM-STR             PIC X(10).\n           05  WS-RATE-STR             PIC X(20).\n\n       01  WS-NUM.\n           05  WS-LOAN-AMT             PIC 9(11)V99 COMP-3.\n           05  WS-PROP-VAL             PIC 9(11)V99 COMP-3.\n           05  WS-DOWN-PAY             PIC 9(11)V99 COMP-3.\n           05  WS-MIN-DOWN             PIC 9(11)V99 COMP-3.\n           05  WS-RATE                 PIC 9(3)V9(5) COMP-3.\n           05  WS-MONTHLY-RATE         PIC 9V9(9) COMP-3.\n           05  WS-BALANCE              PIC 9(11)V99 COMP-3.\n           05  WS-PAYMENT              PIC 9(11)V99 COMP-3.\n           05  WS-INTEREST             PIC 9(11)V99 COMP-3.\n           05  WS-PRINCIPAL            PIC 9(11)V99 COMP-3.\n\n       01  WS-TERM.\n           05  WS-TERM-YEARS           PIC 9(3) COMP.\n           05  WS-TERM-MONTHS          PIC 9(5) COMP.\n           05  WS-MONTH                PIC 9(5) COMP.\n\n       01  WS-FORMULA.\n           05  WS-ONE                  PIC 9V9(9) COMP-3 VALUE 1.\n           05  WS-DENOM                PIC "]
[51.463066, "i", "9V9(9) COMP-3.\n           05  WS-POW                  PIC 9V9(9) COMP-3.\n\n       01  WS-OUT.\n           05  WS-STATUS               PIC X(5).\n           05  WS-REASON               PIC X(50).\n\n       01  WS-SCHED-LINE.\n           05  SL-MONTH                PIC 9(3).\n           05  FILLER                  PIC X VALUE SPACE.\n           05  SL-PAY                  PIC 9(8).99.\n           05  FILLER                  PIC X VALUE SPACE.\n           05  SL-INT                  PIC 9(8).99.\n           05  FILLER                  PIC X VALUE SPACE.\n           05  SL-PRN                  PIC 9(8).99.\n           05  FILLER                  PIC X VALUE SPACE.\n           05  SL-BAL                  PIC 9(10).99.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE.\n\n           PERFORM UNTIL WS-EOF = \"Y\"\n               READ IN-FILE\n                   AT END\n                       MOVE \"Y\" TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-REC\n   "]
[51.463222, "i", "            END-READ\n           END-PERFORM.\n\n           CLOSE IN-FILE OUT-FILE.\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-INPUT.\n           PERFORM CONVERT-FIELDS.\n           PERFORM CHECK-APPLICATION.\n\n       PARSE-INPUT.\n           MOVE SPACES TO WS-PARSED.\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-STR\n                    WS-PROP-STR\n                    WS-DOWN-STR\n                    WS-TERM-STR\n                    WS-RATE-STR\n           END-UNSTRING.\n\n       CONVERT-FIELDS.\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT.\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL.\n           MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY.\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS.\n\n           IF WS-RATE-STR = SPACES\n               MOVE 0 TO WS-RATE\n           ELSE\n               IF WS-RATE-STR CONTAINS \".\"\n                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO W"]
[51.46331, "o", "cat > /app/src/program.cbl <<'COB'\r\n\u001b[?2004l\r            END-READ\r\n           END-PERFORM.\r\n\r\n           CLOSE IN-FILE OUT-FILE.\r\n           STOP RUN.\r\n\r\n       PROCESS-REC.\r\n           PERFORM PARSE-INPUT.\r\n           PERFORM CONVERT-FIELDS.\r\n           PERFORM CHECK-APPLICATION.\r\n\r\n       PARSE-INPUT.\r\n           MOVE SPACES TO WS-PARSED.\r\n           UNSTRING IN-REC DELIMITED BY \";\"\r\n               INTO WS-ID\r\n                    WS-NAME\r\n                    WS-LOAN-STR\r\n                    WS-PROP-STR\r\n                    WS-DOWN-STR\r\n                    WS-TERM-STR\r\n                    WS-RATE-STR\r\n           END-UNSTRING.\r\n\r\n       CONVERT-FIELDS.\r\n           MOVE FUNCTION NUMVAL(WS-LOAN-STR) TO WS-LOAN-AMT.\r\n           MOVE FUNCTION NUMVAL(WS-PROP-STR) TO WS-PROP-VAL.\r\n       "]
[51.463385, "i", "S-RATE\n               ELSE\n                   COMPUTE WS-RATE ROUNDED =\n                       FUNCTION NUMVAL(WS-RATE-STR) / 100\n               END-IF\n           END-IF.\n\n       CHECK-APPLICATION.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP-VAL * 0.15.\n\n           IF WS-DOWN-PAY < WS-MIN-DOWN\n               MOVE \"DENY \" TO WS-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO WS-REASON\n               PERFORM WRITE-DENY\n           ELSE\n               MOVE \"APPRO\" TO WS-STATUS\n               PERFORM WRITE-APPRO\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS SPACE WS-REASON\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPRO.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID WS-STATUS\n               DELIMITED BY SIZE\n               INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHE"]
[51.463436, "o", "    MOVE FUNCTION NUMVAL(WS-DOWN-STR) TO WS-DOWN-PAY.\r\n           MOVE FUNCTION NUMVAL(WS-TERM-STR) TO WS-TERM-YEARS.\r\n\r\n           IF WS-RATE-STR = SPACES\r\n               MOVE 0 TO WS-RATE\r\n           ELSE\r\n               IF WS-RATE-STR CONTAINS \".\"\r\n                   MOVE FUNCTION NUMVAL(WS-RATE-STR) TO W\u001b[?2004h> "]
[51.463616, "i", "DULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12.\n           IF WS-TERM-MONTHS <= 0\n               EXIT PARAGRAPH\n           END-IF.\n\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200.\n           MOVE WS-LOAN-AMT TO WS-BALANCE.\n\n           IF WS-MONTHLY-RATE = 0\n               COMPUTE WS-PAYMENT ROUNDED = WS-LOAN-AMT / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-POW = (WS-ONE + WS-MONTHLY-RATE)\n                   ** (0 - WS-TERM-MONTHS)\n               COMPUTE WS-DENOM ROUNDED = WS-ONE - WS-POW\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN-AMT * WS-MONTHLY-RATE / WS-DENOM\n           END-IF.\n\n           PERFORM VARYING WS-MONTH FROM 1 BY 1\n               UNTIL WS-MONTH > WS-TERM-MONTHS\n\n               COMPUTE WS-INTEREST ROUNDED = WS-BALANCE * WS-MONTHLY-RATE\n               COMPUTE WS-PRINCIPAL ROUNDED = WS-PAYMENT - WS-INTEREST\n\n               IF WS-MONTH = WS-TERM-MONTHS\n                   MOVE WS-BALANCE TO WS-PRINCIPAL\n                   COMPUTE WS"]
[51.463729, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\rOUN\u001b[?2004h> "]
[51.463761, "i", "-PAYMENT ROUNDED = WS-INTEREST + WS-PRINCIPAL\n               END-IF\n\n               COMPUTE WS-BALANCE ROUNDED = WS-BALANCE - WS-PRINCIPAL\n               IF WS-BALANCE < 0\n                   MOVE 0 TO WS-BALANCE\n               END-IF\n\n               PERFORM WRITE-SCHEDULE-LINE\n\n           END-PERFORM.\n\n       WRITE-SCHEDULE-LINE.\n           MOVE WS-MONTH TO SL-MONTH.\n           MOVE WS-PAYMENT TO SL-PAY.\n           MOVE WS-INTEREST TO SL-INT.\n           MOVE WS-PRINCIPAL TO SL-PRN.\n           MOVE WS-BALANCE TO SL-BAL.\n           MOVE WS-SCHED-LINE TO OUT-REC\n           WRITE OUT-REC.\nCOB\n"]
