[3.534678, "o", "0m\u001b[39;49;00m\r\n        compile_result = subprocess.run([\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m'\u001b[39;49;00m\u001b[33mcobc\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m'\u001b[39;49;00m\u001b[33m-x\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m'\u001b[39;49;00m\u001b[33m-o\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m'\u001b[39;49;00m\u001b[33m/app/src/programCOMP\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m'\u001b[39;49;00m\u001b[33m/app/src/program.cbl\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        ], capture_output=\u001b[94mTrue\u001b[39;49;00m, text=\u001b[94mTrue\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m compile_result.returncode == \u001b[94m0\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mCompilation failed: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mcompile_result.stderr\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
