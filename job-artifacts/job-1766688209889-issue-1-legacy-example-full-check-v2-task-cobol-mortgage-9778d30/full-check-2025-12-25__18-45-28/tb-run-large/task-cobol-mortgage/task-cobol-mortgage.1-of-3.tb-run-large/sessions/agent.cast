[72.594616, "o", "       WRITE-APPROVE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.594682, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.594829, "o", "           STRING WS-ID DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.594942, "o", "                  \"APPRO\" DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595022, "o", "             INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595112, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595172, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[72.595194, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.595258, "o", "       BUILD-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59539, "o", "           COMPUTE WS-TERM-MONTHS ROUNDED = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595511, "o", "           COMPUTE WS-MONTH-RATE = WS-RATE / 1200.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595598, "o", "           MOVE WS-LOAN TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.595645, "o", "> "]
[72.595697, "o", "           IF WS-TERM-MONTHS = 0\r\n\u001b[?2004l\r"]
[72.595738, "o", "\u001b[?2004h> "]
[72.595821, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.595855, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.595886, "o", "> "]
[72.595961, "o", "           IF WS-MONTH-RATE = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.596096, "o", "               COMPUTE WS-PAYMENT ROUNDED = WS-LOAN / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.596143, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59628, "o", "               COMPUTE WS-POWER = (1.0 + WS-MONTH-RATE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.596353, "o", "                   ** (-WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59652, "o", "               COMPUTE WS-DENOM = 1.0 - WS-POWER\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59657, "o", "               COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.5967, "o", "                   WS-LOAN * WS-MONTH-RATE / WS-DENOM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.596765, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.596916, "o", "           PERFORM VARYING WS-I FROM 1 BY 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59703, "o", "               UNTIL WS-I > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597127, "o", "               COMPUTE WS-INTEREST ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597226, "o", "                   WS-BALANCE * WS-MONTH-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597319, "o", "               IF WS-I = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597448, "o", "                   MOVE WS-BALANCE TO WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597568, "o", "                   COMPUTE WS-PAYMENT ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597696, "o", "                       WS-PRINCIPAL + WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597785, "o", "                   MOVE 0 TO WS-BALANCE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.597819, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.597874, "o", "> "]
[72.597962, "o", "                   COMPUTE WS-PRINCIPAL ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598069, "o", "                       WS-PAYMENT - WS-INTEREST\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598171, "o", "                   COMPUTE WS-BALANCE ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59828, "o", "                       WS-BALANCE - WS-PRINCIPAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598336, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598424, "o", "               PERFORM WRITE-SCHED-LINE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598473, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.598546, "o", "\u001b[?2004h> "]
[72.598564, "o", "       WRITE-SCHED-LINE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598664, "o", "           MOVE WS-I TO E-MON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598748, "o", "           MOVE WS-PAYMENT TO E-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598832, "o", "           MOVE WS-INTEREST TO E-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.598937, "o", "           MOVE WS-PRINCIPAL TO E-PRN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599019, "o", "           MOVE WS-BALANCE TO E-BAL\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[72.599035, "o", "> "]
[72.599132, "o", "           MOVE SPACES TO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599224, "o", "           STRING E-MON DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59931, "o", "                  SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.59939, "o", "                  E-PAY DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599466, "o", "                  SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599572, "o", "                  E-INT DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599629, "o", "                  SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599724, "o", "                  E-PRN DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599783, "o", "                  SPACE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.5999, "o", "                  E-BAL DELIMITED BY SIZE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.599953, "o", "             INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.600028, "o", "           END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.600083, "o", "           WRITE OUT-REC.\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.600099, "o", "> COBOL\r\n"]
[72.600104, "o", "\u001b[?2004l\r"]
