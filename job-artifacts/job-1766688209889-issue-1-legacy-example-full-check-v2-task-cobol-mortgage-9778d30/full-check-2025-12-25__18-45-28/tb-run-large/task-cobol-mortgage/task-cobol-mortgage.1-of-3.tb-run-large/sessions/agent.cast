[72.58213, "i", "cat > /app/src/program.cbl <<'COBOL'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  IN-FILE.\n       01  IN-REC                      PIC X(200).\n       FD  OUT-FILE.\n       01  OUT-REC                     PIC X(200).\n\n       WORKING-STORAGE SECTION.\n       01  WS-EOF                      PIC X VALUE \"N\".\n\n       01  WS-FIELDS.\n           05  WS-ID                   PIC X(10).\n           05  WS-NAME                 PIC X(30).\n           05  WS-LOAN-TXT             PIC X(20).\n           05  WS-PROP-TXT             PIC X(20).\n           05  WS-DOWN-TXT             PIC X(20).\n           05  WS-TERM-TXT             PIC X(10).\n           05  WS-RATE-TXT             PIC X"]
[72.582177, "i", "(20).\n\n       01  WS-NUMERIC.\n           05  WS-LOAN                 PIC 9(12)V99 COMP-3.\n           05  WS-PROP                 PIC 9(12)V99 COMP-3.\n           05  WS-DOWN                 PIC 9(12)V99 COMP-3.\n           05  WS-MIN-DOWN             PIC 9(12)V99 COMP-3.\n           05  WS-RATE                 COMP-2.\n           05  WS-MONTH-RATE           COMP-2.\n           05  WS-TERM-YEARS           PIC 9(3) COMP-3.\n           05  WS-TERM-MONTHS          PIC 9(4) COMP-3.\n           05  WS-PAYMENT              PIC 9(12)V99 COMP-3.\n           05  WS-INTEREST             PIC 9(12)V99 COMP-3.\n           05  WS-PRINCIPAL            PIC 9(12)V99 COMP-3.\n           05  WS-BALANCE              PIC 9(12)V99 COMP-3.\n           05  WS-DENOM                COMP-2.\n           05  WS-POWER                COMP-2.\n\n       01  WS-EDIT.\n           05  E-MON                   PIC 9(3).\n           05  E-PAY                   PIC 9(8).99.\n           05  E-INT                   PIC 9(8).99.\n           05  E-PRN                   P"]
[72.582358, "i", "IC 9(8).99.\n           05  E-BAL                   PIC 9(10).99.\n\n       01  WS-I                        PIC 9(4) COMP-3.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT IN-FILE\n                OUTPUT OUT-FILE\n           PERFORM UNTIL WS-EOF = \"Y\"\n               READ IN-FILE\n                   AT END\n                       MOVE \"Y\" TO WS-EOF\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n           CLOSE IN-FILE OUT-FILE\n           STOP RUN.\n\n       PROCESS-REC.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID\n                    WS-NAME\n                    WS-LOAN-TXT\n                    WS-PROP-TXT\n                    WS-DOWN-TXT\n                    WS-TERM-TXT\n                    WS-RATE-TXT\n           END-UNSTRING\n\n           MOVE FUNCTION NUMVAL(WS-LOAN-TXT) TO WS-LOAN\n           MOVE FUNCTION NUMVAL(WS-PROP-TXT) TO WS-PROP\n           MOVE FUNCTION NUMVAL(WS-DOW"]
[72.582386, "o", "cat > /app/src/program.cbl <<'COBOL'\r\n\u001b[?2004l\r"]
[72.58249, "i", "N-TXT) TO WS-DOWN\n           MOVE FUNCTION NUMVAL(WS-TERM-TXT) TO WS-TERM-YEARS\n           MOVE FUNCTION NUMVAL(WS-RATE-TXT) TO WS-RATE\n\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\n\n           IF WS-DOWN < WS-MIN-DOWN\n               PERFORM WRITE-DENY\n           ELSE\n               PERFORM WRITE-APPROVE\n               PERFORM BUILD-SCHEDULE\n           END-IF.\n\n       WRITE-DENY.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"DENY \" DELIMITED BY SIZE\n                  \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\"\n                    DELIMITED BY SIZE\n             INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       WRITE-APPROVE.\n           MOVE SPACES TO OUT-REC\n           STRING WS-ID DELIMITED BY SIZE\n                  \"APPRO\" DELIMITED BY SIZE\n             INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\n\n       BUILD-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS ROUNDED = WS-TERM-YEARS * 12\n           COMPUTE WS-MONTH-RATE = WS-"]
[72.582628, "o", "\u001b[?2004h>        IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[72.58266, "i", "RATE / 1200.0\n           MOVE WS-LOAN TO WS-BALANCE\n\n           IF WS-TERM-MONTHS = 0\n               EXIT PARAGRAPH\n           END-IF\n\n           IF WS-MONTH-RATE = 0\n               COMPUTE WS-PAYMENT ROUNDED = WS-LOAN / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-POWER = (1.0 + WS-MONTH-RATE)\n                   ** (-WS-TERM-MONTHS)\n               COMPUTE WS-DENOM = 1.0 - WS-POWER\n               COMPUTE WS-PAYMENT ROUNDED =\n                   WS-LOAN * WS-MONTH-RATE / WS-DENOM\n           END-IF\n\n           PERFORM VARYING WS-I FROM 1 BY 1\n               UNTIL WS-I > WS-TERM-MONTHS\n               COMPUTE WS-INTEREST ROUNDED =\n                   WS-BALANCE * WS-MONTH-RATE\n               IF WS-I = WS-TERM-MONTHS\n                   MOVE WS-BALANCE TO WS-PRINCIPAL\n                   COMPUTE WS-PAYMENT ROUNDED =\n                       WS-PRINCIPAL + WS-INTEREST\n                   MOVE 0 TO WS-BALANCE\n               ELSE\n                   COMPUTE WS-PRINCIPAL ROUNDED =\n                       WS-PAYMENT"]
[72.582759, "o", "\u001b[?2004h>        ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.58278, "i", " - WS-INTEREST\n                   COMPUTE WS-BALANCE ROUNDED =\n                       WS-BALANCE - WS-PRINCIPAL\n               END-IF\n               PERFORM WRITE-SCHED-LINE\n           END-PERFORM.\n\n       WRITE-SCHED-LINE.\n           MOVE WS-I TO E-MON\n           MOVE WS-PAYMENT TO E-PAY\n           MOVE WS-INTEREST TO E-INT\n           MOVE WS-PRINCIPAL TO E-PRN\n           MOVE WS-BALANCE TO E-BAL\n\n           MOVE SPACES TO OUT-REC\n           STRING E-MON DELIMITED BY SIZE\n                  SPACE\n                  E-PAY DELIMITED BY SIZE\n                  SPACE\n                  E-INT DELIMITED BY SIZE\n                  SPACE\n                  E-PRN DELIMITED BY SIZE\n                  SPACE\n                  E-BAL DELIMITED BY SIZE\n             INTO OUT-REC\n           END-STRING\n           WRITE OUT-REC.\nCOBOL\n"]
[72.58288, "o", "       INPUT-OUTPUT SECTION.\r\n"]
