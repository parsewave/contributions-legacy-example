[99.968107, "o", "       IDENTIFICATION DIVISION.$\r\n       PROGRAM-ID. PROGRAM.$\r\n$\r\n       ENVIRONMENT DIVISION.$\r\n       INPUT-OUTPUT SECTION.$\r\n       FILE-CONTROL.$\r\n           SELECT IN-FILE ASSIGN TO \"INPUT.DAT\"$\r\n               ORGANIZATION IS LINE SEQUENTIAL.$\r\n           SELECT OUT-FILE ASSIGN TO \"/app/data/OUTPUT.DAT\"$\r\n               ORGANIZATION IS LINE SEQUENTIAL.$\r\n$\r\n       DATA DIVISION.$\r\n       FILE SECTION.$\r\n       FD  IN-FILE.$\r\n       01  IN-REC                      PIC X(200).$\r\n       FD  OUT-FILE.$\r\n       01  OUT-REC                     PIC X(200).$\r\n$\r\n       WORKING-STORAGE SECTION.$\r\n       01  WS-EOF                      PIC X VALUE \"N\".$\r\n$\r\n       01  WS-FIELDS.$\r\n           05  WS-ID                   PIC X(10).$\r\n           05  WS-NAME                 PIC X(30).$\r\n           05  WS-LOAN-TXT             PIC X(20).$\r\n           05  WS-PROP-TXT             PIC X(20).$\r\n           05  WS-DOWN-TXT             PIC X(20).$\r\n           05  WS-TERM-TXT             PIC X(10).$\r\n           05  WS-RATE-TX"]
[99.968137, "o", "T             PIC X(20).$\r\n$\r\n       01  WS-NUMERIC.$\r\n           05  WS-LOAN                 PIC 9(12)V99 COMP-3.$\r\n           05  WS-PROP                 PIC 9(12)V99 COMP-3.$\r\n           05  WS-DOWN                 PIC 9(12)V99 COMP-3.$\r\n           05  WS-MIN-DOWN             PIC 9(12)V99 COMP-3.$\r\n           05  WS-RATE                 COMP-2.$\r\n           05  WS-MONTH-RATE           COMP-2.$\r\n           05  WS-TERM-YEARS           PIC 9(3) COMP-3.$\r\n           05  WS-TERM-MONTHS          PIC 9(4) COMP-3.$\r\n           05  WS-PAYMENT              PIC 9(12)V99 COMP-3.$\r\n"]
