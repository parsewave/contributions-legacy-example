[?2004l[?2004h>            COMPUTE WS-LOAN = N-LOAN
[?2004l[?2004h>            COMPUTE WS-PROP = N-PROP
[?2004l[?2004h>            COMPUTE WS-DOWN = N-DOWN
[?2004l[?2004h>            COMPUTE WS-RATE = N-RATE
[?2004l[?2004h>            COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT).
[?2004l[?2004h> 
[?2004l[?2004h>        CHECK-AND-WRITE.
[?2004l[?2004h>            COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15
[?2004l[?2004h> 
[?2004l[?2004h>            IF WS-DOWN < WS-MIN-DOWN
[?2004l[?2004h>                MOVE WS-ID TO OUT-ID
