[58.429589, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
[58.928844, "i", "ls -la ../data/OUTPUT.DAT\n"]
[58.929119, "o", "ls -la ../data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[58.930627, "o", "-rw-r--r-- 1 root root 1 Dec 25 18:45 ../data/OUTPUT.DAT\r\n"]
[58.93083, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
