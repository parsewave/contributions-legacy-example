[56.13723, "o", "       77  I                           PIC 9(4) VALUE 0.\r\n\u001b[?2004l\r"]
[56.137316, "o", "\u001b[?2004h>        77  WS-ZERO                     COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.137386, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>        PROCEDURE DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.137441, "o", ">        MAIN.\r\n\u001b[?2004l\r"]
[56.1375, "o", "\u001b[?2004h> "]
[56.13755, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.1376, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.13766, "o", ">            PERFORM UNTIL EOF-FLAG = \"Y\"\r\n"]
[56.137711, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.137734, "o", "               READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.137787, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.137877, "o", "                       MOVE \"Y\" TO EOF-FLAG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.137957, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138039, "o", "                       PERFORM PROCESS-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.13811, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138149, "o", "           END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.138167, "o", "\u001b[?2004h> "]
[56.138262, "o", "           CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138367, "o", "           CLOSE OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h>            STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.138398, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>        PROCESS-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138487, "o", "           PERFORM PARSE-REC\r\n\u001b[?2004l\r\u001b[?2004h>            PERFORM CHECK-AND-WRITE."]
[56.138523, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138623, "o", "       PARSE-REC.\r\n\u001b[?2004l\r\u001b[?2004h>            MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r"]
[56.138651, "o", "\u001b[?2004h> "]
[56.138728, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138756, "o", "               INTO WS-ID-TXT\r\n\u001b[?2004l\r"]
[56.138801, "o", "\u001b[?2004h> "]
[56.138869, "o", "                    WS-NAME-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138929, "o", "                    WS-LOAN-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.138957, "o", "                    WS-PROP-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139059, "o", "                    WS-DOWN-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139087, "o", "                    WS-TERM-TXT\r\n\u001b[?2004l\r"]
[56.139136, "o", "\u001b[?2004h> "]
[56.139197, "o", "                    WS-RATE-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139225, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139346, "o", "           MOVE FUNCTION TRIM(WS-ID-TXT) TO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139442, "o", "           MOVE FUNCTION TRIM(WS-NAME-TXT) TO WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.13955, "o", "           COMPUTE N-LOAN = FUNCTION NUMVAL(WS-LOAN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139665, "o", "           COMPUTE N-PROP = FUNCTION NUMVAL(WS-PROP-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139743, "o", "           COMPUTE N-DOWN = FUNCTION NUMVAL(WS-DOWN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.139843, "o", "           COMPUTE N-RATE = FUNCTION NUMVAL(WS-RATE-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.139908, "o", "\u001b[?2004h> "]
[56.139932, "o", "           COMPUTE WS-LOAN = N-LOAN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.140028, "o", "           COMPUTE WS-PROP = N-PROP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.140084, "o", "           COMPUTE WS-DOWN = N-DOWN\r\n\u001b[?2004l\r"]
[56.140144, "o", "\u001b[?2004h> "]
[56.140172, "o", "           COMPUTE WS-RATE = N-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.140294, "o", "           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14037, "o", "       CHECK-AND-WRITE.\r\n\u001b[?2004l\r"]
[56.140395, "o", "\u001b[?2004h> "]
[56.140446, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.140509, "o", "\u001b[?2004h> "]
[56.140543, "o", "           IF WS-DOWN < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14062, "o", "               MOVE WS-ID TO OUT-ID\r\n\u001b[?2004l\r"]
[56.140648, "o", "\u001b[?2004h> "]
[56.140699, "o", "               MOVE \"DENY \" TO OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.140748, "o", "> "]
[56.140803, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO OUT-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.140937, "o", "               STRING OUT-ID OUT-STATUS OUT-SPACE1 OUT-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141045, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141075, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.141145, "o", "> "]
[56.141202, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h>            ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14129, "o", "               MOVE WS-ID TO OUT-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141355, "o", "               MOVE \"APPRO\" TO OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141433, "o", "               MOVE SPACES TO OUT-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141507, "o", "               STRING OUT-ID OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14158, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141664, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.141716, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.141778, "o", "> "]
[56.141829, "o", "               PERFORM WRITE-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h>            END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.141856, "o", "\u001b[?2004h> "]
[56.141914, "o", "       WRITE-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.141943, "o", "> "]
[56.142013, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142057, "o", "           IF WS-TERM-MONTHS = 0\r\n\u001b[?2004l\r"]
[56.142075, "o", "\u001b[?2004h> "]
[56.142135, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142162, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14233, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.14236, "o", "\u001b[?2004h> "]
[56.142442, "o", "           COMPUTE WS-BAL-RAW = WS-LOAN\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.142469, "o", "\u001b[?2004h> "]
[56.142556, "o", "           IF WS-MONTHLY-RATE = WS-ZERO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142701, "o", "               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED = WS-BAL-RAW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142799, "o", "                   / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142822, "o", "           ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.142955, "o", "               COMPUTE WS-FACTOR = (1 + WS-MONTHLY-RATE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.142991, "o", "> "]
[56.143077, "o", "                   ** (-1 * WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143164, "o", "               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143301, "o", "                   (WS-BAL-RAW * WS-MONTHLY-RATE) / (1 - WS-FACTOR)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143326, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[56.143335, "o", "\u001b[?2004l\r"]
[56.143403, "o", "\u001b[?2004h> "]
[56.143484, "o", "           PERFORM VARYING I FROM 1 BY 1 UNTIL I > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143609, "o", "               COMPUTE WS-INT-RAW ROUNDED = WS-BAL-RAW * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143743, "o", "               COMPUTE WS-PRN-RAW ROUNDED = WS-MONTHLY-PAY-RAW - WS-INT-RAW\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143824, "o", "               IF I = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.143915, "o", "                   COMPUTE WS-PRN-RAW ROUNDED = WS-BAL-RAW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144039, "o", "                   COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.14413, "o", "                       WS-PRN-RAW + WS-INT-RAW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144209, "o", "                   COMPUTE WS-BAL-RAW = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144237, "o", "               ELSE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144408, "o", "                   COMPUTE WS-BAL-RAW ROUNDED = WS-BAL-RAW - WS-PRN-RAW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144435, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.144503, "o", "\u001b[?2004h> "]
[56.144528, "o", "               MOVE I TO SCH-MON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144629, "o", "               MOVE WS-MONTHLY-PAY-RAW TO SCH-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144686, "o", "               MOVE WS-INT-RAW TO SCH-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.144786, "o", "               MOVE WS-PRN-RAW TO SCH-PRN\r\n\u001b[?2004l\r"]
[56.144806, "o", "\u001b[?2004h> "]
[56.144909, "o", "               MOVE WS-BAL-RAW TO SCH-BAL\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.145054, "o", "               STRING SCH-MON SCH-SP1 SCH-PAY SCH-SP2 SCH-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.145137, "o", "                      SCH-SP3 SCH-PRN SCH-SP4 SCH-BAL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.145219, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.145304, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.145334, "o", ">                WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.145405, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[56.146843, "o", "\u001b[?2004hroot@b9423b228534:/app# "]
