[56.421107, "o", "cobc -x -free -Wall program.cbl\r\n\u001b[?2004l\r"]
[56.439022, "o", "program.cbl:7: error: syntax error, unexpected Identifier, expecting COMMA\r\n"]
[56.439719, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
