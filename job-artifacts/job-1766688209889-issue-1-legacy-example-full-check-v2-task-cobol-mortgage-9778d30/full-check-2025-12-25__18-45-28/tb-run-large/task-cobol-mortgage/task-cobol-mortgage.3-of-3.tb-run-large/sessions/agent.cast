[104.241829, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[104.242111, "o", "       77  EOF-FLAG                    PIC X VALUE \"N\".\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.242202, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
