[59.020824, "o", "sed -n '1,40p' ../data/OUTPUT.DAT\r\n\u001b[?2004l\r"]
[59.022043, "o", "\r\n"]
[59.022287, "m", "Episode 1: 8 commands"]
[59.022287, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
[104.026555, "i", "cd /app/src\n"]
[104.026825, "o", "cd /app/src\r\n\u001b[?2004l\r\u001b[?2004hroot@b9423b228534:/app/src# "]
[104.135788, "i", "nl -ba program.cbl | sed -n '1,40p'\n"]
[104.135961, "o", "nl -ba program.cbl | sed -n '1,40p'\r\n\u001b[?2004l\r"]
[104.137542, "o", "     1\t       IDENTIFICATION DIVISION.\r\n     2\t       PROGRAM-ID. PROGRAM.\r\n     3\t\r\n     4\t       ENVIRONMENT DIVISION.\r\n     5\t       CONFIGURATION SECTION.\r\n     6\t       SPECIAL-NAMES.\r\n     7\t           DECIMAL-POINT IS DOT.\r\n     8\t\r\n     9\t       INPUT-OUTPUT SECTION.\r\n    10\t       FILE-CONTROL.\r\n    11\t           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\r\n    12\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n"]
[104.137639, "o", "    13\t           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n    14\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    15\t\r\n    16\t       DATA DIVISION.\r\n    17\t       FILE SECTION.\r\n    18\t       FD  INFILE.\r\n    19\t       01  IN-REC                      PIC X(256).\r\n    20\t\r\n    21\t       FD  OUTFILE.\r\n    22\t       01  OUT-REC                     PIC X(256).\r\n    23\t\r\n    24\t       WORKING-STORAGE SECTION.\r\n    25\t       77  EOF-FLAG                    PIC X VALUE \"N\".\r\n    26\t\r\n    27\t       01  WS-FIELDS.\r\n    28\t           05  WS-ID-TXT               PIC X(40).\r\n    29\t           05  WS-NAME-TXT             PIC X(80).\r\n    30\t           05  WS-LOAN-TXT             PIC X(40).\r\n    31\t           05  WS-PROP-TXT             PIC X(40).\r\n    32\t           05  WS-DOWN-TXT             PIC X(40).\r\n    33\t           05  WS-TERM-TXT             PIC X(40).\r\n    34\t           05  WS-RATE-TXT             PIC X(40).\r\n    35\t\r\n    36\t       01  WS-IN.\r\n    37\t           05  WS-ID                   PIC X(10).\r\n  "]
[104.137753, "o", "  38\t           05  WS-NAME                 PIC X(30).\r\n    39\t           05  WS-LOAN                 PIC 9(10) VALUE 0.\r\n    40\t           05  WS-PROP                 PIC 9(10) VALUE 0.\r\n"]
[104.137871, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
[104.238331, "i", "cat > program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INFILE.\n       01  IN-REC                      PIC X(256).\n\n       FD  OUTFILE.\n       01  OUT-REC                     PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       77  EOF-FLAG                    PIC X VALUE \"N\".\n\n       01  WS-FIELDS.\n           05  WS-ID-TXT               PIC X(40).\n           05  WS-NAME-TXT             PIC X(80).\n           05  WS-LOAN-TXT             PIC X(40).\n           05  WS-PROP-TXT             PIC X(40).\n           05  WS-DOWN-TXT             PIC X(40).\n           05  WS-TERM-TXT             PIC X(40).\n           05  WS-RATE-TXT             PIC X(40).\n\n       01"]
[104.238475, "i", "  WS-IN.\n           05  WS-ID                   PIC X(10).\n           05  WS-NAME                 PIC X(30).\n           05  WS-LOAN                 PIC 9(10) VALUE 0.\n           05  WS-PROP                 PIC 9(10) VALUE 0.\n           05  WS-DOWN                 PIC 9(10) VALUE 0.\n           05  WS-TERM-YEARS           PIC 9(2)  VALUE 0.\n           05  WS-RATE                 PIC 9(3)V9(2) VALUE 0.\n\n       01  WS-CALC.\n           05  WS-MIN-DOWN             PIC 9(12)V99 VALUE 0.\n           05  WS-TERM-MONTHS          PIC 9(4) VALUE 0.\n           05  WS-MONTHLY-RATE         COMP-2 VALUE 0.\n           05  WS-FACTOR               COMP-2 VALUE 0.\n           05  WS-MONTHLY-PAY-RAW      COMP-2 VALUE 0.\n           05  WS-BAL-RAW              COMP-2 VALUE 0.\n           05  WS-INT-RAW              COMP-2 VALUE 0.\n           05  WS-PRN-RAW              COMP-2 VALUE 0.\n\n       01  WS-OUT.\n           05  OUT-ID                  PIC X(10).\n           05  OUT-STATUS              PIC X(5).\n           05  OUT-REASON        "]
[104.238536, "o", "cat > program.cbl <<'EOF'\r\n\u001b[?2004l\r"]
[104.238611, "i", "      PIC X(50).\n\n       01  WS-SCHED.\n           05  SCH-MON                 PIC 9(3).\n           05  SCH-SP1                 PIC X VALUE \" \".\n           05  SCH-PAY                 PIC 9(8).99.\n           05  SCH-SP2                 PIC X VALUE \" \".\n           05  SCH-INT                 PIC 9(8).99.\n           05  SCH-SP3                 PIC X VALUE \" \".\n           05  SCH-PRN                 PIC 9(8).99.\n           05  SCH-SP4                 PIC X VALUE \" \".\n           05  SCH-BAL                 PIC 9(10).99.\n\n       01  WS-NUM.\n           05  N-LOAN                  COMP-2 VALUE 0.\n           05  N-PROP                  COMP-2 VALUE 0.\n           05  N-DOWN                  COMP-2 VALUE 0.\n           05  N-RATE                  COMP-2 VALUE 0.\n\n       77  I                           PIC 9(4) VALUE 0.\n       77  WS-ZERO                     COMP-2 VALUE 0.\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n\n           PERFORM UNTIL EOF-FLAG = \"Y\"\n        "]
[104.238874, "o", "\u001b[?2004h> "]
[104.238953, "i", "       READ INFILE\n                   AT END\n                       MOVE \"Y\" TO EOF-FLAG\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE INFILE\n           CLOSE OUTFILE\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-REC\n           PERFORM CHECK-AND-WRITE.\n\n       PARSE-REC.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID-TXT\n                    WS-NAME-TXT\n                    WS-LOAN-TXT\n                    WS-PROP-TXT\n                    WS-DOWN-TXT\n                    WS-TERM-TXT\n                    WS-RATE-TXT\n           END-UNSTRING\n\n           MOVE FUNCTION TRIM(WS-ID-TXT) TO WS-ID\n           MOVE FUNCTION TRIM(WS-NAME-TXT) TO WS-NAME\n\n           COMPUTE N-LOAN = FUNCTION NUMVAL(WS-LOAN-TXT)\n           COMPUTE N-PROP = FUNCTION NUMVAL(WS-PROP-TXT)\n           COMPUTE N-DOWN = FUNCTION NUMVAL(WS-DOWN-TXT)\n           COMPUTE N-RATE = FUNCTION"]
[104.238978, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>        ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r"]
[104.23902, "i", " NUMVAL(WS-RATE-TXT)\n\n           COMPUTE WS-LOAN = N-LOAN\n           COMPUTE WS-PROP = N-PROP\n           COMPUTE WS-DOWN = N-DOWN\n           COMPUTE WS-RATE = N-RATE\n           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT).\n\n       CHECK-AND-WRITE.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\n\n           IF WS-DOWN < WS-MIN-DOWN\n               MOVE WS-ID TO OUT-ID\n               MOVE \"DENY \" TO OUT-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO OUT-REASON\n               STRING OUT-ID OUT-STATUS OUT-REASON\n                   DELIMITED BY SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE WS-ID TO OUT-ID\n               MOVE \"APPRO\" TO OUT-STATUS\n               STRING OUT-ID OUT-STATUS\n                   DELIMITED BY SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n               PERFORM WRITE-SCHEDULE\n           END-IF.\n\n       WRITE-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS"]
[104.239042, "o", "\u001b[?2004h> "]
[104.239063, "i", " * 12\n           IF WS-TERM-MONTHS = 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\n           COMPUTE WS-BAL-RAW = WS-LOAN\n\n           IF WS-MONTHLY-RATE = WS-ZERO\n               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\n                   WS-BAL-RAW / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-FACTOR =\n                   (1 + WS-MONTHLY-RATE) ** (-1 * WS-TERM-MONTHS)\n               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\n                   (WS-BAL-RAW * WS-MONTHLY-RATE) / (1 - WS-FACTOR)\n           END-IF\n\n           PERFORM VARYING I FROM 1 BY 1 UNTIL I > WS-TERM-MONTHS\n               COMPUTE WS-INT-RAW ROUNDED = WS-BAL-RAW * WS-MONTHLY-RATE\n               COMPUTE WS-PRN-RAW ROUNDED =\n                   WS-MONTHLY-PAY-RAW - WS-INT-RAW\n\n               IF I = WS-TERM-MONTHS\n                   COMPUTE WS-PRN-RAW ROUNDED = WS-BAL-RAW\n                   COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\n                       WS-PRN-RAW + WS-INT-RAW\n      "]
[104.239101, "i", "             COMPUTE WS-BAL-RAW = 0\n               ELSE\n                   COMPUTE WS-BAL-RAW ROUNDED = WS-BAL-RAW - WS-PRN-RAW\n               END-IF\n\n               MOVE I TO SCH-MON\n               MOVE WS-MONTHLY-PAY-RAW TO SCH-PAY\n               MOVE WS-INT-RAW TO SCH-INT\n               MOVE WS-PRN-RAW TO SCH-PRN\n               MOVE WS-BAL-RAW TO SCH-BAL\n\n               STRING SCH-MON SCH-SP1 SCH-PAY SCH-SP2 SCH-INT\n                      SCH-SP3 SCH-PRN SCH-SP4 SCH-BAL\n                   DELIMITED BY SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           END-PERFORM.\nEOF\n"]
[104.239197, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.239302, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\r"]
[104.239377, "o", "\u001b[?2004h> "]
[104.239541, "o", "           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.239566, "o", "> "]
[104.239847, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.240135, "o", "           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.240195, "o", "> "]
[104.240456, "o", "               ORGANIZATION IS LINE SEQUENTIAL.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.240487, "o", "\u001b[?2004h> "]
[104.240642, "o", "       DATA DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h> "]
