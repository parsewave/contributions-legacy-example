[104.24232, "o", "> "]
[104.242534, "o", "           05  WS-ID-TXT               PIC X(40).\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.242558, "o", "> "]
[104.242747, "o", "           05  WS-NAME-TXT             PIC X(80).\r\n\u001b[?2004l\r"]
[104.242775, "o", "\u001b[?2004h> "]
[104.243002, "o", "           05  WS-LOAN-TXT             PIC X(40).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.243193, "o", "           05  WS-PROP-TXT             PIC X(40).\r\n\u001b[?2004l\r\u001b[?2004h> "]
