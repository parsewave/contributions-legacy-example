[125.196928, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
[125.296933, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('program.cbl')\nlines = p.read_text().splitlines(True)\nout = []\nfor line in lines:\n    stripped = line.lstrip()\n    # Insert \"MOVE SPACES TO OUT-REC\" right before STRINGs that build OUT-REC\n    if stripped.startswith('STRING OUT-ID OUT-STATUS OUT-REASON'):\n        indent = line[:len(line)-len(stripped)]\n        out.append(f\"{indent}MOVE SPACES TO OUT-REC\\n\")\n        out.append(line)\n        continue\n    if stripped.startswith('STRING OUT-ID OUT-STATUS') and 'OUT-REASON' not in stripped:\n        indent = line[:len(line)-len(stripped)]\n        out.append(f\"{indent}MOVE SPACES TO OUT-REC\\n\")\n        out.append(line)\n        continue\n    if stripped.startswith('STRING SCH-MON'):\n        indent = line[:len(line)-len(stripped)]\n        out.append(f\"{indent}MOVE SPACES TO OUT-REC\\n\")\n        out.append(line)\n        continue\n    out.append(line)\n\np.write_text(''.join(out))\nPY\n"]
[125.297104, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
