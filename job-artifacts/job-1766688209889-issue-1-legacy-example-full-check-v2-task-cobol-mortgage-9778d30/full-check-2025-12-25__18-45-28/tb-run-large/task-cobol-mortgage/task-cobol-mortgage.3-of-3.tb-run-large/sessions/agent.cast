[57.432935, "o", "cobc -x -Wall program.cbl\r\n\u001b[?2004l\r"]
[57.452015, "o", "program.cbl:7: error: syntax error, unexpected Identifier, expecting COMMA\r\n"]
[57.452772, "o", "\u001b[?2004hroot@b9423b228534:/app/src# "]
