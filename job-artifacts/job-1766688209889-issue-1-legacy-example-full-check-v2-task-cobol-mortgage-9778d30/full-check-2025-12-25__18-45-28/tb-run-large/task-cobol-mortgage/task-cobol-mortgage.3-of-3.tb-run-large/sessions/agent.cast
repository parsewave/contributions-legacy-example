[104.243912, "o", "       01  WS-IN.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.243928, "o", "> "]
[104.244126, "o", "           05  WS-ID                   PIC X(10).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.24436, "o", "           05  WS-NAME                 PIC X(30).\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.244394, "o", "> "]
[104.244594, "o", "           05  WS-LOAN                 PIC 9(10) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.244808, "o", "           05  WS-PROP                 PIC 9(10) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.244828, "o", "> "]
[104.245028, "o", "           05  WS-DOWN                 PIC 9(10) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.245058, "o", "> "]
[104.245283, "o", "           05  WS-TERM-YEARS           PIC 9(2)  VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.245508, "o", "           05  WS-RATE                 PIC 9(3)V9(2) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.245539, "o", "\r\n\u001b[?2004l\r \u001b[?2004h"]
[104.245625, "o", "> "]
[104.245739, "o", "       01  WS-CALC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.245871, "o", "           05  WS-MIN-DOWN             PIC 9(12)V99 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.245906, "o", "> "]
[104.246123, "o", "           05  WS-TERM-MONTHS          PIC 9(4) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.246318, "o", "           05  WS-MONTHLY-RATE         COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.246403, "o", "> "]
[104.246517, "o", "           05  WS-FACTOR               COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.246727, "o", "           05  WS-MONTHLY-PAY-RAW      COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.246972, "o", "           05  WS-BAL-RAW              COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.247199, "o", "           05  WS-INT-RAW              COMP-2 VALUE 0.\r\n\u001b[?2004l\r"]
[104.247235, "o", "\u001b[?2004h> "]
[104.247428, "o", "           05  WS-PRN-RAW              COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[104.247449, "o", "\u001b[?2004l\r"]
[104.247458, "o", "\u001b[?2004h> "]
