[56.03388, "o", "APP0000001;Williams David Robert         ;2000000000;3500000000;0500000000;20;00550\r\nAPP0000002;John Smith Clark              ;0000005000;0000004000;0000003500;01;00550"]
[56.034264, "o", "\u001b[?2004hroot@b9423b228534:/app# "]
[56.126209, "i", "cat > /app/src/program.cbl <<'EOF'\n       IDENTIFICATION DIVISION.\n       PROGRAM-ID. PROGRAM.\n\n       ENVIRONMENT DIVISION.\n       CONFIGURATION SECTION.\n       SPECIAL-NAMES.\n           DECIMAL-POINT IS DOT.\n\n       INPUT-OUTPUT SECTION.\n       FILE-CONTROL.\n           SELECT INFILE ASSIGN TO \"INPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n           SELECT OUTFILE ASSIGN TO \"../data/OUTPUT.DAT\"\n               ORGANIZATION IS LINE SEQUENTIAL.\n\n       DATA DIVISION.\n       FILE SECTION.\n       FD  INFILE.\n       01  IN-REC                      PIC X(256).\n\n       FD  OUTFILE.\n       01  OUT-REC                     PIC X(256).\n\n       WORKING-STORAGE SECTION.\n       77  EOF-FLAG                    PIC X VALUE \"N\".\n\n       01  WS-FIELDS.\n           05  WS-ID-TXT               PIC X(40).\n           05  WS-NAME-TXT             PIC X(80).\n           05  WS-LOAN-TXT             PIC X(40).\n           05  WS-PROP-TXT             PIC X(40).\n           05  WS-DOWN-TXT             PIC X(40).\n           05  "]
[56.126438, "i", "WS-TERM-TXT             PIC X(40).\n           05  WS-RATE-TXT             PIC X(40).\n\n       01  WS-IN.\n           05  WS-ID                   PIC X(10).\n           05  WS-NAME                 PIC X(30).\n           05  WS-LOAN                 PIC 9(10) VALUE 0.\n           05  WS-PROP                 PIC 9(10) VALUE 0.\n           05  WS-DOWN                 PIC 9(10) VALUE 0.\n           05  WS-TERM-YEARS           PIC 9(2)  VALUE 0.\n           05  WS-RATE                 PIC 9(3)V9(2) VALUE 0.\n\n       01  WS-CALC.\n           05  WS-MIN-DOWN             PIC 9(12)V99 VALUE 0.\n           05  WS-TERM-MONTHS          PIC 9(4) VALUE 0.\n           05  WS-MONTHLY-RATE         COMP-2 VALUE 0.\n           05  WS-FACTOR               COMP-2 VALUE 0.\n           05  WS-MONTHLY-PAY-RAW      COMP-2 VALUE 0.\n           05  WS-BAL-RAW              COMP-2 VALUE 0.\n           05  WS-INT-RAW              COMP-2 VALUE 0.\n           05  WS-PRN-RAW              COMP-2 VALUE 0.\n\n       01  WS-OUT.\n           05  OUT-ID                "]
[56.126482, "o", "cat > /app/src/program.cbl <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.126504, "i", "  PIC X(10).\n           05  OUT-STATUS              PIC X(5).\n           05  OUT-SPACE1              PIC X VALUE \" \".\n           05  OUT-REASON              PIC X(50).\n\n       01  WS-SCHED.\n           05  SCH-MON                 PIC 9(3).\n           05  SCH-SP1                 PIC X VALUE \" \".\n           05  SCH-PAY                 PIC 9(8).99.\n           05  SCH-SP2                 PIC X VALUE \" \".\n           05  SCH-INT                 PIC 9(8).99.\n           05  SCH-SP3                 PIC X VALUE \" \".\n           05  SCH-PRN                 PIC 9(8).99.\n           05  SCH-SP4                 PIC X VALUE \" \".\n           05  SCH-BAL                 PIC 9(10).99.\n\n       01  WS-NUM.\n           05  N-LOAN                  COMP-2 VALUE 0.\n           05  N-PROP                  COMP-2 VALUE 0.\n           05  N-DOWN                  COMP-2 VALUE 0.\n           05  N-RATE                  COMP-2 VALUE 0.\n\n       77  I                           PIC 9(4) VALUE 0.\n       77  WS-ZERO                     COMP-2 VALUE 0."]
[56.126731, "o", "       IDENTIFICATION DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        PROGRAM-ID. PROGRAM.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>        ENVIRONMENT DIVISION.\r\n\u001b[?2004l\r\u001b[?2004h>        CONFIGURATION SECTION.\r\n\u001b[?2004l\r\u001b[?2004h>        SPECIAL-NAMES.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.12676, "i", "\n\n       PROCEDURE DIVISION.\n       MAIN.\n           OPEN INPUT INFILE\n           OPEN OUTPUT OUTFILE\n\n           PERFORM UNTIL EOF-FLAG = \"Y\"\n               READ INFILE\n                   AT END\n                       MOVE \"Y\" TO EOF-FLAG\n                   NOT AT END\n                       PERFORM PROCESS-REC\n               END-READ\n           END-PERFORM\n\n           CLOSE INFILE\n           CLOSE OUTFILE\n           STOP RUN.\n\n       PROCESS-REC.\n           PERFORM PARSE-REC\n           PERFORM CHECK-AND-WRITE.\n\n       PARSE-REC.\n           MOVE SPACES TO WS-FIELDS\n           UNSTRING IN-REC DELIMITED BY \";\"\n               INTO WS-ID-TXT\n                    WS-NAME-TXT\n                    WS-LOAN-TXT\n                    WS-PROP-TXT\n                    WS-DOWN-TXT\n                    WS-TERM-TXT\n                    WS-RATE-TXT\n           END-UNSTRING\n\n           MOVE FUNCTION TRIM(WS-ID-TXT) TO WS-ID\n           MOVE FUNCTION TRIM(WS-NAME-TXT) TO WS-NAME\n\n           COMPUTE N-LOAN = FUNCTION NUMVAL(WS-LOAN-TXT)"]
[56.126779, "o", "           DECIMAL-POINT IS DOT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.126795, "i", "\n           COMPUTE N-PROP = FUNCTION NUMVAL(WS-PROP-TXT)\n           COMPUTE N-DOWN = FUNCTION NUMVAL(WS-DOWN-TXT)\n           COMPUTE N-RATE = FUNCTION NUMVAL(WS-RATE-TXT)\n\n           COMPUTE WS-LOAN = N-LOAN\n           COMPUTE WS-PROP = N-PROP\n           COMPUTE WS-DOWN = N-DOWN\n           COMPUTE WS-RATE = N-RATE\n           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT).\n\n       CHECK-AND-WRITE.\n           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\n\n           IF WS-DOWN < WS-MIN-DOWN\n               MOVE WS-ID TO OUT-ID\n               MOVE \"DENY \" TO OUT-STATUS\n               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO OUT-REASON\n               STRING OUT-ID OUT-STATUS OUT-SPACE1 OUT-REASON\n                   DELIMITED BY SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           ELSE\n               MOVE WS-ID TO OUT-ID\n               MOVE \"APPRO\" TO OUT-STATUS\n               MOVE SPACES TO OUT-REASON\n               STRING OUT-ID OUT-STATUS\n                   DELIMITED BY "]
[56.126814, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.12682, "i", "SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n               PERFORM WRITE-SCHEDULE\n           END-IF.\n\n       WRITE-SCHEDULE.\n           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\n           IF WS-TERM-MONTHS = 0\n               EXIT PARAGRAPH\n           END-IF\n\n           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\n\n           COMPUTE WS-BAL-RAW = WS-LOAN\n\n           IF WS-MONTHLY-RATE = WS-ZERO\n               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED = WS-BAL-RAW\n                   / WS-TERM-MONTHS\n           ELSE\n               COMPUTE WS-FACTOR = (1 + WS-MONTHLY-RATE)\n                   ** (-1 * WS-TERM-MONTHS)\n               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\n                   (WS-BAL-RAW * WS-MONTHLY-RATE) / (1 - WS-FACTOR)\n           END-IF\n\n           PERFORM VARYING I FROM 1 BY 1 UNTIL I > WS-TERM-MONTHS\n               COMPUTE WS-INT-RAW ROUNDED = WS-BAL-RAW * WS-MONTHLY-RATE\n               COMPUTE WS-PRN-RAW ROUNDED = WS-MONTHLY-PAY-RAW - WS-INT-RAW\n\n               IF I "]
[56.126968, "i", "= WS-TERM-MONTHS\n                   COMPUTE WS-PRN-RAW ROUNDED = WS-BAL-RAW\n                   COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\n                       WS-PRN-RAW + WS-INT-RAW\n                   COMPUTE WS-BAL-RAW = 0\n               ELSE\n                   COMPUTE WS-BAL-RAW ROUNDED = WS-BAL-RAW - WS-PRN-RAW\n               END-IF\n\n               MOVE I TO SCH-MON\n               MOVE WS-MONTHLY-PAY-RAW TO SCH-PAY\n               MOVE WS-INT-RAW TO SCH-INT\n               MOVE WS-PRN-RAW TO SCH-PRN\n               MOVE WS-BAL-RAW TO SCH-BAL\n\n               STRING SCH-MON SCH-SP1 SCH-PAY SCH-SP2 SCH-INT\n                      SCH-SP3 SCH-PRN SCH-SP4 SCH-BAL\n                   DELIMITED BY SIZE INTO OUT-REC\n               END-STRING\n               WRITE OUT-REC\n           END-PERFORM.\nEOF\n"]
[56.127032, "o", "       INPUT-OUTPUT SECTION.\r\n\u001b[?2004l\r= N\u001b[?2004h> "]
[56.127079, "o", "       FILE-CONTROL.\r\n\u001b[?2004l\r"]
