[104.24791, "o", "           05  OUT-STATUS              PIC X(5).\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.247936, "o", "> "]
[104.248125, "o", "           05  OUT-REASON              PIC X(50).\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.248143, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.248228, "o", "> "]
[104.248258, "o", "       01  WS-SCHED.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.248359, "o", "> "]
[104.24852, "o", "           05  SCH-MON                 PIC 9(3).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.248755, "o", "           05  SCH-SP1                 PIC X VALUE \" \".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.248937, "o", "           05  SCH-PAY                 PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.249159, "o", "           05  SCH-SP2                 PIC X VALUE \" \".\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.249348, "o", "           05  SCH-INT                 PIC 9(8).99.\r\n\u001b[?2004l\r"]
[104.249377, "o", "\u001b[?2004h> "]
[104.24954, "o", "           05  SCH-SP3                 PIC X VALUE \" \".\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.249573, "o", "> "]
[104.249738, "o", "           05  SCH-PRN                 PIC 9(8).99.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.249904, "o", "           05  SCH-SP4                 PIC X VALUE \" \".\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.249931, "o", "> "]
[104.250107, "o", "           05  SCH-BAL                 PIC 9(10).99.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.250143, "o", "\u001b[?2004h> "]
[104.250235, "o", "       01  WS-NUM.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.250442, "o", "           05  N-LOAN                  COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.250582, "o", "           05  N-PROP                  COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.250703, "o", "           05  N-DOWN                  COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.250839, "o", "           05  N-RATE                  COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.250864, "o", "> "]
[104.250997, "o", "       77  I                           PIC 9(4) VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251123, "o", "       77  WS-ZERO                     COMP-2 VALUE 0.\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.251149, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251223, "o", "       PROCEDURE DIVISION.\r\n\u001b[?2004l\r"]
[104.251244, "o", "\u001b[?2004h"]
[104.251352, "o", ">        MAIN.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.25147, "o", "           OPEN INPUT INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251556, "o", "           OPEN OUTPUT OUTFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.251571, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251691, "o", "           PERFORM UNTIL EOF-FLAG = \"Y\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251771, "o", "               READ INFILE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251864, "o", "                   AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.251973, "o", "                       MOVE \"Y\" TO EOF-FLAG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.252129, "o", "                   NOT AT END\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.252155, "o", "                       PERFORM PROCESS-REC\r\n"]
[104.252164, "o", "\u001b[?2004l\r"]
[104.252241, "o", "\u001b[?2004h> "]
[104.25233, "o", "               END-READ\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.252361, "o", "           END-PERFORM\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.252425, "o", "> \r\n\u001b[?2004l\r"]
[104.252459, "o", "\u001b[?2004h>            CLOSE INFILE\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.252526, "o", ">            CLOSE OUTFILE\r\n\u001b[?2004l\r"]
[104.252556, "o", "\u001b[?2004h> "]
[104.252624, "o", "           STOP RUN.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[104.252653, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[104.25274, "o", "       PROCESS-REC.\r\n\u001b[?2004l\r"]
[104.252769, "o", "\u001b[?2004h> "]
[104.252785, "o", "           PERFORM PARSE-REC\r\n"]
[104.252798, "o", "\u001b[?2004l\r"]
[104.252806, "o", "\u001b[?2004h"]
[104.252873, "o", "> "]
[104.252941, "o", "           PERFORM CHECK-AND-WRITE.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253039, "o", "       PARSE-REC.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253134, "o", "           MOVE SPACES TO WS-FIELDS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253236, "o", "           UNSTRING IN-REC DELIMITED BY \";\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253351, "o", "               INTO WS-ID-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253443, "o", "                    WS-NAME-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.25352, "o", "                    WS-LOAN-TXT\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.253586, "o", "> "]
[104.253654, "o", "                    WS-PROP-TXT\r\n\u001b[?2004l\r"]
[104.25372, "o", "\u001b[?2004h>                     WS-DOWN-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253803, "o", "                    WS-TERM-TXT\r\n\u001b[?2004l\r"]
[104.25383, "o", "\u001b[?2004h> "]
[104.253903, "o", "                    WS-RATE-TXT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.253984, "o", "           END-UNSTRING\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.25401, "o", "> "]
[104.254145, "o", "           MOVE FUNCTION TRIM(WS-ID-TXT) TO WS-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.254285, "o", "           MOVE FUNCTION TRIM(WS-NAME-TXT) TO WS-NAME\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.254423, "o", "           COMPUTE N-LOAN = FUNCTION NUMVAL(WS-LOAN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.254551, "o", "           COMPUTE N-PROP = FUNCTION NUMVAL(WS-PROP-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.254679, "o", "           COMPUTE N-DOWN = FUNCTION NUMVAL(WS-DOWN-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.254808, "o", "           COMPUTE N-RATE = FUNCTION NUMVAL(WS-RATE-TXT)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.254831, "o", "\u001b[?2004h> "]
[104.254934, "o", "           COMPUTE WS-LOAN = N-LOAN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.255012, "o", "           COMPUTE WS-PROP = N-PROP\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.255037, "o", "> "]
[104.25515, "o", "           COMPUTE WS-DOWN = N-DOWN\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.25518, "o", "> "]
[104.255234, "o", "           COMPUTE WS-RATE = N-RATE\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.255261, "o", "> "]
[104.255408, "o", "           COMPUTE WS-TERM-YEARS = FUNCTION NUMVAL(WS-TERM-TXT).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.255428, "o", "\u001b[?2004h> "]
[104.255508, "o", "       CHECK-AND-WRITE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.255672, "o", "           COMPUTE WS-MIN-DOWN ROUNDED = WS-PROP * 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.255723, "o", "           IF WS-DOWN < WS-MIN-DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.255819, "o", "               MOVE WS-ID TO OUT-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.25591, "o", "               MOVE \"DENY \" TO OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.255939, "o", "> "]
[104.256092, "o", "               MOVE \"INSUFFICIENT FUNDS FOR DOWN PAYMENT\" TO OUT-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.256216, "o", "               STRING OUT-ID OUT-STATUS OUT-REASON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.256346, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.256413, "o", "               END-STRING\r\n\u001b[?2004l\r"]
[104.256439, "o", "\u001b[?2004h> "]
[104.256503, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.256533, "o", "> "]
[104.256589, "o", "           ELSE\r\n\u001b[?2004l\r"]
[104.256658, "o", "\u001b[?2004h> "]
[104.256696, "o", "               MOVE WS-ID TO OUT-ID\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.256797, "o", "               MOVE \"APPRO\" TO OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.256911, "o", "               STRING OUT-ID OUT-STATUS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.25702, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.257108, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.257205, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r"]
[104.257236, "o", "\u001b[?2004h> "]
[104.257324, "o", "               PERFORM WRITE-SCHEDULE\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.257352, "o", "> "]
[104.257415, "o", "           END-IF.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.257484, "o", "\u001b[?2004h> "]
[104.25755, "o", "       WRITE-SCHEDULE.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.257638, "o", "           COMPUTE WS-TERM-MONTHS = WS-TERM-YEARS * 12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.257734, "o", "           IF WS-TERM-MONTHS = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.257808, "o", "               EXIT PARAGRAPH\r\n\u001b[?2004l\r"]
[104.257836, "o", "\u001b[?2004h> "]
[104.257894, "o", "           END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.257919, "o", "\u001b[?2004h> "]
[104.258054, "o", "           COMPUTE WS-MONTHLY-RATE ROUNDED = WS-RATE / 1200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.258177, "o", "           COMPUTE WS-BAL-RAW = WS-LOAN\r\n\u001b[?2004l\r"]
[104.2582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.258332, "o", "           IF WS-MONTHLY-RATE = WS-ZERO\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.25836, "o", "> "]
[104.258467, "o", "               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.25849, "o", "> "]
[104.2586, "o", "                   WS-BAL-RAW / WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h>            ELSE\r\n\u001b[?2004l\r"]
[104.258619, "o", "\u001b[?2004h> "]
[104.25872, "o", "               COMPUTE WS-FACTOR =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.258856, "o", "                   (1 + WS-MONTHLY-RATE) ** (-1 * WS-TERM-MONTHS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.258991, "o", "               COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.259144, "o", "                   (WS-BAL-RAW * WS-MONTHLY-RATE) / (1 - WS-FACTOR)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.259217, "o", "           END-IF\r\n\u001b[?2004l\r"]
[104.259247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.259392, "o", "           PERFORM VARYING I FROM 1 BY 1 UNTIL I > WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.25955, "o", "               COMPUTE WS-INT-RAW ROUNDED = WS-BAL-RAW * WS-MONTHLY-RATE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.259675, "o", "               COMPUTE WS-PRN-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.259802, "o", "                   WS-MONTHLY-PAY-RAW - WS-INT-RAW\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[104.259823, "o", "\u001b[?2004h> "]
[104.25993, "o", "               IF I = WS-TERM-MONTHS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.260056, "o", "                   COMPUTE WS-PRN-RAW ROUNDED = WS-BAL-RAW\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.260092, "o", "> "]
[104.260222, "o", "                   COMPUTE WS-MONTHLY-PAY-RAW ROUNDED =\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.260342, "o", "                       WS-PRN-RAW + WS-INT-RAW\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.260366, "o", "> "]
[104.260469, "o", "                   COMPUTE WS-BAL-RAW = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.260495, "o", "               ELSE\r\n\u001b[?2004l\r"]
[104.260544, "o", "\u001b[?2004h> "]
[104.260677, "o", "                   COMPUTE WS-BAL-RAW ROUNDED = WS-BAL-RAW - WS-PRN-RAW\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.260698, "o", "> "]
[104.260782, "o", "               END-IF\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.260848, "o", "> "]
[104.260917, "o", "               MOVE I TO SCH-MON\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.260986, "o", "> "]
[104.261015, "o", "               MOVE WS-MONTHLY-PAY-RAW TO SCH-PAY\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.261152, "o", "               MOVE WS-INT-RAW TO SCH-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.261241, "o", "               MOVE WS-PRN-RAW TO SCH-PRN\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.261334, "o", "> "]
[104.261365, "o", "               MOVE WS-BAL-RAW TO SCH-BAL\r\n\u001b[?2004l\r"]
[104.261437, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.261578, "o", "               STRING SCH-MON SCH-SP1 SCH-PAY SCH-SP2 SCH-INT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.261726, "o", "                      SCH-SP3 SCH-PRN SCH-SP4 SCH-BAL\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.261751, "o", "> "]
[104.261894, "o", "                   DELIMITED BY SIZE INTO OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.261965, "o", "               END-STRING\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.261994, "o", "> "]
[104.262065, "o", "               WRITE OUT-REC\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.262146, "o", "> "]
[104.262288, "o", "           END-PERFORM.\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
